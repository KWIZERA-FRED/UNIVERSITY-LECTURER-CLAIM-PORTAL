@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.IndexModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    ViewData["Title"] = "HOD Dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/dashboard.css"
          asp-append-version="true" />
}

<div class="dashboard-page">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="page-header">

        <div class="page-header-content">

            <div class="page-title-group">

                <div class="page-eyebrow">
                    <i class="bi bi-grid-1x2-fill"></i>
                    Head of Department
                </div>

                <h1>Welcome, @Model.HodName</h1>

                <p>
                    Manage academic staff, course assignments, contracts
                    and claims for your department.
                </p>

            </div>

            <div class="department-card">

                <div class="department-icon">
                    <i class="bi bi-building"></i>
                </div>

                <div>
                    <span>Department</span>
                    <strong>@Model.HodDepartment</strong>
                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         STATISTICS
         ============================================================ -->

    <div class="stats-grid">

        <!-- Contracts to Sign -->

        <div class="stat-card">

            <div class="stat-card-top">

                <div class="stat-icon contracts">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <span class="stat-label">
                    Contracts to Sign
                </span>

            </div>

            <div class="stat-value">
                @Model.ContractsToSign
            </div>

            <div class="stat-footer">
                <span>
                    <i class="bi bi-clock"></i>
                    Pending action
                </span>

                <a asp-page="/HOD/Contracts">
                    View
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>


        <!-- Contracts to Review -->

        <div class="stat-card">

            <div class="stat-card-top">

                <div class="stat-icon active">
                    <i class="bi bi-file-earmark-check"></i>
                </div>

                <span class="stat-label">
                    Active Contracts
                </span>

            </div>

            <div class="stat-value">
                @Model.ContractsToReview
            </div>

            <div class="stat-footer">
                <span>
                    <i class="bi bi-check-circle"></i>
                    Active
                </span>

                <a asp-page="/HOD/Contracts">
                    View
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>


        <!-- Claims -->

        <div class="stat-card">

            <div class="stat-card-top">

                <div class="stat-icon claims">
                    <i class="bi bi-receipt"></i>
                </div>

                <span class="stat-label">
                    Claims Received
                </span>

            </div>

            <div class="stat-value">
                @Model.ClaimsReceived
            </div>

            <div class="stat-footer">
                <span>
                    <i class="bi bi-hourglass-split"></i>
                    Awaiting approval
                </span>

                <a asp-page="/HOD/Claims">
                    Review
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>


        <!-- Academic Staff -->

        <div class="stat-card">

            <div class="stat-card-top">

                <div class="stat-icon staff">
                    <i class="bi bi-people"></i>
                </div>

                <span class="stat-label">
                    Academic Staff
                </span>

            </div>

            <div class="stat-value">
                @Model.AcademicStaff
            </div>

            <div class="stat-footer">
                <span>
                    <i class="bi bi-person-check"></i>
                    Active lecturers
                </span>

                <a asp-page="/HOD/Staff">
                    View
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>

    </div>


    <!-- ============================================================
         WORKFLOW / QUICK ACTIONS
         ============================================================ -->

    <div class="dashboard-grid">

        <!-- Workflow -->

        <section class="dashboard-card workflow-card">

            <div class="card-header">

                <div>
                    <span class="card-eyebrow">
                        Department workflow
                    </span>

                    <h2>Academic Staff Process</h2>
                </div>

                <div class="card-header-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>

            </div>

            <div class="workflow-list">

                <div class="workflow-item">

                    <div class="workflow-number">
                        01
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <div class="workflow-content">
                        <strong>Register Staff</strong>
                        <span>
                            Create lecturer accounts and capture staff information.
                        </span>
                    </div>

                </div>


                <div class="workflow-item">

                    <div class="workflow-number">
                        02
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-journal-plus"></i>
                    </div>

                    <div class="workflow-content">
                        <strong>Assign Course</strong>
                        <span>
                            Assign courses and teaching hours to academic staff.
                        </span>
                    </div>

                </div>


                <div class="workflow-item">

                    <div class="workflow-number">
                        03
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div class="workflow-content">
                        <strong>Generate Contract</strong>
                        <span>
                            Generate the academic staff engagement contract.
                        </span>
                    </div>

                </div>


                <div class="workflow-item">

                    <div class="workflow-number">
                        04
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-pen"></i>
                    </div>

                    <div class="workflow-content">
                        <strong>Contract Signing</strong>
                        <span>
                            Follow the required institutional signing workflow.
                        </span>
                    </div>

                </div>


                <div class="workflow-item">

                    <div class="workflow-number">
                        05
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>

                    <div class="workflow-content">
                        <strong>Process Claims</strong>
                        <span>
                            Review and process lecturer claims submitted for payment.
                        </span>
                    </div>

                </div>

            </div>

        </section>


        <!-- Quick Actions -->

        <section class="dashboard-card quick-actions-card">

            <div class="card-header">

                <div>
                    <span class="card-eyebrow">
                        Shortcuts
                    </span>

                    <h2>Quick Actions</h2>
                </div>

                <div class="card-header-icon">
                    <i class="bi bi-lightning-charge"></i>
                </div>

            </div>


            <div class="quick-actions">

                <a asp-page="/HOD/RegisterUser"
                   class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>

                    <div class="quick-action-content">
                        <strong>Register User</strong>
                        <span>
                            Create an academic staff account
                        </span>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>


                <a asp-page="/HOD/Staff"
                   class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="quick-action-content">
                        <strong>Manage Staff</strong>
                        <span>
                            View and manage department staff
                        </span>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>


                <a asp-page="/HOD/AssignCourse"
                   class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-journal-plus"></i>
                    </div>

                    <div class="quick-action-content">
                        <strong>Assign Course</strong>
                        <span>
                            Allocate courses and teaching hours
                        </span>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>


                <a asp-page="/HOD/Contracts"
                   class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>

                    <div class="quick-action-content">
                        <strong>Contracts</strong>
                        <span>
                            View department contracts
                        </span>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>


                <a asp-page="/HOD/Claims"
                   class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <div class="quick-action-content">
                        <strong>Claims</strong>
                        <span>
                            Review lecturer claims
                        </span>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>

            </div>

        </section>

    </div>


    <!-- ============================================================
         CONTRACTS + CLAIMS
         ============================================================ -->

    <div class="dashboard-grid lower-grid">

        <!-- Contracts awaiting signature -->

        <section class="dashboard-card table-card">

            <div class="card-header">

                <div>
                    <span class="card-eyebrow">
                        Contracts
                    </span>

                    <h2>Awaiting Signature</h2>
                </div>

                <a asp-page="/HOD/Contracts"
                   class="view-all-link">
                    View all
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            @if (Model.ContractsAwaitingSignature.Any())
            {
                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Lecturer</th>
                                <th>Course</th>
                                <th>Hours</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var contract in Model.ContractsAwaitingSignature)
                            {
                                <tr>

                                    <td>
                                        <div class="person-cell">

                                            <div class="person-avatar">
                                                @{
                                                    var names = contract.LecturerName
                                                        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                                    var initials = names.Length switch
                                                    {
                                                        0 => "?",
                                                        1 => names[0][0].ToString().ToUpper(),
                                                        _ => $"{names[0][0]}{names[^1][0]}".ToUpper()
                                                    };
                                                }

                                                @initials
                                            </div>

                                            <span>
                                                @contract.LecturerName
                                            </span>

                                        </div>
                                    </td>

                                    <td>
                                        @contract.CourseTitle
                                    </td>

                                    <td>
                                        @contract.Hours
                                    </td>

                                    <td>

                                        <span class="status-badge pending">

                                            <i class="bi bi-clock"></i>

                                            @contract.Status
                                        </span>

                                    </td>

                                    <td>

                                        <a asp-page="/HOD/Contracts"
                                           asp-route-ContractId="@contract.Id"
                                           class="table-action"
                                           title="View contract">

                                            <i class="bi bi-arrow-up-right"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>

                    <h3>No contracts awaiting signature</h3>

                    <p>
                        There are currently no contracts requiring action.
                    </p>

                </div>
            }

        </section>


        <!-- Recent Claims -->

        <section class="dashboard-card table-card">

            <div class="card-header">

                <div>
                    <span class="card-eyebrow">
                        Claims
                    </span>

                    <h2>Recent Claims</h2>
                </div>

                <a asp-page="/HOD/Claims"
                   class="view-all-link">
                    View all
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            @if (Model.RecentClaims.Any())
            {
                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Lecturer</th>
                                <th>Contract</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var claim in Model.RecentClaims)
                            {
                                <tr>

                                    <td>

                                        <div class="person-cell">

                                            <div class="person-avatar">
                                                @{
                                                    var names = claim.LecturerName
                                                        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                                    var initials = names.Length switch
                                                    {
                                                        0 => "?",
                                                        1 => names[0][0].ToString().ToUpper(),
                                                        _ => $"{names[0][0]}{names[^1][0]}".ToUpper()
                                                    };
                                                }

                                                @initials
                                            </div>

                                            <span>
                                                @claim.LecturerName
                                            </span>

                                        </div>

                                    </td>

                                    <td>
                                        CON-@claim.ContractId.ToString("D6")
                                    </td>

                                    <td>

                                        @{
                                            var claimStatusClass =
                                                claim.Status == ClaimStatus.Approved ||
                                                claim.Status == ClaimStatus.Paid
                                                    ? "approved"
                                                    : claim.Status == ClaimStatus.Rejected
                                                        ? "rejected"
                                                        : "pending";
                                        }

                                        <span class="status-badge @claimStatusClass">

                                            @if (claim.Status == ClaimStatus.Approved ||
                                                 claim.Status == ClaimStatus.Paid)
                                            {
                                                <i class="bi bi-check-circle"></i>
                                            }
                                            else if (claim.Status == ClaimStatus.Rejected)
                                            {
                                                <i class="bi bi-x-circle"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-clock"></i>
                                            }

                                            @claim.Status

                                        </span>

                                    </td>

                                    <td>

                                        <a asp-page="/HOD/Claims"
                                           class="table-action"
                                           title="View claim">

                                            <i class="bi bi-arrow-up-right"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <h3>No recent claims</h3>

                    <p>
                        There are currently no claims to display.
                    </p>

                </div>
            }

        </section>

    </div>


    <!-- ============================================================
         HOD RESPONSIBILITIES
         ============================================================ -->

    <section class="responsibilities-card">

        <div class="responsibilities-heading">

            <div class="responsibilities-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <span class="card-eyebrow">
                    HOD Responsibilities
                </span>

                <h2>Department Management</h2>
            </div>

        </div>


        <div class="responsibilities-list">

            <div class="responsibility">

                <i class="bi bi-check2-circle"></i>

                <span>
                    Manage academic staff within your department
                </span>

            </div>


            <div class="responsibility">

                <i class="bi bi-check2-circle"></i>

                <span>
                    Assign courses and teaching hours
                </span>

            </div>


            <div class="responsibility">

                <i class="bi bi-check2-circle"></i>

                <span>
                    Manage academic staff contracts
                </span>

            </div>


            <div class="responsibility">

                <i class="bi bi-check2-circle"></i>

                <span>
                    Review and process lecturer claims
                </span>

            </div>

        </div>

    </section>

</div>