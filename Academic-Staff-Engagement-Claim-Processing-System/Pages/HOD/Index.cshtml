@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.IndexModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    Layout = null;
    ViewData["Title"] = "HOD Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] · UNILAK ASECPS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/HOD/dashboard.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ============================================================
         TOP NAVIGATION
    ============================================================= -->

    <header class="navbar">

        <div class="navbar-container">

            <div class="navbar-left">

                <a href="/" class="brand-link">

                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo"
                         class="navbar-logo" />

                    <div class="brand-text">
                        <strong>UNILAK</strong>
                        <span>ASECPS</span>
                    </div>

                </a>

            </div>

            <div class="navbar-right">

                <div class="user-context">

                    <div class="user-context-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <div class="user-context-text">

                        <strong>@Model.HodName</strong>

                        <span>
                            Head of Department · @Model.HodDepartment
                        </span>

                    </div>

                </div>

                <a href="/Login" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>

            </div>

        </div>

    </header>


    <!-- ============================================================
         APPLICATION
    ============================================================= -->

    <div class="app">

        <!-- ========================================================
             SIDEBAR
        ========================================================= -->

        <aside class="sidebar">

            <div class="sidebar-heading">
                <span>MAIN MENU</span>
            </div>

            <nav class="sidebar-menu">

                <a href="/HOD" class="sidebar-link active">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>Dashboard</span>

                </a>

                <a href="/HOD/Staff" class="sidebar-link">

                    <i class="bi bi-people-fill"></i>

                    <span>Staff Management</span>

                </a>

                <a href="/HOD/AssignCourse" class="sidebar-link">

                    <i class="bi bi-journal-plus"></i>

                    <span>Course Assignments</span>

                </a>

                <a href="/HOD/Contracts" class="sidebar-link">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    <span>Contracts</span>

                    @if (Model.ContractsToSign > 0)
                    {
                        <span class="sidebar-count">
                            @Model.ContractsToSign
                        </span>
                    }

                </a>

                <a href="/HOD/Claims" class="sidebar-link">

                    <i class="bi bi-cash-stack"></i>

                    <span>Claims</span>

                    @if (Model.ClaimsReceived > 0)
                    {
                        <span class="sidebar-count">
                            @Model.ClaimsReceived
                        </span>
                    }

                </a>

            </nav>


            <div class="sidebar-divider"></div>


            <!-- QUICK ACCESS -->

            <div class="sidebar-heading">
                <span>QUICK ACCESS</span>
            </div>

            <nav class="sidebar-menu">

                <a href="/HOD/Staff" class="sidebar-link secondary-link">

                    <i class="bi bi-person-lines-fill"></i>

                    <span>Academic Staff</span>

                </a>

                <a href="/HOD/AssignCourse" class="sidebar-link secondary-link">

                    <i class="bi bi-plus-circle"></i>

                    <span>Assign a Course</span>

                </a>

            </nav>


            <div class="sidebar-bottom">

                <div class="sidebar-system">

                    <div class="system-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>
                        <strong>Secure Portal</strong>
                        <span>UNILAK Academic Services</span>
                    </div>

                </div>

            </div>

        </aside>


        <!-- ========================================================
             MAIN CONTENT
        ========================================================= -->

        <main class="main">

            <div class="main-container">

                <!-- =================================================
                     PAGE INTRO
                ================================================== -->

                <section class="page-intro">

                    <div>

                        <span class="eyebrow">
                            HOD PORTAL
                        </span>

                        <h1>
                            Department Overview
                        </h1>

                        <p>
                            Monitor academic staff, course assignments and
                            contract activities within
                            <strong>@Model.HodDepartment</strong>.
                        </p>

                    </div>

                    <div class="date-card">

                        <div class="date-icon">
                            <i class="bi bi-calendar3"></i>
                        </div>

                        <div>
                            <span>Today</span>

                            <strong>
                                @DateTime.Now.ToString("dd MMM yyyy")
                            </strong>
                        </div>

                    </div>

                </section>


                <!-- =================================================
                     KPI CARDS
                ================================================== -->

                <section class="stats-grid">

                    <!-- STAFF -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon staff-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <span class="stat-context">
                                Department
                            </span>

                        </div>

                        <div class="stat-value">
                            @Model.AcademicStaff
                        </div>

                        <div class="stat-label">
                            Academic Staff
                        </div>

                        <div class="stat-footer">
                            <a href="/HOD/Staff">
                                Manage staff
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                    </div>


                    <!-- CONTRACTS -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon contract-icon">
                                <i class="bi bi-file-earmark-check-fill"></i>
                            </div>

                            @if (Model.ContractsToSign > 0)
                            {
                                <span class="status-indicator attention">
                                    Action required
                                </span>
                            }
                            else
                            {
                                <span class="status-indicator complete">
                                    Up to date
                                </span>
                            }

                        </div>

                        <div class="stat-value">
                            @Model.ContractsToSign
                        </div>

                        <div class="stat-label">
                            Contracts Requiring Action
                        </div>

                        <div class="stat-footer">
                            <a href="/HOD/Contracts">
                                Review contracts
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                    </div>


                    <!-- CLAIMS -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon claims-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>

                            @if (Model.ClaimsReceived > 0)
                            {
                                <span class="status-indicator attention">
                                    Pending
                                </span>
                            }
                            else
                            {
                                <span class="status-indicator complete">
                                    Clear
                                </span>
                            }

                        </div>

                        <div class="stat-value">
                            @Model.ClaimsReceived
                        </div>

                        <div class="stat-label">
                            Claims Awaiting Review
                        </div>

                        <div class="stat-footer">
                            <a href="/HOD/Claims">
                                Review claims
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                    </div>


                    <!-- ACTIVE CONTRACTS -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon active-icon">
                                <i class="bi bi-file-earmark-lock-fill"></i>
                            </div>

                            <span class="stat-context">
                                Department
                            </span>

                        </div>

                        <div class="stat-value">
                            @Model.ContractsToReview
                        </div>

                        <div class="stat-label">
                            Active Contracts
                        </div>

                        <div class="stat-footer">
                            <a href="/HOD/Contracts">
                                View contracts
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                    </div>

                </section>


                <!-- =================================================
                     MAIN TWO-COLUMN AREA
                ================================================== -->

                <section class="dashboard-grid">


                    <!-- =============================================
                         CONTRACT WORKFLOW
                    ============================================== -->

                    <div class="panel workflow-panel">

                        <div class="panel-header">

                            <div class="panel-heading">

                                <div class="panel-icon">
                                    <i class="bi bi-diagram-3-fill"></i>
                                </div>

                                <div>

                                    <h2>
                                        Contract Workflow
                                    </h2>

                                    <p>
                                        Academic engagement contract lifecycle
                                    </p>

                                </div>

                            </div>

                            <a href="/HOD/Contracts" class="panel-link">
                                Manage
                                <i class="bi bi-arrow-up-right"></i>
                            </a>

                        </div>


                        <div class="workflow">

                            <!-- LECTURER -->

                            <div class="workflow-step">

                                <div class="workflow-node completed">
                                    <i class="bi bi-person-check-fill"></i>
                                </div>

                                <div class="workflow-content">
                                    <strong>Lecturer</strong>
                                    <span>Contract initiated and signed</span>
                                </div>

                            </div>


                            <div class="workflow-line"></div>


                            <!-- DEAN -->

                            <div class="workflow-step">

                                <div class="workflow-node current">
                                    <i class="bi bi-building"></i>
                                </div>

                                <div class="workflow-content">
                                    <strong>Dean</strong>

                                    @if (Model.ContractsToSign > 0)
                                    {
                                        <span class="workflow-alert">
                                            @Model.ContractsToSign requiring action
                                        </span>
                                    }
                                    else
                                    {
                                        <span>Department approval stage</span>
                                    }

                                </div>

                            </div>


                            <div class="workflow-line"></div>


                            <!-- HR -->

                            <div class="workflow-step">

                                <div class="workflow-node">
                                    <i class="bi bi-person-badge"></i>
                                </div>

                                <div class="workflow-content">
                                    <strong>HR Officer</strong>
                                    <span>Human resources verification</span>
                                </div>

                            </div>


                            <div class="workflow-line"></div>


                            <!-- DVCAR -->

                            <div class="workflow-step">

                                <div class="workflow-node">
                                    <i class="bi bi-mortarboard-fill"></i>
                                </div>

                                <div class="workflow-content">
                                    <strong>DVCAR</strong>
                                    <span>Academic administration approval</span>
                                </div>

                            </div>


                            <div class="workflow-line"></div>


                            <!-- VC -->

                            <div class="workflow-step">

                                <div class="workflow-node">
                                    <i class="bi bi-award-fill"></i>
                                </div>

                                <div class="workflow-content">
                                    <strong>Vice Chancellor</strong>
                                    <span>Final institutional approval</span>
                                </div>

                            </div>


                            <div class="workflow-line"></div>


                            <!-- ACTIVE -->

                            <div class="workflow-step">

                                <div class="workflow-node final">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div class="workflow-content">
                                    <strong>ACTIVE</strong>
                                    <span>Contract becomes effective</span>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =============================================
                         QUICK ACTIONS
                    ============================================== -->

                    <div class="panel actions-panel">

                        <div class="panel-header">

                            <div class="panel-heading">

                                <div class="panel-icon">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                </div>

                                <div>

                                    <h2>
                                        Quick Actions
                                    </h2>

                                    <p>
                                        Common department tasks
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="quick-actions">

                            <a href="/HOD/Staff" class="quick-action">

                                <div class="quick-action-icon">
                                    <i class="bi bi-people-fill"></i>
                                </div>

                                <div class="quick-action-content">

                                    <strong>Manage Staff</strong>

                                    <span>
                                        View and manage academic staff
                                    </span>

                                </div>

                                <i class="bi bi-chevron-right action-arrow"></i>

                            </a>


                            <a href="/HOD/AssignCourse" class="quick-action">

                                <div class="quick-action-icon">
                                    <i class="bi bi-journal-plus"></i>
                                </div>

                                <div class="quick-action-content">

                                    <strong>Assign Course</strong>

                                    <span>
                                        Allocate courses to lecturers
                                    </span>

                                </div>

                                <i class="bi bi-chevron-right action-arrow"></i>

                            </a>


                            <a href="/HOD/Contracts" class="quick-action">

                                <div class="quick-action-icon">
                                    <i class="bi bi-file-earmark-check"></i>
                                </div>

                                <div class="quick-action-content">

                                    <strong>Review Contracts</strong>

                                    <span>
                                        Process department contracts
                                    </span>

                                </div>

                                <i class="bi bi-chevron-right action-arrow"></i>

                            </a>


                            <a href="/HOD/Claims" class="quick-action">

                                <div class="quick-action-icon">
                                    <i class="bi bi-cash-stack"></i>
                                </div>

                                <div class="quick-action-content">

                                    <strong>Review Claims</strong>

                                    <span>
                                        Review submitted payment claims
                                    </span>

                                </div>

                                <i class="bi bi-chevron-right action-arrow"></i>

                            </a>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     CONTRACTS REQUIRING ACTION
                ================================================== -->

                <section class="panel table-panel">

                    <div class="panel-header">

                        <div class="panel-heading">

                            <div class="panel-icon">
                                <i class="bi bi-file-earmark-check-fill"></i>
                            </div>

                            <div>

                                <h2>
                                    Contracts Requiring Your Attention
                                </h2>

                                <p>
                                    Contracts currently associated with your department
                                </p>

                            </div>

                        </div>

                        <a href="/HOD/Contracts" class="panel-link">
                            View all
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>


                    @if (Model.ContractsAwaitingSignature.Any())
                    {
                        <div class="table-wrapper">

                            <table>

                                <thead>

                                    <tr>

                                        <th>Contract</th>

                                        <th>Lecturer</th>

                                        <th>Course</th>

                                        <th>Hours</th>

                                        <th>Status</th>

                                        <th></th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var contract in Model.ContractsAwaitingSignature)
                                    {
                                        <tr>

                                            <td>
                                                <span class="record-id">
                                                    C@contract.Id.ToString("D3")
                                                </span>
                                            </td>

                                            <td>

                                                <div class="person-cell">

                                                    <div class="avatar">
                                                        @GetInitials(contract.LecturerName)
                                                    </div>

                                                    <div>
                                                        <strong>
                                                            @contract.LecturerName
                                                        </strong>

                                                        <span>
                                                            Academic Staff
                                                        </span>
                                                    </div>

                                                </div>

                                            </td>

                                            <td>
                                                <span class="course-name">
                                                    @contract.CourseTitle
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hours">
                                                    @contract.Hours.ToString("0.##")h
                                                </span>
                                            </td>

                                            <td>

                                                <span class="status-badge pending">
                                                    <i class="bi bi-clock"></i>
                                                    Pending
                                                </span>

                                            </td>

                                            <td>

                                                <a href="/HOD/Contracts?ContractId=@contract.Id"
                                                   class="table-action">

                                                    Review

                                                    <i class="bi bi-arrow-right"></i>

                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="empty-state">

                            <div class="empty-icon">
                                <i class="bi bi-check2-circle"></i>
                            </div>

                            <h3>
                                No contracts require your attention
                            </h3>

                            <p>
                                Your department currently has no contracts
                                awaiting HOD action.
                            </p>

                            <a href="/HOD/Contracts" class="empty-action">
                                View contracts
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>
                    }

                </section>


                <!-- =================================================
                     LOWER INFORMATION GRID
                ================================================== -->

                <section class="lower-grid">


                    <!-- DEPARTMENT RESPONSIBILITIES -->

                    <div class="panel responsibilities-panel">

                        <div class="panel-header">

                            <div class="panel-heading">

                                <div class="panel-icon">
                                    <i class="bi bi-clipboard-check-fill"></i>
                                </div>

                                <div>

                                    <h2>
                                        Department Responsibilities
                                    </h2>

                                    <p>
                                        Key activities under your supervision
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="responsibility-list">

                            <div class="responsibility-item">

                                <div class="responsibility-icon">
                                    <i class="bi bi-people"></i>
                                </div>

                                <div>

                                    <strong>
                                        Academic Staff
                                    </strong>

                                    <span>
                                        Maintain lecturer records and engagement
                                    </span>

                                </div>

                            </div>


                            <div class="responsibility-item">

                                <div class="responsibility-icon">
                                    <i class="bi bi-journal-check"></i>
                                </div>

                                <div>

                                    <strong>
                                        Course Assignments
                                    </strong>

                                    <span>
                                        Monitor course allocations and workload
                                    </span>

                                </div>

                            </div>


                            <div class="responsibility-item">

                                <div class="responsibility-icon">
                                    <i class="bi bi-file-earmark-check"></i>
                                </div>

                                <div>

                                    <strong>
                                        Contract Review
                                    </strong>

                                    <span>
                                        Process departmental contract approvals
                                    </span>

                                </div>

                            </div>


                            <div class="responsibility-item">

                                <div class="responsibility-icon">
                                    <i class="bi bi-cash-coin"></i>
                                </div>

                                <div>

                                    <strong>
                                        Claim Review
                                    </strong>

                                    <span>
                                        Review eligible academic staff claims
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- RECENT CLAIMS -->

                    <div class="panel claims-panel">

                        <div class="panel-header">

                            <div class="panel-heading">

                                <div class="panel-icon">
                                    <i class="bi bi-receipt-cutoff"></i>
                                </div>

                                <div>

                                    <h2>
                                        Recent Claims
                                    </h2>

                                    <p>
                                        Latest department submissions
                                    </p>

                                </div>

                            </div>

                            <a href="/HOD/Claims" class="panel-link">
                                View all
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>


                        @if (Model.RecentClaims.Any())
                        {
                            <div class="claim-list">

                                @foreach (var claim in Model.RecentClaims.Take(5))
                                {
                                    <div class="claim-item">

                                        <div class="claim-avatar">
                                            @GetInitials(claim.LecturerName)
                                        </div>

                                        <div class="claim-info">

                                            <strong>
                                                @claim.LecturerName
                                            </strong>

                                            <span>
                                                Claim CL@claim.Id.ToString("D3")
                                                · Contract C@claim.ContractId.ToString("D3")
                                            </span>

                                        </div>

                                        @switch (claim.Status)
                                        {
                                            case ClaimStatus.PendingHODApproval:
                                            case ClaimStatus.Submitted:
                                                <span class="status-badge review">
                                                    <i class="bi bi-eye"></i>
                                                    Review
                                                </span>
                                                break;

                                            case ClaimStatus.Approved:
                                                <span class="status-badge approved">
                                                    <i class="bi bi-check-circle"></i>
                                                    Approved
                                                </span>
                                                break;

                                            case ClaimStatus.Rejected:
                                                <span class="status-badge rejected">
                                                    <i class="bi bi-x-circle"></i>
                                                    Rejected
                                                </span>
                                                break;

                                            case ClaimStatus.Paid:
                                                <span class="status-badge paid">
                                                    <i class="bi bi-cash"></i>
                                                    Paid
                                                </span>
                                                break;

                                            default:
                                                <span class="status-badge review">
                                                    @claim.Status
                                                </span>
                                                break;
                                        }

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="compact-empty">

                                <i class="bi bi-inbox"></i>

                                <span>
                                    No recent claims for this department.
                                </span>

                            </div>
                        }

                    </div>

                </section>

            </div>

        </main>

    </div>


    <!-- ============================================================
         FOOTER
    ============================================================= -->

    <footer class="footer">

        <div class="footer-content">

            <div class="footer-brand">

                <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                     alt="UNILAK Logo"
                     class="footer-logo" />

                <div>

                    <strong>
                        UNILAK Portal
                    </strong>

                    <span>
                        Academic Staff Engagement & Claim Processing System
                    </span>

                </div>

            </div>

            <div class="footer-right">

                <span>
                    © @DateTime.Now.Year University of Lay Adventists of Kigali
                </span>

                <span>
                    HOD Portal
                </span>

            </div>

        </div>

    </footer>

</body>
</html>

@functions
{
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "—";

        var parts = name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}