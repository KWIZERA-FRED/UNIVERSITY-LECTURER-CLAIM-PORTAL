@page
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ContractsModel

@{
    Layout = "~/Pages/Shared/HOD/_HODLayout.cshtml";
    ViewData["Title"] = "Contracts";

    string GetStatusClass(ContractStatus status) => status switch
    {
        ContractStatus.Active => "status-active",
        ContractStatus.PendingSignature => "status-pending",
        ContractStatus.Expired => "status-neutral",
        ContractStatus.Terminated => "status-danger",
        ContractStatus.Renewed => "status-active",
        _ => "status-neutral"
    };

    string GetStatusLabel(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "Pending Signature",
        ContractStatus.Active => "Active",
        ContractStatus.Expired => "Expired",
        ContractStatus.Terminated => "Terminated",
        ContractStatus.Renewed => "Renewed",
        _ => status.ToString()
    };

    string SignerLabel(SignerRole role) => role switch
    {
        SignerRole.Lecturer => "Lecturer",
        SignerRole.Dean => "Dean",
        SignerRole.HROfficer => "HR Officer",
        SignerRole.DVCAR => "DVCAR",
        SignerRole.ViceChancellor => "Vice Chancellor",
        SignerRole.ExamOffice => "Exam Office",
        _ => role.ToString()
    };

    string WaitingText(DateTime? sinceUtc)
    {
        if (!sinceUtc.HasValue)
        {
            return string.Empty;
        }

        var days = Math.Max(
            0,
            (int)Math.Floor(
                (DateTime.UtcNow - sinceUtc.Value).TotalDays));

        return days switch
        {
            0 => "Waiting since today",
            1 => "Waiting 1 day",
            _ => $"Waiting {days} days"
        };
    }

    string WaitingTone(DateTime? sinceUtc)
    {
        if (!sinceUtc.HasValue)
        {
            return string.Empty;
        }

        var days = Math.Max(
            0,
            (int)Math.Floor(
                (DateTime.UtcNow - sinceUtc.Value).TotalDays));

        return days >= 7
            ? "ds-tone-late"
            : days >= 3
                ? "ds-tone-warn"
                : string.Empty;
    }

    var totalContracts = Model.Contracts.Count;

    var awaitingDeanCount = Model.Contracts.Count(c => c.IsAwaitingDean);

    var activeContractsCount =
        Model.Contracts.Count(c => c.Status == ContractStatus.Active);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/HOD/contracts.css"
          asp-append-version="true" />
}

<section class="contracts-page">

    <header class="page-header">
        <div class="page-header-main">
            <h1>Contracts</h1>
            <p>Monitor the signing workflow of contracts in your faculty.</p>
        </div>

        <div class="page-header-actions">
            <a asp-page="/HOD/AssignCourse"
               class="primary-button">
                <i class="bi bi-plus-lg"></i>
                Assign Course
            </a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @* ---------------- Contract stats ---------------- *@

    <section class="contracts-stats" aria-label="Contract summary">

        <div class="contracts-stat contracts-stat--neutral">
            <span class="contracts-stat-label">
                Faculty Contracts
            </span>
            <span class="contracts-stat-value">@totalContracts</span>
            <span class="contracts-stat-meta">
                All contracts in your faculty
            </span>
        </div>

        <div class="contracts-stat contracts-stat--action">
            <span class="contracts-stat-label">
                Awaiting Dean Signature
            </span>
            <span class="contracts-stat-value">@awaitingDeanCount</span>
            <span class="contracts-stat-meta">
                @if (awaitingDeanCount > 0)
                {
                    <text>Waiting on the Dean</text>
                }
                else
                {
                    <text>Nothing waiting</text>
                }
            </span>
        </div>

        <div class="contracts-stat contracts-stat--success">
            <span class="contracts-stat-label">
                Active Contracts
            </span>
            <span class="contracts-stat-value">@activeContractsCount</span>
            <span class="contracts-stat-meta">
                Currently in force
            </span>
        </div>

    </section>

    <section class="section-card">

        <header class="section-header">
            <h2>Contract Register</h2>
            <span class="section-meta">
                @totalContracts @(totalContracts == 1 ? "contract" : "contracts")
            </span>
        </header>

        <div class="toolbar">
            <form class="search-box" role="search" onsubmit="return false;">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search"
                       id="contractSearch"
                       placeholder="Search by contract, lecturer, department or course…"
                       aria-label="Search contracts"
                       autocomplete="off" />
                <span class="search-hint" aria-hidden="true">Press /</span>
            </form>
        </div>

        @if (Model.Contracts.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Lecturer</th>
                            <th>Department</th>
                            <th>Course</th>
                            <th>Stage</th>
                            <th>Progress</th>
                            <th>Version</th>
                            <th>Status</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var contract in Model.Contracts)
                        {
                            var statusClass = contract.IsDeclined
                                ? "status-danger"
                                : GetStatusClass(contract.Status);

                            var statusLabel = contract.IsDeclined
                                ? "Declined"
                                : GetStatusLabel(contract.Status);

                            // ---- Stage pill content ----

                            string stageLabel;

                            if (contract.IsDeclined)
                            {
                                stageLabel = "Declined";
                            }
                            else if (contract.TotalSteps == 0)
                            {
                                stageLabel = "Not started";
                            }
                            else if (contract.CurrentSignerRole is null)
                            {
                                stageLabel = "Fully signed";
                            }
                            else
                            {
                                stageLabel = $"With {SignerLabel(contract.CurrentSignerRole.Value)}";
                            }

                            var waitingText = WaitingText(contract.WaitingSinceUtc);
                            var waitingTone = WaitingTone(contract.WaitingSinceUtc);

                            var isStageAction =
                                contract.CurrentSignerRole == SignerRole.Dean ||
                                contract.IsAwaitingDean;

                            // ---- Progress count ----

                            var progressLabel =
                                $"{contract.SignedSteps} / {contract.TotalSteps}";

                            <tr class="contract-row"
                                data-search="CON-@contract.ContractId.ToString("D6") @contract.LecturerName @contract.Department @contract.CourseTitle">

                                <td>
                                    <span class="reference-pill">
                                        CON-@contract.ContractId.ToString("D6")
                                    </span>
                                </td>

                                <td>
                                    <span class="lecturer-name">@contract.LecturerName</span>
                                </td>

                                <td>@contract.Department</td>

                                <td>
                                    <span class="course-title">@contract.CourseTitle</span>
                                </td>

                                <td>
                                    <div class="dd-stage">
                                        <span class="dd-stage-pill @(isStageAction ? "dd-stage-pill--action" : "")">
                                            @stageLabel
                                            @if (!string.IsNullOrEmpty(waitingText))
                                            {
                                                <span class="dd-stage-sep" aria-hidden="true">·</span>
                                                <span class="dd-stage-wait @waitingTone">@waitingText</span>
                                            }
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="progress-count">
                                        @progressLabel
                                    </span>
                                </td>

                                <td>
                                    <span class="version-badge">@contract.Version</span>
                                </td>

                                <td>
                                    <span class="status-badge @statusClass">@statusLabel</span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/HOD/ContractDetails"
                                       asp-route-id="@contract.ContractId"
                                       class="row-action">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="table-empty" id="noResults" style="display:none;">
                <p>No contracts match your search.</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No contracts found in your faculty.</p>
            </div>
        }

    </section>

</section>

@section Scripts {
<script>

    const contractSearch = document.getElementById("contractSearch");
    const noResults = document.getElementById("noResults");

    if (contractSearch) {

        contractSearch.addEventListener("input", function () {

            const term = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll(".contract-row");

            let visible = 0;

            rows.forEach(function (row) {

                const haystack = (row.dataset.search || "").toLowerCase();
                const match = term === "" || haystack.includes(term);

                row.style.display = match ? "" : "none";

                if (match) visible++;

            });

            if (noResults) {
                noResults.style.display = visible === 0 ? "" : "none";
            }

        });

        document.addEventListener("keydown", function (event) {

            var tag = (document.activeElement || {}).tagName || "";

            if (event.key === "/" &&
                !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                !event.ctrlKey && !event.metaKey && !event.altKey) {

                event.preventDefault();
                contractSearch.focus();
                contractSearch.select();
            }
        });

    }

</script>
}