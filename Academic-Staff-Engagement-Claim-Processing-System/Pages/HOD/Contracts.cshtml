@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ContractsModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    Layout = null;
    ViewData["Title"] = "Contracts";

    string GetStatusClass(ContractStatus status)
    {
        return status switch
        {
            ContractStatus.Active => "status-active",
            ContractStatus.PendingSignature => "status-pending",
            ContractStatus.Expired => "status-expired",
            ContractStatus.Terminated => "status-terminated",
            _ => "status-default"
        };
    }

    string GetStatusLabel(ContractStatus status)
    {
        return status switch
        {
            ContractStatus.Active => "Active",
            ContractStatus.PendingSignature => "Pending Signature",
            ContractStatus.Expired => "Expired",
            ContractStatus.Terminated => "Terminated",
            _ => status.ToString()
        };
    }

    string GetRoleLabel(SignerRole role)
    {
        return role switch
        {
            SignerRole.Lecturer => "Lecturer",
            SignerRole.Dean => "Dean",
            SignerRole.HROfficer => "HR Officer",
            SignerRole.DVCAR => "DVCAR",
            SignerRole.ViceChancellor => "Vice Chancellor",
            _ => role.ToString()
        };
    }

    var fullySignedCount = Model.Contracts.Count(c =>
        c.TotalSteps > 0 &&
        c.SignedSteps == c.TotalSteps);

    var pendingCount = Model.Contracts.Count(c =>
        c.TotalSteps == 0 ||
        c.SignedSteps < c.TotalSteps);
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UNILAK Portal</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- HOD Contracts CSS -->
    <link rel="stylesheet"
          href="~/css/HOD/contracts.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ============================================================
         TOP NAVBAR
         ============================================================ -->

    <nav class="navbar">

        <div class="navbar-container">

            <div class="navbar-left">

                <a asp-page="/HOD/Index" class="brand-link">

                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK"
                         class="navbar-logo" />

                    <div class="brand-text">
                        <span class="brand-name">UNILAK</span>
                        <span class="brand-system">
                            ASECPS
                        </span>
                    </div>

                </a>

            </div>

            <div class="navbar-right">

                <div class="user-context">

                    <div class="user-context-icon">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>

                    <div class="user-context-text">
                        <span class="user-context-role">
                            Head of Department
                        </span>

                        <span class="user-context-name">
                            @(User.Identity?.Name ?? "HOD")
                        </span>
                    </div>

                </div>

                <form method="post"
                      asp-page="/Login"
                      class="logout-form">

                    <button type="submit"
                            class="logout-btn"
                            title="Logout">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>Logout</span>

                    </button>

                </form>

            </div>

        </div>

    </nav>


    <!-- ============================================================
         SIDEBAR
         ============================================================ -->

    <aside class="sidebar">

        <div class="sidebar-content">

            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    MAIN MENU
                </span>

                <a asp-page="/HOD/Index"
                   class="sidebar-link">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>Dashboard</span>

                </a>

                <a asp-page="/HOD/Staff"
                   class="sidebar-link">

                    <i class="bi bi-people-fill"></i>

                    <span>Academic Staff</span>

                </a>

                <a asp-page="/HOD/AssignCourse"
                   class="sidebar-link">

                    <i class="bi bi-journal-plus"></i>

                    <span>Assign Course</span>

                </a>

                <a asp-page="/HOD/Contracts"
                   class="sidebar-link active">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    <span>Contracts</span>

                </a>

                <a asp-page="/HOD/Claims"
                   class="sidebar-link">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>Claims</span>

                </a>

            </div>


            <div class="sidebar-divider"></div>


            <div class="sidebar-section">

                <span class="sidebar-section-title">
                    QUICK ACCESS
                </span>

                <a asp-page="/HOD/Staff"
                   class="sidebar-link secondary-link">

                    <i class="bi bi-person-lines-fill"></i>

                    <span>Academic Staff</span>

                </a>

                <a asp-page="/HOD/AssignCourse"
                   class="sidebar-link secondary-link">

                    <i class="bi bi-plus-circle-fill"></i>

                    <span>Assign a Course</span>

                </a>

            </div>


            <div class="sidebar-footer">

                <div class="sidebar-footer-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <strong>HOD Portal</strong>
                    <span>Secure access</span>
                </div>

            </div>

        </div>

    </aside>


    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

    <main class="main">

        <!-- PAGE HEADER -->

        <section class="page-header">

            <div class="page-header-content">

                <div class="breadcrumb">

                    <a asp-page="/HOD/Index">
                        Dashboard
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>Contracts</span>

                </div>

                <div class="page-heading-row">

                    <div>

                        <div class="page-title-icon">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </div>

                        <div class="page-title-copy">

                            <h1>
                                Contracts
                            </h1>

                            <p>
                                Review academic staff contracts and monitor
                                the institutional signing workflow.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <div class="department-badge">

                <i class="bi bi-building"></i>

                <div>
                    <span>Department</span>
                    <strong>@Model.HodDepartment</strong>
                </div>

            </div>

        </section>


        <!-- ERROR MESSAGE -->

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-error">

                <div class="alert-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div class="alert-content">

                    <strong>Contract not found</strong>

                    <span>
                        @Model.ErrorMessage
                    </span>

                </div>

            </div>
        }


        <!-- ========================================================
             SUMMARY CARDS
             ======================================================== -->

        <section class="summary-grid">

            <div class="summary-card">

                <div class="summary-icon summary-icon-blue">
                    <i class="bi bi-files"></i>
                </div>

                <div class="summary-content">

                    <span class="summary-label">
                        Department Contracts
                    </span>

                    <strong class="summary-value">
                        @Model.Contracts.Count
                    </strong>

                    <span class="summary-description">
                        Contracts generated
                    </span>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon summary-icon-green">
                    <i class="bi bi-patch-check-fill"></i>
                </div>

                <div class="summary-content">

                    <span class="summary-label">
                        Fully Signed
                    </span>

                    <strong class="summary-value">
                        @fullySignedCount
                    </strong>

                    <span class="summary-description">
                        All required signatures completed
                    </span>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon summary-icon-amber">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div class="summary-content">

                    <span class="summary-label">
                        Pending
                    </span>

                    <strong class="summary-value">
                        @pendingCount
                    </strong>

                    <span class="summary-description">
                        Awaiting signatures
                    </span>

                </div>

            </div>

        </section>


        <!-- ========================================================
             CONTRACT LIST
             ======================================================== -->

        <section class="content-card">

            <div class="card-header">

                <div class="card-header-title">

                    <div class="card-header-icon">
                        <i class="bi bi-folder2-open"></i>
                    </div>

                    <div>

                        <h2>
                            Department Contracts
                        </h2>

                        <p>
                            Contracts generated for lecturers in
                            @Model.HodDepartment.
                        </p>

                    </div>

                </div>

                <div class="record-count">

                    <i class="bi bi-file-earmark-text"></i>

                    @Model.Contracts.Count
                    @(Model.Contracts.Count == 1 ? "contract" : "contracts")

                </div>

            </div>


            @if (Model.Contracts.Any())
            {
                <div class="table-wrapper">

                    <table class="contracts-table">

                        <thead>

                            <tr>

                                <th>Reference</th>

                                <th>Lecturer</th>

                                <th>Course</th>

                                <th>Academic Year</th>

                                <th>Signature Progress</th>

                                <th>Status</th>

                                <th class="action-column">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var contract in Model.Contracts)
                            {
                                var isSelected =
                                    Model.ContractId == contract.Id;

                                var percentage =
                                    contract.TotalSteps > 0
                                        ? (int)Math.Round(
                                            (double)contract.SignedSteps /
                                            contract.TotalSteps * 100)
                                        : 0;

                                <tr class="@(isSelected ? "selected-row" : "")">

                                    <td>

                                        <div class="contract-reference">

                                            <span class="reference-icon">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </span>

                                            <div>

                                                <strong>
                                                    @contract.Reference
                                                </strong>

                                                <span>
                                                    Contract
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <div class="lecturer-cell">

                                            <div class="avatar">
                                                <i class="bi bi-person-fill"></i>
                                            </div>

                                            <span>
                                                @contract.LecturerName
                                            </span>

                                        </div>

                                    </td>


                                    <td>

                                        <div class="course-cell">

                                            <strong>
                                                @contract.CourseCode
                                            </strong>

                                            <span>
                                                @contract.CourseTitle
                                            </span>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="academic-year">
                                            @contract.AcademicYear
                                        </span>

                                    </td>


                                    <td>

                                        <div class="progress-cell">

                                            <div class="progress-top">

                                                <strong>
                                                    @contract.SignedSteps /
                                                    @contract.TotalSteps
                                                </strong>

                                                <span>
                                                    @percentage%
                                                </span>

                                            </div>

                                            <div class="progress-track">

                                                <div class="progress-bar"
                                                     style="width: @percentage%;">
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="status-badge @GetStatusClass(contract.Status)">

                                            @if (contract.Status == ContractStatus.Active)
                                            {
                                                <i class="bi bi-check-circle-fill"></i>
                                            }
                                            else if (contract.Status == ContractStatus.PendingSignature)
                                            {
                                                <i class="bi bi-clock-fill"></i>
                                            }
                                            else if (contract.Status == ContractStatus.Expired)
                                            {
                                                <i class="bi bi-calendar-x-fill"></i>
                                            }
                                            else if (contract.Status == ContractStatus.Terminated)
                                            {
                                                <i class="bi bi-x-circle-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-info-circle-fill"></i>
                                            }

                                            @GetStatusLabel(contract.Status)

                                        </span>

                                    </td>


                                    <td class="action-column">

                                        <a asp-page="/HOD/Contracts"
                                           asp-route-ContractId="@contract.Id"
                                           class="view-btn">

                                            <i class="bi bi-eye-fill"></i>

                                            <span>View</span>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-file-earmark-x"></i>
                    </div>

                    <h3>
                        No contracts found
                    </h3>

                    <p>
                        There are currently no contracts associated with
                        academic staff in your department.
                    </p>

                    <a asp-page="/HOD/AssignCourse"
                       class="empty-state-btn">

                        <i class="bi bi-plus-circle"></i>

                        Assign a Course

                    </a>

                </div>
            }

        </section>


        <!-- ========================================================
             SELECTED CONTRACT
             ======================================================== -->

        @if (Model.SelectedContract is not null)
        {
            <section class="selected-contract-section">

                <div class="section-heading">

                    <div>

                        <span class="section-eyebrow">
                            CONTRACT DETAILS
                        </span>

                        <h2>
                            @Model.SelectedContract.Reference
                        </h2>

                    </div>

                    <span class="status-badge @GetStatusClass(Model.SelectedContract.Status)">

                        @if (Model.SelectedContract.Status == ContractStatus.Active)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                        }
                        else if (Model.SelectedContract.Status == ContractStatus.PendingSignature)
                        {
                            <i class="bi bi-clock-fill"></i>
                        }
                        else if (Model.SelectedContract.Status == ContractStatus.Expired)
                        {
                            <i class="bi bi-calendar-x-fill"></i>
                        }
                        else if (Model.SelectedContract.Status == ContractStatus.Terminated)
                        {
                            <i class="bi bi-x-circle-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-info-circle-fill"></i>
                        }

                        @GetStatusLabel(Model.SelectedContract.Status)

                    </span>

                </div>


                <!-- CONTRACT INFORMATION -->

                <div class="contract-info-grid">

                    <div class="info-item">

                        <span class="info-label">
                            <i class="bi bi-person-fill"></i>
                            Lecturer
                        </span>

                        <strong>
                            @Model.SelectedContract.LecturerName
                        </strong>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            <i class="bi bi-book-fill"></i>
                            Course
                        </span>

                        <strong>
                            @Model.SelectedContract.CourseTitle
                        </strong>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            <i class="bi bi-hash"></i>
                            Reference
                        </span>

                        <strong>
                            @Model.SelectedContract.Reference
                        </strong>

                    </div>

                </div>


                <!-- ====================================================
                     SIGNATURE WORKFLOW
                     ==================================================== -->

                <div class="workflow-card">

                    <div class="workflow-header">

                        <div class="workflow-title">

                            <div class="workflow-icon">
                                <i class="bi bi-pen-fill"></i>
                            </div>

                            <div>

                                <h3>
                                    Signature Workflow
                                </h3>

                                <p>
                                    Contract approval sequence
                                </p>

                            </div>

                        </div>

                        <div class="workflow-count">

                            <strong>
                                @Model.SelectedContract.Steps.Count(s =>
                                    s.Decision == SignatureDecision.Signed)
                            </strong>

                            <span>
                                /
                                @Model.SelectedContract.Steps.Count
                                signed
                            </span>

                        </div>

                    </div>


                    @if (Model.SelectedContract.Steps.Any())
                    {
                        <div class="workflow-list">

                            @for (var i = 0;
                                  i < Model.SelectedContract.Steps.Count;
                                  i++)
                            {
                                var step = Model.SelectedContract.Steps[i];

                                var isSigned =
                                    step.Decision == SignatureDecision.Signed;

                                <div class="workflow-step @(isSigned ? "step-signed" : "step-pending")">

                                    <div class="step-number">

                                        @if (isSigned)
                                        {
                                            <i class="bi bi-check-lg"></i>
                                        }
                                        else
                                        {
                                            @(i + 1)
                                        }

                                    </div>


                                    <div class="step-content">

                                        <div class="step-main">

                                            <div>

                                                <strong>
                                                    @GetRoleLabel(step.Role)
                                                </strong>

                                                @if (isSigned)
                                                {
                                                    <span class="step-status signed">
                                                        Signed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="step-status pending">
                                                        Awaiting Signature
                                                    </span>
                                                }

                                            </div>


                                            @if (isSigned && step.SignedAtUtc.HasValue)
                                            {
                                                <span class="step-date">

                                                    <i class="bi bi-calendar-check"></i>

                                                    @step.SignedAtUtc.Value
                                                        .ToLocalTime()
                                                        .ToString("dd MMM yyyy, HH:mm")

                                                </span>
                                            }

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(step.Comments))
                                        {
                                            <div class="step-comments">

                                                <i class="bi bi-chat-left-text"></i>

                                                <span>
                                                    @step.Comments
                                                </span>

                                            </div>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="workflow-empty">

                            <i class="bi bi-hourglass"></i>

                            <div>

                                <strong>
                                    Signature workflow not started
                                </strong>

                                <span>
                                    No signature records have been created
                                    for this contract yet.
                                </span>

                            </div>

                        </div>
                    }

                </div>


                <!-- ====================================================
                     CONTRACT DOCUMENT
                     ==================================================== -->

                <div class="document-card">

                    <div class="document-header">

                        <div class="document-title">

                            <div class="document-icon">
                                <i class="bi bi-file-earmark-richtext-fill"></i>
                            </div>

                            <div>

                                <h3>
                                    Contract Document
                                </h3>

                                <p>
                                    Official contract content
                                </p>

                            </div>

                        </div>

                        <div class="document-readonly">

                            <i class="bi bi-lock-fill"></i>

                            Read Only

                        </div>

                    </div>


                    <div class="document-body">

                        @if (!string.IsNullOrWhiteSpace(Model.SelectedContract.Content))
                        {
                            @Html.Raw(Model.SelectedContract.Content)
                        }
                        else
                        {
                            <div class="document-empty">

                                <i class="bi bi-file-earmark-x"></i>

                                <strong>
                                    Contract content unavailable
                                </strong>

                                <span>
                                    No contract document content is currently
                                    available for this record.
                                </span>

                            </div>
                        }

                    </div>

                </div>


                <!-- HOD INFORMATION NOTICE -->

                <div class="information-notice">

                    <div class="information-notice-icon">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>

                    <div>

                        <strong>
                            HOD Access
                        </strong>

                        <p>
                            This page provides the HOD with a read-only view
                            of the contract and its signature progress.
                            Contract signatures are completed by the
                            authorized institutional signatories according
                            to the defined approval sequence.
                        </p>

                    </div>

                </div>

            </section>
        }

    </main>


    <!-- ============================================================
         FOOTER
         ============================================================ -->

    <footer class="footer">

        <div class="footer-container">

            <div class="footer-brand">

                <img src="~/images/unilak-logo.png"
                     alt="UNILAK"
                     class="footer-logo" />

                <div>

                    <strong>
                        UNILAK Portal
                    </strong>

                    <span>
                        Academic Staff Engagement &amp;
                        Claim Processing System
                    </span>

                </div>

            </div>

            <div class="footer-right">

                <span>
                    HOD Portal
                </span>

                <span class="footer-separator">
                    •
                </span>

                <span>
                    @DateTime.Now.Year
                </span>

            </div>

        </div>

    </footer>

</body>

</html>