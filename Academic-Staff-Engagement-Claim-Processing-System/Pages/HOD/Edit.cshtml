@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.EditModel

@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    ViewData["Title"] = "Edit Lecturer";

    var countries = Model.CountryCodes
        .OrderByDescending(c => c.Code == "+250")
        .ThenBy(c => c.Name)
        .ToList();

    var selectedCode = countries
        .FirstOrDefault(c => c.Code == "+250")?.Code
        ?? countries.FirstOrDefault()?.Code
        ?? "+250";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/edit.css"
          asp-append-version="true" />
}

<div class="dashboard-page edit-page">

    <header class="page-header">
        <h1>Edit Lecturer</h1>
        <p>Update the lecturer's account information.</p>
    </header>

    <section class="section-card">

        <header class="section-header">
            <div>
                <h2>Lecturer Information</h2>
            </div>
        </header>

        <div class="card-body">

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="success-message"
                     role="alert"
                     aria-live="polite">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@successMessage</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All"
                     class="validation-summary"
                     role="alert">
                </div>
            }

            <form method="post"
                  id="editLecturerForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="LecturerId" />

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="UserName">Username</label>

                        <input asp-for="UserName"
                               autocomplete="username" />

                        <span asp-validation-for="UserName"
                              class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email Address</label>

                        <input asp-for="Email"
                               type="email"
                               autocomplete="email"
                               inputmode="email" />

                        <span asp-validation-for="Email"
                              class="validation"></span>
                    </div>

                    <div class="form-group form-group-phone">

                        <label for="countryCode">
                            Phone Number
                        </label>

                        <div class="phone-field">

                            <select id="countryCode"
                                    class="phone-country"
                                    size="1"
                                    aria-label="Country calling code">

                                @foreach (var country in countries)
                                {
                                    <option value="@country.Code"
                                            data-country="@country.Name"
                                            data-iso="@country.IsoCode"
                                            title="@country.Name (@country.Code)"
                                            selected="@(country.Code == selectedCode)">
                                        @country.IsoCode @country.Code
                                    </option>
                                }

                            </select>

                            <input type="tel"
                                   id="phoneLocal"
                                   class="phone-local"
                                   inputmode="numeric"
                                   autocomplete="tel-national"
                                   maxlength="15"
                                   aria-label="Local phone number" />

                        </div>

                        <input type="hidden"
                               asp-for="PhoneNumber"
                               id="phoneFull" />

                        <span asp-validation-for="PhoneNumber"
                              class="validation"></span>

                    </div>

                    <div class="form-group">
                        <label asp-for="Type">
                            Lecturer Type
                        </label>

                        <select asp-for="Type">

                            <option value="">
                                -- Select Lecturer Type --
                            </option>

                            <option value="@UserRole.PartTimeLecturer">
                                Part-Time Lecturer
                            </option>

                            <option value="@UserRole.FullTimeLecturer">
                                Full-Time Lecturer
                            </option>

                        </select>

                        <span asp-validation-for="Type"
                              class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Rank">
                            Academic Rank
                        </label>

                        <select asp-for="Rank">

                            <option value="">
                                -- Select Rank --
                            </option>

                            @foreach (var rank in Enum.GetValues<LecturerRank>())
                            {
                                <option value="@rank">
                                    @rank
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Rank"
                              class="validation"></span>
                    </div>

                    <div class="form-group">

                        <label>
                            Faculty
                        </label>

                        <div class="readonly-field">
                            <i class="bi bi-building"></i>
                            <span>
                                @Model.FacultyDisplayName
                            </span>
                        </div>

                    </div>

                    <div class="form-group">

                        <label asp-for="Department">
                            Department
                        </label>

                        <select asp-for="Department"
                                id="departmentSelect">

                            <option value="">
                                -- Select Department --
                            </option>

                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.Value">
                                    @department.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Department"
                              class="validation"></span>

                    </div>

                    <div class="form-group">

                        <label class="checkbox-label">

                            <input asp-for="IsActive" />

                            <span>
                                Lecturer Account Is Active
                            </span>

                        </label>

                    </div>

                </div>

                <div class="card-actions">

                    <button type="submit"
                            class="primary-button"
                            id="saveButton">

                        <i class="bi bi-check-lg"></i>

                        <span id="saveButtonText">
                            Save Changes
                        </span>

                    </button>

                    <a asp-page="/HOD/View"
                       asp-route-id="@Model.LecturerId"
                       class="secondary-button">

                        <i class="bi bi-x-lg"></i>

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </section>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        (function () {

            "use strict";

            const E164_MAX_DIGITS = 15;

            const codeSelect = document.getElementById("countryCode");
            const localInput = document.getElementById("phoneLocal");
            const fullInput = document.getElementById("phoneFull");
            const form = document.getElementById("editLecturerForm");
            const saveButton = document.getElementById("saveButton");
            const saveButtonText = document.getElementById("saveButtonText");

            if (!codeSelect ||
                !localInput ||
                !fullInput ||
                !form) {
                return;
            }

            const initialPhone =
                (fullInput.value || "").trim();

            function getCountryCode(phone) {

                if (!phone.startsWith("+")) {
                    return null;
                }

                const codes = Array.from(codeSelect.options)
                    .map(option => option.value)
                    .filter(value => value.startsWith("+"))
                    .sort((a, b) => b.length - a.length);

                for (const code of codes) {

                    if (phone.startsWith(code)) {
                        return code;
                    }

                }

                return null;
            }

            function extractInitialLocalNumber(phone) {

                const normalized = phone
                    .replace(/\s+/g, "")
                    .trim();

                if (!normalized) {
                    return "";
                }

                const detectedCode =
                    getCountryCode(normalized);

                if (detectedCode) {

                    codeSelect.value = detectedCode;

                    return normalized
                        .substring(detectedCode.length)
                        .replace(/\D/g, "");
                }

                return normalized.replace(/\D/g, "");
            }

            function codeDigitCount() {

                return codeSelect.value
                    .replace(/\D/g, "")
                    .length;
            }

            function maxLocalDigits() {

                return E164_MAX_DIGITS -
                       codeDigitCount();
            }

            function formatLocalNumber(value) {

                const digits = value
                    .replace(/\D/g, "")
                    .slice(0, maxLocalDigits());

                if (digits.length <= 3) {
                    return digits;
                }

                if (digits.length <= 6) {

                    return digits.slice(0, 3) +
                           " " +
                           digits.slice(3);
                }

                if (digits.length <= 9) {

                    return digits.slice(0, 3) +
                           " " +
                           digits.slice(3, 6) +
                           " " +
                           digits.slice(6);
                }

                if (digits.length <= 12) {

                    return digits.slice(0, 3) +
                           " " +
                           digits.slice(3, 6) +
                           " " +
                           digits.slice(6, 9) +
                           " " +
                           digits.slice(9);
                }

                return digits.slice(0, 3) +
                       " " +
                       digits.slice(3, 6) +
                       " " +
                       digits.slice(6, 9) +
                       " " +
                       digits.slice(9, 12) +
                       " " +
                       digits.slice(12);
            }

            function syncPhone() {

                const code = codeSelect.value;

                const localDigits = localInput.value
                    .replace(/\D/g, "")
                    .slice(0, maxLocalDigits());

                if (!localDigits) {

                    fullInput.value = "";

                    return;
                }

                fullInput.value =
                    code + localDigits;
            }

            const initialLocal =
                extractInitialLocalNumber(initialPhone);

            localInput.value =
                formatLocalNumber(initialLocal);

            syncPhone();

            codeSelect.addEventListener(
                "change",
                function () {

                    const digits = localInput.value
                        .replace(/\D/g, "")
                        .slice(0, maxLocalDigits());

                    localInput.value =
                        formatLocalNumber(digits);

                    syncPhone();
                }
            );

            localInput.addEventListener(
                "input",
                function () {

                    const digits =
                        this.value.replace(/\D/g, "");

                    this.value =
                        formatLocalNumber(digits);

                    syncPhone();
                }
            );

            form.addEventListener(
                "submit",
                function () {

                    syncPhone();

                    if (saveButton) {
                        saveButton.disabled = true;
                    }

                    if (saveButtonText) {
                        saveButtonText.textContent =
                            "Saving...";
                    }

                }
            );

        })();

    </script>
}