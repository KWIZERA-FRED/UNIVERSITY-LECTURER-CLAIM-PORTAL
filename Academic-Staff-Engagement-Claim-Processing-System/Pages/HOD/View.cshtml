@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ViewModel

@{
    ViewData["Title"] = "View Lecturer";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/view.css"
          asp-append-version="true" />
}

<div class="dashboard-page">

    <header class="page-header">
        <h1>Lecturer Details</h1>
        <p>View the lecturer's information stored in the database.</p>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="success-message"
             id="successMessage"
             role="alert"
             aria-live="polite">

            <i class="bi bi-check-circle-fill"></i>

            <div>
                <strong>Update Successful</strong>
                <span>@successMessage</span>
            </div>

            <button type="button"
                    class="success-close"
                    aria-label="Close notification"
                    onclick="dismissSuccessMessage()">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>
    }

    @if (Model.Lecturer == null)
    {
        <section class="section-card">

            <div class="empty-state">

                <i class="bi bi-person-x"></i>

                <p>
                    The requested lecturer could not be found.
                </p>

                <a href="/HOD/Staff"
                   class="secondary-button">

                    <i class="bi bi-arrow-left"></i>
                    Back to Staff

                </a>

            </div>

        </section>
    }
    else
    {
        var initials = string.IsNullOrWhiteSpace(Model.Lecturer.UserName)
            ? "?"
            : string.Concat(
                Model.Lecturer.UserName
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2)
                    .Select(x => x[0])
            ).ToUpper();

        <section class="section-card">

            <header class="section-header">

                <h2>Lecturer Information</h2>

                <a href="/HOD/Staff"
                   class="secondary-button">

                    <i class="bi bi-arrow-left"></i>
                    Back to Staff

                </a>

            </header>

            <div class="profile">

                <div class="avatar">
                    @initials
                </div>

                <div class="profile-body">

                    <h3>
                        @Model.Lecturer.UserName
                    </h3>

                    <p>
                        @Model.Lecturer.Email
                    </p>

                    @if (Model.Lecturer.IsActive)
                    {
                        <span class="status-badge status-active">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-danger">
                            Inactive
                        </span>
                    }

                </div>

            </div>

            <div class="details-grid">

                <div class="detail">

                    <span class="detail-label">
                        Lecturer ID
                    </span>

                    <strong>
                        @Model.Lecturer.Id
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Username
                    </span>

                    <strong>
                        @Model.Lecturer.UserName
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Email
                    </span>

                    <strong>
                        @Model.Lecturer.Email
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Phone Number
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Lecturer.PhoneNumber)
                            ? "Not provided"
                            : Model.Lecturer.PhoneNumber)
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Lecturer Type
                    </span>

                    <strong>
                        @Model.Lecturer.Type
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Academic Rank
                    </span>

                    <strong>
                        @(Model.Lecturer.Rank.HasValue
                            ? Model.Lecturer.Rank.Value.ToString()
                            : "Not assigned")
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Signature Status
                    </span>

                    <strong>
                        @Model.Lecturer.SignatureStatus
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Account Created
                    </span>

                    <strong>
                        @(Model.Lecturer.CreatedAtUtc
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, HH:mm"))
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Last Login
                    </span>

                    <strong>
                        @(Model.Lecturer.LastLoginUtc.HasValue
                            ? Model.Lecturer.LastLoginUtc.Value
                                .ToLocalTime()
                                .ToString("dd MMM yyyy, HH:mm")
                            : "Never logged in")
                    </strong>

                </div>

                <div class="detail">

                    <span class="detail-label">
                        Failed Login Attempts
                    </span>

                    <strong>
                        @Model.Lecturer.FailedLoginAttempts
                    </strong>

                </div>

            </div>

            <div class="card-actions">

                <a href="/HOD/Edit?id=@Model.Lecturer.Id"
                   class="primary-button">

                    <i class="bi bi-pencil-fill"></i>
                    Edit Lecturer

                </a>

                <a href="/HOD/Staff"
                   class="secondary-button">

                    <i class="bi bi-arrow-left"></i>
                    Back to Staff

                </a>

            </div>

        </section>
    }

</div>

@section Scripts {

    <script>

        (function () {

            "use strict";

            const message =
                document.getElementById("successMessage");

            if (!message) {
                return;
            }

            setTimeout(function () {

                dismissSuccessMessage();

            }, 4000);

        })();

        function dismissSuccessMessage() {

            const message =
                document.getElementById("successMessage");

            if (!message) {
                return;
            }

            message.classList.add("success-message-hide");

            setTimeout(function () {

                message.remove();

            }, 300);

        }

    </script>

}s