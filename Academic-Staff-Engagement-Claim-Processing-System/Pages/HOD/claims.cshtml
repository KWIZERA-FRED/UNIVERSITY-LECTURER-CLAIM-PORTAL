@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ClaimsModel

@{
    Layout = "~/Pages/Shared/HOD/_HODLayout.cshtml";
    ViewData["Title"] = "Claims";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/claims.css"
          asp-append-version="true" />
}

<section class="claims-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>Claims</h1>
            <p>Review lecturer claims awaiting your approval.</p>
        </div>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <section class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon stat-icon-orange">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-value">@Model.PendingClaims.Count</div>
            <span class="stat-label">Pending Claims</span>
        </div>

    </section>

    <section class="section-card">

        <header class="section-header">
            <h2>Claims Awaiting Review</h2>
            <span class="section-meta">
                @Model.PendingClaims.Count @(Model.PendingClaims.Count == 1 ? "claim" : "claims")
            </span>
        </header>

        <div class="toolbar">

            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="search"
                       id="claimsSearch"
                       placeholder="Search by claim, lecturer or contract…"
                       autocomplete="off" />
            </div>

        </div>

        @if (Model.PendingClaims.Count > 0)
        {
            <div class="table-wrapper">
                <table class="data-table" id="claimsTable">

                    <thead>
                        <tr>
                            <th>Claim</th>
                            <th>Lecturer</th>
                            <th>Contract</th>
                            <th class="col-right">Hours</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in Model.PendingClaims)
                        {
                            <tr class="claim-row"
                                data-search="CL@(row.ClaimId.ToString("D3")) @row.LecturerName C@(row.ContractId.ToString("D3"))">

                                <td>
                                    <span class="reference-pill">
                                        CL@(row.ClaimId.ToString("D3"))
                                    </span>
                                </td>

                                <td>
                                    <span class="lecturer-name">@row.LecturerName</span>
                                </td>

                                <td>
                                    <span class="contract-reference">
                                        C@(row.ContractId.ToString("D3"))
                                    </span>
                                </td>

                                <td class="col-right">
                                    <span class="hours-value">@row.HoursClaimed.ToString("N2") h</span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/HOD/ClaimDetails"
                                       asp-route-ClaimId="@row.ClaimId"
                                       class="gray-button">
                                        Review
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="table-empty" id="noResults" style="display:none;">
                <p>No claims match your search.</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No claims awaiting your review.</p>
            </div>
        }

    </section>

</section>

@section Scripts {
<script>

    const claimsSearch = document.getElementById("claimsSearch");
    const noResults = document.getElementById("noResults");

    if (claimsSearch) {

        claimsSearch.addEventListener("input", function () {

            const term = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll(".claim-row");

            let visible = 0;

            rows.forEach(function (row) {

                const haystack = (row.dataset.search || "").toLowerCase();
                const match = term === "" || haystack.includes(term);

                row.style.display = match ? "" : "none";

                if (match) visible++;

            });

            if (noResults) {
                noResults.style.display = visible === 0 ? "" : "none";
            }

        });

    }

</script>
}