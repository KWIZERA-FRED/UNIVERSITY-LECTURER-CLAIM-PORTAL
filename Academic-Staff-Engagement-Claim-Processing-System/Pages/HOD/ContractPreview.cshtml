@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ContractPreviewModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums
@{
    Layout = null;
    ViewData["Title"] = "Contract Preview";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Contract Preview · UNILAK ASECPS</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<style>
    * { box-sizing: border-box; }
    :root {
        --primary: #0f2b4a;
        --primary-light: #1a3f64;
        --accent: #2a7f5e;
        --accent-light: #e1f0e8;
        --bg: #f0f4fa;
        --card: #ffffff;
        --border: #dce4ed;
        --text: #1a2634;
        --text-muted: #4d6278;
        --warning: #856404;
        --warning-light: #fff3cd;
        --radius: 16px;
        --shadow: 0 12px 30px -10px rgba(0,20,40,0.12);
    }
    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text);
        font-family: 'Segoe UI', system-ui, sans-serif; }
    .wrap { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    .top-bar {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 1.5rem;
    }
    .top-bar a {
        text-decoration: none; color: var(--primary); font-weight: 600;
        font-size: 0.85rem;
    }
    .top-bar a i { margin-right: 0.4rem; }
    .summary-card {
        background: var(--primary); color: white; border-radius: var(--radius);
        padding: 1.5rem 1.7rem; margin-bottom: 1.5rem; box-shadow: var(--shadow);
    }
    .summary-card h1 { margin: 0 0 0.3rem; font-size: 1.3rem; }
    .summary-card p { margin: 0; opacity: 0.8; font-size: 0.85rem; }
    .summary-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
        margin-top: 1.2rem;
    }
    .summary-item strong {
        display: block; font-size: 0.68rem; text-transform: uppercase;
        letter-spacing: 0.4px; opacity: 0.65; margin-bottom: 0.2rem;
    }
    .summary-item span { font-size: 0.9rem; }
    .badge {
        display: inline-block; padding: 0.25rem 0.7rem; border-radius: 30px;
        font-size: 0.7rem; font-weight: 600; background: var(--warning-light);
        color: var(--warning);
    }
    .card {
        background: var(--card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow);
    }
    .card h2 {
        margin: 0 0 1rem; font-size: 0.95rem; color: var(--primary);
    }
    .contract-text {
        white-space: pre-wrap; font-family: 'Courier New', monospace;
        font-size: 0.82rem; line-height: 1.6; color: var(--text);
        background: #f8fafc; border: 1px solid var(--border); border-radius: 10px;
        padding: 1.5rem; max-height: 600px; overflow-y: auto;
    }
    .error {
        background: #fdecec; border-left: 4px solid #b42318; padding: 1rem;
        border-radius: 8px; color: #b42318; font-size: 0.85rem;
    }
</style>
</head>
<body>
<div class="wrap">

    <div class="top-bar">
        <a href="/HOD"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
        <a href="/HOD/AssignCourse"><i class="fas fa-plus"></i> Assign Another Course</a>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="error">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="summary-card">
            <h1>Contract Generated</h1>
            <p>This contract has been created and is now pending the signature workflow.</p>

            <div class="summary-grid">
                <div class="summary-item">
                    <strong>Lecturer</strong>
                    <span>@Model.LecturerName</span>
                </div>
                <div class="summary-item">
                    <strong>Course</strong>
                    <span>@Model.CourseCode — @Model.CourseTitle</span>
                </div>
                <div class="summary-item">
                    <strong>Status</strong>
                    <span class="badge">@Model.Status</span>
                </div>
                <div class="summary-item">
                    <strong>Academic Year</strong>
                    <span>@Model.AcademicYear, @Model.Semester</span>
                </div>
                <div class="summary-item">
                    <strong>Campus / Session</strong>
                    <span>@Model.Campus, @Model.Session</span>
                </div>
                <div class="summary-item">
                    <strong>Hours / Rate</strong>
                    <span>@Model.AllocatedHours.ToString("0.##")h @@ @Model.RatePerHour.ToString("N0") RWF/h</span>                </div>
            </div>
        </div>

        <div class="card">
            <h2><i class="fas fa-file-contract"></i> Contract Document</h2>
            <div class="contract-text">@Model.ContractContent</div>
        </div>
    }

</div>
</body>
</html>