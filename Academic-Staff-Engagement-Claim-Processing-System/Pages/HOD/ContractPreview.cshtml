@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ContractPreviewModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    Layout = "~/Pages/Shared/HOD/_HODLayout.cshtml";
    ViewData["Title"] = "Contract Preview";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/contract-preview.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/shared/contract-document.css"
          asp-append-version="true" />
}

<section class="preview-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>Contract Preview</h1>
            <p>Review the generated academic staff employment contract before the institutional signing workflow begins.</p>
        </div>

        <div class="page-header-actions">

            <a href="/HOD/Contracts" class="primary-button">
                <i class="bi bi-file-earmark-text"></i>
                View Contracts
            </a>

        </div>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }
    else
    {
        <section class="section-card">

            <header class="section-header">

                <h2>CON-@Model.ContractId.ToString("D6")</h2>

                @switch (Model.Status)
                {
                    case ContractStatus.PendingSignature:
                        <span class="status-badge status-pending">Pending Signature</span>
                        break;

                    case ContractStatus.Active:
                        <span class="status-badge status-active">Active</span>
                        break;

                    case ContractStatus.Expired:
                        <span class="status-badge status-neutral">Expired</span>
                        break;

                    case ContractStatus.Terminated:
                        <span class="status-badge status-danger">Terminated</span>
                        break;

                    default:
                        <span class="status-badge status-neutral">@Model.Status</span>
                        break;
                }

            </header>

            <div class="detail-grid">

                <div class="detail-item">
                    <span class="detail-label">Lecturer</span>
                    <span class="detail-value">@Model.LecturerName</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Course</span>
                    <span class="detail-value">@Model.CourseCode — @Model.CourseTitle</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Academic Year</span>
                    <span class="detail-value">@Model.AcademicYear</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Semester</span>
                    <span class="detail-value">@Model.Semester</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Campus</span>
                    <span class="detail-value">@Model.Campus</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Session</span>
                    <span class="detail-value">@Model.Session</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Allocated Hours</span>
                    <span class="detail-value">@Model.AllocatedHours.ToString("0.##") hours</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Hourly Rate</span>
                    <span class="detail-value">@Model.RatePerHour.ToString("N0") RWF / hour</span>
                </div>

            </div>

        </section>

        <section class="section-card">

            <header class="section-header">
                <h2>Official Contract Document</h2>
                <span class="section-meta">Read-only preview</span>
            </header>

            <div class="document-stage">

                <article class="contract-document">

                    @if (string.IsNullOrWhiteSpace(Model.ContractContent))
                    {
                        <div class="document-empty">
                            <i class="bi bi-file-earmark-x"></i>
                            <strong>Contract content is unavailable.</strong>
                            <span>The contract does not contain generated content.</span>
                        </div>
                    }
                    else
                    {
                        @Html.Raw(Model.ContractContent)
                    }

                </article>

            </div>

        </section>
    }

</section>