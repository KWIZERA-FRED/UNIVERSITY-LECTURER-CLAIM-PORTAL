
@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ContractPreviewModel

@{
    Layout = null;
    ViewData["Title"] = "Contract Preview";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Contract Preview | UNILAK Staff Portal</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.googleapis.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef2f5;
            color: #202b33;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .topbar {
            height: 72px;
            background: #174d3b;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-logo {
            width: 42px;
            height: 42px;
            object-fit: contain;
        }

        .topbar-title {
            font-size: 14px;
            font-weight: 700;
        }

        .topbar-subtitle {
            font-size: 10px;
            opacity: .75;
            margin-top: 3px;
        }

        .topbar-right {
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .page {
            padding: 30px;
        }

        .toolbar {
            max-width: 950px;
            margin: 0 auto 18px auto;
        }

        .back-button {
            display: inline-block;
            text-decoration: none;
            border-radius: 9px;
            padding: 10px 15px;
            font-size: 11px;
            font-weight: 700;
            color: #174d3b;
            background: white;
            border: 1px solid #d7e0db;
        }

        .back-button:hover {
            background: #f3f7f5;
        }

        .contract {
            max-width: 950px;
            margin: 0 auto;
            background: white;
            padding: 65px 75px;
            box-shadow: 0 10px 35px rgba(0,0,0,.10);
            border: 1px solid #e1e5e7;
        }

        .contract-header {
            text-align: center;
            padding-bottom: 24px;
            border-bottom: 2px solid #174d3b;
        }

        .university-logo {
            width: 78px;
            height: 78px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .university-name {
            font-size: 22px;
            font-weight: 800;
            color: #174d3b;
            letter-spacing: .5px;
        }

        .university-location {
            font-size: 10px;
            color: #68756f;
            margin-top: 5px;
        }

        .contract-title {
            margin-top: 25px;
            font-size: 20px;
            font-weight: 800;
            color: #1e2924;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .contract-subtitle {
            margin-top: 7px;
            font-size: 11px;
            color: #69756f;
        }

        .contract-meta {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
            padding: 14px 18px;
            background: #f6f8f7;
            border-left: 4px solid #2a7f5e;
            font-size: 10px;
        }

        .meta-label {
            color: #718078;
            font-weight: 600;
        }

        .meta-value {
            color: #1e2924;
            font-weight: 800;
            margin-left: 5px;
        }

        .template-content {
            margin-top: 35px;
            font-size: 11px;
            line-height: 1.85;
            color: #3f4c46;
            text-align: left;
        }

        .contract-information {
            margin-top: 35px;
            padding: 20px;
            border: 1px solid #dce4df;
            border-radius: 8px;
            background: #fcfdfc;
        }

        .contract-information-title {
            color: #174d3b;
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .information-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 25px;
        }

        .information-item {
            padding-bottom: 9px;
            border-bottom: 1px solid #edf0ee;
        }

        .information-label {
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #77837d;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .information-value {
            font-size: 11px;
            color: #202b33;
            font-weight: 700;
        }

        .financial-box {
            margin-top: 25px;
            padding: 20px;
            background: #f4f8f5;
            border: 1px solid #d4e2da;
            border-radius: 8px;
        }

        .financial-title {
            color: #174d3b;
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .financial-line {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            font-size: 11px;
            border-bottom: 1px solid #dce7e1;
        }

        .financial-line:last-child {
            border-bottom: none;
        }

        .financial-total {
            margin-top: 8px;
            padding-top: 13px;
            border-top: 2px solid #174d3b;
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            font-weight: 800;
            color: #174d3b;
        }

        .signature-section {
            margin-top: 50px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 45px;
        }

        .signature-box {
            min-height: 120px;
        }

        .signature-role {
            font-size: 11px;
            font-weight: 800;
            color: #174d3b;
            margin-bottom: 55px;
        }

        .signature-line {
            border-top: 1px solid #555;
            padding-top: 7px;
            font-size: 9px;
            color: #69756f;
        }

        .signature-date {
            margin-top: 12px;
            font-size: 9px;
            color: #69756f;
        }

        .approval-section {
            margin-top: 35px;
            padding: 18px;
            border: 1px dashed #b9c9c1;
            background: #fafcfb;
            text-align: center;
        }

        .approval-title {
            color: #174d3b;
            font-size: 11px;
            font-weight: 800;
        }

        .approval-text {
            margin-top: 6px;
            font-size: 9px;
            color: #718078;
            line-height: 1.6;
        }

        .qr-section {
            margin-top: 35px;
            display: flex;
            justify-content: flex-end;
        }

        .qr-box {
            width: 120px;
            text-align: center;
        }

        .qr {
            width: 92px;
            height: 92px;
            margin: auto;
            background:
                linear-gradient(
                    90deg,
                    #174d3b 10%,
                    transparent 10%,
                    transparent 20%,
                    #174d3b 20%,
                    #174d3b 30%,
                    transparent 30%,
                    transparent 40%,
                    #174d3b 40%,
                    #174d3b 50%,
                    transparent 50%,
                    transparent 60%,
                    #174d3b 60%,
                    #174d3b 70%,
                    transparent 70%,
                    transparent 80%,
                    #174d3b 80%,
                    #174d3b 90%,
                    transparent 90%
                ),
                linear-gradient(
                    #174d3b 10%,
                    transparent 10%,
                    transparent 20%,
                    #174d3b 20%,
                    #174d3b 30%,
                    transparent 30%,
                    transparent 40%,
                    #174d3b 40%,
                    #174d3b 50%,
                    transparent 50%,
                    transparent 60%,
                    #174d3b 60%,
                    #174d3b 70%,
                    transparent 70%,
                    transparent 80%,
                    #174d3b 80%,
                    #174d3b 90%,
                    transparent 90%
                );
            border: 5px solid white;
            outline: 1px solid #174d3b;
        }

        .qr-label {
            font-size: 8px;
            color: #69756f;
            margin-top: 8px;
            line-height: 1.4;
        }

        .contract-footer {
            margin-top: 45px;
            padding-top: 15px;
            border-top: 1px solid #dce4df;
            text-align: center;
            font-size: 8px;
            color: #84908b;
            line-height: 1.6;
        }

        .error-box {
            max-width: 950px;
            margin: 40px auto;
            background: white;
            border: 1px solid #e5c4c4;
            border-left: 5px solid #a33a3a;
            padding: 25px;
            border-radius: 8px;
        }

        .error-box h2 {
            margin-top: 0;
            color: #8b2929;
        }

        .error-box p {
            font-size: 12px;
            line-height: 1.7;
        }

        @@media print {

            body {
                background: white;
            }

            .topbar,
            .toolbar {
                display: none;
            }

            .page {
                padding: 0;
            }

            .contract {
                box-shadow: none;
                border: none;
                max-width: none;
                margin: 0;
            }
        }

        @@media(max-width: 700px) {

            .page {
                padding: 10px;
            }

            .contract {
                padding: 35px 25px;
            }

            .contract-meta {
                flex-direction: column;
                gap: 8px;
            }

            .information-grid {
                grid-template-columns: 1fr;
            }

            .signature-section {
                grid-template-columns: 1fr;
                gap: 20px;
            }
        }

    </style>

</head>

<body>

<header class="topbar">

    <div class="topbar-left">

        <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
             class="topbar-logo"
             alt="UNILAK">

        <div>

            <div class="topbar-title">
                UNILAK Staff Portal
            </div>

            <div class="topbar-subtitle">
                Academic Staff Engagement & Claim Processing
            </div>

        </div>

    </div>

    <div class="topbar-right">

        <i class="bi bi-file-earmark-text"></i>

        Contract Preview

    </div>

</header>

<div class="page">

    <div class="toolbar">

        <a href="/HOD/AssignCourse"
           class="back-button">

            <i class="bi bi-arrow-left"></i>

            Back to Assignment

        </a>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-box">

            <h2>
                Contract could not be loaded
            </h2>

            <p>
                @Model.ErrorMessage
            </p>

        </div>
    }
    else
    {
        <article class="contract">

            <header class="contract-header">

                <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                     class="university-logo"
                     alt="University Logo">

                <div class="university-name">
                    UNIVERSITY OF LAY ADVENTISTS OF KIGALI
                </div>

                <div class="university-location">
                    Kigali, Rwanda
                </div>

                <div class="contract-title">
                    Academic Staff Engagement Contract
                </div>

                <div class="contract-subtitle">
                    Part-Time Academic Teaching Engagement
                </div>

            </header>

            <div class="contract-meta">

                <div>

                    <span class="meta-label">
                        Contract Number:
                    </span>

                    <span class="meta-value">
                        @Model.ContractNumber
                    </span>

                </div>

                <div>

                    <span class="meta-label">
                        Contract Date:
                    </span>

                    <span class="meta-value">
                        @Model.ContractDate
                    </span>

                </div>

            </div>

            <div class="template-content">

                @Html.Raw(Model.ContractHtml)

            </div>

            <section class="contract-information">

                <div class="contract-information-title">
                    CONTRACT INFORMATION
                </div>

                <div class="information-grid">

                    <div class="information-item">
                        <div class="information-label">
                            Lecturer
                        </div>

                        <div class="information-value">
                            @Model.LecturerName
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Email
                        </div>

                        <div class="information-value">
                            @Model.LecturerEmail
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Academic Rank
                        </div>

                        <div class="information-value">
                            @Model.AcademicRank
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Department
                        </div>

                        <div class="information-value">
                            @Model.Department
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Course Code
                        </div>

                        <div class="information-value">
                            @Model.CourseCode
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Course Title
                        </div>

                        <div class="information-value">
                            @Model.CourseTitle
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Academic Year
                        </div>

                        <div class="information-value">
                            @Model.AcademicYear
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Semester
                        </div>

                        <div class="information-value">
                            @Model.Semester
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Session
                        </div>

                        <div class="information-value">
                            @Model.Session
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Campus
                        </div>

                        <div class="information-value">
                            @Model.Campus
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Intake
                        </div>

                        <div class="information-value">
                            @Model.Intake
                        </div>
                    </div>

                    <div class="information-item">
                        <div class="information-label">
                            Allocated Hours
                        </div>

                        <div class="information-value">
                            @Model.AllocatedHours.ToString("N0") hours
                        </div>
                    </div>

                </div>

                <div class="financial-box">

                    <div class="financial-title">
                        REMUNERATION
                    </div>

                    <div class="financial-line">

                        <span>
                            Approved Teaching Hours
                        </span>

                        <strong>
                            @Model.AllocatedHours.ToString("N0") hours
                        </strong>

                    </div>

                    <div class="financial-line">

                        <span>
                            Rate Per Hour
                        </span>

                        <strong>
                            RWF @Model.HourlyRate.ToString("N0")
                        </strong>

                    </div>

                    <div class="financial-total">

                        <span>
                            Estimated Contract Value
                        </span>

                        <span>
                            RWF @Model.TotalAmount.ToString("N0")
                        </span>

                    </div>

                </div>

            </section>

            <section class="signature-section">

                <div class="signature-box">

                    <div class="signature-role">
                        Lecturer
                    </div>

                    <div class="signature-line">
                        Signature
                    </div>

                    <div class="signature-date">
                        Date: ______________________________
                    </div>

                </div>

                <div class="signature-box">

                    <div class="signature-role">
                        Dean of Faculty
                    </div>

                    <div class="signature-line">
                        Signature
                    </div>

                    <div class="signature-date">
                        Date: ______________________________
                    </div>

                </div>

                <div class="signature-box">

                    <div class="signature-role">
                        Human Resource Officer
                    </div>

                    <div class="signature-line">
                        Signature
                    </div>

                    <div class="signature-date">
                        Date: ______________________________
                    </div>

                </div>

                <div class="signature-box">

                    <div class="signature-role">
                        DVCAR
                    </div>

                    <div class="signature-line">
                        Signature
                    </div>

                    <div class="signature-date">
                        Date: ______________________________
                    </div>

                </div>

                <div class="signature-box">

                    <div class="signature-role">
                        Vice Chancellor
                    </div>

                    <div class="signature-line">
                        Signature
                    </div>

                    <div class="signature-date">
                        Date: ______________________________
                    </div>

                </div>

            </section>

            <div class="approval-section">

                <div class="approval-title">
                    CONTRACT APPROVAL STATUS
                </div>

                <div class="approval-text">

                    This contract was generated automatically from
                    the contract template stored in the University's
                    database.

                    It is ready for the electronic approval and
                    signature workflow.

                </div>

            </div>

            <div class="qr-section">

                <div class="qr-box">

                    <div class="qr"></div>

                    <div class="qr-label">
                        Contract verification QR code
                    </div>

                </div>

            </div>

            <footer class="contract-footer">

                University of Lay Adventists of Kigali (UNILAK)<br>

                Academic Staff Engagement & Claim Processing System<br>

                Contract Reference: @Model.ContractNumber

            </footer>

        </article>
    }

</div>

</body>

</html>

