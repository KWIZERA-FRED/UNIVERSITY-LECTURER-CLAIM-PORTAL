@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ContractPreviewModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    Layout = null;
    ViewData["Title"] = "Contract Preview";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Contract Preview · UNILAK ASECPS</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Contract Preview CSS -->
    <link rel="stylesheet"
          href="~/css/HOD/contract-preview.css"
          asp-append-version="true" />
</head>

<body>

<div class="page-wrapper">

    <!-- =========================================================
         TOP NAVIGATION
         ========================================================= -->
    <div class="top-bar">

        <a href="/HOD" class="top-link">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>

        <div class="top-actions">

            <a href="/HOD/AssignCourse" class="top-link">
                <i class="fas fa-plus"></i>
                Assign Another Course
            </a>

            @if (Model.ErrorMessage == null)
            {
                <button type="button"
                        class="print-button"
                        onclick="window.print()">
                    <i class="fas fa-print"></i>
                    Print Contract
                </button>
            }

        </div>

    </div>


    @if (Model.ErrorMessage != null)
    {
        <!-- =====================================================
             ERROR
             ===================================================== -->

        <div class="error-card">

            <div class="error-icon">
                <i class="fas fa-circle-exclamation"></i>
            </div>

            <div>
                <h2>Contract Not Found</h2>
                <p>@Model.ErrorMessage</p>
            </div>

        </div>
    }
    else
    {

        <!-- =====================================================
             CONTRACT SUMMARY
             ===================================================== -->

        <section class="summary-card">

            <div class="summary-header">

                <div>
                    <span class="eyebrow">
                        CONTRACT GENERATED
                    </span>

                    <h1>Employment Contract</h1>

                    <p>
                        The contract has been created successfully and
                        is now pending the signature workflow.
                    </p>
                </div>

                <div class="contract-status">
                    <span class="status-label">Status</span>
                    <span class="status-badge">
                        @Model.Status
                    </span>
                </div>

            </div>


            <div class="summary-grid">

                <!-- Lecturer -->
                <div class="summary-item">

                    <div class="summary-icon green">
                        <i class="fas fa-user"></i>
                    </div>

                    <div>
                        <span class="summary-label">Lecturer</span>
                        <strong>@Model.LecturerName</strong>
                    </div>

                </div>


                <!-- Course -->
                <div class="summary-item">

                    <div class="summary-icon blue">
                        <i class="fas fa-book"></i>
                    </div>

                    <div>
                        <span class="summary-label">Course</span>
                        <strong>
                            @Model.CourseCode — @Model.CourseTitle
                        </strong>
                    </div>

                </div>


                <!-- Academic Year -->
                <div class="summary-item">

                    <div class="summary-icon purple">
                        <i class="fas fa-calendar"></i>
                    </div>

                    <div>
                        <span class="summary-label">Academic Year</span>
                        <strong>
                            @Model.AcademicYear
                        </strong>
                    </div>

                </div>


                <!-- Semester -->
                <div class="summary-item">

                    <div class="summary-icon orange">
                        <i class="fas fa-layer-group"></i>
                    </div>

                    <div>
                        <span class="summary-label">Semester</span>
                        <strong>
                            @Model.Semester
                        </strong>
                    </div>

                </div>


                <!-- Campus -->
                <div class="summary-item">

                    <div class="summary-icon cyan">
                        <i class="fas fa-building"></i>
                    </div>

                    <div>
                        <span class="summary-label">Campus</span>
                        <strong>
                            @Model.Campus
                        </strong>
                    </div>

                </div>


                <!-- Session -->
                <div class="summary-item">

                    <div class="summary-icon red">
                        <i class="fas fa-clock"></i>
                    </div>

                    <div>
                        <span class="summary-label">Session</span>
                        <strong>
                            @Model.Session
                        </strong>
                    </div>

                </div>


                <!-- Hours -->
                <div class="summary-item">

                    <div class="summary-icon green">
                        <i class="fas fa-hourglass-half"></i>
                    </div>

                    <div>
                        <span class="summary-label">Allocated Hours</span>
                        <strong>
                            @Model.AllocatedHours.ToString("0.##") hours
                        </strong>
                    </div>

                </div>


                <!-- Rate -->
                <div class="summary-item">

                    <div class="summary-icon blue">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>

                    <div>
                        <span class="summary-label">Hourly Rate</span>
                        <strong>
                            @Model.RatePerHour.ToString("N0") RWF/hour
                        </strong>
                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             SIGNATURE WORKFLOW
             ===================================================== -->

        <section class="workflow-card">

            <div class="workflow-heading">

                <div class="section-icon">
                    <i class="fas fa-signature"></i>
                </div>

                <div>
                    <h2>Contract Signature Workflow</h2>

                    <p>
                        The contract must be signed in the following
                        order.
                    </p>
                </div>

            </div>


            <div class="workflow">

                <div class="workflow-step active">
                    <span class="step-number">1</span>
                    <div>
                        <strong>Lecturer</strong>
                        <span>First signature</span>
                    </div>
                </div>

                <div class="workflow-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

                <div class="workflow-step">
                    <span class="step-number">2</span>
                    <div>
                        <strong>Dean</strong>
                        <span>Faculty approval</span>
                    </div>
                </div>

                <div class="workflow-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

                <div class="workflow-step">
                    <span class="step-number">3</span>
                    <div>
                        <strong>HR Officer</strong>
                        <span>HR verification</span>
                    </div>
                </div>

                <div class="workflow-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

                <div class="workflow-step">
                    <span class="step-number">4</span>
                    <div>
                        <strong>DVCAR</strong>
                        <span>Academic review</span>
                    </div>
                </div>

                <div class="workflow-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

                <div class="workflow-step">
                    <span class="step-number">5</span>
                    <div>
                        <strong>Vice Chancellor</strong>
                        <span>Final approval</span>
                    </div>
                </div>

            </div>

        </section>


        <!-- =====================================================
             OFFICIAL CONTRACT DOCUMENT
             ===================================================== -->

        <section class="document-section">

            <div class="document-toolbar">

                <div class="document-title">

                    <div class="document-icon">
                        <i class="fas fa-file-contract"></i>
                    </div>

                    <div>
                        <h2>Official Contract Document</h2>
                        <p>
                            Generated employment contract
                        </p>
                    </div>

                </div>

                <button type="button"
                        class="toolbar-print"
                        onclick="window.print()">
                    <i class="fas fa-print"></i>
                    Print
                </button>

            </div>


            <!-- =================================================
                 IMPORTANT:
                 ContractContent contains trusted,
                 server-generated HTML.
                 ================================================= -->

            <div class="document-container">

                <div class="contract-document">
                    @Html.Raw(Model.ContractContent)
                </div>

            </div>

        </section>


        <!-- =====================================================
             FOOTER NOTE
             ===================================================== -->

        <div class="information-note">

            <div class="information-icon">
                <i class="fas fa-info-circle"></i>
            </div>

            <div>
                <strong>Signature process</strong>

                <p>
                    This contract follows the official ASECPS approval
                    sequence:
                    Lecturer → Dean → HR Officer → DVCAR →
                    Vice Chancellor.
                    Each officer must complete their step before the
                    contract proceeds to the next stage.
                </p>
            </div>

        </div>

    }

</div>

</body>
</html>