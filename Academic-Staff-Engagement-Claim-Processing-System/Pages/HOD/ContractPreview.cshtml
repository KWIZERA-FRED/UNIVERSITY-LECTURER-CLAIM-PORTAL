@page

@{
    Layout = null;
    ViewData["Title"] = "Contract Preview";


var course = Request.Query["Course"].ToString();
    var lecturer = Request.Query["Lecturer"].ToString();
    var governmentId = Request.Query["GovernmentId"].ToString();
    var rank = Request.Query["Rank"].ToString();
    var session = Request.Query["Session"].ToString();
    var academicYear = Request.Query["AcademicYear"].ToString();
    var campus = Request.Query["Campus"].ToString();
    var hours = Request.Query["Hours"].ToString();
    var rate = Request.Query["Rate"].ToString();

    if (string.IsNullOrWhiteSpace(course))
        course = "Not specified";

    if (string.IsNullOrWhiteSpace(lecturer))
        lecturer = "Not specified";

    if (string.IsNullOrWhiteSpace(governmentId))
        governmentId = "Not specified";

    if (string.IsNullOrWhiteSpace(rank))
        rank = "Not specified";

    if (string.IsNullOrWhiteSpace(session))
        session = "Not specified";

    if (string.IsNullOrWhiteSpace(academicYear))
        academicYear = "Not specified";

    if (string.IsNullOrWhiteSpace(campus))
        campus = "Not specified";

    if (string.IsNullOrWhiteSpace(hours))
        hours = "0";

    if (string.IsNullOrWhiteSpace(rate))
        rate = "0";

    decimal rateValue = 0;

    decimal.TryParse(rate, out rateValue);

    int hoursValue = 0;

    int.TryParse(hours, out hoursValue);

    decimal totalValue = hoursValue * rateValue;

    string formattedRate = rateValue.ToString("N0");
    string formattedTotal = totalValue.ToString("N0");

    var contractNumber =
        "UNILAK-" +
        DateTime.Now.Year +
        "-" +
        DateTime.Now.ToString("MMddHHmmss");


}

<!DOCTYPE html>

<html lang="en">

<head>

