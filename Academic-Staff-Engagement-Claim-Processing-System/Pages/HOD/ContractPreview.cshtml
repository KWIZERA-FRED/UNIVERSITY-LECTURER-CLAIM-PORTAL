</head>

<body>

    ```
    <header class="topbar">

        <div class="topbar-left">

            <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                 class="topbar-logo"
                 alt="UNILAK">

            <div>

                <div class="topbar-title">
                    UNILAK Staff Portal
                </div>

                <div class="topbar-subtitle">
                    Academic Staff Engagement & Claim Processing
                </div>

            </div>

        </div>

        <div class="topbar-right">

            <i class="bi bi-file-earmark-text"></i>

            Contract Preview

        </div>

    </header>


    <div class="page">

        <div class="toolbar">

            <a href="/HOD/AssignCourse"
               class="back-button">

                <i class="bi bi-arrow-left"></i>

                Back to Assignment

            </a>

            <div class="toolbar-actions">

                <button type="button"
                        class="toolbar-button print-button"
                        onclick="window.print()">

                    <i class="bi bi-printer"></i>

                    Print Contract

                </button>

            </div>

        </div>


        <article class="contract">

            <header class="contract-header">

                <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                     class="university-logo"
                     alt="University Logo">

                <div class="university-name">
                    UNIVERSITY OF LAY ADVENTISTS OF KIGALI
                </div>

                <div class="university-location">
                    Kigali, Rwanda
                </div>

                <div class="contract-title">
                    Academic Staff Engagement Contract
                </div>

                <div class="contract-subtitle">
                    Part-Time Academic Teaching Engagement
                </div>

            </header>


            <div class="contract-meta">

                <div>

                    <span class="meta-label">
                        Contract Number:
                    </span>

                    <span class="meta-value">
                        @contractNumber
                    </span>

                </div>

                <div>

                    <span class="meta-label">
                        Academic Year:
                    </span>

                    <span class="meta-value">
                        @academicYear
                    </span>

                </div>

            </div>


            <section class="section">

                <div class="section-heading">
                    1. Parties to the Agreement
                </div>

                <p class="paragraph">

                    This Academic Staff Engagement Contract is entered into between
                    the University of Lay Adventists of Kigali (UNILAK), hereinafter
                    referred to as the "University", and the academic staff member
                    identified below, hereinafter referred to as the "Lecturer".

                </p>

                <div class="person-block">

                    <div class="person-name">
                        @lecturer
                    </div>

                    <div class="person-line">
                        <strong>Government Identification Number:</strong>
                        @governmentId
                    </div>

                    <div class="person-line">
                        <strong>Academic Rank:</strong>
                        @rank
                    </div>

                    <div class="person-line">
                        <strong>Campus:</strong>
                        @campus
                    </div>

                </div>

            </section>


            <section class="section">

                <div class="section-heading">
                    2. Academic Assignment
                </div>

                <p class="paragraph">

                    The University hereby engages the Lecturer to provide academic
                    teaching services for the course and academic period specified
                    below. The Lecturer agrees to perform the assigned academic
                    responsibilities in accordance with University policies,
                    academic regulations and departmental requirements.

                </p>

                <div class="assignment-box">

                    <div class="assignment-item">

                        <div class="assignment-label">
                            Assigned Course
                        </div>

                        <div class="assignment-value">
                            @course
                        </div>

                    </div>

                    <div class="assignment-item">

                        <div class="assignment-label">
                            Academic Year
                        </div>

                        <div class="assignment-value">
                            @academicYear
                        </div>

                    </div>

                    <div class="assignment-item">

                        <div class="assignment-label">
                            Teaching Session
                        </div>

                        <div class="assignment-value">
                            @session
                        </div>

                    </div>

                    <div class="assignment-item">

                        <div class="assignment-label">
                            Campus
                        </div>

                        <div class="assignment-value">
                            @campus
                        </div>

                    </div>

                    <div class="assignment-item">

                        <div class="assignment-label">
                            Approved Teaching Hours
                        </div>

                        <div class="assignment-value">
                            @hours hours
                        </div>

                    </div>

                </div>

            </section>


            <section class="section">

                <div class="section-heading">
                    3. Remuneration
                </div>

                <p class="paragraph">

                    In consideration of the academic teaching services provided
                    under this agreement, the Lecturer shall be remunerated at
                    the applicable rate determined by the Lecturer's academic rank.

                </p>

                <div class="financial-box">

                    <div class="financial-title">
                        REMUNERATION DETAILS
                    </div>

                    <div class="financial-line">

                        <span>
                            Approved Teaching Hours
                        </span>

                        <strong>
                            @hours hours
                        </strong>

                    </div>

                    <div class="financial-line">

                        <span>
                            Rate Per Hour
                        </span>

                        <strong>
                            RWF @formattedRate
                        </strong>

                    </div>

                    <div class="financial-total">

                        <span>
                            Estimated Contract Value
                        </span>

                        <span>
                            RWF @formattedTotal
                        </span>

                    </div>

                </div>

            </section>


            <section class="section">

                <div class="section-heading">
                    4. Responsibilities of the Lecturer
                </div>

                <ol class="conditions">

                    <li>
                        Deliver the assigned course in accordance with the
                        approved curriculum and academic timetable.
                    </li>

                    <li>
                        Maintain accurate attendance and academic records
                        for all assigned teaching activities.
                    </li>

                    <li>
                        Conduct assessments and submit marks within the
                        deadlines established by the University.
                    </li>

                    <li>
                        Comply with all applicable University academic,
                        administrative and professional policies.
                    </li>

                    <li>
                        Perform the approved teaching hours specified in
                        this contract.
                    </li>

                </ol>

            </section>


            <section class="section">

                <div class="section-heading">
                    5. Contract Conditions
                </div>

                <p class="paragraph">

                    This contract becomes effective upon completion of the
                    required institutional approval and signature process.
                    Any amendment to the assignment, teaching hours or
                    remuneration must be authorized by the appropriate
                    University authorities.

                </p>

                <p class="paragraph">

                    The Lecturer acknowledges that payment is subject to
                    verification of teaching activities, attendance records,
                    academic deliverables and the University's applicable
                    claim-processing procedures.

                </p>

            </section>


            <section class="section">

                <div class="section-heading">
                    6. Approval and Signatures
                </div>

                <p class="paragraph">

                    By signing below, the respective parties acknowledge that
                    they have reviewed the terms of this Academic Staff
                    Engagement Contract and agree to the responsibilities
                    and conditions contained herein.

                </p>


                <div class="signature-section">

                    <div class="signature-box">

                        <div class="signature-role">
                            Lecturer
                        </div>

                        <div class="signature-line">
                            Signature
                        </div>

                        <div class="signature-date">
                            Date: ______________________________
                        </div>

                    </div>


                    <div class="signature-box">

                        <div class="signature-role">
                            Head of Department
                        </div>

                        <div class="signature-line">
                            Signature
                        </div>

                        <div class="signature-date">
                            Date: ______________________________
                        </div>

                    </div>


                    <div class="signature-box">

                        <div class="signature-role">
                            Dean / Authorized Academic Authority
                        </div>

                        <div class="signature-line">
                            Signature
                        </div>

                        <div class="signature-date">
                            Date: ______________________________
                        </div>

                    </div>


                    <div class="signature-box">

                        <div class="signature-role">
                            Management / Authorized Representative
                        </div>

                        <div class="signature-line">
                            Signature
                        </div>

                        <div class="signature-date">
                            Date: ______________________________
                        </div>

                    </div>

                </div>

            </section>


            <div class="approval-section">

                <div class="approval-title">
                    CONTRACT APPROVAL STATUS
                </div>

                <div class="approval-text">

                    This document is currently a generated contract preview.
                    Final validity requires completion of the University's
                    electronic approval and signature workflow.

                </div>

            </div>


            <div class="qr-section">

                <div class="qr-box">

                    <div class="qr"></div>

                    <div class="qr-label">

                        Scan to verify contract and
                        access associated academic
                        engagement documents.

                    </div>

                </div>

            </div>


            <footer class="contract-footer">

                University of Lay Adventists of Kigali (UNILAK)<br>

                Academic Staff Engagement & Claim Processing System<br>

                Contract Reference: @contractNumber

            </footer>

        </article>

    </div>
 

</body>

</html>
