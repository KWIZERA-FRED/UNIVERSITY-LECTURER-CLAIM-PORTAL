@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.RegisterUserModel

@{
    Layout = "~/Pages/Shared/HOD/_HODLayout.cshtml";
    ViewData["Title"] = "Register New User";
}

<link rel="stylesheet" href="~/css/HOD/register-user.css" asp-append-version="true" />

<div class="register-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div class="page-heading">

            <div class="page-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <div>
                <h1>Register New User</h1>

                <p>
                    Create a new Lecturer account and capture their digital signature.
                </p>
            </div>

        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert-message success-message">

            <i class="bi bi-check-circle-fill"></i>

            <div>
                <strong>Registration Successful</strong>
                <span>@Model.SuccessMessage</span>
            </div>

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert-message error-message">

            <i class="bi bi-exclamation-circle-fill"></i>

            <div>
                <strong>Registration Failed</strong>
                <span>@Model.ErrorMessage</span>
            </div>

        </div>
    }


    <!-- REGISTRATION CARD -->
    <section class="register-card">

        <div class="card-header">

            <div>
                <h2>Lecturer Information</h2>

                <p>
                    Enter the lecturer's account and employment details below.
                </p>
            </div>

            <span class="required-note">
                <span class="required">*</span>
                Required fields
            </span>

        </div>


        <form method="post" id="registerForm">

            <div class="form-grid">

                <!-- FULL NAME -->
                <div class="form-group">

                    <label>
                        Full Name
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-person"></i>

                        <input type="text"
                               asp-for="Name"
                               class="form-control"
                               placeholder="Enter full name"
                               autocomplete="name"
                               required />

                    </div>

                    <span asp-validation-for="Name" class="validation-message"></span>

                </div>


                <!-- EMAIL -->
                <div class="form-group">

                    <label>
                        Email Address
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-envelope"></i>

                        <input type="email"
                               asp-for="Email"
                               class="form-control"
                               placeholder="Enter email address"
                               autocomplete="email"
                               required />

                    </div>

                    <span asp-validation-for="Email" class="validation-message"></span>

                </div>


                <!-- SYSTEM ROLE -->
                <div class="form-group">

                    <label>
                        System Role
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-shield-check"></i>

                        <select asp-for="Role"
                                class="form-select"
                                id="roleSelect"
                                required>

                            <option value="Lecturer" selected>
                                Lecturer
                            </option>

                        </select>

                    </div>

                    <div class="field-help">
                        HODs can only create Lecturer accounts.
                    </div>

                </div>


                <!-- EMPLOYMENT TYPE -->
                <div class="form-group">

                    <label>
                        Employment Type
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-briefcase"></i>

                        <select asp-for="LecturerType"
                                id="lecturerTypeInput"
                                class="form-select"
                                required>

                            <option value="">
                                Select employment type
                            </option>

                            <option value="PartTimeLecturer">
                                Part-Time
                            </option>

                            <option value="FullTimeLecturer">
                                Full-Time
                            </option>

                        </select>

                    </div>

                    <div class="field-help">
                        Determines the lecturer's rate and contract type.
                    </div>

                </div>


                <!-- GOVERNMENT ID -->
                <div class="form-group">

                    <label>
                        Government ID
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-card-text"></i>

                        <input type="text"
                               asp-for="GovernmentId"
                               id="governmentIdInput"
                               class="form-control"
                               placeholder="Enter government ID"
                               required />

                    </div>

                    <div class="field-help">
                        Required for the lecturer's account.
                    </div>

                    <span asp-validation-for="GovernmentId" class="validation-message"></span>

                </div>


                <!-- ACADEMIC RANK -->
                <div class="form-group">

                    <label>
                        Academic Rank
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-mortarboard"></i>

                        <select asp-for="Rank"
                                id="rankInput"
                                class="form-select"
                                required>

                            <option value="">
                                Select academic rank
                            </option>

                            <option value="AssistantLecturer">
                                Assistant Lecturer
                            </option>

                            <option value="Lecturer">
                                Lecturer
                            </option>

                            <option value="SeniorLecturer">
                                Senior Lecturer
                            </option>

                            <option value="AssociateProfessor">
                                Associate Professor
                            </option>

                            <option value="Professor">
                                Professor
                            </option>

                        </select>

                    </div>

                    <div class="field-help">
                        Select the lecturer's current academic rank.
                    </div>

                </div>


                <!-- ROLE INFORMATION -->
                <div class="role-info">

                    <div class="role-info-icon">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>

                    <div>
                        <strong>Lecturer account requirements</strong>

                        <p>
                            A Lecturer account requires a Government ID,
                            academic rank, employment type, and digital signature.
                        </p>
                    </div>

                </div>


                <!-- DIGITAL SIGNATURE -->
                <div class="signature-section">

                    <div class="section-heading">

                        <div>
                            <h3>Digital Signature</h3>

                            <p>
                                Capture the lecturer's signature using the signing area below.
                            </p>
                        </div>

                        <span class="required-badge">
                            Required
                        </span>

                    </div>


                    <div class="signature-container">

                        <div class="signature-canvas-wrapper">

                            <canvas id="signaturePad"></canvas>

                            <div class="signature-placeholder"
                                 id="signaturePlaceholder">

                                <i class="bi bi-pen"></i>

                                <span>
                                    Sign here
                                </span>

                            </div>

                        </div>


                        <div class="signature-footer">

                            <div class="signature-status">

                                <span class="status-indicator"></span>

                                <span>
                                    Signature will be securely saved with the account.
                                </span>

                            </div>

                            <button type="button"
                                    class="clear-signature"
                                    id="clearSignature">

                                <i class="bi bi-arrow-counterclockwise"></i>

                                Clear

                            </button>

                        </div>

                    </div>

                </div>


                <!-- INFORMATION BOX -->
                <div class="info-box">

                    <i class="bi bi-shield-check"></i>

                    <div>

                        <strong>Account creation</strong>

                        <p>
                            After registration, the system will automatically generate
                            the lecturer's username and password. Login credentials will
                            be sent to the email address provided above.
                        </p>

                    </div>

                </div>

            </div>


            <!-- FORM ACTIONS -->
            <div class="form-actions">

                <a href="/HOD/Index"
                   class="cancel-button">

                    Cancel

                </a>

                <button type="submit"
                        class="submit-button">

                    <i class="bi bi-person-check-fill"></i>

                    Create Lecturer Account

                </button>

            </div>


            <!-- SIGNATURE DATA -->
            <input type="hidden"
                   asp-for="SignatureData"
                   id="signatureData" />

        </form>

    </section>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const governmentIdInput =
            document.getElementById("governmentIdInput");

        const rankInput =
            document.getElementById("rankInput");

        const lecturerTypeInput =
            document.getElementById("lecturerTypeInput");

        const signatureData =
            document.getElementById("signatureData");

        const signaturePlaceholder =
            document.getElementById("signaturePlaceholder");

        const canvas =
            document.getElementById("signaturePad");

        const ctx =
            canvas.getContext("2d");

        let drawing = false;
        let hasSignature = false;


        function resizeCanvas() {

            const rect =
                canvas.getBoundingClientRect();

            const ratio =
                window.devicePixelRatio || 1;

            const existingSignature =
                hasSignature
                    ? canvas.toDataURL("image/png")
                    : null;

            canvas.width =
                rect.width * ratio;

            canvas.height =
                rect.height * ratio;

            ctx.setTransform(
                ratio,
                0,
                0,
                ratio,
                0,
                0
            );

            ctx.lineWidth = 2;
            ctx.lineCap = "round";
            ctx.lineJoin = "round";
            ctx.strokeStyle = "#174c3c";


            if (existingSignature) {

                const image =
                    new Image();

                image.onload =
                    function () {

                        ctx.drawImage(
                            image,
                            0,
                            0,
                            rect.width,
                            rect.height
                        );

                    };

                image.src =
                    existingSignature;
            }
        }


        resizeCanvas();

        window.addEventListener(
            "resize",
            resizeCanvas
        );


        function getPosition(e) {

            const rect =
                canvas.getBoundingClientRect();


            if (
                e.touches &&
                e.touches.length > 0
            ) {

                return {

                    x:
                        e.touches[0].clientX -
                        rect.left,

                    y:
                        e.touches[0].clientY -
                        rect.top

                };

            }


            return {

                x:
                    e.clientX -
                    rect.left,

                y:
                    e.clientY -
                    rect.top

            };
        }


        function startDrawing(e) {

            e.preventDefault();

            drawing = true;
            hasSignature = true;

            signaturePlaceholder.classList.add("hidden");

            const position =
                getPosition(e);

            ctx.beginPath();

            ctx.moveTo(
                position.x,
                position.y
            );
        }


        function draw(e) {

            if (!drawing) {
                return;
            }

            e.preventDefault();

            const position =
                getPosition(e);

            ctx.lineTo(
                position.x,
                position.y
            );

            ctx.stroke();
        }


        function stopDrawing() {

            if (!drawing) {
                return;
            }

            drawing = false;

            signatureData.value =
                canvas.toDataURL("image/png");
        }


        canvas.addEventListener(
            "mousedown",
            startDrawing
        );

        canvas.addEventListener(
            "mousemove",
            draw
        );

        canvas.addEventListener(
            "mouseup",
            stopDrawing
        );

        canvas.addEventListener(
            "mouseleave",
            stopDrawing
        );


        canvas.addEventListener(
            "touchstart",
            startDrawing,
            {
                passive: false
            }
        );

        canvas.addEventListener(
            "touchmove",
            draw,
            {
                passive: false
            }
        );

        canvas.addEventListener(
            "touchend",
            stopDrawing
        );


        document.getElementById(
            "clearSignature"
        ).addEventListener(
            "click",
            function () {

                const rect =
                    canvas.getBoundingClientRect();

                ctx.clearRect(
                    0,
                    0,
                    rect.width,
                    rect.height
                );

                hasSignature = false;

                signatureData.value = "";

                signaturePlaceholder.classList.remove("hidden");

            }
        );


        document.getElementById(
            "registerForm"
        ).addEventListener(
            "submit",
            function (e) {

                if (!hasSignature) {

                    e.preventDefault();

                    alert(
                        "Please provide the lecturer's digital signature."
                    );

                    return;
                }


                if (!governmentIdInput.value.trim()) {

                    e.preventDefault();

                    alert(
                        "Please enter the lecturer's Government ID."
                    );

                    governmentIdInput.focus();

                    return;
                }


                if (!rankInput.value) {

                    e.preventDefault();

                    alert(
                        "Please select the lecturer's academic rank."
                    );

                    rankInput.focus();

                    return;
                }


                if (!lecturerTypeInput.value) {

                    e.preventDefault();

                    alert(
                        "Please select whether this lecturer is part-time or full-time."
                    );

                    lecturerTypeInput.focus();

                    return;
                }


                signatureData.value =
                    canvas.toDataURL("image/png");

            }
        );

    </script>

}