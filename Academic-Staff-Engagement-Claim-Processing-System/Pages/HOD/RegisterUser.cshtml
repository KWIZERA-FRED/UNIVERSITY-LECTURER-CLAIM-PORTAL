@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.RegisterUserModel

@{
    Layout = "~/Pages/Shared/HOD/_HODLayout.cshtml";
    ViewData["Title"] = "Register Lecturers";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/register-user.css"
          asp-append-version="true" />
}

<section class="register-page">

    <header class="page-header">
        <h1>Register Lecturers</h1>
        <p>Create lecturer accounts and capture their registration information and digital signatures.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (Model.RegistrationResults.Count > 0)
    {
        <section class="section-card">

            <header class="section-header">
                <h2>Registration Results</h2>
            </header>

            <div class="results-list">

                @foreach (var result in Model.RegistrationResults)
                {
                    <div class="result-row">
                        <i class="bi bi-dot"></i>
                        <span>@result</span>
                    </div>
                }

            </div>

        </section>
    }

    <form method="post"
          id="registerForm"
          autocomplete="off">

        @Html.AntiForgeryToken()

        <div id="lecturerContainer">

            @for (int i = 0; i < Model.Users.Count; i++)
            {
                <section class="lecturer-card"
                         data-index="@i">

                    <header class="lecturer-card-header">

                        <div class="lecturer-title">
                            <strong>Lecturer @(i + 1)</strong>
                        </div>

                        <button type="button"
                                class="remove-lecturer"
                                onclick="removeLecturer(this)"
                                @(Model.Users.Count == 1 ? "disabled" : null)>

                            <i class="bi bi-trash3"></i>
                            Remove

                        </button>

                    </header>

                    <div class="lecturer-card-body">

                        <div class="form-section">

                            <h3 class="form-section-title">Personal Information</h3>

                            <div class="form-grid">

                                <div class="form-group form-group-full">
                                    <label for="name_@i">Full Name <span>*</span></label>

                                    <input type="text"
                                           id="name_@i"
                                           name="Users[@i].Name"
                                           value="@Model.Users[i].Name"
                                           class="form-control"
                                           placeholder="Enter lecturer's full name"
                                           maxlength="150"
                                           autocomplete="off" />

                                    <span class="field-error"
                                          asp-validation-for="Users[i].Name"></span>
                                </div>

                                <div class="form-group">
                                    <label for="email_@i">Email Address <span>*</span></label>

                                    <input type="email"
                                           id="email_@i"
                                           name="Users[@i].Email"
                                           value="@Model.Users[i].Email"
                                           class="form-control"
                                           placeholder="lecturer@example.com"
                                           maxlength="150"
                                           autocomplete="off" />

                                    <span class="field-error"
                                          asp-validation-for="Users[i].Email"></span>
                                </div>

                                <div class="form-group">
                                    <label for="governmentId_@i">Government ID <span>*</span></label>

                                    <input type="text"
                                           id="governmentId_@i"
                                           name="Users[@i].GovernmentId"
                                           value="@Model.Users[i].GovernmentId"
                                           class="form-control"
                                           placeholder="Enter government ID"
                                           maxlength="100"
                                           autocomplete="off" />

                                    <span class="field-error"
                                          asp-validation-for="Users[i].GovernmentId"></span>
                                </div>

                            </div>

                        </div>

                        <div class="form-divider"></div>

                        <div class="form-section">

                            <h3 class="form-section-title">Academic Information</h3>

                            <div class="form-grid">

                                <div class="form-group">
                                    <label for="lecturerType_@i">Employment Type <span>*</span></label>

                                    <select id="lecturerType_@i"
                                            name="Users[@i].LecturerType"
                                            class="form-control">

                                        @if (Model.Users[i].LecturerType == "PartTimeLecturer")
                                        {
                                            <option value="PartTimeLecturer" selected>Part-Time Lecturer</option>
                                        }
                                        else
                                        {
                                            <option value="PartTimeLecturer">Part-Time Lecturer</option>
                                        }

                                        @if (Model.Users[i].LecturerType == "FullTimeLecturer")
                                        {
                                            <option value="FullTimeLecturer" selected>Full-Time Lecturer</option>
                                        }
                                        else
                                        {
                                            <option value="FullTimeLecturer">Full-Time Lecturer</option>
                                        }

                                    </select>

                                    <span class="field-error"
                                          asp-validation-for="Users[i].LecturerType"></span>
                                </div>

                                <div class="form-group">
                                    <label for="rank_@i">Academic Rank <span>*</span></label>

                                    <select id="rank_@i"
                                            name="Users[@i].Rank"
                                            class="form-control">

                                        <option value="">Select academic rank</option>

                                        <option value="TutorialAssistant"
                                                selected="@(Model.Users[i].Rank == "TutorialAssistant")">
                                            Tutorial Assistant
                                        </option>

                                        <option value="AssistantLecturer"
                                                selected="@(Model.Users[i].Rank == "AssistantLecturer")">
                                            Assistant Lecturer
                                        </option>

                                        <option value="LecturerWithMasters"
                                                selected="@(Model.Users[i].Rank == "LecturerWithMasters")">
                                            Lecturer With Masters
                                        </option>

                                        <option value="LecturerWithPhD"
                                                selected="@(Model.Users[i].Rank == "LecturerWithPhD")">
                                            Lecturer With PhD
                                        </option>

                                        <option value="SeniorLecturer"
                                                selected="@(Model.Users[i].Rank == "SeniorLecturer")">
                                            Senior Lecturer
                                        </option>

                                        <option value="AssistantProfessor"
                                                selected="@(Model.Users[i].Rank == "AssistantProfessor")">
                                            Assistant Professor
                                        </option>

                                        <option value="Professor"
                                                selected="@(Model.Users[i].Rank == "Professor")">
                                            Professor
                                        </option>

                                    </select>

                                    <span class="field-error"
                                          asp-validation-for="Users[i].Rank"></span>
                                </div>

                            </div>

                        </div>

                        <div class="form-divider"></div>

                        <div class="form-section">

                            <h3 class="form-section-title">Digital Signature</h3>

                            <div class="signature-area">

                                <div class="signature-wrapper">

                                    <canvas class="signature-pad"
                                            width="900"
                                            height="220"></canvas>

                                    <div class="signature-line"></div>

                                    <div class="signature-label">Digital Signature</div>

                                </div>

                                <input type="hidden"
                                       name="Users[@i].SignatureData"
                                       class="signatureData"
                                       value="@Model.Users[i].SignatureData" />

                                <div class="signature-actions">

                                    <button type="button"
                                            class="secondary-button clear-signature"
                                            onclick="clearSignature(this)">

                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        Clear Signature

                                    </button>

                                </div>

                                <span class="field-error signature-error"
                                      asp-validation-for="Users[i].SignatureData"></span>

                            </div>

                        </div>

                    </div>

                </section>
            }

        </div>

        <button type="button"
                id="addLecturerButton"
                class="add-lecturer-button">

            <i class="bi bi-plus-lg"></i>
            Add Another Lecturer

        </button>

        <footer class="form-actions">

            <button type="submit"
                    id="registerButton"
                    class="primary-button register-submit-button">

                <span class="button-text">
                    <i class="bi bi-person-plus"></i>
                    Register Lecturers
                </span>

                <span class="button-loading">
                    <span class="loading-spinner"></span>
                    Registering...
                </span>

            </button>

        </footer>

    </form>

</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            document
                .querySelectorAll(".lecturer-card")
                .forEach(function (card) {
                    initializeSignatureCard(card);
                });

            document
                .getElementById("addLecturerButton")
                .addEventListener("click", addLecturer);

            document
                .getElementById("registerForm")
                .addEventListener("submit", function (event) {

                    rebuildLecturerIndexes();

                    let valid = true;

                    document
                        .querySelectorAll(".lecturer-card")
                        .forEach(function (card) {

                            const signatureInput = card.querySelector(".signatureData");

                            if (!signatureInput.value) {

                                valid = false;

                                const error = card.querySelector(".signature-error");

                                if (error) {
                                    error.textContent = "Digital signature is required.";
                                }
                            }
                        });

                    if (!valid) {

                        event.preventDefault();

                        const firstError = document.querySelector(".signature-error");

                        if (firstError) {
                            firstError.scrollIntoView({ behavior: "smooth", block: "center" });
                        }

                        return;
                    }

                    const button = document.getElementById("registerButton");

                    button.disabled = true;

                    button.querySelector(".button-text").style.display = "none";
                    button.querySelector(".button-loading").style.display = "inline-flex";

                });

        });

        function addLecturer() {

            const container = document.getElementById("lecturerContainer");
            const index = container.querySelectorAll(".lecturer-card").length;

            const card = document.createElement("div");
            card.className = "lecturer-card";
            card.dataset.index = index;

            card.innerHTML = `
                <header class="lecturer-card-header">
                    <div class="lecturer-title">
                        <strong>Lecturer ${index + 1}</strong>
                    </div>
                    <button type="button"
                            class="remove-lecturer"
                            onclick="removeLecturer(this)">
                        <i class="bi bi-trash3"></i>
                        Remove
                    </button>
                </header>

                <div class="lecturer-card-body">

                    <div class="form-section">
                        <h3 class="form-section-title">Personal Information</h3>

                        <div class="form-grid">
                            <div class="form-group form-group-full">
                                <label>Full Name <span>*</span></label>
                                <input type="text"
                                       name="Users[${index}].Name"
                                       class="form-control"
                                       placeholder="Enter lecturer's full name"
                                       maxlength="150"
                                       autocomplete="off" />
                                <span class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label>Email Address <span>*</span></label>
                                <input type="email"
                                       name="Users[${index}].Email"
                                       class="form-control"
                                       placeholder="lecturer@example.com"
                                       maxlength="150"
                                       autocomplete="off" />
                                <span class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label>Government ID <span>*</span></label>
                                <input type="text"
                                       name="Users[${index}].GovernmentId"
                                       class="form-control"
                                       placeholder="Enter government ID"
                                       maxlength="100"
                                       autocomplete="off" />
                                <span class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-divider"></div>

                    <div class="form-section">
                        <h3 class="form-section-title">Academic Information</h3>

                        <div class="form-grid">
                            <div class="form-group">
                                <label>Employment Type <span>*</span></label>
                                <select name="Users[${index}].LecturerType" class="form-control">
                                    <option value="PartTimeLecturer">Part-Time Lecturer</option>
                                    <option value="FullTimeLecturer">Full-Time Lecturer</option>
                                </select>
                                <span class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label>Academic Rank <span>*</span></label>
                                <select name="Users[${index}].Rank" class="form-control">
                                    <option value="">Select academic rank</option>
                                    <option value="TutorialAssistant">Tutorial Assistant</option>
                                    <option value="AssistantLecturer">Assistant Lecturer</option>
                                    <option value="LecturerWithMasters">Lecturer With Masters</option>
                                    <option value="LecturerWithPhD">Lecturer With PhD</option>
                                    <option value="SeniorLecturer">Senior Lecturer</option>
                                    <option value="AssistantProfessor">Assistant Professor</option>
                                    <option value="Professor">Professor</option>
                                </select>
                                <span class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-divider"></div>

                    <div class="form-section">
                        <h3 class="form-section-title">Digital Signature</h3>

                        <div class="signature-area">
                            <div class="signature-wrapper">
                                <canvas class="signature-pad" width="900" height="220"></canvas>
                                <div class="signature-line"></div>
                                <div class="signature-label">Digital Signature</div>
                            </div>

                            <input type="hidden"
                                   name="Users[${index}].SignatureData"
                                   class="signatureData" />

                            <div class="signature-actions">
                                <button type="button"
                                        class="secondary-button clear-signature"
                                        onclick="clearSignature(this)">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    Clear Signature
                                </button>
                            </div>

                            <span class="field-error signature-error"></span>
                        </div>
                    </div>

                </div>
            `;

            container.appendChild(card);

            initializeSignatureCard(card);
            rebuildLecturerIndexes();

            card.scrollIntoView({ behavior: "smooth", block: "start" });

        }

        function removeLecturer(button) {

            const cards = document.querySelectorAll(".lecturer-card");

            if (cards.length <= 1) return;

            const card = button.closest(".lecturer-card");

            if (!card) return;

            card.remove();

            rebuildLecturerIndexes();

        }

        function rebuildLecturerIndexes() {

            const cards = document.querySelectorAll(".lecturer-card");

            cards.forEach(function (card, index) {

                card.dataset.index = index;

                const heading = card.querySelector(".lecturer-title strong");

                if (heading) {
                    heading.textContent = `Lecturer ${index + 1}`;
                }

                card.querySelectorAll("[name]").forEach(function (element) {

                    const name = element.getAttribute("name");

                    if (!name) return;

                    element.setAttribute(
                        "name",
                        name.replace(/Users\[\d+\]/, `Users[${index}]`)
                    );

                });

            });

            document
                .querySelectorAll(".remove-lecturer")
                .forEach(function (button) {
                    button.disabled = cards.length <= 1;
                });

        }

        function initializeSignatureCard(card) {

            const canvas = card.querySelector(".signature-pad");
            const signatureInput = card.querySelector(".signatureData");

            if (!canvas || !signatureInput) return;

            const context = canvas.getContext("2d");

            let drawing = false;

            function resizeCanvas() {

                const rect = canvas.getBoundingClientRect();
                const ratio = Math.max(window.devicePixelRatio || 1, 1);
                const existingSignature = signatureInput.value;

                canvas.width = rect.width * ratio;
                canvas.height = 220 * ratio;
                canvas.style.height = "220px";

                context.setTransform(ratio, 0, 0, ratio, 0, 0);
                context.lineWidth = 2.2;
                context.lineCap = "round";
                context.lineJoin = "round";

                if (existingSignature) {

                    const image = new Image();

                    image.onload = function () {
                        context.drawImage(image, 0, 0, rect.width, 220);
                    };

                    image.src = existingSignature;

                }

            }

            resizeCanvas();

            function getPosition(event) {

                const rect = canvas.getBoundingClientRect();

                if (event.touches && event.touches.length > 0) {
                    return {
                        x: event.touches[0].clientX - rect.left,
                        y: event.touches[0].clientY - rect.top
                    };
                }

                return {
                    x: event.clientX - rect.left,
                    y: event.clientY - rect.top
                };

            }

            function startDrawing(event) {

                event.preventDefault();

                drawing = true;

                const position = getPosition(event);

                context.beginPath();
                context.moveTo(position.x, position.y);

            }

            function draw(event) {

                if (!drawing) return;

                event.preventDefault();

                const position = getPosition(event);

                context.lineTo(position.x, position.y);
                context.stroke();

            }

            function stopDrawing(event) {

                if (!drawing) return;

                if (event) event.preventDefault();

                drawing = false;

                context.closePath();

                signatureInput.value = canvas.toDataURL("image/png");

                const error = card.querySelector(".signature-error");

                if (error) error.textContent = "";

            }

            canvas.addEventListener("mousedown", startDrawing);
            canvas.addEventListener("mousemove", draw);
            canvas.addEventListener("mouseup", stopDrawing);
            canvas.addEventListener("mouseleave", stopDrawing);

            canvas.addEventListener("touchstart", startDrawing, { passive: false });
            canvas.addEventListener("touchmove", draw, { passive: false });
            canvas.addEventListener("touchend", stopDrawing, { passive: false });

        }

        function clearSignature(button) {

            const card = button.closest(".lecturer-card");

            if (!card) return;

            const canvas = card.querySelector(".signature-pad");
            const signatureInput = card.querySelector(".signatureData");

            if (!canvas || !signatureInput) return;

            const context = canvas.getContext("2d");

            context.clearRect(0, 0, canvas.width, canvas.height);

            signatureInput.value = "";

            const error = card.querySelector(".signature-error");

            if (error) error.textContent = "";

        }

    </script>

}