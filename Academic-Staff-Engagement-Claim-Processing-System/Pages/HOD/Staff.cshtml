@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.StaffModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    ViewData["Title"] = "Lecturer Management";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/staff.css"
          asp-append-version="true" />
}

<section class="staff-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>Lecturer Management</h1>
            <p>Manage departmental lecturers, course assignments and account status.</p>
        </div>

        <a href="/HOD/RegisterUser" class="primary-button">
            <i class="bi bi-person-plus-fill"></i>
            Register Lecturer
        </a>

    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <section class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon stat-icon-blue">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-value">@Model.Lecturers.Count</div>
            <span class="stat-label">Total Lecturers</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-green">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div class="stat-value">@Model.Lecturers.Count(x => x.IsActive)</div>
            <span class="stat-label">Active Lecturers</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-journal-bookmark-fill"></i>
            </div>
            <div class="stat-value">@Model.Lecturers.Sum(x => x.ActiveAssignmentCount)</div>
            <span class="stat-label">Active Assignments</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-orange">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-value">
                @Model.Lecturers.Sum(x => x.Assignments.Count(a => !a.IsApproved && a.IsActive))
            </div>
            <span class="stat-label">Awaiting Approval</span>
        </div>

    </section>

    <section class="section-card">

        <header class="section-header">
            <h2>Academic Staff</h2>
        </header>

        <div class="toolbar">

            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="search"
                       id="staffSearch"
                       placeholder="Search lecturer, ID, email, rank or course…"
                       autocomplete="off" />
            </div>

        </div>

        <div class="table-wrapper">

            <table class="data-table" id="staffTable">

                <thead>
                    <tr>
                        <th>Lecturer</th>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Rank</th>
                        <th>Courses</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Lecturers.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <p>No lecturers found in your department.</p>
                                    <a href="/HOD/RegisterUser" class="primary-button">
                                        <i class="bi bi-person-plus-fill"></i>
                                        Register Lecturer
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lecturer in Model.Lecturers)
                        {
                            <tr class="staff-row"
                                data-lecturer-id="@lecturer.Id"
                                data-search="@lecturer.UserName @lecturer.Email @lecturer.Id @lecturer.Type @lecturer.Rank @string.Join(" ", lecturer.Assignments.Select(a => a.CourseCode)) @string.Join(" ", lecturer.Assignments.Select(a => a.CourseTitle))">

                                <td>
                                    <div class="lecturer-cell">
                                        <strong>@lecturer.UserName</strong>
                                        <span>@lecturer.Email</span>
                                    </div>
                                </td>

                                <td>L-@lecturer.Id</td>

                                <td>@lecturer.Type</td>

                                <td>
                                    @if (lecturer.Rank.HasValue)
                                    {
                                        @lecturer.Rank.Value
                                    }
                                    else
                                    {
                                        <span class="muted-text">—</span>
                                    }
                                </td>

                                <td>
                                    @if (lecturer.Assignments.Any())
                                    {
                                        <button type="button"
                                                class="row-action"
                                                data-lecturer-id="@lecturer.Id"
                                                onclick="openCoursesModal('@lecturer.Id')">

                                            @lecturer.Assignments.Count
                                            @(lecturer.Assignments.Count == 1 ? "course" : "courses")

                                            <i class="bi bi-chevron-right"></i>

                                        </button>
                                    }
                                    else
                                    {
                                        <span class="muted-text">None</span>
                                    }
                                </td>

                                <td>
                                    @if (lecturer.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-neutral">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <a href="/HOD/View?id=@lecturer.Id"
                                           class="icon-button"
                                           title="View lecturer">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a href="/HOD/Edit?id=@lecturer.Id"
                                           class="icon-button"
                                           title="Edit lecturer">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        @if (lecturer.IsActive)
                                        {
                                            <form method="post"
                                                  asp-page-handler="Deactivate"
                                                  class="inline-form"
                                                  onsubmit="return confirmDeactivate('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lecturer.UserName ?? "this lecturer"))');">

                                                <input type="hidden" name="id" value="@lecturer.Id" />

                                                <button type="submit"
                                                        class="icon-button danger"
                                                        title="Deactivate lecturer">

                                                    <i class="bi bi-person-dash"></i>

                                                </button>

                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </section>

    <!-- ============================================================
         Courses overlay — one modal per lecturer, hidden by default.
         Data is rendered server-side; JS only toggles visibility.
         ============================================================ -->

    @foreach (var lecturer in Model.Lecturers.Where(l => l.Assignments.Any()))
    {
        <div class="modal-overlay"
             id="coursesModal-@lecturer.Id"
             onclick="closeModalOnOverlay(event, 'coursesModal-@lecturer.Id')">

            <div class="modal-card modal-card-wide"
                 onclick="event.stopPropagation()">

                <header class="modal-header">

                    <div class="modal-heading">
                        <h2>Assigned Courses</h2>
                        <p>@lecturer.UserName · @lecturer.Assignments.Count @(lecturer.Assignments.Count == 1 ? "course" : "courses")</p>
                    </div>

                    <button type="button"
                            class="modal-close"
                            onclick="closeModal('coursesModal-@lecturer.Id')">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </header>

                <div class="modal-body modal-body-flush">

                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Academic Year</th>
                                    <th>Semester</th>
                                    <th>Hours</th>
                                    <th>Approval</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assignment in lecturer.Assignments)
                                {
                                    <tr>
                                        <td>
                                            <div class="course-cell">
                                                <span class="course-code">@assignment.CourseCode</span>
                                                <span>@assignment.CourseTitle</span>
                                            </div>
                                        </td>

                                        <td>@assignment.AcademicYear</td>
                                        <td>@assignment.Semester</td>
                                        <td>@assignment.AllocatedHours.ToString("0.##")</td>

                                        <td>
                                            @if (assignment.IsApproved)
                                            {
                                                <span class="status-badge status-active">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-pending">Pending</span>
                                            }
                                        </td>

                                        <td>
                                            @if (assignment.IsActive)
                                            {
                                                <span class="status-badge status-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-neutral">Inactive</span>
                                            }
                                        </td>

                                        <td>
                                            <div class="action-buttons">

                                                <button type="button"
                                                        class="icon-button"
                                                        title="Edit assignment"
                                                        onclick="openEditModal(
                                                            '@assignment.Id',
                                                            '@assignment.LecturerId',
                                                            '@assignment.CourseId',
                                                            '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(assignment.AcademicYear ?? string.Empty))',
                                                            '@assignment.Semester',
                                                            '@assignment.AllocatedHours'
                                                        )">

                                                    <i class="bi bi-pencil"></i>

                                                </button>

                                                @if (assignment.IsActive)
                                                {
                                                    <form method="post"
                                                          asp-page-handler="RemoveAssignment"
                                                          class="inline-form"
                                                          onsubmit="return confirmRemoveAssignment('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(assignment.CourseCode ?? "this course"))');">

                                                        <input type="hidden"
                                                               name="assignmentId"
                                                               value="@assignment.Id" />

                                                        <button type="submit"
                                                                class="icon-button danger"
                                                                title="Remove assignment">

                                                            <i class="bi bi-trash3"></i>

                                                        </button>

                                                    </form>
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>

                <footer class="modal-footer">
                    <a href="/HOD/AssignCourse" class="secondary-button">
                        <i class="bi bi-plus-lg"></i>
                        Assign Course
                    </a>
                    <button type="button"
                            class="primary-button"
                            onclick="closeModal('coursesModal-@lecturer.Id')">
                        Close
                    </button>
                </footer>

            </div>

        </div>
    }

    <!-- ============================================================
         Edit Assignment modal
         ============================================================ -->

    <div class="modal-overlay"
         id="editAssignmentModal"
         onclick="closeModalOnOverlay(event, 'editAssignmentModal')">

        <div class="modal-card"
             onclick="event.stopPropagation()">

            <header class="modal-header">

                <div class="modal-heading">
                    <h2>Update Course Assignment</h2>
                    <p>Changing the course, period, or hours resets approval.</p>
                </div>

                <button type="button"
                        class="modal-close"
                        onclick="closeModal('editAssignmentModal')">

                    <i class="bi bi-x-lg"></i>

                </button>

            </header>

            <form method="post"
                  asp-page-handler="UpdateAssignment"
                  id="editAssignmentForm">

                <input type="hidden" id="editAssignmentId" name="AssignmentId" />
                <input type="hidden" id="editLecturerId" name="LecturerId" />

                <div class="modal-body">

                    <div class="form-group">
                        <label for="editCourseId">Course</label>
                        <select id="editCourseId" name="CourseId" required>
                            <option value="">Select course</option>
                            @foreach (var course in Model.CourseOptions)
                            {
                                <option value="@course.Id">
                                    @course.Code — @course.Title
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-grid">

                        <div class="form-group">
                            <label for="editAcademicYear">Academic Year</label>
                            <input type="text"
                                   id="editAcademicYear"
                                   name="AcademicYear"
                                   maxlength="20"
                                   placeholder="e.g. 2026/2027"
                                   required />
                        </div>

                        <div class="form-group">
                            <label for="editSemester">Semester</label>
                            <select id="editSemester" name="Semester" required>
                                @foreach (var semester in Enum.GetValues<Semester>())
                                {
                                    <option value="@semester">@semester</option>
                                }
                            </select>
                        </div>

                    </div>

                    <div class="form-group">
                        <label for="editAllocatedHours">Allocated Teaching Hours</label>
                        <input type="number"
                               id="editAllocatedHours"
                               name="AllocatedHours"
                               min="0"
                               max="500"
                               step="0.01"
                               required />
                    </div>

                </div>

                <footer class="modal-footer">

                    <button type="button"
                            class="secondary-button"
                            onclick="closeModal('editAssignmentModal')">
                        Cancel
                    </button>

                    <button type="submit" class="primary-button">
                        Save Changes
                    </button>

                </footer>

            </form>

        </div>

    </div>

</section>

@section Scripts {

<script>

    /* ============================================================
       Modal helpers — one function to open/close ANY overlay
       ============================================================ */

    function openModal(id) {

        const modal = document.getElementById(id);

        if (!modal) return;

        modal.classList.add("show");
        document.body.classList.add("modal-open");

    }

    function closeModal(id) {

        const modal = document.getElementById(id);

        if (!modal) return;

        modal.classList.remove("show");

        /* Only release the scroll lock if no other modal is open */
        if (!document.querySelector(".modal-overlay.show")) {
            document.body.classList.remove("modal-open");
        }

    }

    function closeModalOnOverlay(event, id) {

        if (event.target && event.target.id === id) {
            closeModal(id);
        }

    }

    function openCoursesModal(lecturerId) {
        openModal("coursesModal-" + lecturerId);
    }


    /* ============================================================
       Edit assignment modal
       ============================================================ */

    function openEditModal(
        assignmentId,
        lecturerId,
        courseId,
        academicYear,
        semester,
        allocatedHours
    ) {

        const fields = {
            editAssignmentId: assignmentId ?? "",
            editLecturerId: lecturerId ?? "",
            editCourseId: courseId ?? "",
            editAcademicYear: academicYear ?? "",
            editSemester: semester ?? "",
            editAllocatedHours: allocatedHours ?? ""
        };

        for (const [id, value] of Object.entries(fields)) {
            const el = document.getElementById(id);
            if (el) el.value = value;
        }

        openModal("editAssignmentModal");

    }


    /* ============================================================
       Confirm helpers
       ============================================================ */

    function confirmRemoveAssignment(courseCode) {

        return confirm(
            "Remove the assignment for " + courseCode + "?\n\n" +
            "The assignment will be deactivated rather than permanently deleted."
        );

    }

    function confirmDeactivate(lecturerName) {

        return confirm(
            "Deactivate the lecturer account for " + lecturerName + "?\n\n" +
            "The account will no longer be active."
        );

    }


    /* ============================================================
       Escape closes any open modal
       ============================================================ */

    document.addEventListener("keydown", function (event) {

        if (event.key !== "Escape") return;

        document
            .querySelectorAll(".modal-overlay.show")
            .forEach(function (modal) {
                modal.classList.remove("show");
            });

        document.body.classList.remove("modal-open");

    });


    /* ============================================================
       Live search
       ============================================================ */

    const searchInput = document.getElementById("staffSearch");

    if (searchInput) {

        searchInput.addEventListener("input", function () {

            const searchTerm = this.value.toLowerCase().trim();

            document.querySelectorAll(".staff-row").forEach(function (row) {

                const matches =
                    (row.dataset.search || "").toLowerCase().includes(searchTerm);

                row.style.display = matches ? "" : "none";

            });

        });

    }

</script>

}