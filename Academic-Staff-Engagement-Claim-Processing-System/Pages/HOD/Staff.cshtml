@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.StaffModel

@{
    ViewData["Title"] = "Lecturer Management";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Lecturer Management · UNILAK Portal</title>

    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            /* =========================================================
                       RESET
                    ========================================================= */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: "Plus Jakarta Sans", "Poppins", sans-serif;
                background: #f8fafc;
                color: #1e293b;
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
            }

            a {
                text-decoration: none;
            }


            /* =========================================================
                       VARIABLES
                    ========================================================= */

            :root {
                --navy: #0f172a;
                --navy-light: #1e293b;
                --green: #059669;
                --green-dark: #047857;
                --green-light: #ecfdf5;
                --background: #f8fafc;
                --white: #ffffff;
                --border: #e2e8f0;
                --text: #1e293b;
                --muted: #64748b;
                --danger: #dc2626;
                --danger-light: #fef2f2;
                --shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
            }


            /* =========================================================
                       APP
                    ========================================================= */

            .app {
                min-height: 100vh;
                background: var(--background);
            }


            /* =========================================================
                       TRANSPARENT / GLASS HEADER
                    ========================================================= */

            .navbar {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 80px;
                z-index: 1000;
                background: rgba(10, 25, 47, 0.75);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .navbar-container {
                max-width: 1280px;
                height: 100%;
                margin: 0 auto;
                padding: 0 32px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .navbar-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .navbar-logo {
                width: 48px;
                height: 48px;
                object-fit: contain;
                filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
                transition: transform 0.3s ease;
            }

            .logo-link:hover .navbar-logo {
                transform: scale(1.05);
            }

            .navbar-brand {
                color: #ffffff;
                font-size: 20px;
                font-weight: 700;
                letter-spacing: -0.3px;
            }

                .navbar-brand span {
                    color: #64748b;
                    font-weight: 400;
                }

            .user-area {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .role-badge {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 8px 14px;
                color: #cbd5e1;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 100px;
                font-size: 13px;
                font-weight: 500;
            }

                .role-badge i {
                    color: #34d399;
                }

            .logout {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 9px 17px;
                color: #ffffff;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.2);
                border-radius: 8px;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.2s ease;
            }

                .logout:hover {
                    background: #ffffff;
                    color: #0f172a;
                }


            /* =========================================================
                       BODY
                    ========================================================= */

            .app-body {
                display: flex;
                min-height: 100vh;
                padding-top: 80px;
            }


            /* =========================================================
                       SIDEBAR
                    ========================================================= */

            .sidebar {
                width: 240px;
                flex-shrink: 0;
                min-height: calc(100vh - 80px);
                background: #ffffff;
                border-right: 1px solid var(--border);
                padding: 28px 0;
            }

            .sidebar-title {
                padding: 0 24px 12px;
                color: var(--muted);
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.5px;
            }

            .sidebar-menu {
                display: flex;
                flex-direction: column;
            }

            .sidebar-link {
                position: relative;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 24px;
                color: #64748b;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .sidebar-link i {
                    width: 20px;
                    font-size: 17px;
                }

                .sidebar-link:hover {
                    color: var(--green);
                    background: #f8fafc;
                }

                .sidebar-link.active {
                    color: var(--green);
                    background: var(--green-light);
                    font-weight: 600;
                }

                    .sidebar-link.active::before {
                        content: "";
                        position: absolute;
                        left: 0;
                        top: 0;
                        bottom: 0;
                        width: 3px;
                        background: var(--green);
                        border-radius: 0 4px 4px 0;
                    }


            /* =========================================================
                       MAIN
                    ========================================================= */

            .main {
                flex: 1;
                min-width: 0;
                padding: 42px;
            }

            .page-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 30px;
            }

            .page-label {
                display: inline-block;
                margin-bottom: 8px;
                color: var(--green);
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
            }

            .page-header h1 {
                color: #0f172a;
                font-size: 32px;
                font-weight: 700;
                letter-spacing: -0.8px;
            }

            .page-header p {
                margin-top: 6px;
                color: var(--muted);
                font-size: 14px;
            }


            /* =========================================================
                       CONTENT CARD
                    ========================================================= */

            .content-card {
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: 16px;
                box-shadow: var(--shadow);
                overflow: hidden;
            }


            /* =========================================================
                       CARD HEADER
                    ========================================================= */

            .card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 22px 24px;
                border-bottom: 1px solid var(--border);
            }

            .card-title {
                display: flex;
                align-items: center;
                gap: 11px;
            }

            .card-title-icon {
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                color: var(--green);
                background: var(--green-light);
                font-size: 18px;
            }

            .card-title h2 {
                color: #0f172a;
                font-size: 17px;
                font-weight: 700;
            }

            .card-title p {
                color: var(--muted);
                font-size: 12px;
            }


            /* =========================================================
                       SEARCH
                    ========================================================= */

            .search-area {
                padding: 20px 24px;
                background: #ffffff;
                border-bottom: 1px solid var(--border);
            }

            .search-wrapper {
                position: relative;
                max-width: 500px;
            }

                .search-wrapper i {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--muted);
                    font-size: 15px;
                }

            .search-input {
                width: 100%;
                padding: 12px 16px 12px 42px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: #ffffff;
                color: var(--text);
                font-family: inherit;
                font-size: 13px;
                transition: all 0.2s ease;
            }

                .search-input::placeholder {
                    color: #94a3b8;
                }

                .search-input:focus {
                    outline: none;
                    border-color: var(--green);
                    box-shadow: 0 0 0 3px rgba(5,150,105,0.08);
                }


            /* =========================================================
                       TABLE
                    ========================================================= */

            .table-container {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

            thead {
                background: #f8fafc;
            }

            th {
                padding: 14px 18px;
                color: #64748b;
                font-size: 11px;
                font-weight: 700;
                text-align: left;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
            }

            td {
                padding: 16px 18px;
                color: #475569;
                border-bottom: 1px solid #eef2f7;
                vertical-align: middle;
            }

            tbody tr {
                transition: background 0.15s ease;
            }

                tbody tr:hover {
                    background: #f8fafc;
                }

                tbody tr:last-child td {
                    border-bottom: none;
                }


            /* =========================================================
                       LECTURER
                    ========================================================= */

            .lecturer-name {
                display: flex;
                align-items: center;
                gap: 11px;
            }

            .lecturer-avatar {
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border-radius: 50%;
                color: var(--green);
                background: var(--green-light);
                font-size: 13px;
                font-weight: 700;
            }

            .lecturer-info strong {
                display: block;
                color: #0f172a;
                font-size: 13px;
                font-weight: 600;
            }

            .lecturer-info span {
                display: block;
                margin-top: 2px;
                color: var(--muted);
                font-size: 11px;
            }


            /* =========================================================
                       RANK
                    ========================================================= */

            .rank-badge {
                display: inline-block;
                padding: 5px 10px;
                color: #047857;
                background: #ecfdf5;
                border-radius: 100px;
                font-size: 11px;
                font-weight: 600;
            }


            /* =========================================================
                       ACTIONS
                    ========================================================= */

            .actions {
                display: flex;
                align-items: center;
                gap: 7px;
            }

            .action-btn {
                width: 34px;
                height: 34px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: #ffffff;
                color: #64748b;
                font-size: 14px;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .action-btn:hover {
                    color: var(--green);
                    border-color: #a7f3d0;
                    background: var(--green-light);
                }

                .action-btn.delete:hover {
                    color: var(--danger);
                    border-color: #fecaca;
                    background: var(--danger-light);
                }


            /* =========================================================
                       EMPTY STATE
                    ========================================================= */

            .empty-state {
                padding: 60px 20px;
                text-align: center;
                color: var(--muted);
            }

                .empty-state i {
                    display: block;
                    margin-bottom: 12px;
                    color: #cbd5e1;
                    font-size: 42px;
                }

                .empty-state strong {
                    display: block;
                    color: #475569;
                    font-size: 15px;
                    margin-bottom: 4px;
                }

                .empty-state span {
                    font-size: 13px;
                }


            /* =========================================================
                       RESPONSIVE
                    ========================================================= */

            @@media (max-width: 900px) {

                .sidebar {
                    width: 210px;
                }

                .main {
                    padding: 28px;
                }

                .role-badge {
                    display: none;
                }
            }

            @@media (max-width: 700px) {

                .navbar-container {
                    padding: 0 18px;
                }

                .navbar-brand {
                    font-size: 17px;
                }

                .navbar-logo {
                    width: 40px;
                    height: 40px;
                }

                .app-body {
                    flex-direction: column;
                }

                .sidebar {
                    width: 100%;
                    min-height: auto;
                    border-right: none;
                    border-bottom: 1px solid var(--border);
                    padding: 12px 0;
                }

                .sidebar-title {
                    display: none;
                }

                .sidebar-menu {
                    flex-direction: row;
                    overflow-x: auto;
                }

                .sidebar-link {
                    white-space: nowrap;
                    padding: 10px 16px;
                }

                    .sidebar-link.active::before {
                        left: 0;
                        right: 0;
                        top: auto;
                        bottom: 0;
                        width: 100%;
                        height: 3px;
                    }

                .main {
                    padding: 24px 16px;
                }

                .page-header h1 {
                    font-size: 26px;
                }

                .card-header {
                    align-items: flex-start;
                }

                .actions {
                    gap: 4px;
                }

                .action-btn {
                    width: 32px;
                    height: 32px;
                }
            }

    </style>

</head>


<body>

    <div class="app">

        <!-- =====================================================
         HEADER
    ====================================================== -->

        <nav class="navbar">

            <div class="navbar-container">

