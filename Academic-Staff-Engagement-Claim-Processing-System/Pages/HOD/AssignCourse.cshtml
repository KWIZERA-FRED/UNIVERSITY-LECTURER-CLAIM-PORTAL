@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.AssignCourseModel

@using System.Text.Json

@{
    Layout = "~/Pages/Shared/HOD/_HODLayout.cshtml";
    ViewData["Title"] = "Assign Course";

    var lecturerInformation = Model.Lecturers.ToDictionary(
        lecturer => lecturer.Id.ToString(),
        lecturer => new
        {
            Rank = lecturer.Rank?.ToString() ?? "Not specified",
            GovernmentId = "Protected"
        });
}

<link rel="stylesheet"
      href="~/css/HOD/assign-course.css"
      asp-append-version="true" />


<div class="assign-course-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="page-header">

        <div class="page-heading">

            <div class="page-icon">
                <i class="bi bi-journal-plus"></i>
            </div>

            <div>

                <h1>
                    Assign Course
                </h1>

                <p>
                    Assign a course to a lecturer and generate their academic engagement contract.
                </p>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ERROR MESSAGE
    ========================================================== -->

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-message">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                @Model.ErrorMessage
            </span>

        </div>
    }


    <!-- =========================================================
         ASSIGNMENT CARD
    ========================================================== -->

    <section class="assignment-card">

        <!-- CARD HEADER -->

        <div class="card-header">

            <div>

                <h2>
                    Course Assignment Details
                </h2>

                <p>
                    Select the lecturer, course, academic period and workload details.
                </p>

            </div>

        </div>


        <!-- FORM -->

        <form method="post">

            @Html.AntiForgeryToken()


            <div class="form-grid">


                <!-- =================================================
                     COURSE
                ================================================== -->

                <div class="form-group">

                    <label for="courseSelect">
                        Course
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-journal-bookmark"></i>

                        <select asp-for="SelectedCourse"
                                id="courseSelect"
                                class="form-select"
                                required>

                            <option value="">
                                Select course
                            </option>

                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.Id">
                                    @course.Code - @course.Title
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <!-- =================================================
                     LECTURER
                ================================================== -->

                <div class="form-group">

                    <label for="lecturerSelect">
                        Lecturer
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-person"></i>

                        <select asp-for="SelectedLecturer"
                                id="lecturerSelect"
                                class="form-select"
                                required>

                            <option value="">
                                Select lecturer
                            </option>

                            @foreach (var lecturer in Model.Lecturers)
                            {
                                <option value="@lecturer.Id">
                                    @lecturer.UserName
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <!-- =================================================
                     LECTURER RANK
                ================================================== -->

                <div class="form-group">

                    <label for="rank">
                        Lecturer Rank
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-mortarboard"></i>

                        <input id="rank"
                               class="form-control readonly"
                               readonly
                               placeholder="Automatically displayed" />

                    </div>

                </div>


                <!-- =================================================
                     GOVERNMENT ID
                ================================================== -->

                <div class="form-group">

                    <label for="governmentId">
                        Government ID
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-card-text"></i>

                        <input id="governmentId"
                               class="form-control readonly"
                               readonly
                               value="Protected"
                               placeholder="Protected" />

                    </div>

                    <span class="field-help">
                        Government ID is protected and encrypted in the database.
                    </span>

                </div>


                <!-- =================================================
                     SEMESTER
                ================================================== -->

                <div class="form-group">

                    <label for="semester">
                        Semester
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-calendar3"></i>

                        <select asp-for="Semester"
                                id="semester"
                                class="form-select"
                                required>

                            <option value="">
                                Select semester
                            </option>

                            <option value="1">
                                Semester One
                            </option>

                            <option value="2">
                                Semester Two
                            </option>

                            <option value="3">
                                Summer Semester
                            </option>

                        </select>

                    </div>

                </div>


                <!-- =================================================
                     SESSION
                ================================================== -->

                <div class="form-group">

                    <label for="session">
                        Session
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-clock"></i>

                        <select asp-for="Session"
                                id="session"
                                class="form-select"
                                required>

                            <option value="">
                                Select session
                            </option>

                            <option value="1">
                                Day
                            </option>

                            <option value="2">
                                Evening
                            </option>

                        </select>

                    </div>

                </div>


                <!-- =================================================
                     ACADEMIC YEAR
                ================================================== -->

                <div class="form-group">

                    <label for="academicYear">
                        Academic Year
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-calendar-range"></i>

                        <select asp-for="AcademicYear"
                                id="academicYear"
                                class="form-select"
                                required>

                            <option value="">
                                Select academic year
                            </option>

                            <option value="2025/2026">
                                2025/2026
                            </option>

                            <option value="2026/2027">
                                2026/2027
                            </option>

                            <option value="2027/2028">
                                2027/2028
                            </option>

                            <option value="2028/2029">
                                2028/2029
                            </option>

                        </select>

                    </div>

                </div>


                <!-- =================================================
                     CAMPUS
                ================================================== -->

                <div class="form-group">

                    <label for="campus">
                        Campus
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-geo-alt"></i>

                        <select asp-for="Campus"
                                id="campus"
                                class="form-select"
                                required>

                            <option value="">
                                Select campus
                            </option>

                            <option value="1">
                                Kigali
                            </option>

                            <option value="2">
                                Rwamagana
                            </option>

                            <option value="3">
                                Nyanza
                            </option>

                        </select>

                    </div>

                </div>


                <!-- =================================================
                     HOURS
                ================================================== -->

                <div class="form-group">

                    <label for="allocatedHours">
                        Number of Hours
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-hourglass-split"></i>

                        <input asp-for="AllocatedHours"
                               id="allocatedHours"
                               class="form-control"
                               type="number"
                               min="1"
                               max="500"
                               step="0.01"
                               placeholder="Enter number of hours"
                               required />

                    </div>

                    <span class="field-help">
                        Enter the total teaching hours allocated to this lecturer.
                    </span>

                </div>


                <!-- =================================================
                     RATE
                ================================================== -->

                <div class="form-group">

                    <label>
                        Rate Per Hour
                    </label>

                    <div class="rate-box">

                        <div class="rate-content">

                            <div class="rate-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>

                            <div>

                                <div class="rate-label">
                                    Rate determined by lecturer rank
                                </div>

                                <div class="rate-value"
                                     id="rateDisplay">

                                    RWF 0

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


            </div>


            <!-- =====================================================
                 INFORMATION
            ====================================================== -->

            <div class="info-box">

                <div class="info-icon">

                    <i class="bi bi-info-circle-fill"></i>

                </div>

                <div>

                    <strong>
                        Assignment and contract generation
                    </strong>

                    <p>
                        The selected lecturer's academic rank determines the applicable
                        hourly rate. Once the assignment is submitted, the system will
                        generate the lecturer's academic engagement contract.
                    </p>

                </div>

            </div>


            <!-- =====================================================
                 ACTIONS
            ====================================================== -->

            <div class="actions">

                <a href="/HOD/Index"
                   class="cancel-button">

                    Cancel

                </a>

                <button type="submit"
                        class="generate-button">

                    <i class="bi bi-file-earmark-plus"></i>

                    Generate Contract

                </button>

            </div>


        </form>

    </section>

</div>


<!-- =============================================================
     LECTURER DATA
============================================================== -->

<script>

    const lecturerData =
        @Html.Raw(JsonSerializer.Serialize(lecturerInformation));


    const lecturerSelect =
        document.getElementById("lecturerSelect");


    const rankInput =
        document.getElementById("rank");


    const governmentIdInput =
        document.getElementById("governmentId");


    const rateDisplay =
        document.getElementById("rateDisplay");


    /* ============================================================
       RATE BY ACADEMIC RANK
    ============================================================ */

    function getRateForRank(rank) {

        switch (rank) {

            case "TeachingAssistant":
                return 4000;

            case "AssistantLecturer":
                return 5000;

            case "Lecturer":
                return 7000;

            case "SeniorLecturer":
                return 9000;

            case "AssociateProfessor":
                return 11000;

            case "Professor":
                return 13000;

            case "ProfessorEmeritus":
                return 13000;

            default:
                return 5000;
        }
    }


    /* ============================================================
       FORMAT RANK
    ============================================================ */

    function formatRank(rank) {

        if (!rank) {
            return "Not specified";
        }

        return rank.replace(
            /([a-z])([A-Z])/g,
            "$1 $2"
        );

    }


    /* ============================================================
       UPDATE LECTURER INFORMATION
    ============================================================ */

    function updateLecturer() {

        const id =
            lecturerSelect.value;


        const lecturer =
            lecturerData[id];


        if (!lecturer) {

            rankInput.value = "";

            governmentIdInput.value =
                "Protected";

            rateDisplay.textContent =
                "RWF 0";

            return;
        }


        rankInput.value =
            formatRank(lecturer.Rank);


        governmentIdInput.value =
            lecturer.GovernmentId;


        const rate =
            getRateForRank(lecturer.Rank);


        rateDisplay.textContent =
            "RWF " + rate.toLocaleString();

    }


    /* ============================================================
       LECTURER CHANGE EVENT
    ============================================================ */

    if (lecturerSelect) {

        lecturerSelect.addEventListener(
            "change",
            updateLecturer
        );

        updateLecturer();
    }

</script>