@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.HOD.ContractDetailsModel

@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    Layout = "~/Pages/Shared/HOD/_HODLayout.cshtml";
    ViewData["Title"] = "Contract Details";

    string GetStatusClass(ContractStatus status) => status switch
    {
        ContractStatus.Active => "status-active",
        ContractStatus.PendingSignature => "status-pending",
        ContractStatus.Expired => "status-neutral",
        ContractStatus.Terminated => "status-danger",
        ContractStatus.Renewed => "status-active",
        _ => "status-neutral"
    };

    string GetStatusLabel(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "Pending Signature",
        ContractStatus.Active => "Active",
        ContractStatus.Expired => "Expired",
        ContractStatus.Terminated => "Terminated",
        ContractStatus.Renewed => "Renewed",
        _ => status.ToString()
    };

    string GetRoleLabel(SignerRole role) => role switch
    {
        SignerRole.Lecturer => "Lecturer",
        SignerRole.Dean => "Dean of Faculty",
        SignerRole.HROfficer => "Human Resource Officer",
        SignerRole.DVCAR => "DVCAR",
        SignerRole.ViceChancellor => "Vice Chancellor",
        _ => role.ToString()
    };

    var contract = Model.Contract;

    var signedSteps = contract?.Steps.Count(s =>
        s.Decision == SignatureDecision.Signed) ?? 0;

    var totalSteps = contract?.Steps.Count ?? 0;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/HOD/contracts.css"
          asp-append-version="true" />
}

<section class="contracts-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>Contract Details</h1>
            <p>Review the contract and monitor the electronic signature workflow.</p>
        </div>

        <div class="page-header-actions">

            <a href="/HOD/Contracts" class="secondary-button">
                <i class="bi bi-arrow-left"></i>
                Back to Contracts
            </a>

            @if (contract is not null)
            {
                <button type="button"
                        class="primary-button"
                        onclick="openContractPreview()">
                    <i class="bi bi-arrows-fullscreen"></i>
                    Full Preview
                </button>
            }

        </div>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }
    else if (contract is not null)
    {
        <section class="section-card">

            <header class="section-header">
                <h2>@contract.Reference</h2>
                <span class="status-badge @GetStatusClass(contract.Status)">
                    @GetStatusLabel(contract.Status)
                </span>
            </header>

            <div class="detail-grid">

                <div class="detail-item">
                    <span class="detail-label">Lecturer</span>
                    <span class="detail-value">@contract.LecturerName</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Course</span>
                    <span class="detail-value">@contract.CourseTitle</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Academic Year</span>
                    <span class="detail-value">@contract.AcademicYear</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Signature Progress</span>
                    <span class="detail-value">@signedSteps / @totalSteps</span>
                </div>

            </div>

        </section>

        <section class="section-card">

            <header class="section-header">
                <h2>Signature Workflow</h2>
            </header>

            @if (contract.Steps.Count > 0)
            {
                <div class="timeline">

                    @for (var index = 0; index < contract.Steps.Count; index++)
                    {
                        var step = contract.Steps[index];

                        var isSigned = step.Decision == SignatureDecision.Signed;
                        var isDeclined = step.Decision == SignatureDecision.Declined;

                        var isCurrent = !isSigned && !isDeclined
                            && !contract.Steps.Take(index).Any(s => s.Decision == SignatureDecision.Declined)
                            && contract.Steps.Take(index).All(s => s.Decision == SignatureDecision.Signed);

                        <div class="timeline-step">

                            <div class="timeline-role">
                                @GetRoleLabel(step.Role)
                            </div>

                            <div class="timeline-content">

                                <div class="timeline-status">

                                    @if (isSigned)
                                    {
                                        <span class="status-badge status-active">Signed</span>
                                    }
                                    else if (isDeclined)
                                    {
                                        <span class="status-badge status-danger">Declined</span>
                                    }
                                    else if (isCurrent)
                                    {
                                        <span class="status-badge status-pending">Current Step</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-neutral">Pending</span>
                                    }

                                    @if (step.SignedAtUtc.HasValue)
                                    {
                                        <span class="timeline-date">
                                            @step.SignedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                        </span>
                                    }

                                </div>

                                @if (!string.IsNullOrWhiteSpace(step.Comments))
                                {
                                    <p class="timeline-comments">@step.Comments</p>
                                }

                                @if (isSigned && !string.IsNullOrWhiteSpace(step.SignatureFilePath))
                                {
                                    <div class="signature-preview">
                                        <span>Signature</span>
                                        <img src="@step.SignatureFilePath" alt="Electronic signature" />
                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>No signature records for this contract.</p>
                </div>
            }

        </section>

        <section class="section-card">

            <header class="section-header">
                <h2>Contract Document</h2>
                <span class="section-meta">Live preview with current signatures</span>
            </header>

            <div class="document-stage">
                <article class="contract-document">
                    @Html.Raw(contract.Content)
                </article>
            </div>

        </section>
    }

</section>

@if (contract is not null)
{
    <div id="contractPreview"
         class="preview-modal"
         aria-hidden="true">

        <div class="preview-backdrop"
             onclick="closeContractPreview()">
        </div>

        <div class="preview-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="contractPreviewTitle">

            <header class="preview-header">

                <h2 id="contractPreviewTitle">@contract.Reference</h2>

                <button type="button"
                        class="preview-close"
                        aria-label="Close preview"
                        onclick="closeContractPreview()">
                    <i class="bi bi-x-lg"></i>
                </button>

            </header>

            <div class="preview-body">
                <article class="contract-preview-paper">
                    @Html.Raw(contract.Content)
                </article>
            </div>

        </div>

    </div>
}

@section Scripts {
<script>

    function openContractPreview() {

        const modal = document.getElementById("contractPreview");

        if (!modal) return;

        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.classList.add("preview-open");

    }

    function closeContractPreview() {

        const modal = document.getElementById("contractPreview");

        if (!modal) return;

        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        document.body.classList.remove("preview-open");

    }

    document.addEventListener("keydown", function (event) {

        if (event.key === "Escape") {
            closeContractPreview();
        }

    });

</script>
}