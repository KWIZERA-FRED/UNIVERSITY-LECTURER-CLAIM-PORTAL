@page
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ContractsModel

@{
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
    ViewData["Title"] = "My Contracts";

    string GetStatusClass(ContractStatus status) => status switch
    {
        ContractStatus.Active => "status-active",
        ContractStatus.PendingSignature => "status-pending",
        ContractStatus.Expired => "status-neutral",
        ContractStatus.Terminated => "status-danger",
        ContractStatus.Renewed => "status-active",
        _ => "status-neutral"
    };

    string GetStatusLabel(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "Pending Signature",
        ContractStatus.Active => "Active",
        ContractStatus.Expired => "Expired",
        ContractStatus.Terminated => "Terminated",
        ContractStatus.Renewed => "Renewed",
        _ => status.ToString()
    };

    var totalContracts = Model.Contracts.Count;
    var pendingCount = Model.PendingSignatureCount;
    var activeCount = Model.ActiveContractCount;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Lecturer/contracts.css"
          asp-append-version="true" />
}

<section class="contracts-page">

    @* ---------------- Header ---------------- *@

    <header class="page-header">

        <div class="page-header-main">
            <h1>My Contracts</h1>
            <p>Review your academic contracts and complete your required signatures.</p>
        </div>

    </header>


    @* ---------------- Stats — uniform white cards ---------------- *@

    <section class="contracts-stats" aria-label="Contract summary">

        <div class="contracts-stat contracts-stat--neutral">
            <span class="contracts-stat-label">Total Contracts</span>
            <span class="contracts-stat-value">@totalContracts</span>
            <span class="contracts-stat-meta">Contracts assigned to you</span>
        </div>

        <div class="contracts-stat contracts-stat--action">
            <span class="contracts-stat-label">Awaiting Your Signature</span>
            <span class="contracts-stat-value">@pendingCount</span>
            <span class="contracts-stat-meta">
                @if (pendingCount > 0)
                {
                    <text>Needs your signature</text>
                }
                else
                {
                    <text>Nothing waiting</text>
                }
            </span>
        </div>

        <div class="contracts-stat contracts-stat--success">
            <span class="contracts-stat-label">Active Contracts</span>
            <span class="contracts-stat-value">@activeCount</span>
            <span class="contracts-stat-meta">Currently in force</span>
        </div>

    </section>


    @* ---------------- Contract register ---------------- *@

    <section class="section-card" id="dd-contracts">

        <header class="section-header">

            <h2>Contract Register</h2>

            <span class="section-meta">
                @totalContracts @(totalContracts == 1 ? "contract" : "contracts")
            </span>

        </header>


        @* ---- Search ---- *@

        <div class="dd-toolbar">

            <form method="get"
                  asp-page="/Lecturer/Contracts"
                  id="dd-contracts-search-form"
                  class="ds-search"
                  role="search"
                  onsubmit="return false;">

                <i class="bi bi-search" aria-hidden="true"></i>

                <input type="search"
                       id="dd-contracts-search"
                       name="q"
                       autocomplete="off"
                       placeholder="Search by contract, course or year"
                       aria-label="Search contracts" />

                <span class="ds-search-hint" aria-hidden="true">Press /</span>

            </form>

        </div>


        @* ---- Table ---- *@

        @if (Model.Contracts.Any())
        {
            <div class="table-wrapper">

                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Course</th>
                            <th>Year</th>
                            <th>Campus</th>
                            <th>Hours</th>
                            <th>Status</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody id="dd-contracts-body">

                        @foreach (var contract in Model.Contracts)
                        {
                            var statusClass = GetStatusClass(contract.Status);
                            var statusLabel = GetStatusLabel(contract.Status);

                            var isAction = !contract.IsSignedByLecturer && !contract.IsClosed;

                            <tr class="contract-row @(isAction ? "contract-row--action" : "")"
                                data-search="@($"{contract.Reference} {contract.CourseCode} {contract.CourseTitle} {contract.AcademicYear} {contract.Campus}".ToLowerInvariant())">

                                <td>
                                    <span class="contract-reference">
                                        @contract.Reference
                                    </span>
                                </td>

                                <td>
                                    <span class="course-title">@contract.CourseTitle</span>
                                    @if (!string.IsNullOrWhiteSpace(contract.CourseCode))
                                    {
                                        <span class="course-code">@contract.CourseCode</span>
                                    }
                                </td>

                                <td>@contract.AcademicYear</td>

                                <td>@contract.Campus</td>

                                <td>
                                    <span class="hours-value">@contract.AllocatedHours.ToString("N1")</span>
                                </td>

                                <td>
                                    <span class="status-badge @statusClass">
                                        @statusLabel
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/Lecturer/ContractDetails"
                                       asp-route-id="@contract.Id"
                                       class="row-action @(isAction ? "row-action--primary" : "")">
                                        @(isAction ? "Review & sign" : "View")
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-empty" id="noResults" hidden>
                <p>No contracts match your search.</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-file-earmark-x"></i>
                </span>
                <h3>No contracts yet</h3>
                <p>Your contracts will appear here once they have been generated.</p>
            </div>
        }

    </section>

</section>


@section Scripts {
    <script>
        (function () {

            var input = document.getElementById("dd-contracts-search");
            var body = document.getElementById("dd-contracts-body");
            var empty = document.getElementById("noResults");

            if (!input || !body) {
                return;
            }

            var rows = Array.prototype.slice.call(
                body.querySelectorAll(".contract-row"));

            var timer = null;

            function apply() {

                var query = input.value.trim().toLowerCase();
                var terms = query.split(/\s+/).filter(Boolean);

                var shown = 0;

                rows.forEach(function (row) {

                    var key = (row.getAttribute("data-search") || "");

                    var matches = terms.every(function (t) {
                        return key.indexOf(t) !== -1;
                    });

                    row.hidden = !matches;

                    if (matches) {
                        shown++;
                    }
                });

                if (empty) {
                    empty.hidden = shown > 0 || rows.length === 0;
                }
            }

            input.addEventListener("input", function () {
                clearTimeout(timer);
                timer = setTimeout(apply, 100);
            });

            input.addEventListener("search", apply);

            document.addEventListener("keydown", function (event) {

                var tag = (document.activeElement || {}).tagName || "";

                if (event.key === "/" &&
                    !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                    !event.ctrlKey && !event.metaKey && !event.altKey) {

                    event.preventDefault();
                    input.focus();
                    input.select();
                }
            });

            apply();

        })();
    </script>
}