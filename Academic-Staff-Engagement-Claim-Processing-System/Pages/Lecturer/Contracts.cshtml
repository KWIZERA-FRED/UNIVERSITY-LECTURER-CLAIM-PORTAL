@page
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ContractsModel

@{
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
    ViewData["Title"] = "My Contracts";

    var selectedRow = Model.SelectedContract == null
        ? null
        : Model.Contracts.FirstOrDefault(c => c.Id == Model.SelectedContract.Id);

    string GetStatusClass(ContractStatus status) => status switch
    {
        ContractStatus.Active => "status-active",
        ContractStatus.PendingSignature => "status-pending",
        ContractStatus.Expired => "status-neutral",
        ContractStatus.Terminated => "status-danger",
        ContractStatus.Renewed => "status-active",
        _ => "status-neutral"
    };

    string GetStatusLabel(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "Pending Signature",
        ContractStatus.Active => "Active",
        ContractStatus.Expired => "Expired",
        ContractStatus.Terminated => "Terminated",
        ContractStatus.Renewed => "Renewed",
        _ => status.ToString()
    };

    string GetDecisionClass(SignatureDecision decision) => decision switch
    {
        SignatureDecision.Signed => "signature-signed",
        SignatureDecision.Declined => "signature-declined",
        _ => "signature-pending"
    };

    string GetDecisionText(SignatureDecision decision) => decision switch
    {
        SignatureDecision.Signed => "Signed",
        SignatureDecision.Declined => "Declined",
        _ => "Pending"
    };

    string GetSignerIconClass(SignatureDecision decision) => decision switch
    {
        SignatureDecision.Signed => "signer-icon-signed",
        SignatureDecision.Declined => "signer-icon-declined",
        _ => "signer-icon-pending"
    };

    string GetSignerIcon(SignatureDecision decision) => decision switch
    {
        SignatureDecision.Signed => "bi-check-lg",
        SignatureDecision.Declined => "bi-x-lg",
        _ => "bi-clock"
    };

    string GetSignerRoleLabel(SignerRole role) => role switch
    {
        SignerRole.Lecturer => "Lecturer",
        SignerRole.Dean => "Dean of Faculty",
        SignerRole.HROfficer => "Human Resource Officer",
        SignerRole.DVCAR => "DVCAR",
        SignerRole.ViceChancellor => "Vice Chancellor",
        _ => role.ToString()
    };

    var totalContracts = Model.Contracts.Count;
    var pendingCount = Model.PendingSignatureCount;
    var activeCount = Model.ActiveContractCount;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/shared/contract-document.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Lecturer/contracts.css"
          asp-append-version="true" />
}

<section class="contracts-page">

    @* ---------------- Header ---------------- *@

    <header class="page-header">

        <div class="page-header-main">
            <h1>My Contracts</h1>
            <p>Review your academic contracts and complete your required signatures.</p>
        </div>

    </header>


    @* ---------------- Alerts ---------------- *@

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }


    @* ---------------- Stats — uniform white cards ---------------- *@

    <section class="contracts-stats" aria-label="Contract summary">

        <div class="contracts-stat contracts-stat--neutral">
            <span class="contracts-stat-label">Total Contracts</span>
            <span class="contracts-stat-value">@totalContracts</span>
            <span class="contracts-stat-meta">Contracts assigned to you</span>
        </div>

        <div class="contracts-stat contracts-stat--action">
            <span class="contracts-stat-label">Awaiting Your Signature</span>
            <span class="contracts-stat-value">@pendingCount</span>
            <span class="contracts-stat-meta">
                @if (pendingCount > 0)
                {
                    <text>Needs your signature</text>
                }
                else
                {
                    <text>Nothing waiting</text>
                }
            </span>
        </div>

        <div class="contracts-stat contracts-stat--success">
            <span class="contracts-stat-label">Active Contracts</span>
            <span class="contracts-stat-value">@activeCount</span>
            <span class="contracts-stat-meta">Currently in force</span>
        </div>

    </section>


    @* ---------------- Contract register ---------------- *@

    <section class="section-card" id="dd-contracts">

        <header class="section-header">

            <h2>Contract Register</h2>

            <span class="section-meta">
                @totalContracts @(totalContracts == 1 ? "contract" : "contracts")
            </span>

        </header>


        @* ---- Search ---- *@

        <div class="dd-toolbar">

            <form method="get"
                  asp-page="/Lecturer/Contracts"
                  id="dd-contracts-search-form"
                  class="ds-search"
                  role="search"
                  onsubmit="return false;">

                <i class="bi bi-search" aria-hidden="true"></i>

                <input type="search"
                       id="dd-contracts-search"
                       name="q"
                       autocomplete="off"
                       placeholder="Search by contract, course or year"
                       aria-label="Search contracts" />

                <span class="ds-search-hint" aria-hidden="true">Press /</span>

            </form>

        </div>


        @* ---- Table ---- *@

        @if (Model.Contracts.Any())
        {
            <div class="table-wrapper">

                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Course</th>
                            <th>Year</th>
                            <th>Campus</th>
                            <th>Hours</th>
                            <th>Status</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody id="dd-contracts-body">

                        @foreach (var contract in Model.Contracts)
                        {
                            var statusClass = GetStatusClass(contract.Status);
                            var statusLabel = GetStatusLabel(contract.Status);

                            var isAction = !contract.IsSignedByLecturer && !contract.IsClosed;
                            var isClosed = contract.IsClosed;

                            <tr class="contract-row @(isAction ? "contract-row--action" : "")"
                                data-search="@($"{contract.Reference} {contract.CourseCode} {contract.CourseTitle} {contract.AcademicYear} {contract.Campus}".ToLowerInvariant())">

                                <td>
                                    <span class="contract-reference">
                                        @contract.Reference
                                    </span>
                                </td>

                                <td>
                                    <span class="course-title">@contract.CourseTitle</span>
                                    @if (!string.IsNullOrWhiteSpace(contract.CourseCode))
                                    {
                                        <span class="course-code">@contract.CourseCode</span>
                                    }
                                </td>

                                <td>@contract.AcademicYear</td>

                                <td>@contract.Campus</td>

                                <td>
                                    <span class="hours-value">@contract.AllocatedHours.ToString("N1")</span>
                                </td>

                                <td>
                                    <span class="status-badge @statusClass">
                                        @statusLabel
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/Lecturer/Contracts"
                                       asp-route-ContractId="@contract.Id"
                                       class="row-action @(isAction ? "row-action--primary" : "")">
                                        @if (isAction)
                                        {
                                            <text>Review &amp; sign</text>
                                        }
                                        else if (isClosed)
                                        {
                                            <text>View</text>
                                        }
                                        else
                                        {
                                            <text>View</text>
                                        }
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-empty" id="noResults" hidden>
                <p>No contracts match your search.</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-file-earmark-x"></i>
                </span>
                <h3>No contracts yet</h3>
                <p>Your contracts will appear here once they have been generated.</p>
            </div>
        }

    </section>


    @* ---------------- Selected contract — the review panel ---------------- *@

    @if (Model.SelectedContract != null)
    {
        var contract = Model.SelectedContract;

        <section class="selected-contract">

            <div class="selected-contract-header">

                <div>
                    <div class="contract-reference-block">
                        <span class="reference-label">Contract Reference</span>
                        <span class="reference-number">@contract.Reference</span>
                    </div>

                    @if (selectedRow != null)
                    {
                        <div class="selected-contract-meta">
                            <span>
                                <i class="bi bi-book"></i>
                                @selectedRow.CourseCode
                            </span>

                            <span>
                                <i class="bi bi-mortarboard"></i>
                                @selectedRow.CourseTitle
                            </span>
                        </div>
                    }
                </div>

                <div class="contract-status @GetStatusClass(contract.Status)">
                    <span class="status-dot"></span>
                    @GetStatusLabel(contract.Status)
                </div>

            </div>

            @if (selectedRow != null)
            {
                <div class="contract-detail-grid">

                    <div class="contract-detail-item">
                        <span class="detail-label">Course Code</span>
                        <span class="detail-value">@selectedRow.CourseCode</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Course</span>
                        <span class="detail-value">@selectedRow.CourseTitle</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Academic Year</span>
                        <span class="detail-value">@selectedRow.AcademicYear</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Campus</span>
                        <span class="detail-value">@selectedRow.Campus</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Allocated Hours</span>
                        <span class="detail-value">@selectedRow.AllocatedHours.ToString("N1")</span>
                    </div>

                </div>
            }

            @if (contract.IsFullySigned)
            {
                <div class="fully-signed-banner">
                    <div class="fully-signed-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <div>
                        <strong>Contract fully approved</strong>
                        <span>All required signatures have been completed.</span>
                    </div>
                </div>
            }

            <div class="contract-section">

                <div class="section-heading">
                    <div class="section-heading-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <h2>Contract Document</h2>
                        <p>Review the terms and details of your contract.</p>
                    </div>
                </div>

                <article class="contract-document">
                    @Html.Raw(contract.Content)
                </article>

            </div>

            <div class="contract-section">

                <div class="section-heading">
                    <div class="section-heading-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>

                    <div>
                        <h2>Signature Progress</h2>
                        <p>Track the approval and signing progress.</p>
                    </div>
                </div>

                <div class="signature-timeline">

                    @foreach (var group in contract.SignerStatuses
                        .GroupBy(s => s.SequenceOrder)
                        .OrderBy(g => g.Key))
                    {
                        <div class="signature-step">

                            <div class="step-number">
                                @group.Key
                            </div>

                            <div class="step-content">

                                @foreach (var signer in group)
                                {
                                    var roleLabel = GetSignerRoleLabel(signer.Role);

                                    var signerName = !string.IsNullOrWhiteSpace(signer.SignerDisplayName)
                                        ? signer.SignerDisplayName
                                        : roleLabel;

                                    <div class="signer-row">

                                        <div class="signer-information">

                                            <div class="signer-icon @GetSignerIconClass(signer.Decision)">
                                                <i class="bi @GetSignerIcon(signer.Decision)"></i>
                                            </div>

                                            <div class="signer-details">

                                                <span class="signer-role">
                                                    @roleLabel
                                                </span>

                                                <span class="signer-status-text">
                                                    @signerName
                                                </span>

                                                @if (signer.Decision == SignatureDecision.Signed &&
                                                     signer.SignedAtUtc.HasValue)
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(signer.SignatureFilePath))
                                                    {
                                                        <div class="signature-preview">
                                                            <span>Signature</span>
                                                            <img src="@signer.SignatureFilePath"
                                                                 alt="Electronic signature" />
                                                        </div>
                                                    }

                                                    <span class="signer-signed-text">
                                                        Signed @(signer.SignedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm"))
                                                    </span>
                                                }
                                                else if (signer.Decision == SignatureDecision.Declined)
                                                {
                                                    <span class="signer-declined-text">
                                                        Signature declined
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="signer-status-text">
                                                        Awaiting signature
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <div class="signer-status">
                                            <span class="signature-badge @GetDecisionClass(signer.Decision)">
                                                @GetDecisionText(signer.Decision)
                                            </span>
                                        </div>

                                    </div>
                                }

                                @if (group.Count() > 1)
                                {
                                    <div class="parallel-note">
                                        <i class="bi bi-info-circle"></i>
                                        <span>
                                            These approval roles are part of the same signing stage.
                                        </span>
                                    </div>
                                }

                            </div>
                        </div>
                    }

                </div>

            </div>

            <div class="contract-actions">

                <div class="contract-action-information">

                    @if (contract.IsSignedByLecturer)
                    {
                        <div class="you-signed-badge">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>You have signed this contract.</span>
                        </div>
                    }
                    else if (contract.IsClosed)
                    {
                        <div class="you-signed-badge">
                            <i class="bi bi-lock-fill"></i>
                            <span>This contract is closed and can no longer be signed.</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <strong>Action required</strong>
                            <span>Please review the contract before confirming your signature.</span>
                        </div>
                    }

                </div>

                @if (!contract.IsSignedByLecturer &&
                     !contract.IsClosed &&
                     !contract.IsFullySigned)
                {
                    <div class="contract-action-buttons">

                        <form method="post" asp-page-handler="Sign">
                            <input type="hidden" name="contractId" value="@contract.Id" />

                            <button type="submit" class="sign-contract-button">
                                <i class="bi bi-pen"></i>
                                <span>Sign Contract</span>
                            </button>
                        </form>

                    </div>
                }

            </div>

        </section>
    }

</section>


@section Scripts {
    <script>
        (function () {

            var input = document.getElementById("dd-contracts-search");
            var body = document.getElementById("dd-contracts-body");
            var empty = document.getElementById("noResults");

            if (!input || !body) {
                return;
            }

            var rows = Array.prototype.slice.call(
                body.querySelectorAll(".contract-row"));

            var timer = null;

            function apply() {

                var query = input.value.trim().toLowerCase();
                var terms = query.split(/\s+/).filter(Boolean);

                var shown = 0;

                rows.forEach(function (row) {

                    var key = (row.getAttribute("data-search") || "");

                    var matches = terms.every(function (t) {
                        return key.indexOf(t) !== -1;
                    });

                    row.hidden = !matches;

                    if (matches) {
                        shown++;
                    }
                });

                if (empty) {
                    empty.hidden = shown > 0 || rows.length === 0;
                }
            }

            input.addEventListener("input", function () {
                clearTimeout(timer);
                timer = setTimeout(apply, 100);
            });

            input.addEventListener("search", apply);

            document.addEventListener("keydown", function (event) {

                var tag = (document.activeElement || {}).tagName || "";

                if (event.key === "/" &&
                    !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                    !event.ctrlKey && !event.metaKey && !event.altKey) {

                    event.preventDefault();
                    input.focus();
                    input.select();
                }
            });

            apply();

        })();
    </script>
}