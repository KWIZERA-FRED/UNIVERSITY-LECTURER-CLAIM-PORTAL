
@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ContractsModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    ViewData["Title"] = "My Contracts";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";

    var selectedRow = Model.SelectedContract == null
        ? null
        : Model.Contracts.FirstOrDefault(c => c.Id == Model.SelectedContract.Id);

    string GetStatusClass(ContractStatus status)
    {
        return status switch
        {
            ContractStatus.Active => "status-active",
            ContractStatus.PendingSignature => "status-pending",
            ContractStatus.Expired => "status-closed",
            ContractStatus.Terminated => "status-closed",
            ContractStatus.Renewed => "status-active",
            _ => "status-pending"
        };
    }

    string GetDecisionClass(SignatureDecision decision)
    {
        return decision switch
        {
            SignatureDecision.Signed => "signature-signed",
            SignatureDecision.Declined => "signature-declined",
            _ => "signature-pending"
        };
    }

    string GetDecisionText(SignatureDecision decision)
    {
        return decision switch
        {
            SignatureDecision.Signed => "Signed",
            SignatureDecision.Declined => "Declined",
            _ => "Pending"
        };
    }

    string GetSignerIconClass(SignatureDecision decision)
    {
        return decision switch
        {
            SignatureDecision.Signed => "signer-icon-signed",
            SignatureDecision.Declined => "signer-icon-declined",
            _ => "signer-icon-pending"
        };
    }

    string GetSignerIcon(SignatureDecision decision)
    {
        return decision switch
        {
            SignatureDecision.Signed => "bi-check-lg",
            SignatureDecision.Declined => "bi-x-lg",
            _ => "bi-clock"
        };
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Lecturer/contracts.css"
          asp-append-version="true" />
}

<section class="contracts-page">

    <div class="contracts-page-header">
        <div class="contracts-heading">
            <div class="contracts-heading-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div>
                <div class="page-eyebrow">
                    ACADEMIC STAFF ENGAGEMENT
                </div>

                <h1>My Contracts</h1>

                <p>
                    Review your academic contracts and complete your required signatures.
                </p>
            </div>
        </div>

        <a asp-page="/Lecturer/Index"
           class="contracts-back-button">
            <i class="bi bi-arrow-left"></i>
            <span>Dashboard</span>
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="contract-alert contract-alert-success">
            <div class="contract-alert-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="contract-alert contract-alert-error">
            <div class="contract-alert-icon">
                <i class="bi bi-exclamation-circle"></i>
            </div>

            <span>@Model.ErrorMessage</span>
        </div>
    }

    <section class="contract-summary">

        <div class="summary-card">
            <div class="summary-card-icon summary-icon-blue">
                <i class="bi bi-files"></i>
            </div>

            <div class="summary-card-content">
                <span class="summary-label">Total Contracts</span>
                <strong class="summary-value">@Model.Contracts.Count</strong>
                <span class="summary-description">Contracts assigned to you</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-icon summary-icon-amber">
                <i class="bi bi-clock-history"></i>
            </div>

            <div class="summary-card-content">
                <span class="summary-label">Awaiting Signature</span>
                <strong class="summary-value">@Model.PendingSignatureCount</strong>
                <span class="summary-description">Contracts requiring your action</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-icon summary-icon-green">
                <i class="bi bi-check2-circle"></i>
            </div>

            <div class="summary-card-content">
                <span class="summary-label">Active Contracts</span>
                <strong class="summary-value">@Model.ActiveContractCount</strong>
                <span class="summary-description">Currently active contracts</span>
            </div>
        </div>

    </section>

    @if (Model.SelectedContract != null)
    {
        var contract = Model.SelectedContract;

        <section class="selected-contract">

            <div class="selected-contract-header">

                <div>
                    <div class="contract-reference">
                        <span class="reference-label">Contract Reference</span>
                        <span class="reference-number">@contract.Reference</span>
                    </div>

                    @if (selectedRow != null)
                    {
                        <div class="selected-contract-meta">
                            <span>
                                <i class="bi bi-book"></i>
                                @selectedRow.CourseCode
                            </span>

                            <span>
                                <i class="bi bi-mortarboard"></i>
                                @selectedRow.CourseTitle
                            </span>
                        </div>
                    }
                </div>

                <div class="contract-status @GetStatusClass(contract.Status)">
                    <span class="status-dot"></span>
                    @contract.Status
                </div>

            </div>

            @if (selectedRow != null)
            {
                <div class="contract-detail-grid">

                    <div class="contract-detail-item">
                        <span class="detail-label">Course Code</span>
                        <span class="detail-value">@selectedRow.CourseCode</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Course</span>
                        <span class="detail-value">@selectedRow.CourseTitle</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Academic Year</span>
                        <span class="detail-value">@selectedRow.AcademicYear</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Campus</span>
                        <span class="detail-value">@selectedRow.Campus</span>
                    </div>

                    <div class="contract-detail-item">
                        <span class="detail-label">Allocated Hours</span>
                        <span class="detail-value">
                            @selectedRow.AllocatedHours.ToString("N1")
                        </span>
                    </div>

                </div>
            }

            @if (contract.IsFullySigned)
            {
                <div class="fully-signed-banner">
                    <div class="fully-signed-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <div>
                        <strong>Contract fully approved</strong>
                        <span>All required signatures have been completed.</span>
                    </div>
                </div>
            }

            <div class="contract-section">

                <div class="section-heading">
                    <div class="section-heading-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <h2>Contract Document</h2>
                        <p>Review the terms and details of your contract.</p>
                    </div>
                </div>

                <div class="contract-document">
                    @Html.Raw(contract.Content)
                </div>

            </div>

            <div class="contract-section">

                <div class="section-heading">
                    <div class="section-heading-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>

                    <div>
                        <h2>Signature Progress</h2>
                        <p>Track the approval and signing progress.</p>
                    </div>
                </div>

                <div class="signature-timeline">

                    @foreach (var group in contract.SignerStatuses
                        .GroupBy(s => s.SequenceOrder)
                        .OrderBy(g => g.Key))
                    {
                        <div class="signature-step">

                            <div class="step-number">
                                @group.Key
                            </div>

                            <div class="step-content">

                                @foreach (var signer in group)
                                {
                                    <div class="signer-row">

                                        <div class="signer-information">

                                            <div class="signer-icon @GetSignerIconClass(signer.Decision)">
                                                <i class="bi @GetSignerIcon(signer.Decision)"></i>
                                            </div>

                                            <div class="signer-details">

                                                <span class="signer-role">
                                                    @signer.Role
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(signer.SignerDisplayName))
                                                {
                                                    <span class="signer-status-text">
                                                        @signer.SignerDisplayName
                                                    </span>
                                                }

                                                @if (signer.Decision == SignatureDecision.Signed &&
                                                     signer.SignedAtUtc.HasValue)
                                                {
                                                    <span class="signer-signed-text">
                                                        Signed
                                                        @signer.SignedAtUtc.Value
                                                            .ToLocalTime()
                                                            .ToString("dd MMM yyyy, HH:mm")
                                                    </span>
                                                }
                                                else if (signer.Decision == SignatureDecision.Declined)
                                                {
                                                    <span class="signer-declined-text">
                                                        Signature declined
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="signer-status-text">
                                                        Awaiting signature
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <div class="signer-status">
                                            <span class="signature-badge @GetDecisionClass(signer.Decision)">
                                                @GetDecisionText(signer.Decision)
                                            </span>
                                        </div>

                                    </div>
                                }

                                @if (group.Count() > 1)
                                {
                                    <div class="parallel-note">
                                        <i class="bi bi-info-circle"></i>
                                        <span>
                                            These approval roles are part of the same signing stage.
                                        </span>
                                    </div>
                                }

                            </div>
                        </div>
                    }

                </div>

            </div>

            <div class="contract-actions">

                <div class="contract-action-information">

                    @if (contract.IsSignedByLecturer)
                    {
                        <div class="you-signed-badge">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>You have signed this contract.</span>
                        </div>
                    }
                    else if (contract.IsClosed)
                    {
                        <div class="you-signed-badge">
                            <i class="bi bi-lock-fill"></i>
                            <span>
                                This contract is closed and can no longer be signed.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <strong>Action required</strong>
                            <span>
                                Please review the contract before confirming your signature.
                            </span>
                        </div>
                    }

                </div>

                @if (!contract.IsSignedByLecturer &&
                     !contract.IsClosed &&
                     !contract.IsFullySigned)
                {
                    <div class="contract-action-buttons">

                        <form method="post"
                              asp-page-handler="Sign">

                            <input type="hidden"
                                   name="contractId"
                                   value="@contract.Id" />

                            <button type="submit"
                                    class="sign-contract-button">
                                <i class="bi bi-pen"></i>
                                <span>Sign Contract</span>
                            </button>

                        </form>

                    </div>
                }

            </div>

        </section>
    }

    <section class="contracts-section">

        <div class="contracts-section-header">

            <div>
                <div class="section-eyebrow">
                    CONTRACT MANAGEMENT
                </div>

                <h2>Your Contracts</h2>
            </div>

            <span class="contract-count">
                @Model.Contracts.Count
                @(Model.Contracts.Count == 1 ? "contract" : "contracts")
            </span>

        </div>

        @if (Model.Contracts.Count > 0)
        {
            <div class="contract-list">

                @foreach (var contract in Model.Contracts)
                {
                    <article class="contract-card">

                        <div class="contract-card-main">

                            <div class="contract-card-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>

                            <div class="contract-card-information">

                                <div class="contract-card-reference">

                                    <span>
                                        @contract.Reference
                                    </span>

                                    <span class="contract-status @GetStatusClass(contract.Status)">
                                        <span class="status-dot"></span>
                                        @contract.Status
                                    </span>

                                </div>

                                <h3>
                                    @contract.CourseTitle
                                </h3>

                                <div class="contract-card-meta">

                                    <span>
                                        <i class="bi bi-book"></i>
                                        @contract.CourseCode
                                    </span>

                                    <span>
                                        <i class="bi bi-calendar3"></i>
                                        @contract.AcademicYear
                                    </span>

                                    <span>
                                        <i class="bi bi-building"></i>
                                        @contract.Campus
                                    </span>

                                    <span>
                                        <i class="bi bi-clock"></i>
                                        @contract.AllocatedHours.ToString("N1") hours
                                    </span>

                                </div>

                            </div>

                        </div>

                        <div class="contract-card-actions">

                            @if (contract.IsSignedByLecturer)
                            {
                                <span class="signature-badge signature-signed">
                                    <i class="bi bi-check-circle"></i>
                                    Signed
                                </span>
                            }
                            else if (contract.IsClosed)
                            {
                                <span class="signature-badge signature-declined">
                                    <i class="bi bi-lock"></i>
                                    Closed
                                </span>
                            }
                            else
                            {
                                <span class="signature-badge signature-pending">
                                    <i class="bi bi-clock"></i>
                                    Action Required
                                </span>
                            }

                            <a asp-page="/Lecturer/Contracts"
                               asp-route-ContractId="@contract.Id"
                               class="view-contract-button">
                                <span>View</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="empty-contracts">

                <div class="empty-contract-icon">
                    <i class="bi bi-file-earmark-x"></i>
                </div>

                <h3>No contracts available</h3>

                <p>
                    You do not have any academic contracts assigned to you yet.
                </p>

            </div>
        }

    </section>

</section>

