@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ClaimPreviewModel

@{
    Layout = null;
    ViewData["Title"] = "Claim Preview";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Claim Preview | UNILAK Staff Portal</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --primary: #174d3b;
                --primary-light: #236b51;
                --accent: #2a7f5e;
                --accent-light: #e1f0e8;
                --bg: #f5f8f6;
                --card: #ffffff;
                --border: #dce7e1;
                --text: #1a2b24;
                --text-muted: #60736a;
                --danger: #a94442;
                --radius: 16px;
                --shadow: 0 10px 30px rgba(23, 77, 59, 0.08);
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background: var(--bg);
                color: var(--text);
                min-height: 100vh;
            }

            /* =====================================================
                       HEADER
                       ===================================================== */

            .top-header {
                height: 72px;
                background: rgba(255,255,255,.97);
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .header-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .header-logo {
                width: 42px;
                height: 42px;
                object-fit: contain;
            }

            .header-title {
                font-size: 15px;
                font-weight: 700;
                color: var(--primary);
            }

            .header-subtitle {
                font-size: 11px;
                color: var(--text-muted);
                margin-top: 2px;
            }

            .header-user {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .user-icon {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .user-text {
                font-size: 12px;
            }

            .user-name {
                font-weight: 700;
            }

            .user-role {
                color: var(--text-muted);
                font-size: 10px;
            }

            /* =====================================================
                       PAGE
                       ===================================================== */

            .page {
                max-width: 1100px;
                margin: 0 auto;
                padding: 35px 25px 60px;
            }

            .page-heading {
                margin-bottom: 25px;
            }

                .page-heading h1 {
                    color: var(--primary);
                    font-size: 25px;
                    font-weight: 800;
                }

                .page-heading p {
                    color: var(--text-muted);
                    font-size: 12px;
                    margin-top: 6px;
                }

            /* =====================================================
                       ACTION BAR
                       ===================================================== */

            .action-bar {
                background: white;
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 15px 18px;
                margin-bottom: 22px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                box-shadow: var(--shadow);
            }

            .action-info {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 11px;
                color: var(--text-muted);
            }

                .action-info i {
                    color: var(--accent);
                    font-size: 17px;
                }

            .action-buttons {
                display: flex;
                gap: 10px;
            }

            .back-button,
            .sign-button {
                border: none;
                border-radius: 30px;
                padding: 12px 20px;
                font-family: inherit;
                font-size: 11px;
                font-weight: 700;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 7px;
                text-decoration: none;
            }

            .back-button {
                background: #f1f5f3;
                color: var(--text-muted);
            }

            .sign-button {
                background: var(--accent);
                color: white;
            }

                .sign-button:hover {
                    background: #216b4f;
                }

            /* =====================================================
                       OFFICIAL DOCUMENT
                       ===================================================== */

            .document {
                background: white;
                border: 1px solid #cfdad4;
                box-shadow: 0 15px 40px rgba(23,77,59,.10);
                padding: 65px 75px;
                position: relative;
            }

                .document::before {
                    content: "";
                    position: absolute;
                    top: 18px;
                    left: 18px;
                    right: 18px;
                    bottom: 18px;
                    border: 1px solid #dce7e1;
                    pointer-events: none;
                }

            .document-content {
                position: relative;
                z-index: 1;
            }

            /* =====================================================
                       DOCUMENT HEADER
                       ===================================================== */

            .document-header {
                text-align: center;
                padding-bottom: 25px;
                border-bottom: 2px solid var(--primary);
            }

            .document-logo {
                width: 70px;
                height: 70px;
                object-fit: contain;
                margin-bottom: 10px;
            }

            .institution {
                font-size: 18px;
                font-weight: 800;
                color: var(--primary);
                text-transform: uppercase;
            }

            .institution-subtitle {
                font-size: 10px;
                color: var(--text-muted);
                margin-top: 5px;
            }

            .document-title {
                font-size: 18px;
                font-weight: 800;
                margin-top: 25px;
                color: var(--text);
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .reference {
                margin-top: 8px;
                font-size: 10px;
                color: var(--text-muted);
            }

            /* =====================================================
                       LETTER
                       ===================================================== */

            .letter-body {
                margin-top: 35px;
                font-family: Georgia, 'Times New Roman', serif;
                font-size: 14px;
                line-height: 1.9;
                color: #28342f;
            }

                .letter-body p {
                    margin-bottom: 18px;
                }

            .subject {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 12px;
                font-weight: 800;
                text-transform: uppercase;
                margin: 25px 0 18px;
                color: var(--primary);
            }

            .highlight {
                font-weight: 700;
            }

            /* =====================================================
                       CLAIM DETAILS
                       ===================================================== */

            .claim-details {
                margin: 25px 0;
                padding: 20px;
                border: 1px solid var(--border);
                background: #fbfdfc;
            }

            .detail-row {
                display: flex;
                padding: 9px 0;
                border-bottom: 1px solid #edf1ef;
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 11px;
            }

                .detail-row:last-child {
                    border-bottom: none;
                }

            .detail-label {
                width: 190px;
                font-weight: 700;
                color: var(--text-muted);
            }

            .detail-value {
                flex: 1;
                font-weight: 600;
                color: var(--text);
            }

            /* =====================================================
                       AMOUNT
                       ===================================================== */

            .amount-box {
                margin: 25px 0;
                padding: 18px 20px;
                background: var(--accent-light);
                border: 1px solid #cde3d8;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .amount-label {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-muted);
            }

            .amount-value {
                font-size: 22px;
                font-weight: 800;
                color: var(--accent);
            }

            /* =====================================================
                       MIS VERIFICATION
                       ===================================================== */

            .verification {
                margin-top: 30px;
                padding: 17px;
                border: 1px solid var(--border);
                background: #f8fbf9;
            }

            .verification-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 11px;
                font-weight: 800;
                color: var(--primary);
                margin-bottom: 12px;
            }

            .verification-row {
                display: flex;
                align-items: center;
                gap: 8px;
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 10px;
                margin: 7px 0;
            }

                .verification-row i {
                    color: var(--accent);
                    font-size: 14px;
                }

            /* =====================================================
                       QR
                       ===================================================== */

            .qr-section {
                margin-top: 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-top: 1px solid var(--border);
                padding-top: 25px;
            }

            .qr-text {
                max-width: 500px;
            }

                .qr-text h3 {
                    font-family: 'Plus Jakarta Sans', sans-serif;
                    color: var(--primary);
                    font-size: 12px;
                    margin-bottom: 7px;
                }

                .qr-text p {
                    font-family: 'Plus Jakarta Sans', sans-serif;
                    font-size: 10px;
                    color: var(--text-muted);
                    line-height: 1.6;
                }

            .qr-code {
                width: 105px;
                height: 105px;
                border: 7px solid white;
                outline: 1px solid #cfdad4;
                background: linear-gradient(90deg, #174d3b 8px, transparent 8px) 0 0/24px 24px, linear-gradient(#174d3b 8px, transparent 8px) 0 0/24px 24px, linear-gradient(90deg, transparent 12px, #174d3b 12px 18px, transparent 18px) 0 0/24px 24px, linear-gradient(transparent 12px, #174d3b 12px 18px, transparent 18px) 0 0/24px 24px;
            }

            /* =====================================================
                       SIGNATURE
                       ===================================================== */

            .signature-section {
                margin-top: 35px;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 50px;
            }

            .signature-box {
                padding-top: 35px;
                border-top: 1px solid #46544e;
            }

            .signature-label {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 10px;
                font-weight: 700;
                color: var(--text-muted);
            }

            .signature-name {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 11px;
                font-weight: 700;
                margin-top: 5px;
            }

            /* =====================================================
                       FOOTER
                       ===================================================== */

            .document-footer {
                margin-top: 40px;
                padding-top: 15px;
                border-top: 1px solid var(--border);
                text-align: center;
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 9px;
                color: var(--text-muted);
            }

            /* =====================================================
                       RESPONSIVE
                       ===================================================== */

            @@media(max-width: 800px) {

                .page {
                    padding: 20px 10px;
                }

                .document {
                    padding: 40px 30px;
                }

                .action-bar {
                    flex-direction: column;
                    align-items: stretch;
                }

                .action-buttons {
                    justify-content: stretch;
                }

                    .action-buttons a,
                    .action-buttons button {
                        flex: 1;
                        justify-content: center;
                    }

                .signature-section {
                    grid-template-columns: 1fr;
                    gap: 35px;
                }

                .qr-section {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 20px;
                }

                .detail-row {
                    flex-direction: column;
                    gap: 4px;
                }

                .detail-label {
                    width: auto;
                }
            }

    </style>

</head>

<body>

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="top-header">

        <div class="header-left">

            <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                 class="header-logo"
                 alt="UNILAK">

            <div>

                <div class="header-title">
                    UNILAK Staff Portal
                </div>

                <div class="header-subtitle">
                    Academic Staff Engagement & Claim Processing
                </div>

            </div>

        </div>


        <div class="header-user">

            <div class="user-icon">
                <i class="bi bi-person"></i>
            </div>

            <div class="user-text">

                <div class="user-name">
                    @Model.Lecturer
                </div>

                <div class="user-role">
                    Lecturer
                </div>

            </div>

        </div>

    </header>


    <!-- =====================================================
         PAGE
         ===================================================== -->

    <main class="page">


        <div class="page-heading">

            <h1>
                Claim Preview
            </h1>

            <p>
                Review the generated claim document before signing.
            </p>

        </div>


        <!-- =================================================
             ACTION BAR
             ================================================= -->

        <div class="action-bar">

            <div class="action-info">

                <i class="bi bi-shield-check"></i>

                <span>
                    Review all claim information before applying your signature.
                </span>

            </div>


            <div class="action-buttons">

                <a href="/Lecturer/SubmitClaim"
                   class="back-button">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>


                <form method="post"
                      asp-page-handler="Sign">

                    <input type="hidden"
                           asp-for="Course" />

                    <input type="hidden"
                           asp-for="Lecturer" />

                    <input type="hidden"
                           asp-for="LecturerId" />

                    <input type="hidden"
                           asp-for="StartDate" />

                    <input type="hidden"
                           asp-for="FinishDate" />

                    <input type="hidden"
                           asp-for="Hours" />

                    <input type="hidden"
                           asp-for="MarksSubmitted" />

                    <input type="hidden"
                           asp-for="MarksSigned" />

                    <button type="submit"
                            class="sign-button">

                        <i class="bi bi-pen"></i>

                        Sign Claim

                    </button>

                </form>

            </div>

        </div>


        <!-- =================================================
             OFFICIAL DOCUMENT
             ================================================= -->

        <section class="document">

            <div class="document-content">


                <!-- DOCUMENT HEADER -->

                <div class="document-header">

                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         class="document-logo"
                         alt="UNILAK">

                    <div class="institution">
                        University of Lay Adventists of Kigali
                    </div>

                    <div class="institution-subtitle">
                        Academic Staff Engagement & Claim Processing System
                    </div>

                    <div class="document-title">
                        Teaching Claim Submission
                    </div>

                    <div class="reference">

                        Claim Reference:
                        <strong>@Model.ClaimReference</strong>

                    </div>

                </div>


                <!-- LETTER -->

                <div class="letter-body">

                    <p>
                        Date:
                        <span class="highlight">
                            @DateTime.Now.ToString("dd MMMM yyyy")
                        </span>
                    </p>


                    <p>
                        To:
                        <span class="highlight">
                            Academic Administration
                        </span>
                    </p>


                    <div class="subject">
                        Subject: Claim for Academic Teaching Services
                    </div>


                    <p>
                        I,
                        <span class="highlight">
                            @Model.Lecturer
                        </span>,
                        Staff ID
                        <span class="highlight">
                            @Model.LecturerId
                        </span>,
                        hereby submit this claim for academic teaching services
                        rendered during the period specified below.
                    </p>


                    <p>
                        The claim relates to the teaching and academic activities
                        performed for the course
                        <span class="highlight">
                            @Model.Course
                        </span>.
                    </p>


                    <!-- CLAIM DETAILS -->

                    <div class="claim-details">

                        <div class="detail-row">

                            <div class="detail-label">
                                Lecturer
                            </div>

                            <div class="detail-value">
                                @Model.Lecturer
                            </div>

                        </div>


                        <div class="detail-row">

                            <div class="detail-label">
                                Staff ID
                            </div>

                            <div class="detail-value">
                                @Model.LecturerId
                            </div>

                        </div>


                        <div class="detail-row">

                            <div class="detail-label">
                                Course
                            </div>

                            <div class="detail-value">
                                @Model.Course
                            </div>

                        </div>


                        <div class="detail-row">

                            <div class="detail-label">
                                Teaching Start Date
                            </div>

                            <div class="detail-value">
                                @Model.StartDate
                            </div>

                        </div>


                        <div class="detail-row">

                            <div class="detail-label">
                                Teaching Finish Date
                            </div>

                            <div class="detail-value">
                                @Model.FinishDate
                            </div>

                        </div>


                        <div class="detail-row">

                            <div class="detail-label">
                                Teaching Hours
                            </div>

                            <div class="detail-value">
                                @Model.Hours hours
                            </div>

                        </div>


                        <div class="detail-row">

                            <div class="detail-label">
                                Rate Per Hour
                            </div>

                            <div class="detail-value">
                                RWF @Model.RatePerHour.ToString("N0")
                            </div>

                        </div>

                    </div>


                    <!-- AMOUNT -->

                    <div class="amount-box">

                        <div class="amount-label">
                            TOTAL CLAIM AMOUNT
                        </div>

                        <div class="amount-value">
                            RWF @Model.TotalAmount.ToString("N0")
                        </div>

                    </div>


                    <p>
                        I certify that the information provided in this claim is
                        accurate and represents academic services actually
                        rendered during the stated period. I acknowledge that
                        the claim is subject to verification and approval by
                        the relevant university authorities.
                    </p>


                    <!-- MIS VERIFICATION -->

                    <div class="verification">

                        <div class="verification-title">

                            <i class="bi bi-database-check"></i>

                            MIS ACADEMIC RECORD VERIFICATION

                        </div>


                        <div class="verification-row">

                            <i class="bi bi-check-circle-fill"></i>

                            Marks submitted in MIS:
                            <strong>Verified</strong>

                        </div>


                        <div class="verification-row">

                            <i class="bi bi-check-circle-fill"></i>

                            Marks signed:
                            <strong>Verified</strong>

                        </div>


                        <div class="verification-row">

                            <i class="bi bi-check-circle-fill"></i>

                            Academic records matched:
                            <strong>Verified</strong>

                        </div>

                    </div>


                    <!-- QR -->

                    <div class="qr-section">

                        <div class="qr-text">

                            <h3>
                                Supporting Documents
                            </h3>

                            <p>
                                Scan the QR code to access the supporting
                                documents associated with this claim,
                                including the approved contract, submitted
                                marks and other verified academic records.
                            </p>

                        </div>


                        <div class="qr-code"
                             title="Claim verification QR code">
                        </div>

                    </div>


                    <!-- SIGNATURE -->

                    <div class="signature-section">

                        <div class="signature-box">

                            <div class="signature-label">
                                Lecturer Signature
                            </div>

                            <div class="signature-name">
                                @Model.Lecturer
                            </div>

                        </div>


                        <div class="signature-box">

                            <div class="signature-label">
                                Date
                            </div>

                            <div class="signature-name">
                                __________________________
                            </div>

                        </div>

                    </div>


                    <!-- FOOTER -->

                    <div class="document-footer">

                        This document was generated electronically by the
                        Academic Staff Engagement & Claim Processing System.
                        <br />

                        Claim Reference:
                        @Model.ClaimReference

                    </div>

                </div>

            </div>

        </section>

    </main>

</body>

</html>