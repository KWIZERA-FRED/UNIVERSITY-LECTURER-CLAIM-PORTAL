@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.SubmitClaimModel

@{
    ViewData["Title"] = "Submit Claim";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Lecturer/submit-claim.css"
          asp-append-version="true" />
}

<section class="submit-claim-page">

    <header class="page-header">
        <h1>Submit Claim</h1>
        <p>Select an assigned course and submit a payment claim.</p>
    </header>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <section class="section-card">

        <header class="section-header">
            <h2>Teaching Claim Details</h2>
        </header>

        <form method="post">

            <div class="form-body">

                <div class="form-grid">

                    <div class="form-group form-group-full">

                        <label for="course">Course <span>*</span></label>

                        <select asp-for="SelectedCourseAssignmentId"
                                id="course"
                                class="form-control"
                                onchange="updateClaimVerification()">

                            <option value="">Select course</option>

                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.AssignmentId"
                                        data-submitted="@course.MarksSubmitted.ToString().ToLowerInvariant()"
                                        data-signed="@course.MarksSigned.ToString().ToLowerInvariant()"
                                        data-hours="@course.AllocatedHours">

                                    @course.Code - @course.Name
                                    (@course.AcademicYear, @course.Semester, @course.AllocatedHours hours)

                                </option>
                            }

                        </select>

                    </div>

                    <div class="form-group">

                        <label for="hours">Allocated Teaching Hours</label>

                        <input asp-for="Hours"
                               id="hours"
                               type="number"
                               min="0"
                               step="0.5"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="form-group">

                        <label for="lecturer">Lecturer</label>

                        <input id="lecturer"
                               value="@Model.LecturerName"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <div class="form-divider"></div>

                <div class="form-section">

                    <h3 class="form-section-title">Claim Evidence Verification</h3>

                    <div class="verification-grid">

                        <div class="verification-item">

                            <span class="verification-label">
                                Marks Submission
                            </span>

                            <span class="status-value"
                                  id="marks-submitted-status">

                                <i class="bi bi-dash-circle"></i>
                                Select a course

                            </span>

                        </div>

                        <div class="verification-item">

                            <span class="verification-label">
                                Exam Office Signature
                            </span>

                            <span class="status-value"
                                  id="marks-signed-status">

                                <i class="bi bi-dash-circle"></i>
                                Select a course

                            </span>

                        </div>

                        <div class="verification-item">

                            <span class="verification-label">
                                MIS Attendance
                            </span>

                            <span class="status-value status-information"
                                  id="attendance-status">

                                <i class="bi bi-cloud-arrow-down"></i>
                                Retrieved when claim is submitted

                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <footer class="form-actions">

                <button type="submit"
                        class="primary-button">

                    <i class="bi bi-file-earmark-check"></i>
                    Generate Claim

                </button>

            </footer>

        </form>

    </section>

</section>

@section Scripts {

<script>
    function updateClaimVerification() {
        const select = document.getElementById("course");
        const option = select.options[select.selectedIndex];

        const submittedElement = document.getElementById("marks-submitted-status");
        const signedElement = document.getElementById("marks-signed-status");
        const attendanceElement = document.getElementById("attendance-status");
        const hoursInput = document.getElementById("hours");

        if (!option || !option.value) {

            submittedElement.className = "status-value";
            submittedElement.innerHTML =
                '<i class="bi bi-dash-circle"></i> Select a course';

            signedElement.className = "status-value";
            signedElement.innerHTML =
                '<i class="bi bi-dash-circle"></i> Select a course';

            attendanceElement.className = "status-value status-information";
            attendanceElement.innerHTML =
                '<i class="bi bi-cloud-arrow-down"></i> Retrieved when claim is submitted';

            hoursInput.value = "";

            return;
        }

        const submitted = option.getAttribute("data-submitted") === "true";
        const signed = option.getAttribute("data-signed") === "true";
        const hours = option.getAttribute("data-hours");

        hoursInput.value = hours || "";

        submittedElement.className =
            "status-value " + (submitted ? "status-positive" : "status-negative");

        submittedElement.innerHTML =
            submitted
                ? '<i class="bi bi-check-circle-fill"></i> Submitted'
                : '<i class="bi bi-x-circle-fill"></i> Not submitted';

        signedElement.className =
            "status-value " + (signed ? "status-positive" : "status-negative");

        signedElement.innerHTML =
            signed
                ? '<i class="bi bi-check-circle-fill"></i> Signed by Exam Office'
                : '<i class="bi bi-x-circle-fill"></i> Not signed';

        attendanceElement.className = "status-value status-information";
        attendanceElement.innerHTML =
            '<i class="bi bi-cloud-arrow-down"></i> Retrieved from MIS during submission';
    }

    document.addEventListener("DOMContentLoaded", updateClaimVerification);
</script>

}