@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.SubmitClaimModel

@{
    ViewData["Title"] = "Submit Claim";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Lecturer/submit-claim.css"
          asp-append-version="true" />
}

<section class="submit-claim-page">

    <header class="claim-page-header">

        <div class="claim-heading">

            <span class="page-eyebrow">
                Lecturer Portal
            </span>

            <h1>
                Submit Claim
            </h1>

            <p>
                Submit a teaching claim after marks have been submitted
                and signed in MIS.
            </p>

        </div>

    </header>


    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="claim-alert claim-alert-error">

            <span class="claim-alert-icon">
                <i class="bi bi-exclamation-circle"></i>
            </span>

            <span>
                @Model.ErrorMessage
            </span>

        </div>
    }


    <section class="claim-form-card">

        <div class="claim-section-header">

            <div class="claim-section-icon">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div>

                <span class="section-eyebrow">
                    Payment Claim
                </span>

                <h2>
                    Teaching Claim Details
                </h2>

                <p>
                    Provide the verified teaching hours for the selected course.
                </p>

            </div>

        </div>


        <form method="post">

            <div class="claim-form-body">

                <div class="form-grid">

                    <div class="form-group form-group-full">

                        <label for="course">
                            Course
                        </label>

                        <select asp-for="SelectedCourseAssignmentId"
                                id="course"
                                onchange="updateMisStatus()">

                            <option value="">
                                Select course
                            </option>

                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.AssignmentId"
                                        data-submitted="@course.MarksSubmitted.ToString().ToLowerInvariant()"
                                        data-signed="@course.MarksSigned.ToString().ToLowerInvariant()">

                                    @course.Code - @course.Name
                                    (@course.AcademicYear, @course.AllocatedHours hours)

                                </option>
                            }

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="hours">
                            Verified Teaching Hours
                        </label>

                        <input asp-for="Hours"
                               id="hours"
                               type="number"
                               min="0.5"
                               step="0.5"
                               placeholder="Enter the allocated hours" />

                    </div>


                    <div class="form-group">

                        <label for="lecturer">
                            Lecturer
                        </label>

                        <input id="lecturer"
                               value="@Model.LecturerName"
                               readonly />

                    </div>

                </div>


                <section class="mis-verification">

                    <div class="mis-header">

                        <div class="mis-header-icon">
                            <i class="bi bi-database-check"></i>
                        </div>

                        <div>

                            <h3>
                                MIS Verification
                            </h3>

                            <p>
                                Course marks must be submitted and signed before a claim can be created.
                            </p>

                        </div>

                    </div>


                    <div class="mis-status-grid">

                        <div class="status-item">

                            <div class="status-item-label">
                                Marks Submitted
                            </div>

                            <div class="status-value"
                                 id="marks-submitted-status">

                                <i class="bi bi-dash-circle"></i>

                                Select a course

                            </div>

                        </div>


                        <div class="status-item">

                            <div class="status-item-label">
                                Marks Signed
                            </div>

                            <div class="status-value"
                                 id="marks-signed-status">

                                <i class="bi bi-dash-circle"></i>

                                Select a course

                            </div>

                        </div>

                    </div>

                </section>


                <div class="claim-information">

                    <div class="claim-information-icon">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>

                    <div>

                        <strong>
                            Before submitting
                        </strong>

                        <p>
                            The number of hours must exactly match the approved allocation.
                            The system verifies that an active, fully signed contract and an
                            Exam Office-signed marks submission exist before creating the claim.
                        </p>

                    </div>

                </div>

            </div>


            <div class="claim-form-actions">

                <button type="submit"
                        class="submit-claim-button">

                    <i class="bi bi-file-earmark-check"></i>

                    Submit Claim

                </button>

            </div>

        </form>

    </section>

</section>


@section Scripts {

    <script>
        function updateMisStatus() {

            const select = document.getElementById("course");

            const option = select.options[select.selectedIndex];

            const submittedElement =
                document.getElementById("marks-submitted-status");

            const signedElement =
                document.getElementById("marks-signed-status");


            if (!option || !option.value) {

                submittedElement.className = "status-value";
                submittedElement.innerHTML =
                    '<i class="bi bi-dash-circle"></i> Select a course';

                signedElement.className = "status-value";
                signedElement.innerHTML =
                    '<i class="bi bi-dash-circle"></i> Select a course';

                return;
            }


            const submitted =
                option.getAttribute("data-submitted") === "true";

            const signed =
                option.getAttribute("data-signed") === "true";


            submittedElement.className =
                "status-value" + (submitted ? "" : " status-negative");

            submittedElement.innerHTML = submitted
                ? '<i class="bi bi-check-circle-fill"></i> Verified'
                : '<i class="bi bi-x-circle-fill"></i> Not submitted';


            signedElement.className =
                "status-value" + (signed ? "" : " status-negative");

            signedElement.innerHTML = signed
                ? '<i class="bi bi-check-circle-fill"></i> Verified'
                : '<i class="bi bi-x-circle-fill"></i> Not signed';
        }


        document.addEventListener(
            "DOMContentLoaded",
            updateMisStatus
        );
    </script>

}