@page
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ClaimDetailModel

@{
    ViewData["Title"] = "Claim Detail";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link
        rel="stylesheet"
        href="~/css/Lecturer/claim-detail.css"
        asp-append-version="true" />
}

<section class="claim-detail-page">

    <header class="claim-detail-header">

        <div class="claim-detail-heading">

            <span class="page-eyebrow">
                Lecturer Portal
            </span>

            <h1>
                Claim Detail
            </h1>

            <p>
                Track your claim's approval progress and access official documents.
            </p>

        </div>

        <a
            class="back-button"
            href="/Lecturer/Claims">

            <i class="bi bi-arrow-left"></i>

            Back to Claims

        </a>

    </header>


    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="claim-alert claim-alert-error">

            <span class="claim-alert-icon">
                <i class="bi bi-exclamation-circle-fill"></i>
            </span>

            <div>

                <strong>
                    Claim unavailable
                </strong>

                <span>
                    @Model.ErrorMessage
                </span>

            </div>

        </div>
    }
    else if (Model.Claim is not null)
    {
        var claim = Model.Claim;

        <section class="claim-detail-card">

            <div class="claim-card-header">

                <div>

                    <span class="section-eyebrow">
                        Claim Reference
                    </span>

                    <h2>
                        @claim.Reference
                    </h2>

                </div>

                <span
                    class="claim-status-badge @(claim.IsFullyApproved ? "status-approved" : claim.IsRejected ? "status-rejected" : "status-pending")">

                    @claim.Status

                </span>

            </div>


            <div class="claim-meta-grid">

                <div class="meta-item">

                    <div class="meta-label">
                        Course
                    </div>

                    <div class="meta-value">
                        @claim.CourseCode - @claim.CourseTitle
                    </div>

                </div>


                <div class="meta-item">

                    <div class="meta-label">
                        Contract
                    </div>

                    <div class="meta-value">
                        @claim.ContractReference
                    </div>

                </div>


                <div class="meta-item">

                    <div class="meta-label">
                        Academic Year
                    </div>

                    <div class="meta-value">
                        @claim.AcademicYear
                    </div>

                </div>


                <div class="meta-item">

                    <div class="meta-label">
                        Campus
                    </div>

                    <div class="meta-value">
                        @claim.Campus
                    </div>

                </div>


                <div class="meta-item">

                    <div class="meta-label">
                        Hours Claimed
                    </div>

                    <div class="meta-value">
                        @claim.HoursClaimed.ToString("N1")
                    </div>

                </div>


                <div class="meta-item">

                    <div class="meta-label">
                        Submitted
                    </div>

                    <div class="meta-value">
                        @(claim.SubmittedAtUtc.HasValue
                            ? claim.SubmittedAtUtc.Value.ToString("dd MMM yyyy")
                            : "-")
                    </div>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(claim.Description))
            {
                <div class="claim-description">

                    <div class="meta-label">
                        Description
                    </div>

                    <div class="description-value">
                        @claim.Description
                    </div>

                </div>
            }

        </section>


        <section class="claim-detail-card">

            <div class="card-section-heading">

                <div class="section-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>

                <div>

                    <span class="section-eyebrow">
                        Approval Process
                    </span>

                    <h2>
                        Approval Timeline
                    </h2>

                    <p>
                        Track the progress of your claim through each approval stage.
                    </p>

                </div>

            </div>


            @if (claim.Steps.Any())
            {
                <div class="approval-timeline">

                    @foreach (var step in claim.Steps)
                    {
                        <div class="timeline-step">

                            <div class="timeline-role">
                                @step.RoleLabel
                            </div>

                            <div class="timeline-content">

                                <div class="timeline-status">

                                    <span class="step-badge @step.BadgeClass">
                                        @step.Decision
                                    </span>

                                    @if (step.DecidedAtUtc.HasValue)
                                    {
                                        <span class="timeline-date">

                                            @step.DecidedAtUtc.Value.ToString("dd MMM yyyy")

                                            @if (!string.IsNullOrWhiteSpace(step.ApproverName))
                                            {
                                                <span>
                                                    · @step.ApproverName
                                                </span>
                                            }

                                        </span>
                                    }

                                </div>

                                @if (!string.IsNullOrWhiteSpace(step.Comments))
                                {
                                    <div class="step-comments">
                                        @step.Comments
                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="timeline-empty">

                    <div class="timeline-empty-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div>

                        <strong>
                            Approval process pending
                        </strong>

                        <p>
                            No approval activity has been recorded for this claim yet.
                        </p>

                    </div>

                </div>
            }

        </section>


        @if (claim.IsFullyApproved)
        {
            <section class="claim-detail-card documents-card">

                <div class="card-section-heading">

                    <div class="section-icon">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>

                    <div>

                        <span class="section-eyebrow">
                            Official Documents
                        </span>

                        <h2>
                            Claim Documents
                        </h2>

                        <p>
                            Your claim has been approved. Access the official claim documents below.
                        </p>

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(claim.PublicDocumentsUrl))
                {
                    <div class="document-actions">

                        <a
                            class="document-button"
                            href="@claim.PublicDocumentsUrl"
                            target="_blank"
                            rel="noopener noreferrer">

                            <i class="bi bi-folder2-open"></i>

                            Open Claim Documents

                        </a>

                    </div>
                }
                else
                {
                    <div class="documents-unavailable">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Official documents are not currently available.
                        </span>

                    </div>
                }

            </section>
        }

    }

</section>