@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.IndexModel

@{
    ViewData["Title"] = "Lecturer Dashboard";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Lecturer/dashboard.css"
          asp-append-version="true" />
}

<section class="ds-page ld-page">

    @* ---------------- Header ---------------- *@

    <header class="ld-header">

        <div class="ld-header-main">
            <h1>Welcome back, @Model.DisplayName</h1>
            <p>Contracts to sign, claims in progress and your courses.</p>
        </div>

        <div class="ld-header-actions">

            <a asp-page="/Lecturer/SubmitMarks"
               class="ds-btn ds-btn--quiet">
                <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
                Submit marks
            </a>

            <a asp-page="/Lecturer/SubmitClaim"
               class="ds-btn ds-btn--primary">
                <i class="bi bi-send" aria-hidden="true"></i>
                Submit claim
            </a>

        </div>

    </header>


    @* ---------------- Next action strip ---------------- *@

    @if (Model.SignatureBlockedItem is not null)
    {
        <div class="ld-milestone ld-milestone--warn" role="status">

            <span class="ld-milestone-icon" aria-hidden="true">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </span>

            <p class="ld-milestone-text">
                <strong>Your signature isn't on file yet.</strong>
                <strong>@Model.SignatureBlockedItem.Reference</strong>
                is ready for you, but you can't sign it until your
                HOD captures your signature.
            </p>

            <a href="@Model.SignatureBlockedItem.ReviewUrl"
               class="ld-milestone-btn">
                View contract
            </a>

        </div>
    }
    else if (Model.NextAction is not null)
    {
        <div class="ld-milestone" role="status">

            <span class="ld-milestone-icon" aria-hidden="true">
                <i class="bi @(Model.NextAction.IsContract ? "bi-pen-fill" : "bi-send-fill")"></i>
            </span>

            <p class="ld-milestone-text">
                <strong>@Model.NextAction.Reference</strong>
                for @Model.NextAction.CourseTitle
                @Model.NextAction.PromptText :
                waiting @Model.NextActionWaitText.
                @if (Model.ActionCount > 1)
                {
                    <text>
                        <strong>@(Model.ActionCount - 1) more</strong> waiting.
                    </text>
                }
            </p>

            <a href="@Model.NextAction.ReviewUrl"
               class="ld-milestone-btn">
                @Model.NextAction.ActionLabel
            </a>

        </div>
    }
    else
    {
        <div class="ld-milestone ld-milestone--calm" role="status">

            <span class="ld-milestone-icon" aria-hidden="true">
                <i class="bi bi-check2-circle"></i>
            </span>

            <p class="ld-milestone-text">
                <strong>You're all caught up.</strong>
                Nothing is waiting for you right now.
                @if (Model.InReviewCount > 0)
                {
                    <text>
                        <strong>@Model.InReviewCount</strong>
                        @(Model.InReviewCount == 1 ? "item is" : "items are")
                        with approvers.
                    </text>
                }
            </p>

        </div>
    }


    @* ---------------- Workflow cards — three tiers, full width ---------------- *@

    <section class="ld-workflow" aria-label="Your workflow">

        <a asp-page="/Lecturer/Index"
           asp-route-filter="needs-action"
           data-filter="needs-action"
           class="ld-workflow-card ld-workflow-card--action">

            <span class="ld-workflow-label">
                Needs your action
                <i class="bi bi-info-circle"
                   aria-hidden="true"
                   title="Contracts waiting for your signature and claims you have not submitted yet."></i>
            </span>

            <span class="ld-workflow-value">@Model.ActionCount</span>

            <span class="ld-workflow-meta">
                @if (Model.ActionCount > 0)
                {
                    <text>Oldest waiting @Model.OldestActionText</text>
                }
                else
                {
                    <text>Nothing for you to do</text>
                }
            </span>

        </a>

        <a asp-page="/Lecturer/Index"
           asp-route-filter="in-review"
           data-filter="in-review"
           class="ld-workflow-card ld-workflow-card--waiting">

            <span class="ld-workflow-label">
                With approvers
                <i class="bi bi-info-circle"
                   aria-hidden="true"
                   title="Contracts you have signed and claims you have submitted that are still moving through approval."></i>
            </span>

            <span class="ld-workflow-value">@Model.InReviewCount</span>

            <span class="ld-workflow-meta">
                You've done your part — still in progress
            </span>

        </a>

        <a asp-page="/Lecturer/Index"
           asp-route-filter="closed"
           data-filter="closed"
           class="ld-workflow-card ld-workflow-card--done">

            <span class="ld-workflow-label">
                Approved &amp; paid
                <i class="bi bi-info-circle"
                   aria-hidden="true"
                   title="Claims that have been fully approved or paid."></i>
            </span>

            <span class="ld-workflow-value">@Model.ApprovedPaidCount</span>

            <span class="ld-workflow-meta">
                @if (Model.ApprovedPaidCount > 0)
                {
                    <text>RWF @Model.ApprovedPaidAmount.ToString("N0") in total</text>
                }
                else
                {
                    <text>No approved claims yet</text>
                }
            </span>

        </a>

    </section>


    @* ---------------- Full-time notice ---------------- *@

    @if (Model.IsFullTime)
    {
        <div class="ld-note" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>Teaching-hour data will sync automatically once MIS integration is available.</span>
        </div>
    }


    @* ---------------- Queue ---------------- *@

    <section class="ds-card" id="ld-queue">

        <div class="ds-card-header">

            <h2>The queue</h2>

            <nav class="ds-chips" aria-label="Filter the queue">

                <a asp-page="/Lecturer/Index"
                   asp-route-filter="needs-action"
                   asp-route-q="@Model.Q"
                   data-filter="needs-action"
                   class="ds-chip @(Model.ActiveFilter == "needs-action" ? "is-active" : "")">
                    Needs your action
                    <span class="ds-chip-count">@Model.ActionCount</span>
                </a>

                <a asp-page="/Lecturer/Index"
                   asp-route-filter="in-review"
                   asp-route-q="@Model.Q"
                   data-filter="in-review"
                   class="ds-chip @(Model.ActiveFilter == "in-review" ? "is-active" : "")">
                    In review
                    <span class="ds-chip-count">@Model.InReviewCount</span>
                </a>

                <a asp-page="/Lecturer/Index"
                   asp-route-filter="closed"
                   asp-route-q="@Model.Q"
                   data-filter="closed"
                   class="ds-chip @(Model.ActiveFilter == "closed" ? "is-active" : "")">
                    Closed
                    <span class="ds-chip-count">@Model.ClosedCount</span>
                </a>

                <a asp-page="/Lecturer/Index"
                   asp-route-filter="all"
                   asp-route-q="@Model.Q"
                   data-filter="all"
                   class="ds-chip @(Model.ActiveFilter == "all" ? "is-active" : "")">
                    All
                    <span class="ds-chip-count">@Model.AllCount</span>
                </a>

            </nav>

        </div>

        <div class="ld-toolbar">

            <form method="get"
                  asp-page="/Lecturer/Index"
                  id="ld-search-form"
                  class="ds-search"
                  role="search">

                <i class="bi bi-search" aria-hidden="true"></i>

                <input type="hidden" name="filter" value="@Model.ActiveFilter" />

                <input type="search"
                       id="ld-search"
                       name="q"
                       value="@Model.Q"
                       autocomplete="off"
                       aria-keyshortcuts="/"
                       placeholder="Search reference or course"
                       aria-label="Search reference or course" />

                <span class="ds-search-hint" aria-hidden="true">Press /</span>

            </form>

        </div>

        <div class="ld-list"
             id="ld-list"
             role="list"
             data-filter="@Model.ActiveFilter">

            <div class="ld-row ld-row--head" id="ld-head" aria-hidden="true">
                <span>Reference</span>
                <span>Course</span>
                <span>Value</span>
                <span>Stage</span>
                <span></span>
            </div>

            @foreach (var item in Model.Items)
            {
                <article class="ld-row @(item.NeedsAction ? "ld-row--needs" : "")"
                         role="listitem"
                         data-bucket="@Model.BucketKey(item)"
                         data-search="@Model.SearchKey(item)"
                         hidden="@(!Model.IsVisibleOnLoad(item))">

                    <div class="ld-cell ld-ref">

                        <span class="ld-avatar" aria-hidden="true">
                            <i class="bi @(item.IsClaim ? "bi-receipt" : "bi-file-earmark-text")"></i>
                        </span>

                        <div class="ld-ref-body">

                            <div class="ld-ref-line">
                                <span class="ld-ref-code">@item.Reference</span>

                                <button type="button"
                                        class="ds-copy"
                                        data-copy="@item.Reference"
                                        aria-label="Copy reference @item.Reference">
                                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                                </button>
                            </div>

                            <span class="ds-tag @(item.IsClaim ? "ds-tag--claim" : "ds-tag--contract")">
                                @(item.IsClaim ? "Claim" : "Contract")
                            </span>

                        </div>

                    </div>

                    <div class="ld-cell ld-who">
                        <span class="ld-who-name">@item.CourseTitle</span>

                        <span class="ld-who-course">
                            @if (!string.IsNullOrWhiteSpace(item.CourseCode))
                            {
                                <text>@item.CourseCode</text>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </span>
                    </div>

                    <div class="ld-cell ld-value">
                        <span class="ld-value-amount">RWF @item.Amount.ToString("N0")</span>
                        <span class="ld-value-hours">@item.Hours.ToString("0.##") hours</span>
                    </div>

                    <div class="ld-cell ld-stage">
                        <span class="ld-stage-pill ld-stage-pill--@item.PillTone">
                            @item.StatusText
                            <span class="ld-stage-sep" aria-hidden="true">·</span>
                            <span class="ld-stage-wait @item.WaitTone">@item.WaitText</span>
                        </span>
                    </div>

                    <div class="ld-cell ld-action">
                        <a href="@item.ReviewUrl"
                           class="ld-row-action"
                           aria-label="Open @item.Reference">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </div>

                </article>
            }

        </div>

        <div class="ds-empty" id="ld-empty" hidden>
            <span class="ds-empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></span>
            <h3 id="ld-empty-title"></h3>
            <p id="ld-empty-text"></p>
            <button type="button"
                    class="ds-btn ds-btn--quiet"
                    id="ld-empty-action"
                    hidden></button>
        </div>

        <div class="ld-footnote" id="ld-footnote">
            @if (Model.IsTruncated)
            {
                <text>Showing the first 300 items.</text>
            }
        </div>

        <div class="ds-visually-hidden" id="ld-summary" aria-live="polite"></div>

    </section>


    @* ---------------- Your courses ---------------- *@

    <section class="ds-card">

        <header class="ds-card-header">

            <h2>Your courses</h2>

            <span class="ld-card-meta">
                @Model.ActiveCourseCount
                @(Model.ActiveCourseCount == 1 ? "course" : "courses")
                ·
                @Model.TotalAllocatedHours.ToString("0.##") hours allocated
            </span>

        </header>

        @if (Model.CourseAssignments.Any())
        {
            <div class="ld-courses" role="list">

                <div class="ld-crow ld-crow--head" aria-hidden="true">
                    <span>Course</span>
                    <span>Term</span>
                    <span>Delivery</span>
                    <span>Hours</span>
                    <span>Status</span>
                </div>

                @foreach (var assignment in Model.CourseAssignments)
                {
                    <article class="ld-crow" role="listitem">

                        <div class="ld-crow-course">
                            <span class="ld-crow-title">@assignment.Course.Title</span>
                            <span class="ld-crow-code">@assignment.Course.Code</span>
                        </div>

                        <div class="ld-crow-text">
                            @assignment.AcademicYear · @assignment.Semester
                        </div>

                        <div class="ld-crow-text">
                            @assignment.Session · @assignment.Campus
                        </div>

                        <div class="ld-crow-hours">
                            @assignment.AllocatedHours.ToString("0.##") hours
                        </div>

                        <div class="ld-crow-status">
                            @if (assignment.IsApproved)
                            {
                                <span class="ld-stage-pill ld-stage-pill--done">Approved</span>
                            }
                            else
                            {
                                <span class="ld-stage-pill">Pending approval</span>
                            }
                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="ds-empty">
                <span class="ds-empty-icon"><i class="bi bi-journal-x" aria-hidden="true"></i></span>
                <h3>No course assignments</h3>
                <p>Your teaching engagements will appear here once they are assigned by your faculty.</p>
            </div>
        }

    </section>


    @* ---------------- Recent activity ---------------- *@

    @if (Model.Activity.Any())
    {
        <section class="ds-card">

            <header class="ds-card-header">
                <h2>Your recent activity</h2>
            </header>

            <ul class="ds-activity">

                @foreach (var entry in Model.Activity)
                {
                    <li class="ds-activity-item">

                        <span class="ds-activity-dot @(entry.Positive ? "ds-activity-dot--done" : "ds-activity-dot--rejected")"
                              aria-hidden="true"></span>

                        <span class="ds-activity-text">
                            @entry.Verb <strong>@entry.Reference</strong>
                            · @entry.Detail
                        </span>

                        <span class="ds-activity-when">@entry.WhenText</span>

                    </li>
                }

            </ul>

        </section>
    }

</section>

@section Scripts {
    <script>
        (function () {

            // ---------------- Copy a reference ----------------

            document.addEventListener("click", async function (event) {

                var button = event.target.closest("[data-copy]");

                if (!button) {
                    return;
                }

                var text = button.getAttribute("data-copy");

                try {
                    await navigator.clipboard.writeText(text);
                } catch (err) {
                    var temp = document.createElement("textarea");
                    temp.value = text;
                    document.body.appendChild(temp);
                    temp.select();
                    document.execCommand("copy");
                    document.body.removeChild(temp);
                }

                button.classList.add("is-copied");

                setTimeout(function () {
                    button.classList.remove("is-copied");
                }, 1500);
            });


            // ---------------- Live search + tabs ----------------

            var list = document.getElementById("ld-list");

            if (!list) {
                return;
            }

            var rows = Array.prototype.slice.call(
                list.querySelectorAll(".ld-row[data-bucket]"));

            var head = document.getElementById("ld-head");
            var input = document.getElementById("ld-search");
            var form = document.getElementById("ld-search-form");
            var queue = document.getElementById("ld-queue");
            var empty = document.getElementById("ld-empty");
            var emptyTitle = document.getElementById("ld-empty-title");
            var emptyText = document.getElementById("ld-empty-text");
            var emptyAction = document.getElementById("ld-empty-action");
            var footnote = document.getElementById("ld-footnote");
            var summary = document.getElementById("ld-summary");

            var chips = Array.prototype.slice.call(
                document.querySelectorAll(".ds-chip[data-filter]"));

            var triggers = Array.prototype.slice.call(
                document.querySelectorAll("a[data-filter]"));

            var baseFootnote = footnote.textContent.trim();
            var tab = list.getAttribute("data-filter") || "needs-action";
            var emptyMode = "";
            var timer = null;

            function inTab(bucket) {
                if (tab === "all") { return true; }
                if (tab === "in-review") { return bucket === "review"; }
                if (tab === "closed") { return bucket === "closed"; }
                return bucket === "needs";
            }

            function plural(n, one, many) {
                return n + " " + (n === 1 ? one : many);
            }

            function showEmpty(title, text, actionLabel, mode) {
                empty.hidden = false;
                footnote.hidden = true;
                emptyTitle.textContent = title;
                emptyText.textContent = text;
                emptyMode = mode || "";

                if (actionLabel) {
                    emptyAction.textContent = actionLabel;
                    emptyAction.hidden = false;
                } else {
                    emptyAction.hidden = true;
                }
            }

            function apply() {

                var query = input.value.trim();
                var terms = query.toLowerCase().split(/\s+/).filter(Boolean);

                var counts = { "needs-action": 0, "in-review": 0, closed: 0, all: 0 };
                var shown = 0;

                rows.forEach(function (row) {

                    var key = row.getAttribute("data-search") || "";
                    var bucket = row.getAttribute("data-bucket");

                    var matches = terms.every(function (term) {
                        return key.indexOf(term) !== -1;
                    });

                    if (matches) {
                        counts.all++;

                        if (bucket === "needs") {
                            counts["needs-action"]++;
                        } else if (bucket === "closed") {
                            counts.closed++;
                        } else {
                            counts["in-review"]++;
                        }
                    }

                    var visible = matches && inTab(bucket);

                    row.hidden = !visible;

                    if (visible) {
                        shown++;
                    }
                });

                var url = new URL(window.location.href);
                url.searchParams.set("filter", tab);

                if (query) {
                    url.searchParams.set("q", query);
                } else {
                    url.searchParams.delete("q");
                }

                chips.forEach(function (chip) {

                    var filter = chip.getAttribute("data-filter");
                    var count = chip.querySelector(".ds-chip-count");

                    chip.classList.toggle("is-active", filter === tab);

                    if (count) {
                        count.textContent = counts[filter];
                    }

                    var chipUrl = new URL(url.toString());
                    chipUrl.searchParams.set("filter", filter);

                    chip.setAttribute("href", chipUrl.pathname + chipUrl.search);
                });

                window.history.replaceState(null, "", url.toString());

                head.hidden = shown === 0;

                if (shown > 0) {

                    empty.hidden = true;
                    footnote.hidden = false;

                    if (query) {
                        footnote.textContent =
                            plural(shown, "result", "results") + " for “" + query + "”";
                    } else if (tab === "closed") {
                        footnote.textContent =
                            "Most recently updated first." +
                            (baseFootnote ? " " + baseFootnote : "");
                    } else if (tab === "all") {
                        footnote.textContent =
                            "Open items first, then closed items — most recent first." +
                            (baseFootnote ? " " + baseFootnote : "");
                    } else {
                        footnote.textContent = "Oldest waiting first.";
                    }

                    summary.textContent = plural(shown, "result", "results");

                } else if (rows.length === 0) {

                    showEmpty(
                        "No contracts or claims yet",
                        "Your contracts and payment claims will appear here once they exist.");

                } else if (query) {

                    if (tab !== "all" && counts.all > 0) {
                        showEmpty(
                            "No matches in this view",
                            "Nothing here matches “" + query + "”, but " +
                                plural(counts.all, "item does", "items do") +
                                " in other tabs.",
                            "Show " + plural(counts.all, "match", "matches") + " in all items",
                            "all");
                    } else {
                        showEmpty(
                            "No matches",
                            "Nothing matches “" + query + "”. Try a different reference or course.",
                            "Clear search",
                            "clear");
                    }

                } else if (tab === "needs-action") {

                    showEmpty(
                        "Nothing needs your action",
                        "You're up to date. Contracts to sign and claims to finish will show up here.",
                        "See what's in review",
                        "in-review");

                } else if (tab === "in-review") {

                    showEmpty(
                        "Nothing in review",
                        "None of your contracts or claims are with approvers right now.");

                } else {

                    showEmpty(
                        "Nothing closed yet",
                        "Fully signed contracts and approved, paid or rejected claims will appear here.");
                }

                if (shown === 0) {
                    summary.textContent = "No results";
                }
            }

            function selectTab(filter) {
                tab = filter;
                apply();
            }

            triggers.forEach(function (link) {

                link.addEventListener("click", function (event) {

                    if (event.button !== 0 ||
                        event.metaKey || event.ctrlKey || event.shiftKey) {
                        return;
                    }

                    event.preventDefault();

                    selectTab(link.getAttribute("data-filter"));

                    if (link.classList.contains("ld-workflow-card")) {

                        var reduce = window.matchMedia &&
                            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                        queue.scrollIntoView({
                            behavior: reduce ? "auto" : "smooth",
                            block: "start"
                        });
                    }
                });
            });

            emptyAction.addEventListener("click", function () {

                if (emptyMode === "all") {
                    selectTab("all");
                } else if (emptyMode === "in-review") {
                    selectTab("in-review");
                } else {
                    input.value = "";
                    apply();
                    input.focus();
                }
            });

            input.addEventListener("input", function () {
                clearTimeout(timer);
                timer = setTimeout(apply, 100);
            });

            input.addEventListener("search", apply);

            form.addEventListener("submit", function (event) {
                event.preventDefault();
                apply();
            });

            document.addEventListener("keydown", function (event) {

                var tag = (document.activeElement || {}).tagName || "";

                if (event.key === "/" &&
                    !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                    !event.ctrlKey && !event.metaKey && !event.altKey) {

                    event.preventDefault();
                    input.focus();
                    input.select();
                }
            });

            apply();

        })();
    </script>
}