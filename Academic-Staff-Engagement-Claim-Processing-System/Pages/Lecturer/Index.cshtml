@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.IndexModel

@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Lecturer/dashboard.css" asp-append-version="true" />
}

@{
    var lecturer = Model.CurrentLecturer;

    string ContractStatusLabel(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "Pending Signature",
        ContractStatus.Active => "Active",
        ContractStatus.Expired => "Expired",
        ContractStatus.Terminated => "Terminated",
        ContractStatus.Renewed => "Renewed",
        _ => status.ToString()
    };

    string ContractStatusClass(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "status-pending",
        ContractStatus.Active => "status-active",
        ContractStatus.Expired => "status-expired",
        ContractStatus.Terminated => "status-danger",
        ContractStatus.Renewed => "status-active",
        _ => "status-neutral"
    };

    string ClaimStatusLabel(ClaimStatus status) => status switch
    {
        ClaimStatus.Draft => "Draft",
        ClaimStatus.Submitted => "Submitted",
        ClaimStatus.PendingHODApproval => "HOD Review",
        ClaimStatus.PendingDeanApproval => "Dean Review",
        ClaimStatus.Approved => "Approved",
        ClaimStatus.Rejected => "Rejected",
        ClaimStatus.Paid => "Paid",
        _ => status.ToString()
    };

    string ClaimStatusClass(ClaimStatus status) => status switch
    {
        ClaimStatus.Draft => "status-neutral",
        ClaimStatus.Submitted => "status-pending",
        ClaimStatus.PendingHODApproval => "status-pending",
        ClaimStatus.PendingDeanApproval => "status-pending",
        ClaimStatus.Approved => "status-active",
        ClaimStatus.Paid => "status-paid",
        ClaimStatus.Rejected => "status-danger",
        _ => "status-neutral"
    };
}

<section class="dashboard-page">

    <header class="page-header">
        <h1>Dashboard</h1>
        @if (lecturer != null)
        {
            <p>Welcome back, <strong>@lecturer.UserName</strong> :@Model.LecturerTypeName</p>
        }
    </header>

    <section class="stats-grid">

        <div class="stat-card stat-card-blue">
            <div class="stat-icon">
                <i class="bi bi-book-fill"></i>
            </div>
            <div class="stat-value">@Model.ActiveCourseCount</div>
            <span class="stat-label">Active Courses</span>
        </div>

        <div class="stat-card stat-card-orange">
            <div class="stat-icon">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div class="stat-value">@Model.TotalAllocatedHours.ToString("0.##")</div>
            <span class="stat-label">Allocated Hours</span>
        </div>

        <div class="stat-card stat-card-green">
            <div class="stat-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <div class="stat-value">@Model.ContractCount</div>
            <span class="stat-label">Contracts</span>
            @if (Model.PendingSignatureCount > 0)
            {
                <span class="stat-meta">@Model.PendingSignatureCount pending</span>
            }
        </div>

        <div class="stat-card stat-card-purple">
            <div class="stat-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="stat-value">@Model.PendingClaimCount</div>
            <span class="stat-label">Pending Claims</span>
        </div>

    </section>

    @if (Model.IsFullTime)
    {
        <div class="notice">
            <i class="bi bi-info-circle"></i>
            <span>Teaching-hour data will sync automatically once MIS integration is available.</span>
        </div>
    }

    <section class="section-card">
        <header class="section-header">
            <h2>Course Assignments</h2>
        </header>

        @if (Model.CourseAssignments.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Year</th>
                            <th>Semester</th>
                            <th>Session</th>
                            <th>Campus</th>
                            <th>Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.CourseAssignments)
                        {
                            <tr>
                                <td>
                                    <div class="course-cell">
                                        <span class="course-code">@assignment.Course.Code</span>
                                        <span class="course-title">@assignment.Course.Title</span>
                                    </div>
                                </td>
                                <td>@assignment.AcademicYear</td>
                                <td>@assignment.Semester</td>
                                <td>@assignment.Session</td>
                                <td>@assignment.Campus</td>
                                <td>@assignment.AllocatedHours.ToString("0.##")</td>
                                <td>
                                    @if (assignment.IsApproved)
                                    {
                                        <span class="status-badge status-active">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No course assignments.</p>
            </div>
        }
    </section>

    <div class="dashboard-columns">

        <section class="section-card">
            <header class="section-header">
                <h2>Contracts</h2>
                <a href="/Lecturer/Contracts" class="section-link">View all</a>
            </header>

            @if (Model.Contracts.Any())
            {
                <div class="list-table">
                    @foreach (var contract in Model.Contracts.Take(5))
                    {
                        <div class="list-row">
                            <div class="list-main">
                                <span class="list-reference">CON-@contract.Id.ToString("D6")</span>
                                <strong>@(contract.CourseAssignment?.Course?.Title ?? "Course")</strong>
                                <span class="list-meta">
                                    v@contract.Version ·
                                    @(contract.StartDateUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                                </span>
                            </div>
                            <span class="status-badge @ContractStatusClass(contract.Status)">
                                @ContractStatusLabel(contract.Status)
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state"><p>No contracts.</p></div>
            }
        </section>

        <section class="section-card">
            <header class="section-header">
                <h2>Payment Claims</h2>
                <a href="/Claims" class="section-link">View all</a>
            </header>

            @if (Model.Claims.Any())
            {
                <div class="list-table">
                    @foreach (var claim in Model.Claims.Take(5))
                    {
                        <a href="/Lecturer/ClaimDetail?ClaimId=@claim.Id" class="list-row list-row-link">
                            <div class="list-main">
                                <span class="list-reference">CLM-@claim.Id.ToString("D6")</span>
                                <strong>@(claim.CourseAssignment?.Course?.Title ?? "Course")</strong>
                                <span class="list-meta">
                                    @claim.HoursClaimed.ToString("0.##") hrs ·
                                    @(claim.SubmittedAtUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                                </span>
                            </div>
                            <span class="status-badge @ClaimStatusClass(claim.Status)">
                                @ClaimStatusLabel(claim.Status)
                            </span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="empty-state"><p>No claims.</p></div>
            }
        </section>

    </div>

    <section class="section-card">
        <header class="section-header">
            <h2>Quick Actions</h2>
        </header>

        <div class="quick-actions-grid">
            <a href="/Lecturer/Contracts" class="quick-action">
                <i class="bi bi-file-earmark-text"></i>
                <span>My Contracts</span>
            </a>

            <a href="/Lecturer/SubmitMarks" class="quick-action">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <span>Submit Marks</span>
            </a>

            <a href="/Lecturer/SubmitClaim" class="quick-action">
                <i class="bi bi-send"></i>
                <span>Submit Claim</span>
            </a>
        </div>
    </section>

</section>