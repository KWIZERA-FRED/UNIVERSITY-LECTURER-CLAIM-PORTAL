@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.IndexModel

@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Lecturer/dashboard.css"
          asp-append-version="true" />
}

@{
    var lecturer = Model.CurrentLecturer;

    string ContractStatusLabel(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "Pending Signature",
        ContractStatus.Active => "Active",
        ContractStatus.Expired => "Expired",
        ContractStatus.Terminated => "Terminated",
        ContractStatus.Renewed => "Renewed",
        _ => status.ToString()
    };

    string ContractStatusClass(ContractStatus status) => status switch
    {
        ContractStatus.PendingSignature => "status-pending",
        ContractStatus.Active => "status-active",
        ContractStatus.Expired => "status-expired",
        ContractStatus.Terminated => "status-danger",
        ContractStatus.Renewed => "status-active",
        _ => "status-neutral"
    };

    string ClaimStatusLabel(ClaimStatus status) => status switch
    {
        ClaimStatus.Draft => "Draft",
        ClaimStatus.Submitted => "Submitted",
        ClaimStatus.PendingHODApproval => "HOD Review",
        ClaimStatus.PendingDeanApproval => "Dean Review",
        ClaimStatus.Approved => "Approved",
        ClaimStatus.Rejected => "Rejected",
        ClaimStatus.Paid => "Paid",
        _ => status.ToString()
    };

    string ClaimStatusClass(ClaimStatus status) => status switch
    {
        ClaimStatus.Draft => "status-neutral",
        ClaimStatus.Submitted => "status-pending",
        ClaimStatus.PendingHODApproval => "status-pending",
        ClaimStatus.PendingDeanApproval => "status-pending",
        ClaimStatus.Approved => "status-active",
        ClaimStatus.Paid => "status-paid",
        ClaimStatus.Rejected => "status-danger",
        _ => "status-neutral"
    };

    // ---- Workflow summary counts ----

    var openClaims = Model.Claims.Count(c =>
        c.Status == ClaimStatus.Draft ||
        c.Status == ClaimStatus.Submitted ||
        c.Status == ClaimStatus.PendingHODApproval ||
        c.Status == ClaimStatus.PendingDeanApproval);

    var approvedClaims = Model.Claims.Count(c =>
        c.Status == ClaimStatus.Approved);

    var paidClaims = Model.Claims.Count(c =>
        c.Status == ClaimStatus.Paid);

    var oldestPendingText =
        Model.Contracts.Where(c => c.Status == ContractStatus.PendingSignature)
            .OrderBy(c => c.CreatedAtUtc)
            .Select(c => (DateTime?)c.CreatedAtUtc)
            .FirstOrDefault() is DateTime oldestContract
            ? $"Oldest contract {Math.Max(0, (int)(DateTime.UtcNow - oldestContract).TotalDays)} days"
            : "No contracts awaiting signature";
}

<section class="dashboard-page">

    @* ---------------- Header ---------------- *@

    <header class="page-header">

        <div class="page-header-main">

            <h1>Welcome back, @(lecturer?.UserName ?? "Lecturer")</h1>

            <p>Your courses, contracts, and payment claims in one place.</p>

        </div>

    </header>


    @* ---------------- Workflow summary ---------------- *@

    <section class="workflow-summary" aria-label="Your workflow">

        <div class="workflow-card workflow-card--neutral">
            <span class="workflow-label">Active Courses</span>
            <span class="workflow-value">@Model.ActiveCourseCount</span>
            <span class="workflow-meta">
                @Model.TotalAllocatedHours.ToString("0.##") hours allocated
            </span>
        </div>

        <div class="workflow-card workflow-card--action">
            <span class="workflow-label">Contracts</span>
            <span class="workflow-value">@Model.ContractCount</span>
            <span class="workflow-meta">@oldestPendingText</span>
        </div>

        <div class="workflow-card workflow-card--info">
            <span class="workflow-label">Pending Claims</span>
            <span class="workflow-value">@openClaims</span>
            <span class="workflow-meta">In review pipeline</span>
        </div>

    </section>


    @* ---------------- Full-time notice ---------------- *@

    @if (Model.IsFullTime)
    {
        <div class="notice" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>Teaching-hour data will sync automatically once MIS integration is available.</span>
        </div>
    }


    @* ---------------- Course assignments ---------------- *@

    <section class="section-card">

        <header class="section-header">
            <h2>Course Assignments</h2>
            <span class="section-meta">
                @Model.CourseAssignments.Count
                @(Model.CourseAssignments.Count == 1 ? "course" : "courses")
            </span>
        </header>

        @if (Model.CourseAssignments.Any())
        {
            <div class="table-wrapper">

                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Year</th>
                            <th>Semester</th>
                            <th>Session</th>
                            <th>Campus</th>
                            <th class="col-right">Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var assignment in Model.CourseAssignments)
                        {
                            <tr>
                                <td>
                                    <div class="course-cell">
                                        <span class="course-code">@assignment.Course.Code</span>
                                        <span class="course-title">@assignment.Course.Title</span>
                                    </div>
                                </td>
                                <td>@assignment.AcademicYear</td>
                                <td>@assignment.Semester</td>
                                <td>@assignment.Session</td>
                                <td>@assignment.Campus</td>
                                <td class="col-right">
                                    <span class="hours-value">@assignment.AllocatedHours.ToString("0.##")</span>
                                </td>
                                <td>
                                    @if (assignment.IsApproved)
                                    {
                                        <span class="status-badge status-active">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state empty-state--compact">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-journal-x"></i>
                </span>
                <h3>No course assignments</h3>
                <p>Your teaching engagements will appear here once they are assigned by your faculty.</p>
            </div>
        }

    </section>


    @* ---------------- Unified queue — contracts + claims ---------------- *@

    <section class="section-card queue-card" id="lecturer-queue">

        <header class="section-header">
            <h2>The queue</h2>

            <nav class="ds-chips" aria-label="Filter the queue">

                <button type="button"
                        class="ds-chip is-active"
                        data-filter="all">
                    All
                    <span class="ds-chip-count">@(Model.Contracts.Count + Model.Claims.Count)</span>
                </button>

                <button type="button"
                        class="ds-chip"
                        data-filter="contract">
                    Contracts
                    <span class="ds-chip-count">@Model.Contracts.Count</span>
                </button>

                <button type="button"
                        class="ds-chip"
                        data-filter="claim">
                    Claims
                    <span class="ds-chip-count">@Model.Claims.Count</span>
                </button>

                <button type="button"
                        class="ds-chip"
                        data-filter="action">
                    Needs action
                    <span class="ds-chip-count">@Model.PendingSignatureCount</span>
                </button>

            </nav>
        </header>

        <div class="queue-toolbar">

            <div class="ds-search" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>

                <input type="search"
                       id="lecturer-queue-search"
                       placeholder="Search reference or course"
                       aria-label="Search the queue"
                       autocomplete="off" />

                <span class="ds-search-hint" aria-hidden="true">Press /</span>
            </div>

        </div>

        @if (Model.Contracts.Any() || Model.Claims.Any())
        {
            <div class="queue-list" id="lecturer-queue-list">

                @* ---- Contracts as queue rows ---- *@

                @foreach (var contract in Model.Contracts)
                {
                    var statusKey = contract.Status.ToString().ToLowerInvariant();

                    <a href="/Lecturer/Contracts/Details/@contract.Id"
                       class="queue-row"
                       data-kind="contract"
                       data-status="@statusKey"
                       data-search="@($"CON-{contract.Id:D6} {contract.CourseAssignment?.Course?.Title}")">

                        <div class="queue-ref">
                            <span class="queue-ref-code">CON-@contract.Id.ToString("D6")</span>
                            <span class="ds-tag ds-tag--contract">Contract</span>
                        </div>

                        <div class="queue-who">
                            <span class="queue-who-name">
                                @(contract.CourseAssignment?.Course?.Title ?? "Course")
                            </span>
                            <span class="queue-who-meta">
                                @(contract.StartDateUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                            </span>
                        </div>

                        <div class="queue-status">
                            <span class="status-badge @ContractStatusClass(contract.Status)">
                                @ContractStatusLabel(contract.Status)
                            </span>
                        </div>

                        <div class="queue-action">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </div>

                    </a>
                }

                @* ---- Claims as queue rows ---- *@

                @foreach (var claim in Model.Claims)
                {
                    var statusKey = claim.Status.ToString().ToLowerInvariant();

                    <a href="/Lecturer/ClaimDetail?ClaimId=@claim.Id"
                       class="queue-row"
                       data-kind="claim"
                       data-status="@statusKey"
                       data-search="@($"CLM-{claim.Id:D6} {claim.CourseAssignment?.Course?.Title}")">

                        <div class="queue-ref">
                            <span class="queue-ref-code">CLM-@claim.Id.ToString("D6")</span>
                            <span class="ds-tag ds-tag--claim">Claim</span>
                        </div>

                        <div class="queue-who">
                            <span class="queue-who-name">
                                @(claim.CourseAssignment?.Course?.Title ?? "Course")
                            </span>
                            <span class="queue-who-meta">
                                @claim.HoursClaimed.ToString("0.##") hrs ·
                                @(claim.SubmittedAtUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                            </span>
                        </div>

                        <div class="queue-status">
                            <span class="status-badge @ClaimStatusClass(claim.Status)">
                                @ClaimStatusLabel(claim.Status)
                            </span>
                        </div>

                        <div class="queue-action">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </div>

                    </a>
                }

            </div>

            <div class="queue-empty" id="lecturer-queue-empty" hidden>
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-inbox"></i>
                </span>
                <h3 id="lecturer-queue-empty-title">No items match this filter</h3>
                <p id="lecturer-queue-empty-text">
                    Try a different filter or search term.
                </p>
            </div>
        }
        else
        {
            <div class="empty-state empty-state--compact">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-inbox"></i>
                </span>
                <h3>Nothing in the queue yet</h3>
                <p>Your contracts and payment claims will appear here once they exist.</p>
            </div>
        }

    </section>

</section>

@section Scripts {
    <script>
        (function () {

            var list = document.getElementById("lecturer-queue-list");

            if (!list) {
                return;
            }

            var rows = Array.prototype.slice.call(
                list.querySelectorAll(".queue-row"));

            var chips = Array.prototype.slice.call(
                document.querySelectorAll(".queue-card .ds-chip"));

            var search = document.getElementById("lecturer-queue-search");
            var empty = document.getElementById("lecturer-queue-empty");
            var emptyTitle = document.getElementById("lecturer-queue-empty-title");
            var emptyText = document.getElementById("lecturer-queue-empty-text");

            var activeFilter = "all";
            var timer = null;

            function apply() {

                var query = (search?.value || "").trim().toLowerCase();
                var terms = query.split(/\s+/).filter(Boolean);

                var shown = 0;

                rows.forEach(function (row) {

                    var kind = row.getAttribute("data-kind") || "";
                    var status = row.getAttribute("data-status") || "";
                    var key = (row.getAttribute("data-search") || "").toLowerCase();

                    var matchesFilter = false;

                    if (activeFilter === "all") {
                        matchesFilter = true;
                    } else if (activeFilter === "contract") {
                        matchesFilter = kind === "contract";
                    } else if (activeFilter === "claim") {
                        matchesFilter = kind === "claim";
                    } else if (activeFilter === "action") {
                        matchesFilter =
                            status === "pendingsignature" ||
                            status === "submitted" ||
                            status === "pendinghodapproval" ||
                            status === "pendingdeanapproval";
                    }

                    var matchesQuery = terms.every(function (t) {
                        return key.indexOf(t) !== -1;
                    });

                    var visible = matchesFilter && matchesQuery;

                    row.hidden = !visible;

                    if (visible) {
                        shown++;
                    }
                });

                if (shown === 0 && rows.length > 0) {
                    empty.hidden = false;
                    if (query) {
                        emptyTitle.textContent = "No matches";
                        emptyText.textContent =
                            "Nothing in the queue matches your search.";
                    } else {
                        emptyTitle.textContent = "Nothing in this view";
                        emptyText.textContent =
                            "No items match the current filter.";
                    }
                } else {
                    empty.hidden = true;
                }
            }

            chips.forEach(function (chip) {

                chip.addEventListener("click", function () {

                    activeFilter = chip.getAttribute("data-filter") || "all";

                    chips.forEach(function (c) {
                        c.classList.toggle("is-active", c === chip);
                    });

                    apply();
                });
            });

            if (search) {
                search.addEventListener("input", function () {
                    clearTimeout(timer);
                    timer = setTimeout(apply, 100);
                });
            }

            document.addEventListener("keydown", function (event) {

                var tag = (document.activeElement || {}).tagName || "";

                if (event.key === "/" &&
                    !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                    !event.ctrlKey && !event.metaKey && !event.altKey &&
                    search) {

                    event.preventDefault();
                    search.focus();
                    search.select();
                }
            });

            apply();

        })();
    </script>
}