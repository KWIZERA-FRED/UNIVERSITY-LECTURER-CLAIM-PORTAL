@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.IndexModel

@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
ViewData["Title"] = "Lecturer Dashboard";
Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="utf-8" />

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<title>Lecturer Dashboard</title>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    * {
        box-sizing: border-box;
    }

    :root {
        --primary: #0f2b4a;
        --primary-light: #1a3f64;
        --accent: #2a7f5e;
        --accent-light: #e1f0e8;
        --bg: #f0f4fa;
        --card: #ffffff;
        --border: #dce4ed;
        --text: #1a2634;
        --text-muted: #4d6278;
        --danger: #b42318;
        --danger-light: #fdecec;
        --warning: #856404;
        --warning-light: #fff3cd;
        --blue-light: #dbeafe;
        --blue-text: #1a4b7a;
        --radius: 16px;
        --shadow: 0 12px 30px -10px rgba(0,20,40,0.12);
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        color: var(--text);
    }

    .lecturer-app {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* ============================================================
       HEADER
       ============================================================ */

    .app-header {
        min-height: 70px;
        background: var(--primary);
        color: white;
        padding: 0.9rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 3px solid var(--accent);
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-weight: 600;
        font-size: 1.15rem;
    }

    .brand i {
        color: #7bc9a0;
        font-size: 1.35rem;
    }

    .user-area {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .role-badge {
        background: rgba(255,255,255,0.1);
        padding: 0.4rem 0.9rem;
        border-radius: 40px;
        font-size: 0.8rem;
    }

    .logout {
        color: white;
        text-decoration: none;
        font-size: 0.82rem;
        padding: 0.4rem 0.9rem;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 30px;
    }

    .logout:hover {
        background: rgba(255,255,255,0.1);
    }

    /* ============================================================
       BODY
       ============================================================ */

    .app-body {
        display: flex;
        flex: 1;
    }

    /* ============================================================
       SIDEBAR
       ============================================================ */

    .sidebar {
        width: 235px;
        background: white;
        border-right: 1px solid var(--border);
        padding: 1.2rem 0;
        flex-shrink: 0;
        min-height: calc(100vh - 70px);
    }

    .sidebar-title {
        padding: 0 1.8rem 0.8rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--text-muted);
        font-weight: 700;
    }

    .sidebar a {
        display: block;
        width: 100%;
        text-decoration: none;
        padding: 0.75rem 1.8rem;
        color: var(--text);
        font-size: 0.9rem;
        font-weight: 500;
        border-left: 3px solid transparent;
        transition: 0.2s ease;
    }

    .sidebar a i {
        width: 1.6rem;
        color: var(--text-muted);
    }

    .sidebar a:hover {
        background: var(--bg);
    }

    .sidebar a.active {
        background: var(--accent-light);
        border-left-color: var(--accent);
        color: var(--primary);
        font-weight: 600;
    }

    .sidebar a.active i {
        color: var(--accent);
    }

    /* ============================================================
       MAIN
       ============================================================ */

    .main {
        flex: 1;
        padding: 1.8rem 2rem 2.5rem;
        overflow-x: auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .page-header h1 {
        margin: 0;
        color: var(--primary);
        font-size: 1.6rem;
    }

    .page-header p {
        margin: 0.35rem 0 0;
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    /* ============================================================
       WELCOME
       ============================================================ */

    .welcome-card {
        background: linear-gradient(
            135deg,
            var(--primary),
            var(--primary-light)
        );
        color: white;
        border-radius: var(--radius);
        padding: 1.5rem 1.7rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow);
    }

    .welcome-card h2 {
        margin: 0;
        font-size: 1.35rem;
    }

    .welcome-card p {
        margin: 0.45rem 0 0;
        opacity: 0.85;
        font-size: 0.85rem;
    }

    .welcome-meta {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .welcome-meta-item {
        font-size: 0.78rem;
        opacity: 0.9;
    }

    .welcome-meta-item strong {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        opacity: 0.65;
        margin-bottom: 0.15rem;
    }

    /* ============================================================
       NOTICE
       ============================================================ */

    .notice {
        background: var(--accent-light);
        border-left: 4px solid var(--accent);
        padding: 0.9rem 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        color: var(--text);
        font-size: 0.84rem;
    }

    .notice strong {
        color: var(--primary);
    }

    .notice.warning {
        background: var(--warning-light);
        border-left-color: #d39e00;
    }

    /* ============================================================
       STATISTICS
       ============================================================ */

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: var(--card);
        padding: 1.15rem 1.2rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    .stat-card .icon {
        color: var(--accent);
        margin-bottom: 0.5rem;
        font-size: 1rem;
    }

    .stat-card .number {
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--primary);
        line-height: 1.2;
    }

    .stat-card .label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--text-muted);
        margin-top: 0.3rem;
    }

    /* ============================================================
       CARDS
       ============================================================ */

    .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.2rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .card-header h3 {
        margin: 0;
        font-size: 1rem;
        color: var(--primary);
    }

    .card-header h3 i {
        color: var(--accent);
        margin-right: 0.4rem;
    }

    .view-all {
        font-size: 0.75rem;
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
    }

    .view-all:hover {
        text-decoration: underline;
    }

    /* ============================================================
       TABLE
       ============================================================ */

    .table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

    th {
        background: var(--primary);
        color: white;
        font-weight: 600;
        padding: 0.7rem 0.8rem;
        text-align: left;
        white-space: nowrap;
    }

    th:first-child {
        border-radius: 7px 0 0 0;
    }

    th:last-child {
        border-radius: 0 7px 0 0;
    }

    td {
        padding: 0.7rem 0.8rem;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }

    tr:hover td {
        background: #f8fafc;
    }

    /* ============================================================
       BADGES
       ============================================================ */

    .badge {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 30px;
        font-size: 0.68rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-ft {
        background: var(--blue-light);
        color: var(--blue-text);
    }

    .badge-pt {
        background: var(--accent-light);
        color: #216344;
    }

    .badge-pending {
        background: var(--warning-light);
        color: var(--warning);
    }

    .badge-approved {
        background: #d4edda;
        color: #0b5e2e;
    }

    .badge-paid {
        background: #d4edda;
        color: #0b5e2e;
    }

    .badge-rejected {
        background: var(--danger-light);
        color: var(--danger);
    }

    .badge-draft {
        background: #edf0f3;
        color: #586879;
    }

    .badge-active {
        background: #d4edda;
        color: #0b5e2e;
    }

    .badge-expired {
        background: #edf0f3;
        color: #586879;
    }

    /* ============================================================
       BUTTONS
       ============================================================ */

    .action-btn {
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.42rem 0.9rem;
        border-radius: 40px;
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

    .action-btn:hover {
        background: #1d6a4d;
        color: white;
    }

    .action-btn.outline {
        background: transparent;
        border: 1px solid var(--accent);
        color: var(--accent);
    }

    .action-btn.outline:hover {
        background: var(--accent);
        color: white;
    }

    /* ============================================================
       EMPTY STATE
       ============================================================ */

    .empty {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--text-muted);
    }

    .empty i {
        font-size: 1.8rem;
        margin-bottom: 0.7rem;
        opacity: 0.5;
    }

    .empty p {
        margin: 0;
        font-size: 0.82rem;
    }

    /* ============================================================
       FULL-TIME MIS AREA
       ============================================================ */

    .mis-card {
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
    }

    .mis-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .mis-title {
        font-weight: 600;
        color: var(--primary);
        font-size: 0.9rem;
    }

    .mis-subtitle {
        margin-top: 0.25rem;
        color: var(--text-muted);
        font-size: 0.76rem;
    }

    .mis-status {
        display: inline-block;
        padding: 0.25rem 0.65rem;
        border-radius: 30px;
        background: var(--warning-light);
        color: var(--warning);
        font-size: 0.68rem;
        font-weight: 600;
        white-space: nowrap;
    }

    /* ============================================================
       QUICK ACTIONS
       ============================================================ */

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .quick-action {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        text-decoration: none;
        color: var(--text);
        transition: 0.2s ease;
        background: white;
    }

    .quick-action:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,20,40,0.08);
    }

    .quick-action i {
        color: var(--accent);
        font-size: 1.1rem;
        margin-bottom: 0.55rem;
    }

    .quick-action strong {
        display: block;
        color: var(--primary);
        font-size: 0.85rem;
    }

    .quick-action span {
        display: block;
        color: var(--text-muted);
        font-size: 0.72rem;
        margin-top: 0.25rem;
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 1050px) {

        .stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .quick-actions {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {

        .app-body {
            flex-direction: column;
        }

        .sidebar {
            width: 100%;
            min-height: auto;
            border-right: none;
            border-bottom: 1px solid var(--border);
        }

        .app-header {
            padding: 0.8rem 1rem;
        }

        .brand span {
            display: none;
        }

        .main {
            padding: 1.2rem;
        }

        .stat-grid {
            grid-template-columns: 1fr;
        }

        .welcome-meta {
            flex-direction: column;
            gap: 0.7rem;
        }
    }

</style>
```

</head>

<body>

<div class="lecturer-app">


<!-- ============================================================
     HEADER
     ============================================================ -->

<header class="app-header">

    <div class="brand">

        <i class="fas fa-university"></i>

        <span>
            UNILAK · Staff Engagement
        </span>

    </div>

    <div class="user-area">

        <span class="role-badge">

            <i class="fas fa-chalkboard-teacher"></i>

            @Model.LecturerTypeName

        </span>

        <a href="/Login" class="logout">
            Logout
        </a>

    </div>

</header>


<div class="app-body">

    <!-- ========================================================
         SIDEBAR
         ======================================================== -->

    <aside class="sidebar">

        <div class="sidebar-title">
            Lecturer Portal
        </div>

        <a href="/Lecturer" class="active">

            <i class="fas fa-th-large"></i>

            Dashboard

        </a>

        <a href="/Lecturer/Contracts">

            <i class="fas fa-file-signature"></i>

            My Contracts

        </a>

        <a href="/Lecturer/SubmitMarks">

            <i class="fas fa-file-excel"></i>

            Submit Marks

        </a>

        <a href="/Lecturer/SubmitClaim">

            <i class="fas fa-coins"></i>

            Payment Claims

        </a>

    </aside>


    <!-- ========================================================
         MAIN CONTENT
         ======================================================== -->

    <main class="main">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <div>

                <h1>
                    Lecturer Dashboard
                </h1>

                <p>
                    View your academic engagement, courses, contracts,
                    marks submission and payment claims.
                </p>

            </div>

        </div>


        <!-- ====================================================
             WELCOME
             ==================================================== -->

        <div class="welcome-card">

            <h2>
                Welcome, @Model.CurrentLecturer!.UserName
            </h2>

            <p>
                Your lecturer account and academic engagement information
                are displayed below.
            </p>

            <div class="welcome-meta">

                <div class="welcome-meta-item">

                    <strong>Username</strong>

                    @Model.CurrentLecturer.UserName

                </div>

                <div class="welcome-meta-item">

                    <strong>Email</strong>

                    @Model.CurrentLecturer.Email

                </div>

                <div class="welcome-meta-item">

                    <strong>Lecturer Type</strong>

                    @Model.LecturerTypeName

                </div>

                @if (Model.CurrentLecturer.Rank.HasValue)
                {
                    <div class="welcome-meta-item">

                        <strong>Rank</strong>

                        @Model.CurrentLecturer.Rank.Value

                    </div>
                }

            </div>

        </div>


        <!-- ====================================================
             ROLE NOTICE
             ==================================================== -->

        @if (Model.IsFullTime)
        {
            <div class="notice warning">

                <strong>
                    <i class="fas fa-clock"></i>
                    Full-Time Lecturer
                </strong>

                <br />

                Your teaching-hour information will be retrieved from
                the MIS integration. The dashboard currently displays
                your real course assignments and allocated hours from
                this system. MIS-completed hours will be enabled when
                the MIS API is connected.

            </div>
        }
        else
        {
            <div class="notice">

                <strong>
                    <i class="fas fa-user-clock"></i>
                    Part-Time Lecturer
                </strong>

                <br />

                Your assigned courses, contracts and payment claims
                are displayed using the information recorded in the
                system.

            </div>
        }


        <!-- ====================================================
             STATISTICS
             ==================================================== -->

        <div class="stat-grid">

            <!-- COURSES -->

            <div class="stat-card">

                <div class="icon">

                    <i class="fas fa-book-open"></i>

                </div>

                <div class="number">

                    @Model.ActiveCourseCount

                </div>

                <div class="label">

                    Active Courses

                </div>

            </div>


            <!-- ALLOCATED HOURS -->

            <div class="stat-card">

                <div class="icon">

                    <i class="fas fa-clock"></i>

                </div>

                <div class="number">

                    @Model.TotalAllocatedHours.ToString("0.##")h

                </div>

                <div class="label">

                    Allocated Hours

                </div>

            </div>


            <!-- CONTRACTS -->

            <div class="stat-card">

                <div class="icon">

                    <i class="fas fa-file-signature"></i>

                </div>

                <div class="number">

                    @Model.ContractCount

                </div>

                <div class="label">

                    Contracts

                </div>

            </div>


            <!-- CLAIMS -->

            <div class="stat-card">

                <div class="icon">

                    <i class="fas fa-coins"></i>

                </div>

                <div class="number">

                    @Model.PendingClaimCount

                </div>

                <div class="label">

                    Pending Claims

                </div>

            </div>

        </div>


        <!-- ====================================================
             FULL-TIME MIS INFORMATION
             ==================================================== -->

        @if (Model.IsFullTime)
        {
            <div class="card">

                <div class="card-header">

                    <h3>

                        <i class="fas fa-database"></i>

                        MIS Teaching Hours

                    </h3>

                </div>

                <div class="mis-card">

                    <div class="mis-header">

                        <div>

                            <div class="mis-title">

                                MIS integration status

                            </div>

                            <div class="mis-subtitle">

                                Completed teaching hours will be
                                retrieved from the university MIS API.

                            </div>

                        </div>

                        <span class="mis-status">

                            MIS API Pending

                        </span>

                    </div>

                </div>

            </div>
        }


        <!-- ====================================================
             COURSE ASSIGNMENTS
             ==================================================== -->

        <div class="card">

            <div class="card-header">

                <h3>

                    <i class="fas fa-book-open"></i>

                    My Course Assignments

                </h3>

            </div>


            @if (Model.CourseAssignments.Any())
            {
                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Course Code
                                </th>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Academic Year
                                </th>

                                <th>
                                    Semester
                                </th>

                                <th>
                                    Session
                                </th>

                                <th>
                                    Campus
                                </th>

                                <th>
                                    Hours
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var assignment in Model.CourseAssignments)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @assignment.Course.Code
                                        </strong>

                                    </td>

                                    <td>

                                        @assignment.Course.Title

                                    </td>

                                    <td>

                                        @assignment.AcademicYear

                                    </td>

                                    <td>

                                        @assignment.Semester

                                    </td>

                                    <td>

                                        @assignment.Session

                                    </td>

                                    <td>

                                        @assignment.Campus

                                    </td>

                                    <td>

                                        @assignment.AllocatedHours.ToString("0.##")h

                                    </td>

                                    <td>

                                        @if (assignment.IsApproved)
                                        {
                                            <span class="badge badge-approved">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pending">
                                                Pending Approval
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty">

                    <i class="fas fa-book-open"></i>

                    <p>
                        No active course assignments have been recorded
                        for your account.
                    </p>

                </div>
            }

        </div>


        <!-- ====================================================
             CONTRACTS
             ==================================================== -->

        <div class="card">

            <div class="card-header">

                <h3>

                    <i class="fas fa-file-signature"></i>

                    My Contracts

                </h3>

                <a href="/Lecturer/Contracts"
                   class="view-all">

                    View All

                </a>

            </div>


            @if (Model.Contracts.Any())
            {
                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Contract ID
                                </th>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Version
                                </th>

                                <th>
                                    Start Date
                                </th>

                                <th>
                                    End Date
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var contract in Model.Contracts.Take(5))
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            #@contract.Id
                                        </strong>

                                    </td>

                                    <td>

                                        @(contract.CourseAssignment?.Course?.Title
                                            ?? "Not assigned")

                                    </td>

                                    <td>

                                        @contract.Version

                                    </td>

                                    <td>

                                        @(contract.StartDateUtc.HasValue
                                            ? contract.StartDateUtc.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </td>

                                    <td>

                                        @(contract.EndDateUtc.HasValue
                                            ? contract.EndDateUtc.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </td>

                                    <td>

                                        @switch (contract.Status)
                                        {
                                            case ContractStatus.PendingSignature:

                                                <span class="badge badge-pending">
                                                    Pending Signature
                                                </span>

                                                break;

                                            case ContractStatus.Active:

                                                <span class="badge badge-active">
                                                    Active
                                                </span>

                                                break;

                                            case ContractStatus.Expired:

                                                <span class="badge badge-expired">
                                                    Expired
                                                </span>

                                                break;

                                            case ContractStatus.Terminated:

                                                <span class="badge badge-rejected">
                                                    Terminated
                                                </span>

                                                break;

                                            case ContractStatus.Renewed:

                                                <span class="badge badge-approved">
                                                    Renewed
                                                </span>

                                                break;
                                        }

                                    </td>

                                    <td>

                                        <a href="/Lecturer/Contracts"
                                           class="action-btn">

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty">

                    <i class="fas fa-file-signature"></i>

                    <p>
                        No contracts have been created for your account.
                    </p>

                </div>
            }

        </div>


        <!-- ====================================================
             CLAIMS
             ==================================================== -->

        <div class="card">

            <div class="card-header">

                <h3>

                    <i class="fas fa-coins"></i>

                    Payment Claims

                </h3>

                <a href="/Lecturer/SubmitClaim"
                   class="view-all">

                    Submit Claim

                </a>

            </div>


            @if (Model.Claims.Any())
            {
                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Claim ID
                                </th>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Contract
                                </th>

                                <th>
                                    Hours
                                </th>

                                <th>
                                    Submitted
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var claim in Model.Claims.Take(5))
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            #@claim.Id
                                        </strong>

                                    </td>

                                    <td>

                                        @(claim.CourseAssignment?.Course?.Title
                                            ?? "Not assigned")

                                    </td>

                                    <td>

                                        #@claim.ContractId

                                    </td>

                                    <td>

                                        @claim.HoursClaimed.ToString("0.##")h

                                    </td>

                                    <td>

                                        @(claim.SubmittedAtUtc.HasValue
                                            ? claim.SubmittedAtUtc.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </td>

                                    <td>

                                        @switch (claim.Status)
                                        {
                                            case ClaimStatus.Draft:

                                                <span class="badge badge-draft">
                                                    Draft
                                                </span>

                                                break;

                                            case ClaimStatus.Submitted:

                                                <span class="badge badge-pending">
                                                    Submitted
                                                </span>

                                                break;

                                            case ClaimStatus.PendingHODApproval:

                                                <span class="badge badge-pending">
                                                    Pending HOD Approval
                                                </span>

                                                break;

                                            case ClaimStatus.PendingDeanApproval:

                                                <span class="badge badge-pending">
                                                    Pending Dean Approval
                                                </span>

                                                break;

                                            case ClaimStatus.Approved:

                                                <span class="badge badge-approved">
                                                    Approved
                                                </span>

                                                break;

                                            case ClaimStatus.Rejected:

                                                <span class="badge badge-rejected">
                                                    Rejected
                                                </span>

                                                break;

                                            case ClaimStatus.Paid:

                                                <span class="badge badge-paid">
                                                    Paid
                                                </span>

                                                break;
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty">

                    <i class="fas fa-coins"></i>

                    <p>
                        You have not submitted any payment claims yet.
                    </p>

                </div>
            }

        </div>


        <!-- ====================================================
             QUICK ACTIONS
             ==================================================== -->

        <div class="card">

            <div class="card-header">

                <h3>

                    <i class="fas fa-bolt"></i>

                    Quick Actions

                </h3>

            </div>

            <div class="quick-actions">

                <!-- CONTRACTS -->

                <a href="/Lecturer/Contracts"
                   class="quick-action">

                    <i class="fas fa-file-signature"></i>

                    <strong>
                        My Contracts
                    </strong>

                    <span>
                        View and sign your contracts.
                    </span>

                </a>


                <!-- MARKS -->

                <a href="/Lecturer/SubmitMarks"
                   class="quick-action">

                    <i class="fas fa-file-excel"></i>

                    <strong>
                        Submit Marks
                    </strong>

                    <span>
                        Upload your marks Excel file for examination
                        office processing.
                    </span>

                </a>


                <!-- CLAIM -->

                <a href="/Lecturer/SubmitClaim"
                   class="quick-action">

                    <i class="fas fa-coins"></i>

                    <strong>
                        Payment Claim
                    </strong>

                    <span>
                        Submit a payment claim for your assigned work.
                    </span>

                </a>

            </div>

        </div>

    </main>

</div>
