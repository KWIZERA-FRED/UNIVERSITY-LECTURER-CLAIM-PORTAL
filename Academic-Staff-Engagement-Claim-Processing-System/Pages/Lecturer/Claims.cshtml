@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ClaimsModel

@{
    ViewData["Title"] = "My Claims";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";

    // How many "needs your attention" banners to show before summarising.
    const int maxBanners = 5;

    var attention = Model.AttentionClaims;

    var moreAttention = Math.Max(0, attention.Count - maxBanners);

    var inReview = Model.PendingClaims;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Lecturer/claims.css"
          asp-append-version="true" />
}

<section class="claims-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>My Claims</h1>
            <p>View your teaching claims and follow each one through approval and payment.</p>
        </div>

        <div class="page-header-actions">
            <a asp-page="/Lecturer/SubmitClaim" class="primary-button">
                <i class="bi bi-plus-lg"></i>
                Submit Claim
            </a>
        </div>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <!-- ============================================================
         NEEDS YOUR ATTENTION — banners (same look as the HOD page)
         ============================================================ -->

    <section class="cl-banners" aria-label="Claims that need your attention">

        @if (attention.Count == 0)
        {
            <div class="cl-banner cl-banner--calm" role="status">

                <span class="cl-banner-icon" aria-hidden="true">
                    <i class="bi bi-check2-circle"></i>
                </span>

                <p class="cl-banner-text">
                    <strong>You're all caught up.</strong>
                    @if (inReview > 0)
                    {
                        <text>
                            No claim needs your attention.
                            @inReview @(inReview == 1 ? "claim is" : "claims are")
                            still moving through approval.
                        </text>
                    }
                    else
                    {
                        <text>No claim needs your attention right now.</text>
                    }
                </p>

            </div>
        }
        else
        {
            @foreach (var row in attention.Take(maxBanners))
            {
                <div class="cl-banner" role="status">

                    <span class="cl-banner-icon" aria-hidden="true">
                        <i class="bi bi-exclamation-lg"></i>
                    </span>

                    <p class="cl-banner-text">
                        <strong>@row.ClaimNumber</strong>
                        for @row.CourseCode (@row.CourseName)
                        was rejected :
                        @row.Hours.ToString("0.##") hours claimed.
                        Open it to see what happened.
                    </p>

                    <a href="@row.OpenUrl" class="cl-banner-btn">
                        View claim
                    </a>

                </div>
            }

            @if (moreAttention > 0)
            {
                <p class="cl-banners-more">
                    <strong>@moreAttention more</strong>
                    rejected — you'll find them highlighted in the table below.
                </p>
            }
        }

    </section>

    <!-- ============================================================
         ALL CLAIMS
         ============================================================ -->

    <section class="section-card" id="all-claims-card">

        <header class="section-header">
            <h2>All claims</h2>
            <span class="section-meta">
                @Model.TotalClaims
                @(Model.TotalClaims == 1 ? "claim" : "claims")
                · @Model.TotalHours.ToString("N1") hours
            </span>
        </header>

        @if (Model.Claims.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-wallet2"></i>
                </span>
                <h3>No claims yet</h3>
                <p>
                    Once you submit a claim, it will appear here.
                </p>
                <a asp-page="/Lecturer/SubmitClaim" class="primary-button">
                    <i class="bi bi-plus-lg"></i>
                    Submit Your First Claim
                </a>
            </div>
        }
        else
        {
            <div class="toolbar">

                <form class="search-box"
                      role="search"
                      onsubmit="return false;">

                    <i class="bi bi-search" aria-hidden="true"></i>

                    <input type="search"
                           id="allClaimSearch"
                           placeholder="Search by claim, course or status…"
                           aria-label="Search all claims"
                           autocomplete="off" />

                    <span class="search-hint" aria-hidden="true">Press /</span>

                </form>

            </div>

            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Claim</th>
                            <th>Course</th>
                            <th>Academic Year</th>
                            <th>Campus</th>
                            <th class="col-right">Hours</th>
                            <th>Status</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in Model.Claims)
                        {
                            <tr class="all-claim-row"
                                data-search="@($"{row.ClaimNumber} {row.CourseCode} {row.CourseName} {row.AcademicYear} {row.Campus} {row.Status}".ToLowerInvariant())">

                                <td>
                                    <span class="reference-pill">
                                        @row.ClaimNumber
                                    </span>
                                </td>

                                <td>
                                    <div class="course-cell">
                                        <span class="course-title">@row.CourseName</span>
                                        <span class="course-code">@row.CourseCode</span>
                                    </div>
                                </td>

                                <td>@row.AcademicYear</td>

                                <td>@row.Campus</td>

                                <td class="col-right">
                                    <span class="hours-value">
                                        @row.Hours.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge @row.StatusClass">
                                        @row.Status
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a href="@row.OpenUrl"
                                       class="row-action @(row.NeedsAttention ? "row-action--primary" : "")">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="table-empty" id="allNoResults" style="display:none;">
                <p>No claims match your search.</p>
            </div>
        }

    </section>

</section>

@section Scripts {
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input = document.getElementById("allClaimSearch");
        const noResults = document.getElementById("allNoResults");

        if (!input) return;

        const rows = Array.prototype.slice.call(
            document.querySelectorAll(".all-claim-row"));

        function apply() {

            const terms = input.value
                .trim()
                .toLowerCase()
                .split(/\s+/)
                .filter(Boolean);

            let shown = 0;

            rows.forEach(function (row) {

                const key = (row.dataset.search || "").toLowerCase();

                const match = terms.every(function (t) {
                    return key.indexOf(t) !== -1;
                });

                row.style.display = match ? "" : "none";

                if (match) shown++;
            });

            if (noResults) {
                noResults.style.display = shown === 0 ? "" : "none";
            }
        }

        input.addEventListener("input", apply);
        input.addEventListener("search", apply);

        // Press / to focus the search box.
        document.addEventListener("keydown", function (event) {

            const tag = (document.activeElement || {}).tagName || "";

            if (event.key === "/" &&
                !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                !event.ctrlKey && !event.metaKey && !event.altKey) {

                event.preventDefault();
                input.focus();
                input.select();
            }
        });

    });

</script>
}