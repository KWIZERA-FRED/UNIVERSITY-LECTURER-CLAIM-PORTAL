@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ClaimsModel

@{
    ViewData["Title"] = "My Claims";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Lecturer/claims.css"
          asp-append-version="true" />
}

<section class="claims-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>My Claims</h1>
            <p>View your teaching claims and track their approval and payment status.</p>
        </div>

        <a href="/Lecturer/SubmitClaim" class="primary-button">
            <i class="bi bi-plus-lg"></i>
            Submit Claim
        </a>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <section class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon stat-icon-blue">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="stat-value">@Model.TotalClaims</div>
            <span class="stat-label">Total Claims</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-orange">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-value">@Model.PendingClaims</div>
            <span class="stat-label">Pending</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-value">@Model.ApprovedClaims</div>
            <span class="stat-label">Approved</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="stat-value">@Model.TotalHours.ToString("N1")</div>
            <span class="stat-label">Total Hours</span>
        </div>

    </section>

    <section class="section-card">

        <header class="section-header">
            <h2>Submitted Claims</h2>
        </header>

        @if (Model.Claims.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Claim</th>
                            <th>Course</th>
                            <th>Academic Year</th>
                            <th>Campus</th>
                            <th>Hours</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.Claims)
                        {
                            <tr>
                                <td>
                                    <div class="claim-ref">
                                        <strong>@claim.ClaimNumber</strong>
                                        <span>Teaching claim</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="course-cell">
                                        <strong>@claim.CourseCode</strong>
                                        <span>@claim.CourseName</span>
                                    </div>
                                </td>

                                <td>@claim.AcademicYear</td>

                                <td>@claim.Campus</td>

                                <td>@claim.Hours.ToString("N1")</td>

                                <td>
                                    <span class="status-badge @claim.StatusClass">
                                        @claim.Status
                                    </span>
                                </td>

                                <td>
                                    <a href="@claim.OpenUrl" class="row-action">
                                        View
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No claims yet. Once you submit a claim, it will appear here.</p>
                <a href="/Lecturer/SubmitClaim" class="primary-button">
                    <i class="bi bi-plus-lg"></i>
                    Submit Your First Claim
                </a>
            </div>
        }

    </section>

</section>