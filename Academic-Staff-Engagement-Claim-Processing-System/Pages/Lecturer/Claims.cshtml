@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.ClaimsModel

@{
    ViewData["Title"] = "My Claims";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";

    string GetStatusClass(string status) => status switch
    {
        "Approved" => "status-active",
        "Paid" => "status-paid",
        "Rejected" => "status-danger",
        "Submitted" => "status-pending",
        "Under Review" => "status-pending",
        _ => "status-neutral"
    };

    var totalClaims = Model.TotalClaims;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Lecturer/claims.css"
          asp-append-version="true" />
}

<section class="claims-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>My Claims</h1>
            <p>View your teaching claims and track their approval and payment status.</p>
        </div>

        <div class="page-header-actions">
            <a asp-page="/Lecturer/SubmitClaim" class="primary-button">
                <i class="bi bi-plus-lg"></i>
                Submit Claim
            </a>
        </div>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <section class="claims-stats" aria-label="Claim summary">

        <div class="claims-stat claims-stat--neutral">
            <span class="claims-stat-label">Total Claims</span>
            <span class="claims-stat-value">@Model.TotalClaims</span>
            <span class="claims-stat-meta">All claims you have submitted</span>
        </div>

        <div class="claims-stat claims-stat--action">
            <span class="claims-stat-label">Pending</span>
            <span class="claims-stat-value">@Model.PendingClaims</span>
            <span class="claims-stat-meta">
                @(Model.PendingClaims > 0 ? "In the approval pipeline" : "Nothing waiting")
            </span>
        </div>

        <div class="claims-stat claims-stat--success">
            <span class="claims-stat-label">Approved</span>
            <span class="claims-stat-value">@Model.ApprovedClaims</span>
            <span class="claims-stat-meta">Fully approved claims</span>
        </div>

        <div class="claims-stat claims-stat--neutral">
            <span class="claims-stat-label">Total Hours</span>
            <span class="claims-stat-value">@Model.TotalHours.ToString("N1")</span>
            <span class="claims-stat-meta">Hours across all claims</span>
        </div>

    </section>

    <section class="section-card" id="claims-card">

        <header class="section-header">
            <h2>Submitted Claims</h2>
            <span class="section-meta">
                @totalClaims @(totalClaims == 1 ? "claim" : "claims")
            </span>
        </header>

        @if (Model.Claims.Any())
        {
            <div class="toolbar">

                <form class="search-box"
                      role="search"
                      onsubmit="return false;">

                    <i class="bi bi-search" aria-hidden="true"></i>

                    <input type="search"
                           id="claimSearch"
                           placeholder="Search by claim, course or status…"
                           aria-label="Search claims"
                           autocomplete="off" />

                    <span class="search-hint" aria-hidden="true">Press /</span>

                </form>

            </div>

            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Claim</th>
                            <th>Course</th>
                            <th>Academic Year</th>
                            <th>Campus</th>
                            <th class="col-right">Hours</th>
                            <th>Status</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody id="claimsBody">
                        @foreach (var claim in Model.Claims)
                        {
                            <tr class="claim-row"
                                data-search="@($"{claim.ClaimNumber} {claim.CourseCode} {claim.CourseName} {claim.AcademicYear} {claim.Campus} {claim.Status}".ToLowerInvariant())">

                                <td>
                                    <span class="reference-pill">
                                        @claim.ClaimNumber
                                    </span>
                                </td>

                                <td>
                                    <div class="course-cell">
                                        <span class="course-title">@claim.CourseName</span>
                                        <span class="course-code">@claim.CourseCode</span>
                                    </div>
                                </td>

                                <td>@claim.AcademicYear</td>

                                <td>@claim.Campus</td>

                                <td class="col-right">
                                    <span class="hours-value">
                                        @claim.Hours.ToString("N1")
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge @GetStatusClass(claim.Status)">
                                        @claim.Status
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a href="@claim.OpenUrl" class="row-action">
                                        View
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="table-empty" id="noResults" hidden>
                <p>No claims match your search.</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-wallet2"></i>
                </span>
                <h3>No claims yet</h3>
                <p>Once you submit a claim, it will appear here.</p>
                <a asp-page="/Lecturer/SubmitClaim" class="primary-button">
                    <i class="bi bi-plus-lg"></i>
                    Submit Your First Claim
                </a>
            </div>
        }

    </section>

</section>

@section Scripts {
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input = document.getElementById("claimSearch");
        const noResults = document.getElementById("noResults");

        if (!input) return;

        const rows = Array.prototype.slice.call(
            document.querySelectorAll(".claim-row"));

        function apply() {

            const query = input.value.trim().toLowerCase();
            const terms = query.split(/\s+/).filter(Boolean);

            let shown = 0;

            rows.forEach(function (row) {

                const key = (row.dataset.search || "").toLowerCase();

                const match = terms.every(function (t) {
                    return key.indexOf(t) !== -1;
                });

                row.hidden = !match;

                if (match) shown++;
            });

            if (noResults) {
                noResults.hidden = shown > 0 || rows.length === 0;
            }
        }

        input.addEventListener("input", apply);
        input.addEventListener("search", apply);

        // Press / to focus the search box.
        document.addEventListener("keydown", function (event) {

            const tag = (document.activeElement || {}).tagName || "";

            if (event.key === "/" &&
                !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                !event.ctrlKey && !event.metaKey && !event.altKey) {

                event.preventDefault();
                input.focus();
                input.select();
            }
        });

    });

</script>
}