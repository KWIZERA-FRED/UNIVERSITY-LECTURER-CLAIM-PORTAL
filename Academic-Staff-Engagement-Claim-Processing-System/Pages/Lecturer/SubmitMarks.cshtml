@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.SubmitMarksModel

@{
    ViewData["Title"] = "Submit Marks";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Lecturer/submit-marks.css"
          asp-append-version="true" />
}

<section class="submit-marks-page">

    <header class="page-header">
        <h1>Submit Marks</h1>
        <p>Upload the completed marks sheet for one of your assigned courses.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error" role="alert">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <section class="section-card">

        <header class="section-header">
            <h2>Marks Submission</h2>
        </header>

        <form method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="form-body">

                <div class="form-grid">

                    <div class="form-group form-group-full">

                        <label asp-for="CourseAssignmentId">Course <span>*</span></label>

                        <select asp-for="CourseAssignmentId"
                                id="courseAssignment"
                                class="form-control">

                            <option value="0">Select course</option>

                            @foreach (var assignment in Model.Assignments)
                            {
                                <option value="@assignment.Id"
                                        data-academic-year="@assignment.AcademicYear"
                                        data-semester="@assignment.Semester"
                                        data-session="@assignment.Session"
                                        data-campus="@assignment.Campus">

                                    @assignment.Course.Code - @assignment.Course.Title

                                </option>
                            }

                        </select>

                    </div>

                    <div class="form-group">

                        <label for="academicYear">Academic Year</label>

                        <input type="text"
                               id="academicYear"
                               class="form-control"
                               readonly
                               placeholder="—" />

                    </div>

                    <div class="form-group">

                        <label for="semester">Semester</label>

                        <input type="text"
                               id="semester"
                               class="form-control"
                               readonly
                               placeholder="—" />

                    </div>

                    <div class="form-group">

                        <label for="session">Session</label>

                        <input type="text"
                               id="session"
                               class="form-control"
                               readonly
                               placeholder="—" />

                    </div>

                    <div class="form-group">

                        <label for="campus">Campus</label>

                        <input type="text"
                               id="campus"
                               class="form-control"
                               readonly
                               placeholder="—" />

                    </div>

                </div>

                <div class="form-divider"></div>

                <div class="form-section">

                    <h3 class="form-section-title">Marks Sheet</h3>

                    <div class="form-group">

                        <label asp-for="MarksFile">Marks Excel Sheet <span>*</span></label>

                        <div class="upload-area"
                             id="uploadArea"
                             onclick="document.getElementById('marksFile').click();">

                            <div class="upload-icon" aria-hidden="true">
                                <i class="bi bi-file-earmark-excel"></i>
                            </div>

                            <div class="upload-title">
                                Upload Excel Marks Sheet
                            </div>

                            <div class="upload-description">
                                Select the completed .xlsx file from your computer.
                            </div>

                            <div class="file-input">

                                <input asp-for="MarksFile"
                                       id="marksFile"
                                       type="file"
                                       accept=".xlsx"
                                       onclick="event.stopPropagation();"
                                       onchange="showFileName(this)" />

                            </div>

                            <div id="fileName" class="upload-file-name"></div>

                        </div>

                    </div>

                </div>

            </div>

            <footer class="form-actions">

                <button type="submit" class="primary-button">
                    <i class="bi bi-cloud-arrow-up"></i>
                    Submit Marks
                </button>

            </footer>

        </form>

    </section>

</section>

@section Scripts {

    <script>
        function showFileName(input) {
            const fileName = document.getElementById("fileName");
            const area = document.getElementById("uploadArea");

            if (input.files && input.files.length > 0) {
                fileName.innerHTML =
                    '<i class="bi bi-check-circle-fill"></i> ' +
                    "Selected: " + input.files[0].name;

                if (area) area.classList.add("has-file");
            } else {
                fileName.textContent = "";

                if (area) area.classList.remove("has-file");
            }
        }

        document.addEventListener("DOMContentLoaded", function () {

            const courseSelect = document.getElementById("courseAssignment");
            const academicYear = document.getElementById("academicYear");
            const semester = document.getElementById("semester");
            const session = document.getElementById("session");
            const campus = document.getElementById("campus");

            function updateAssignmentDetails() {

                const selectedOption =
                    courseSelect.options[courseSelect.selectedIndex];

                if (!selectedOption ||
                    !selectedOption.value ||
                    selectedOption.value === "0") {

                    academicYear.value = "";
                    semester.value = "";
                    session.value = "";
                    campus.value = "";

                    return;
                }

                academicYear.value = selectedOption.dataset.academicYear || "";
                semester.value = selectedOption.dataset.semester || "";
                session.value = selectedOption.dataset.session || "";
                campus.value = selectedOption.dataset.campus || "";
            }

            courseSelect.addEventListener("change", updateAssignmentDetails);

            updateAssignmentDetails();
        });
    </script>

}