@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.SubmitMarksModel

@{
    Layout = null;
    ViewData["Title"] = "Submit Marks";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Submit Marks | UNILAK Staff Portal</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --primary: #174d3b;
            --primary-light: #236b51;
            --accent: #2a7f5e;
            --accent-light: #e1f0e8;
            --bg: #f5f8f6;
            --card: #ffffff;
            --border: #dce7e1;
            --text: #1a2b24;
            --text-muted: #60736a;
            --danger-bg: #f8d7da;
            --danger-text: #721c24;
            --danger-border: #f1bfc4;
            --success-bg: #e1f0e8;
            --success-text: #174d3b;
            --radius: 16px;
            --shadow: 0 10px 30px rgba(23,77,59,.08);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* =====================================================
           HEADER
           ===================================================== */

        .top-header {
            height: 72px;
            background: rgba(255,255,255,.97);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-logo {
            width: 42px;
            height: 42px;
            object-fit: contain;
        }

        .header-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--primary);
        }

        .header-subtitle {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .header-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-text {
            font-size: 12px;
        }

        .user-name {
            font-weight: 700;
        }

        .user-role {
            color: var(--text-muted);
            font-size: 10px;
        }

        /* =====================================================
           LAYOUT
           ===================================================== */

        .layout {
            display: flex;
            min-height: calc(100vh - 72px);
        }

        /* =====================================================
           SIDEBAR
           ===================================================== */

        .sidebar {
            width: 245px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 25px 15px;
            flex-shrink: 0;
        }

        .sidebar-title {
            font-size: 10px;
            font-weight: 700;
            color: #94a59d;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 0 12px;
            margin-bottom: 10px;
        }

        .menu {
            list-style: none;
        }

        .menu li {
            margin-bottom: 5px;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 10px;
            text-decoration: none;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 600;
            transition: .2s;
        }

        .menu a:hover,
        .menu a.active {
            background: var(--accent-light);
            color: var(--accent);
        }

        .menu i {
            font-size: 15px;
        }

        /* =====================================================
           CONTENT
           ===================================================== */

        .content {
            flex: 1;
            padding: 32px;
            max-width: 1150px;
        }

        .page-header {
            margin-bottom: 25px;
        }

        .page-header h1 {
            color: var(--primary);
            font-size: 25px;
            font-weight: 800;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 12px;
            margin-top: 5px;
        }

        /* =====================================================
           CARD
           ===================================================== */

        .form-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 30px;
            max-width: 850px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .section-title i {
            color: var(--accent);
        }

        /* =====================================================
           MESSAGES
           ===================================================== */

        .error-message,
        .success-message {
            padding: 13px;
            border-radius: 9px;
            font-size: 11px;
            margin-bottom: 20px;
        }

        .error-message {
            background: var(--danger-bg);
            color: var(--danger-text);
            border: 1px solid var(--danger-border);
        }

        .success-message {
            background: var(--success-bg);
            color: var(--success-text);
            border: 1px solid #bfd8ca;
        }

        /* =====================================================
           FORM
           ===================================================== */

        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        select {
            width: 100%;
            padding: 13px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: white;
            font-family: inherit;
            font-size: 12px;
            color: var(--text);
        }

        select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(42,127,94,.10);
        }

        /* =====================================================
           UPLOAD
           ===================================================== */

        .upload-area {
            border: 2px dashed #bfd3c9;
            border-radius: 14px;
            padding: 35px 25px;
            text-align: center;
            background: #fbfdfc;
            transition: .2s;
            cursor: pointer;
        }

        .upload-area:hover {
            border-color: var(--accent);
            background: var(--accent-light);
        }

        .upload-icon {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 24px;
        }

        .upload-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--primary);
        }

        .upload-description {
            margin-top: 6px;
            font-size: 10px;
            color: var(--text-muted);
        }

        .file-input {
            margin-top: 18px;
        }

        .file-input input {
            font-family: inherit;
            font-size: 11px;
            max-width: 100%;
        }

        #fileName {
            margin-top: 10px;
            font-size: 10px;
            color: var(--accent);
            font-weight: 700;
        }

        /* =====================================================
           FORMAT
           ===================================================== */

        .format-box {
            margin-top: 20px;
            padding: 15px;
            border-radius: 11px;
            background: #f8fbf9;
            border: 1px solid var(--border);
        }

        .format-title {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .format-title i {
            color: var(--accent);
        }

        .format-box p {
            font-size: 10px;
            line-height: 1.7;
            color: var(--text-muted);
        }

        .columns {
            margin-top: 8px;
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .column-tag {
            background: white;
            border: 1px solid var(--border);
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 9px;
            color: var(--text);
            font-weight: 600;
        }

        /* =====================================================
           BUTTON
           ===================================================== */

        .actions {
            display: flex;
            justify-content: flex-end;
            margin-top: 28px;
        }

        .submit-button {
            border: none;
            border-radius: 30px;
            padding: 13px 23px;
            background: var(--accent);
            color: white;
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: .2s;
        }

        .submit-button:hover {
            background: #216b4f;
            transform: translateY(-1px);
        }

        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @@media(max-width: 800px) {

            .sidebar {
                width: 70px;
            }

            .sidebar-title,
            .menu span {
                display: none;
            }

            .menu a {
                justify-content: center;
            }

            .content {
                padding: 20px;
            }

            .form-card {
                padding: 22px;
            }

            .header-subtitle {
                display: none;
            }
        }

    </style>

</head>

<body>

    <!-- HEADER -->

    <header class="top-header">

        <div class="header-left">

            <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                 class="header-logo"
                 alt="UNILAK">

            <div>

                <div class="header-title">
                    UNILAK Staff Portal
                </div>

                <div class="header-subtitle">
                    Academic Staff Engagement & Claim Processing
                </div>

            </div>

        </div>

        <div class="header-user">

            <div class="user-icon">
                <i class="bi bi-person"></i>
            </div>

            <div class="user-text">

                <div class="user-name">
                    @Model.LecturerName
                </div>

                <div class="user-role">
                    Lecturer
                </div>

            </div>

        </div>

    </header>


    <div class="layout">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="sidebar-title">
                Lecturer Portal
            </div>

            <ul class="menu">

                <li>
                    <a href="/Lecturer">
                        <i class="bi bi-grid"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li>
                    <a href="/Lecturer/Contracts">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Contracts</span>
                    </a>
                </li>

                <li>
                    <a href="/Lecturer/SubmitMarks"
                       class="active">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        <span>Submit Marks</span>
                    </a>
                </li>

                <li>
                    <a href="/Lecturer/SubmitClaim">
                        <i class="bi bi-cash-stack"></i>
                        <span>Submit Claim</span>
                    </a>
                </li>

                <li>
                    <a href="/Shared/Claims">
                        <i class="bi bi-receipt"></i>
                        <span>Claims</span>
                    </a>
                </li>

            </ul>

        </aside>


        <!-- CONTENT -->

        <main class="content">

            <div class="page-header">

                <h1>
                    Submit Marks
                </h1>

                <p>
                    Upload the completed marks sheet for one of your assigned courses.
                </p>

            </div>


            <div class="form-card">

                <div class="section-title">

                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>

                    Academic Marks Submission

                </div>


                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message">

                        <i class="bi bi-exclamation-circle"></i>

                        @Model.ErrorMessage

                    </div>
                }


                <form method="post"
                      enctype="multipart/form-data">


                    <!-- COURSE -->

                    <div class="form-group">

                        <label for="courseAssignment">
                            Course
                        </label>

                        <select asp-for="SelectedCourseAssignmentId"
                                id="courseAssignment">

                            <option value="0">
                                Select course
                            </option>

                            @foreach (var assignment in Model.CourseAssignments)
                            {
                                <option value="@assignment.Id">

                                    @assignment.Course.Code -
                                    @assignment.Course.Title

                                </option>
                            }

                        </select>

                    </div>


                    <!-- ACADEMIC YEAR -->

                    <div class="form-group">

                        <label for="academicYear">
                            Academic Year
                        </label>

                        <select asp-for="AcademicYear"
                                id="academicYear">

                            <option value="">
                                Select academic year
                            </option>

                            <option value="2025/2026">
                                2025/2026
                            </option>

                            <option value="2026/2027">
                                2026/2027
                            </option>

                            <option value="2027/2028">
                                2027/2028
                            </option>

                        </select>

                    </div>


                    <!-- EXCEL -->

                    <div class="form-group">

                        <label>
                            Marks Excel Sheet
                        </label>

                        <div class="upload-area"
                             onclick="document.getElementById('marksFile').click();">

                            <div class="upload-icon">

                                <i class="bi bi-file-earmark-excel"></i>

                            </div>

                            <div class="upload-title">
                                Upload Excel Marks Sheet
                            </div>

                            <div class="upload-description">
                                Select the completed .xlsx marks file from your computer.
                            </div>

                            <div class="file-input">

                                <input asp-for="MarksFile"
                                       id="marksFile"
                                       type="file"
                                       accept=".xlsx"
                                       onclick="event.stopPropagation();"
                                       onchange="showFileName(this)" />

                            </div>

                            <div id="fileName"></div>

                        </div>

                    </div>


                    <!-- FORMAT -->

                    <div class="format-box">

                        <div class="format-title">

                            <i class="bi bi-info-circle-fill"></i>

                            Required Excel Format

                        </div>

                        <p>
                            Your Excel file should contain the student
                            information and their marks. The system will
                            validate the uploaded sheet before accepting
                            the submission.
                        </p>

                        <div class="columns">

                            <span class="column-tag">
                                Student ID
                            </span>

                            <span class="column-tag">
                                Student Name
                            </span>

                            <span class="column-tag">
                                CAT
                            </span>

                            <span class="column-tag">
                                Assignment
                            </span>

                            <span class="column-tag">
                                Exam
                            </span>

                            <span class="column-tag">
                                Total
                            </span>

                            <span class="column-tag">
                                Grade
                            </span>

                        </div>

                    </div>


                    <!-- SUBMIT -->

                    <div class="actions">

                        <button type="submit"
                                class="submit-button">

                            <i class="bi bi-cloud-arrow-up"></i>

                            Submit Marks

                        </button>

                    </div>

                </form>

            </div>

        </main>

    </div>


    <script>

        function showFileName(input) {

            const fileName =
                document.getElementById("fileName");

            if (input.files &&
                input.files.length > 0) {

                fileName.textContent =
                    "Selected: " +
                    input.files[0].name;

            } else {

                fileName.textContent = "";

            }
        }

    </script>

</body>

</html>