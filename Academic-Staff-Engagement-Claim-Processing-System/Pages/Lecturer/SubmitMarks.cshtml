@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.SubmitMarksModel

@{
    Layout = null;
    ViewData["Title"] = "Submit Marks";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Submit Marks | UNILAK Staff Portal</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --primary: #174d3b;
            --primary-light: #236b51;
            --accent: #2a7f5e;
            --accent-light: #e1f0e8;
            --bg: #f5f8f6;
            --card: #ffffff;
            --border: #dce7e1;
            --text: #1a2b24;
            --muted: #60736a;
            --danger-bg: #f8d7da;
            --danger-text: #721c24;
            --danger-border: #f1bfc4;
            --success-bg: #dff3e7;
            --success-text: #145c35;
            --success-border: #b8dfc6;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        .top-header {
            height: 72px;
            background: white;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .header-left,
        .header-user {
            display: flex;
            align-items: center;
        }

        .header-left {
            gap: 12px;
        }

        .header-logo {
            width: 42px;
            height: 42px;
            object-fit: contain;
        }

        .header-title {
            font-size: 15px;
            font-weight: 800;
            color: var(--primary);
        }

        .header-subtitle {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
        }

        .header-user {
            gap: 10px;
        }

        .user-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-name {
            font-size: 12px;
            font-weight: 700;
        }

        .user-role {
            font-size: 10px;
            color: var(--muted);
        }

        .layout {
            display: flex;
            min-height: calc(100vh - 72px);
        }

        .sidebar {
            width: 245px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 25px 15px;
            flex-shrink: 0;
        }

        .sidebar-title {
            font-size: 10px;
            font-weight: 800;
            color: #94a59d;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 0 12px;
            margin-bottom: 10px;
        }

        .menu {
            list-style: none;
        }

        .menu li {
            margin-bottom: 5px;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 10px;
            text-decoration: none;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .menu a:hover,
        .menu a.active {
            background: var(--accent-light);
            color: var(--accent);
        }

        .content {
            flex: 1;
            padding: 32px;
            max-width: 1100px;
        }

        .page-header {
            margin-bottom: 25px;
        }

        .page-header h1 {
            color: var(--primary);
            font-size: 25px;
            font-weight: 800;
        }

        .page-header p {
            color: var(--muted);
            font-size: 12px;
            margin-top: 5px;
        }

        .form-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(23, 77, 59, .08);
            max-width: 850px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 25px;
        }

        .section-title i {
            color: var(--accent);
        }

        .message {
            padding: 13px;
            border-radius: 9px;
            font-size: 11px;
            margin-bottom: 20px;
        }

        .error-message {
            background: var(--danger-bg);
            color: var(--danger-text);
            border: 1px solid var(--danger-border);
        }

        .success-message {
            background: var(--success-bg);
            color: var(--success-text);
            border: 1px solid var(--success-border);
        }

        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            font-size: 11px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        select,
        input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: white;
            font-family: inherit;
            font-size: 12px;
            color: var(--text);
        }

        select:focus,
        input[type="file"]:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(42, 127, 94, .10);
        }

        .upload-area {
            border: 2px dashed #bfd3c9;
            border-radius: 14px;
            padding: 30px 25px;
            text-align: center;
            background: #fbfdfc;
        }

        .upload-icon {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 24px;
        }

        .upload-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--primary);
        }

        .upload-description {
            margin-top: 6px;
            margin-bottom: 18px;
            font-size: 10px;
            color: var(--muted);
        }

        .format-box {
            margin-top: 20px;
            padding: 15px;
            border-radius: 11px;
            background: #f8fbf9;
            border: 1px solid var(--border);
        }

        .format-title {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--primary);
            font-size: 11px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .format-title i {
            color: var(--accent);
        }

        .format-box p {
            font-size: 10px;
            line-height: 1.7;
            color: var(--muted);
        }

        .columns {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .column-tag {
            background: white;
            border: 1px solid var(--border);
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 9px;
            color: var(--text);
            font-weight: 600;
        }

        .actions {
            display: flex;
            justify-content: flex-end;
            margin-top: 28px;
        }

        .submit-button {
            border: none;
            border-radius: 30px;
            padding: 13px 23px;
            background: var(--accent);
            color: white;
            font-family: inherit;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .submit-button:hover {
            background: var(--primary-light);
        }

        .security-note {
            margin-top: 18px;
            font-size: 10px;
            color: var(--muted);
            display: flex;
            gap: 7px;
            align-items: flex-start;
        }

        .security-note i {
            color: var(--accent);
        }

        @@media(max-width: 800px) {

            .sidebar {
                width: 70px;
            }

            .sidebar-title,
            .menu span {
                display: none;
            }

            .menu a {
                justify-content: center;
            }

            .content {
                padding: 20px;
            }

            .form-card {
                padding: 22px;
            }

            .header-subtitle {
                display: none;
            }
        }

    </style>

</head>

<body>

<header class="top-header">

    <div class="header-left">

        <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
             class="header-logo"
             alt="UNILAK">

        <div>

            <div class="header-title">
                UNILAK Staff Portal
            </div>

            <div class="header-subtitle">
                Academic Staff Engagement & Claim Processing
            </div>

        </div>

    </div>

    <div class="header-user">

        <div class="user-icon">
            <i class="bi bi-person"></i>
        </div>

        <div>

            <div class="user-name">
                @Model.LecturerName
            </div>

            <div class="user-role">
                Lecturer
            </div>

        </div>

    </div>

</header>


<div class="layout">

    <aside class="sidebar">

        <div class="sidebar-title">
            Lecturer Portal
        </div>

        <ul class="menu">

            <li>
                <a href="/Lecturer">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li>
                <a href="/Lecturer/Contracts">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Contracts</span>
                </a>
            </li>

            <li>
                <a href="/Lecturer/SubmitMarks"
                   class="active">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    <span>Submit Marks</span>
                </a>
            </li>

            <li>
                <a href="/Lecturer/SubmitClaim">
                    <i class="bi bi-cash-stack"></i>
                    <span>Submit Claim</span>
                </a>
            </li>

            <li>
                <a href="/Shared/Claims">
                    <i class="bi bi-receipt"></i>
                    <span>Claims</span>
                </a>
            </li>

        </ul>

    </aside>


    <main class="content">

        <div class="page-header">

            <h1>
                Submit Marks
            </h1>

            <p>
                Upload the completed marks sheet for your assigned course.
            </p>

        </div>


        <div class="form-card">

            <div class="section-title">

                <i class="bi bi-file-earmark-spreadsheet-fill"></i>

                Academic Marks Submission

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="message error-message">

                    <i class="bi bi-exclamation-circle"></i>

                    @Model.ErrorMessage

                </div>
            }


            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="message success-message">

                    <i class="bi bi-check-circle"></i>

                    @Model.SuccessMessage

                </div>
            }


            <form method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <div class="form-group">

                    <label asp-for="CourseAssignmentId">
                        Course
                    </label>

                    <select asp-for="CourseAssignmentId">

                        <option value="0">
                            Select course
                        </option>

                        @foreach (var assignment in Model.Assignments)
                        {
                            <option value="@assignment.Id">

                                @assignment.Course.Code -
                                @assignment.Course.Title
                                |
                                @assignment.AcademicYear
                                |
                                @assignment.Semester

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label asp-for="AcademicYear">
                        Academic Year
                    </label>

                    <select asp-for="AcademicYear">

                        <option value="">
                            Select academic year
                        </option>

                        @foreach (var year in Model.Assignments
                            .Select(a => a.AcademicYear)
                            .Distinct()
                            .OrderByDescending(y => y))
                        {
                            <option value="@year">
                                @year
                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label asp-for="Semester">
                        Semester
                    </label>

                    <select asp-for="Semester">

                        <option value="">
                            Select semester
                        </option>

                        @foreach (var semester in Enum.GetValues<Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums.Semester>())
                        {
                            <option value="@semester">
                                @semester
                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label asp-for="MarksFile">
                        Marks Excel Sheet
                    </label>

                    <div class="upload-area">

                        <div class="upload-icon">

                            <i class="bi bi-file-earmark-excel"></i>

                        </div>

                        <div class="upload-title">

                            Upload Excel Marks Sheet

                        </div>

                        <div class="upload-description">

                            Only .xlsx files are accepted.
                            Maximum file size: 10 MB.

                        </div>

                        <input asp-for="MarksFile"
                               type="file"
                               accept=".xlsx" />

                    </div>

                </div>


                <div class="format-box">

                    <div class="format-title">

                        <i class="bi bi-info-circle-fill"></i>

                        Required Excel Format

                    </div>

                    <p>

                        Your Excel file should contain the student
                        information and marks required by the university.

                    </p>

                    <div class="columns">

                        <span class="column-tag">
                            Student ID
                        </span>

                        <span class="column-tag">
                            Student Name
                        </span>

                        <span class="column-tag">
                            CAT
                        </span>

                        <span class="column-tag">
                            Assignment
                        </span>

                        <span class="column-tag">
                            Exam
                        </span>

                        <span class="column-tag">
                            Total
                        </span>

                        <span class="column-tag">
                            Grade
                        </span>

                    </div>

                </div>


                <div class="security-note">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Your submission is linked to your authenticated
                        lecturer account. The uploaded file is stored using
                        a server-generated private storage key and is
                        protected by a SHA-256 integrity hash.
                    </span>

                </div>


                <div class="actions">

                    <button type="submit"
                            class="submit-button">

                        <i class="bi bi-cloud-arrow-up"></i>

                        Submit Marks

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>

</body>

</html>