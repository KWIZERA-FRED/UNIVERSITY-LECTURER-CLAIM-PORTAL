@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.SubmitMarksModel

@{
    ViewData["Title"] = "Submit Marks";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Lecturer/submit-marks.css"
          asp-append-version="true" />
}

<section class="submit-marks-page">

    <header class="marks-page-header">

        <div class="marks-heading">

            <span class="page-eyebrow">
                Lecturer Portal
            </span>

            <h1>
                Submit Marks
            </h1>

            <p>
                Upload the completed marks sheet for one of your assigned courses.
            </p>

        </div>

    </header>


    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="marks-alert marks-alert-error">

            <span class="marks-alert-icon">
                <i class="bi bi-exclamation-circle"></i>
            </span>

            <span>
                @Model.ErrorMessage
            </span>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="marks-alert marks-alert-success">

            <span class="marks-alert-icon">
                <i class="bi bi-check-circle"></i>
            </span>

            <span>
                @Model.SuccessMessage
            </span>

        </div>
    }


    <section class="marks-form-card">

        <div class="marks-section-header">

            <div class="marks-section-icon">
                <i class="bi bi-file-earmark-spreadsheet-fill"></i>
            </div>

            <div>

                <span class="section-eyebrow">
                    Academic Records
                </span>

                <h2>
                    Academic Marks Submission
                </h2>

                <p>
                    Select the course and academic period, then upload the completed marks sheet.
                </p>

            </div>

        </div>


        <form method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="marks-form-body">

                <div class="form-grid">

                    <div class="form-group form-group-full">

                        <label asp-for="CourseAssignmentId">
                            Course
                        </label>

                        <select asp-for="CourseAssignmentId">

                            <option value="0">
                                Select course
                            </option>

                            @foreach (var assignment in Model.Assignments)
                            {
                                <option value="@assignment.Id">
                                    @assignment.Course.Code - @assignment.Course.Title
                                </option>
                            }

                        </select>

                    </div>


                    <div class="form-group">

                        <label asp-for="AcademicYear">
                            Academic Year
                        </label>

                        <select asp-for="AcademicYear">

                            <option value="">
                                Select academic year
                            </option>

                            @foreach (var year in Model.Assignments
                                .Select(a => a.AcademicYear)
                                .Distinct()
                                .OrderByDescending(y => y))
                            {
                                <option value="@year">
                                    @year
                                </option>
                            }

                        </select>

                    </div>


                    <div class="form-group">

                        <label asp-for="Semester">
                            Semester
                        </label>

                        <select asp-for="Semester">

                            <option value="">
                                Select semester
                            </option>

                            @foreach (var semester in Enum.GetValues<Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums.Semester>())
                            {
                                <option value="@semester">
                                    @semester
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="form-group upload-form-group">

                    <label asp-for="MarksFile">
                        Marks Excel Sheet
                    </label>

                    <div class="upload-area"
                         onclick="document.getElementById('marksFile').click();">

                        <div class="upload-icon">

                            <i class="bi bi-file-earmark-excel"></i>

                        </div>

                        <div class="upload-title">
                            Upload Excel Marks Sheet
                        </div>

                        <div class="upload-description">
                            Select the completed .xlsx marks file from your computer.
                        </div>

                        <div class="file-input">

                            <input asp-for="MarksFile"
                                   id="marksFile"
                                   type="file"
                                   accept=".xlsx"
                                   onclick="event.stopPropagation();"
                                   onchange="showFileName(this)" />

                        </div>

                        <div id="fileName"></div>

                    </div>

                </div>


                <div class="format-box">

                    <div class="format-title">

                        <i class="bi bi-info-circle-fill"></i>

                        <span>
                            Required Excel Format
                        </span>

                    </div>

                    <p>
                        Your Excel file should contain the student information and
                        marks required by the university. The system will validate
                        the uploaded sheet before accepting the submission.
                    </p>

                    <div class="columns">

                        <span class="column-tag">
                            Student ID
                        </span>

                        <span class="column-tag">
                            Student Name
                        </span>

                        <span class="column-tag">
                            CAT
                        </span>

                        <span class="column-tag">
                            Assignment
                        </span>

                        <span class="column-tag">
                            Exam
                        </span>

                        <span class="column-tag">
                            Total
                        </span>

                        <span class="column-tag">
                            Grade
                        </span>

                    </div>

                </div>


                <div class="security-note">

                    <span class="security-icon">
                        <i class="bi bi-shield-check"></i>
                    </span>

                    <span>
                        Your submission is linked to your authenticated lecturer account.
                        The uploaded file is stored using a server-generated private storage
                        key and is protected by a SHA-256 integrity hash.
                    </span>

                </div>

            </div>


            <div class="marks-form-actions">

                <button type="submit"
                        class="submit-marks-button">

                    <i class="bi bi-cloud-arrow-up"></i>

                    Submit Marks

                </button>

            </div>

        </form>

    </section>

</section>


@section Scripts {

    <script>
        function showFileName(input) {

            const fileName =
                document.getElementById("fileName");

            if (input.files && input.files.length > 0) {

                fileName.textContent =
                    "Selected: " + input.files[0].name;

            } else {

                fileName.textContent = "";

            }
        }
    </script>

}