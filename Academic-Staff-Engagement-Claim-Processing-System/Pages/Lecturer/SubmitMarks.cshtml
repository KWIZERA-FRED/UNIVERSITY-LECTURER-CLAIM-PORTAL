@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Lecturer.SubmitMarksModel

@{
    ViewData["Title"] = "Submit Marks";
    Layout = "/Pages/Shared/Lecturer/_LecturerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Lecturer/submit-marks.css"
          asp-append-version="true" />
}

<section class="submit-marks-page">

    <header class="page-header">
        <h1>Submit Marks</h1>
        <p>Upload the completed marks sheet for one of your assigned courses.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="marks-alert marks-alert-error">
            <span class="marks-alert-icon">
                <i class="bi bi-exclamation-circle"></i>
            </span>

            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="marks-alert marks-alert-success">
            <span class="marks-alert-icon">
                <i class="bi bi-check-circle"></i>
            </span>

            <span>@Model.SuccessMessage</span>
        </div>
    }

    <section class="marks-form-card">

        <header class="marks-section-header">
            <h2>Marks Submission</h2>
        </header>

        <form method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="marks-form-body">

                <div class="form-grid">

                    <div class="form-group form-group-full">

                        <label asp-for="CourseAssignmentId">Course</label>

                        <select asp-for="CourseAssignmentId"
                                id="courseAssignment">

                            <option value="0">Select course</option>

                            @foreach (var assignment in Model.Assignments)
                            {
                                <option value="@assignment.Id"
                                        data-academic-year="@assignment.AcademicYear"
                                        data-semester="@assignment.Semester"
                                        data-session="@assignment.Session"
                                        data-campus="@assignment.Campus">

                                    @assignment.Course.Code - @assignment.Course.Title

                                </option>
                            }

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Academic Year</label>

                        <input type="text"
                               id="academicYear"
                               readonly
                               placeholder="—" />

                    </div>

                    <div class="form-group">

                        <label>Semester</label>

                        <input type="text"
                               id="semester"
                               readonly
                               placeholder="—" />

                    </div>

                    <div class="form-group">

                        <label>Session</label>

                        <input type="text"
                               id="session"
                               readonly
                               placeholder="—" />

                    </div>

                    <div class="form-group">

                        <label>Campus</label>

                        <input type="text"
                               id="campus"
                               readonly
                               placeholder="—" />

                    </div>

                </div>

                <div class="form-group upload-form-group">

                    <label asp-for="MarksFile">Marks Excel Sheet</label>

                    <div class="upload-area"
                         onclick="document.getElementById('marksFile').click();">

                        <div class="upload-icon">
                            <i class="bi bi-file-earmark-excel"></i>
                        </div>

                        <div class="upload-title">
                            Upload Excel Marks Sheet
                        </div>

                        <div class="upload-description">
                            Select the completed .xlsx file from your computer.
                        </div>

                        <div class="file-input">

                            <input asp-for="MarksFile"
                                   id="marksFile"
                                   type="file"
                                   accept=".xlsx"
                                   onclick="event.stopPropagation();"
                                   onchange="showFileName(this)" />

                        </div>

                        <div id="fileName"></div>

                    </div>

                </div>

            </div>

            <div class="marks-form-actions">

                <button type="submit" class="submit-marks-button">
                    <i class="bi bi-cloud-arrow-up"></i>
                    Submit Marks
                </button>

            </div>

        </form>

    </section>

</section>

@section Scripts {

    <script>
        function showFileName(input) {
            const fileName = document.getElementById("fileName");

            if (input.files && input.files.length > 0) {
                fileName.textContent = "Selected: " + input.files[0].name;
            } else {
                fileName.textContent = "";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {

            const courseSelect = document.getElementById("courseAssignment");
            const academicYear = document.getElementById("academicYear");
            const semester = document.getElementById("semester");
            const session = document.getElementById("session");
            const campus = document.getElementById("campus");

            function updateAssignmentDetails() {

                const selectedOption =
                    courseSelect.options[courseSelect.selectedIndex];

                if (!selectedOption ||
                    !selectedOption.value ||
                    selectedOption.value === "0") {

                    academicYear.value = "";
                    semester.value = "";
                    session.value = "";
                    campus.value = "";

                    return;
                }

                academicYear.value = selectedOption.dataset.academicYear || "";
                semester.value = selectedOption.dataset.semester || "";
                session.value = selectedOption.dataset.session || "";
                campus.value = selectedOption.dataset.campus || "";
            }

            courseSelect.addEventListener("change", updateAssignmentDetails);

            updateAssignmentDetails();
        });
    </script>

}