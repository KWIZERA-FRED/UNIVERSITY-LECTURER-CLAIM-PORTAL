@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Public.ClaimDocumentsModel

@{
    ViewData["Title"] = "Claim Documents";

    var managementTitle = User.FindFirst("ManagementTitle")?.Value;

    Layout =
        User.IsInRole("Lecturer")
            ? "/Pages/Shared/Lecturer/_LecturerLayout.cshtml"
            : User.IsInRole("HOD")
                ? "/Pages/Shared/HOD/_HODLayout.cshtml"
                : User.IsInRole("Dean")
                    ? "/Pages/Shared/DEAN/_DeanLayout.cshtml"
                    : User.IsInRole("Management") &&
                      (managementTitle == "DirectorOfQuality" ||
                       managementTitle == "DVCAR")
                        ? "/Pages/Shared/Management/_ManagementLayout.cshtml"
                        : null;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Public/claim-documents.css"
          asp-append-version="true" />
}

<section class="claim-documents-page">

    @if (Model.Documents is null)
    {
        <div class="cd-empty">

            <div class="cd-empty-icon">
                <i class="bi bi-file-earmark-x"></i>
            </div>

            <h1>Documents not found</h1>

            <p>
                The claim documents you are trying to access do not exist
                or the access link has expired.
            </p>

        </div>
    }
    else
    {
        var documents = Model.Documents;

        <article class="cd-card">

            <header class="cd-header">

                <a class="cd-header-back"
                   href="@Model.BackUrl"
                   aria-label="Back to claim">

                    <i class="bi bi-arrow-left"></i>

                </a>

                <div class="cd-header-main">

                    <h1>Claim Documents</h1>

                    <p class="cd-header-refs">
                        <span>@documents.ClaimReference</span>
                        <span class="cd-separator">·</span>
                        <span>@documents.ContractReference</span>
                    </p>

                </div>

                <div class="cd-header-spacer" aria-hidden="true"></div>

            </header>

            @if (!string.IsNullOrEmpty(Model.QrCodeDataUrl))
            {
                <section class="cd-qr-hero">

                    <div class="cd-qr">

                        <img src="@Model.QrCodeDataUrl"
                             alt="QR code for these claim documents"
                             width="140"
                             height="140" />

                    </div>

                    <p class="cd-qr-caption">
                        Scan this code to verify the claim
                    </p>

                </section>
            }

            <section class="cd-details">

                <div class="cd-detail">
                    <span class="cd-detail-label">Lecturer</span>
                    <span class="cd-detail-value">
                        @documents.LecturerName
                    </span>
                </div>

                <div class="cd-detail">
                    <span class="cd-detail-label">Course</span>
                    <span class="cd-detail-value">
                        @documents.CourseCode — @documents.CourseTitle
                    </span>
                </div>

                <div class="cd-detail">
                    <span class="cd-detail-label">Claimed Hours</span>
                    <span class="cd-detail-value">
                        @documents.Hours.ToString("N1")
                    </span>
                </div>

                <div class="cd-detail">
                    <span class="cd-detail-label">Status</span>
                    <span class="cd-detail-value">
                        @FormatStatus(documents.Status.ToString())
                    </span>
                </div>

            </section>

            <footer class="cd-actions">

                <a class="cd-download"
                   href="?handler=Pdf&token=@documents.Token&document=contract">

                    <span class="cd-badge cd-badge-pdf">PDF</span>

                    <div class="cd-download-text">
                        <strong>Signed Contract</strong>
                        <span>Download PDF</span>
                    </div>

                    <i class="bi bi-download cd-download-icon"></i>

                </a>

                <a class="cd-download"
                   href="?handler=Pdf&token=@documents.Token&document=claim-letter">

                    <span class="cd-badge cd-badge-doc">DOC</span>

                    <div class="cd-download-text">
                        <strong>Claim Letter</strong>
                        <span>Download PDF</span>
                    </div>

                    <i class="bi bi-download cd-download-icon"></i>

                </a>

            </footer>

        </article>
    }

</section>

@functions {

    private static string FormatStatus(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return raw;
        }

        var sb = new System.Text.StringBuilder(raw.Length + 6);

        for (var i = 0; i < raw.Length; i++)
        {
            if (i > 0 &&
                char.IsUpper(raw[i]) &&
                !char.IsUpper(raw[i - 1]))
            {
                sb.Append(' ');
            }

            sb.Append(raw[i]);
        }

        return sb.ToString();
    }

}