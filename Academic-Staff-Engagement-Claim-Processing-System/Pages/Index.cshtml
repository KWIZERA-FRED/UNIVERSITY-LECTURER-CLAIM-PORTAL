    <!-- =================================================
         SCROLL REVEAL & DRAG-IN ANIMATION
         ================================================= -->

    <script>
        /* =================================================
           1. GENERAL SCROLL REVEAL (.ax-reveal)
           ================================================= */
        (function () {
            var items = document.querySelectorAll(".ax-reveal");
            if (!items.length) return;

            if (!("IntersectionObserver" in window)) {
                items.forEach(function (el) { el.classList.remove("ax-reveal"); });
                return;
            }

            function settle(el) {
                var finished = false;
                function finish() {
                    if (finished) return;
                    finished = true;
                    el.removeEventListener("transitionend", onEnd);
                    el.classList.add("is-done");
                }
                function onEnd(e) {
                    if (e.target === el && e.propertyName === "opacity") finish();
                }
                el.addEventListener("transitionend", onEnd);
                setTimeout(finish, 2000);
            }

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var el = entry.target;
                    el.classList.add("is-in");
                    settle(el);
                    observer.unobserve(el);
                });
            }, { threshold: 0, rootMargin: "0px 0px 40px 0px" });

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    items.forEach(function (el) { observer.observe(el); });
                });
            });
        })();

        /* =================================================
           2. DRAG-IN ANIMATION FOR FEATURE CARDS (.reveal-card)
           Dedicated observer + JS stagger so each card waits
           its turn before dragging in.
           ================================================= */
        (function () {
            var cards = document.querySelectorAll(".reveal-card");
            if (!cards.length) return;

            if (!("IntersectionObserver" in window)) {
                cards.forEach(function (c) { c.classList.add("is-in"); });
                return;
            }

            var cardObserver = new IntersectionObserver(function (entries, obs) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;

                    var card = entry.target;
                    var index = parseInt(card.dataset.revealIndex || "0", 10);
                    var delay = index * 350; // 350ms stagger between cards

                    setTimeout(function () {
                        card.classList.add("is-in");
                    }, delay);

                    obs.unobserve(card);
                });
            }, {
                threshold: 0.15,
                rootMargin: "0px 0px -40px 0px"
            });

            cards.forEach(function (card, i) {
                card.dataset.revealIndex = i;
                cardObserver.observe(card);
            });
        })();
    </script>

