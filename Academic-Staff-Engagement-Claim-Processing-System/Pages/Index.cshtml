
@page
@model IndexModel

@{
    Layout = null;
    ViewData["Title"] = "UNILAK Staff Engagement Portal";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="UNILAK Academic Staff Engagement & Claim Processing System">

    <title>@ViewData["Title"]</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/index.css"
          asp-append-version="true">

</head>

<body>

    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <nav class="navbar">

        <div class="navbar-container">

            <div class="navbar-left">

                <a href="/"
                   class="logo-link"
                   aria-label="UNILAK Portal Home">

                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo"
                         class="navbar-logo">

                </a>

                <a href="/"
                   class="navbar-brand">

                    <span class="navbar-brand-title">
                        UNILAK Portal
                    </span>

                    <span class="navbar-brand-subtitle">
                        Academic Staff Engagement System
                    </span>

                </a>

            </div>


            <ul class="navbar-nav">

                <li>

                    <a href="/"
                       class="nav-link active">

                        <i class="bi bi-house-door-fill"></i>

                        <span>
                            Home
                        </span>

                    </a>

                </li>


                <li>

                    <a href="#features"
                       class="nav-link">

                        <i class="bi bi-grid-fill"></i>

                        <span>
                            Features
                        </span>

                    </a>

                </li>


                <li>

                    <a href="/Login"
                       class="nav-btn-login">

                        <i class="bi bi-box-arrow-in-right"></i>

                        <span>
                            Sign In
                        </span>

                    </a>

                </li>

            </ul>

        </div>

    </nav>


    <!-- =====================================================
         HERO
         ===================================================== -->

    <main>

        <section class="hero">

            <div class="hero-overlay"></div>

            <div class="hero-content">

                <h1 class="hero-title">

                    Lecturer Engagement

                    <span>
                        &amp; Claim Management
                    </span>

                </h1>


                <p class="hero-subtitle">

                    Streamline academic staff engagements, attendance
                    tracking, contracts, and payment claims through
                    one secure and centralized university platform.

                </p>


                <div class="hero-buttons">

                    <a href="/Login"
                       class="btn btn-primary">

                        <i class="bi bi-box-arrow-in-right"></i>

                        <span>
                            Staff Login
                        </span>

                    </a>


                    <a href="#features"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-down-circle"></i>

                        <span>
                            Explore Platform
                        </span>

                    </a>

                </div>

            </div>

        </section>


        <!-- =================================================
             TRUST STRIP
             ================================================= -->

        <section class="trust-strip"
                 aria-label="Platform capabilities">

            <div class="trust-container">

                <span class="trust-label">
                    Secure Academic Workflow
                </span>


                <div class="trust-items">

                    <span class="trust-item">

                        <i class="bi bi-person-lock"></i>

                        Role-Based Access

                    </span>


                    <span class="trust-divider"></span>


                    <span class="trust-item">

                        <i class="bi bi-file-earmark-check"></i>

                        Digital Contracts

                    </span>


                    <span class="trust-divider"></span>


                    <span class="trust-item">

                        <i class="bi bi-activity"></i>

                        Approval Tracking

                    </span>


                    <span class="trust-divider"></span>


                    <span class="trust-item">

                        <i class="bi bi-database-check"></i>

                        Centralized Records

                    </span>

                </div>

            </div>

        </section>


        <!-- =================================================
             FEATURES
             ================================================= -->

        <section class="features"
                 id="features">

            <div class="section-header">

                <span class="section-label">
                    PLATFORM
                </span>

                <h2>
                    Core Platform Features
                </h2>

                <p>
                    Everything academic staff and university
                    administrators need to manage engagements,
                    attendance, contracts, and claims efficiently.
                </p>

            </div>


            <div class="features-grid">


                <article class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-person-workspace"></i>

                    </div>

                    <h3>
                        Staff Engagements
                    </h3>

                    <p>
                        Manage lecturer appointments, course
                        assignments, and engagement records
                        through a centralized workflow.
                    </p>

                    <a href="/Login"
                       class="feature-link">

                        Manage Engagements

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </article>


                <article class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-calendar-check-fill"></i>

                    </div>

                    <h3>
                        Attendance Tracking
                    </h3>

                    <p>
                        Record and monitor teaching attendance
                        and completed teaching hours for
                        academic sessions.
                    </p>

                    <a href="/Login"
                       class="feature-link">

                        Track Attendance

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </article>


                <article class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-file-earmark-text-fill"></i>

                    </div>

                    <h3>
                        Digital Contracts
                    </h3>

                    <p>
                        Generate, manage, review, and access
                        academic staff contracts through a
                        structured digital signing workflow.
                    </p>

                    <a href="/Login"
                       class="feature-link">

                        View Contracts

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </article>


                <article class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-cash-coin"></i>

                    </div>

                    <h3>
                        Payment Claims
                    </h3>

                    <p>
                        Submit, review, approve, and track
                        academic staff payment claims with
                        greater transparency.
                    </p>

                    <a href="/Login"
                       class="feature-link">

                        Manage Claims

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </article>


            </div>

        </section>


        <!-- =================================================
             HOW IT WORKS
             ================================================= -->

        <section class="how-it-works">

            <div class="section-header">

                <span class="section-label">
                    WORKFLOW
                </span>

                <h2>
                    How the Platform Works
                </h2>

                <p>
                    A structured workflow connects academic
                    staff and university administration from
                    engagement through claim approval.
                </p>

            </div>


            <div class="workflow">


                <div class="workflow-step">

                    <div class="workflow-number">
                        01
                    </div>

                    <h3>
                        Engagement
                    </h3>

                    <p>
                        Academic staff are registered and
                        assigned teaching engagements.
                    </p>

                </div>


                <div class="workflow-step">

                    <div class="workflow-number">
                        02
                    </div>

                    <h3>
                        Contract
                    </h3>

                    <p>
                        Engagement details are converted
                        into a digital academic contract.
                    </p>

                </div>


                <div class="workflow-step">

                    <div class="workflow-number">
                        03
                    </div>

                    <h3>
                        Attendance
                    </h3>

                    <p>
                        Teaching activities and completed
                        hours are recorded and monitored.
                    </p>

                </div>


                <div class="workflow-step">

                    <div class="workflow-number">
                        04
                    </div>

                    <h3>
                        Claim
                    </h3>

                    <p>
                        Verified teaching activity supports
                        the submission of payment claims.
                    </p>

                </div>


                <div class="workflow-step">

                    <div class="workflow-number">
                        05
                    </div>

                    <h3>
                        Approval
                    </h3>

                    <p>
                        Claims proceed through the required
                        institutional review and approval process.
                    </p>

                </div>


            </div>

        </section>


        <!-- =================================================
             USERS
             ================================================= -->

        <section class="audience">

            <div class="section-header">

                <span class="section-label">
                    USERS
                </span>

                <h2>
                    Built for the UNILAK Community
                </h2>

                <p>
                    A unified platform designed to support
                    academic staff and the university
                    administration throughout the engagement
                    lifecycle.
                </p>

            </div>


            <div class="audience-grid">


                <article class="audience-card">

                    <div class="audience-icon">

                        <i class="bi bi-mortarboard-fill"></i>

                    </div>


                    <div>

                        <h3>
                            Academic Staff
                        </h3>

                        <p>
                            View course engagements, manage
                            digital contracts, record teaching
                            activities, and track remuneration
                            claims from one place.
                        </p>

                    </div>

                </article>


                <article class="audience-card">

                    <div class="audience-icon">

                        <i class="bi bi-building-gear"></i>

                    </div>


                    <div>

                        <h3>
                            Department &amp; Faculty Administration
                        </h3>

                        <p>
                            Manage staff, course assignments,
                            engagements, contracts, attendance,
                            and claim verification workflows.
                        </p>

                    </div>

                </article>


                <article class="audience-card">

                    <div class="audience-icon">

                        <i class="bi bi-person-gear"></i>

                    </div>


                    <div>

                        <h3>
                            University Management
                        </h3>

                        <p>
                            Review institutional workflows,
                            authorize engagements, monitor
                            approvals, and oversee verified
                            academic payment claims.
                        </p>

                    </div>

                </article>


            </div>

        </section>


        <!-- =================================================
             CTA
             ================================================= -->

        <section class="cta">

            <div class="cta-content">


                <div class="cta-icon">

                    <i class="bi bi-shield-lock-fill"></i>

                </div>


                <div class="cta-text">

                    <h2>
                        Access the UNILAK Staff Portal
                    </h2>

                    <p>
                        Sign in using your authorized university
                        credentials to manage your academic
                        engagements and related activities.
                    </p>

                </div>


                <a href="/Login"
                   class="btn btn-cta">

                    <span>
                        Sign In to Portal
                    </span>

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </section>

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="footer">

        <div class="footer-content">


            <div class="footer-brand">

                <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                     alt="UNILAK Logo"
                     class="footer-logo">


                <div>

                    <h3>
                        UNILAK Portal
                    </h3>

                    <p>
                        Academic Staff Engagement &amp;
                        Claim Processing System
                    </p>

                </div>

            </div>


            <div class="footer-right">

                <p>
                    © @DateTime.Now.Year
                    University of Lay Adventists of Kigali
                </p>


                <p class="footer-text">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Secure Academic Management Platform
                    </span>

                </p>

            </div>

        </div>

    </footer>


</body>

</html>

