@page
@model IndexModel

@{
    Layout = null;
    ViewData["Title"] = "UNILAK Staff Engagement Portal";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="UNILAK Academic Staff Engagement & Claim Processing System">

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/index.css"
          asp-append-version="true">
</head>

<body>

    <nav class="navbar">
        <div class="navbar-container">

            <div class="navbar-left">

                <a href="/" class="logo-link">
                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo"
                         class="navbar-logo">
                </a>

                <a href="/" class="navbar-brand">
                    <span class="navbar-brand-title">UNILAK Portal</span>
                    <span class="navbar-brand-subtitle">Academic Staff Engagement System</span>
                </a>

            </div>

            <ul class="navbar-nav">

                <li>
                    <a href="/" class="nav-link active">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Home</span>
                    </a>
                </li>

                <li>
                    <a href="#features" class="nav-link">
                        <i class="bi bi-grid-fill"></i>
                        <span>Features</span>
                    </a>
                </li>

                <li>
                    <a href="/Login" class="nav-btn-login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login</span>
                    </a>
                </li>

            </ul>

        </div>
    </nav>


    <section class="hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <span class="hero-badge">
                <i class="bi bi-shield-check"></i>
                Official Academic Portal
            </span>

            <h1 class="hero-title">
                Lecturer Engagement
                <span>&amp; Claim Management</span>
            </h1>

            <p class="hero-subtitle">
                Streamline academic staff engagements, attendance tracking,
                contract workflows, and payment claims in one secure platform.
            </p>

            <div class="hero-buttons">

                <a href="/Login" class="btn btn-primary">
                    <span>Staff Login</span>
                </a>

                <a href="#features" class="btn btn-secondary">
                    <span>Explore Features</span>
                </a>

            </div>

        </div>

    </section>


    <section class="features" id="features">

        <div class="section-header">

            <span class="section-label">PLATFORM</span>

            <h2>Core Platform Features</h2>

            <p>
                Everything academic staff and administrators need to manage
                engagements and claims seamlessly.
            </p>

        </div>


        <div class="features-marquee">

            <div class="features-track">

                <!-- SET 1 -->

                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <h3>Staff Engagements</h3>

                    <p>
                        Manage lecturer appointments, course assignments,
                        and engagement records efficiently.
                    </p>

                    <a href="/Login" class="feature-link">
                        <span>Manage Engagements</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>

                    <h3>Attendance Tracking</h3>

                    <p>
                        Record and monitor teaching attendance and completed
                        hours for every academic session.
                    </p>

                    <a href="/Login" class="feature-link">
                        <span>Track Attendance</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>

                    <h3>Digital Contracts</h3>

                    <p>
                        Generate, manage, and access signed academic staff
                        contracts digitally and securely.
                    </p>

                    <a href="/Login" class="feature-link">
                        <span>View Contracts</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>

                    <h3>Payment Claims</h3>

                    <p>
                        Submit, review, approve, and track academic staff
                        payment claims transparently.
                    </p>

                    <a href="/Login" class="feature-link">
                        <span>Manage Claims</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- SET 2 — duplicate for seamless loop -->

                <div class="feature-card" aria-hidden="true">

                    <div class="feature-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <h3>Staff Engagements</h3>

                    <p>
                        Manage lecturer appointments, course assignments,
                        and engagement records efficiently.
                    </p>

                    <a href="/Login" class="feature-link" tabindex="-1">
                        <span>Manage Engagements</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="feature-card" aria-hidden="true">

                    <div class="feature-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>

                    <h3>Attendance Tracking</h3>

                    <p>
                        Record and monitor teaching attendance and completed
                        hours for every academic session.
                    </p>

                    <a href="/Login" class="feature-link" tabindex="-1">
                        <span>Track Attendance</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="feature-card" aria-hidden="true">

                    <div class="feature-icon">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>

                    <h3>Digital Contracts</h3>

                    <p>
                        Generate, manage, and access signed academic staff
                        contracts digitally and securely.
                    </p>

                    <a href="/Login" class="feature-link" tabindex="-1">
                        <span>View Contracts</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="feature-card" aria-hidden="true">

                    <div class="feature-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>

                    <h3>Payment Claims</h3>

                    <p>
                        Submit, review, approve, and track academic staff
                        payment claims transparently.
                    </p>

                    <a href="/Login" class="feature-link" tabindex="-1">
                        <span>Manage Claims</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </section>


    <section class="audience">

        <div class="section-header">

            <span class="section-label">USERS</span>

            <h2>Who Uses This Platform?</h2>

            <p>
                Connecting academic staff and university administration
                in a unified ecosystem.
            </p>

        </div>


        <div class="audience-grid">

            <div class="audience-card">

                <div class="audience-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div>

                    <h3>Academic Staff</h3>

                    <p>
                        View course engagements, log teaching hours,
                        manage digital contracts, and track remuneration claims.
                    </p>

                </div>

            </div>


            <div class="audience-card">

                <div class="audience-icon">
                    <i class="bi bi-person-gear"></i>
                </div>

                <div>

                    <h3>Administrators</h3>

                    <p>
                        Authorize engagements, verify attendance logs,
                        execute contracts, and process verified payment claims.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <section class="cta">

        <div class="cta-content">

            <div class="cta-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <div class="cta-text">

                <h2>Ready to access the portal?</h2>

                <p>
                    Sign in with your UNILAK staff credentials to manage
                    your academic engagements.
                </p>

            </div>

            <a href="/Login" class="btn btn-cta">
                <span>Login to Portal</span>
            </a>

        </div>

    </section>


    <footer class="footer">

        <div class="footer-content">

            <div class="footer-brand">

                <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                     alt="UNILAK Logo"
                     class="footer-logo">

                <div>

                    <h3>UNILAK Portal</h3>

                    <p>
                        Academic Staff Engagement &amp; Claim Processing System
                    </p>

                </div>

            </div>


            <div class="footer-right">

                <p>
                    © @DateTime.Now.Year
                    University of Lay Adventists of Kigali
                </p>

                <p class="footer-text">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Secure Academic Management Platform
                    </span>

                </p>

            </div>

        </div>

    </footer>

</body>

</html>