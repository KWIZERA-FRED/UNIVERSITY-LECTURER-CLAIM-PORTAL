@page "/Claims"
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Shared.ClaimsModel

@{
    Layout = null;
    ViewData["Title"] = "Claims";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Claims | UNILAK Staff Portal</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --primary: #174d3b;
                --primary-light: #236b51;
                --accent: #2a7f5e;
                --accent-light: #e1f0e8;
                --bg: #f5f8f6;
                --card: #ffffff;
                --border: #dce7e1;
                --text: #1a2b24;
                --text-muted: #60736a;
                --warning-bg: #fff7df;
                --warning-text: #8a6500;
                --success-bg: #e1f0e8;
                --success-text: #236b51;
                --danger-bg: #f8d7da;
                --danger-text: #721c24;
                --blue-bg: #e8f0fb;
                --blue-text: #315f96;
                --radius: 16px;
                --shadow: 0 10px 30px rgba(23, 77, 59, 0.08);
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background: var(--bg);
                color: var(--text);
                min-height: 100vh;
            }

            /* HEADER */

            .top-header {
                height: 72px;
                background: rgba(255,255,255,.97);
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .header-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .header-logo {
                width: 42px;
                height: 42px;
                object-fit: contain;
            }

            .header-title {
                font-size: 15px;
                font-weight: 700;
                color: var(--primary);
            }

            .header-subtitle {
                font-size: 11px;
                color: var(--text-muted);
                margin-top: 2px;
            }

            .header-user {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .user-icon {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .user-text {
                font-size: 12px;
            }

            .user-name {
                font-weight: 700;
            }

            .user-role {
                color: var(--text-muted);
                font-size: 10px;
            }

            /* PAGE */

            .page-container {
                max-width: 1250px;
                margin: 0 auto;
                padding: 35px;
            }

            /* HEADER */

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                margin-bottom: 28px;
            }

                .page-header h1 {
                    color: var(--primary);
                    font-size: 26px;
                    font-weight: 800;
                }

                .page-header p {
                    color: var(--text-muted);
                    font-size: 12px;
                    margin-top: 6px;
                }

            .role-badge {
                background: var(--accent-light);
                color: var(--accent);
                border-radius: 20px;
                padding: 9px 14px;
                font-size: 11px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 7px;
            }

            /* SUMMARY */

            .summary {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 18px;
                margin-bottom: 25px;
            }

            .summary-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 20px;
                box-shadow: var(--shadow);
            }

            .summary-icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                float: right;
            }

            .summary-label {
                font-size: 10px;
                color: var(--text-muted);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .summary-number {
                margin-top: 6px;
                font-size: 25px;
                font-weight: 800;
                color: var(--primary);
            }

            /* CLAIM CARD */

            .claims-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                overflow: hidden;
            }

            .claims-header {
                padding: 22px 25px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .claims-title {
                display: flex;
                align-items: center;
                gap: 10px;
                color: var(--primary);
                font-size: 14px;
                font-weight: 800;
            }

                .claims-title i {
                    color: var(--accent);
                }

            .claims-description {
                color: var(--text-muted);
                font-size: 11px;
                margin-top: 4px;
            }

            /* CLAIM */

            .claim-list {
                display: flex;
                flex-direction: column;
            }

            .claim-item {
                padding: 22px 25px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                transition: .2s;
            }

                .claim-item:last-child {
                    border-bottom: none;
                }

                .claim-item:hover {
                    background: #fbfdfc;
                }

            .claim-left {
                display: flex;
                align-items: center;
                gap: 15px;
                min-width: 0;
            }

            .claim-icon {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .claim-info {
                min-width: 0;
            }

            .claim-number {
                color: var(--primary);
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 4px;
            }

            .claim-course {
                font-size: 13px;
                font-weight: 700;
                color: var(--text);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .claim-meta {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
                margin-top: 6px;
                font-size: 10px;
                color: var(--text-muted);
            }

                .claim-meta span {
                    display: flex;
                    align-items: center;
                    gap: 4px;
                }

            /* AMOUNT */

            .claim-amount {
                text-align: right;
                flex-shrink: 0;
            }

            .amount-label {
                font-size: 9px;
                color: var(--text-muted);
                text-transform: uppercase;
                font-weight: 700;
            }

            .amount {
                margin-top: 3px;
                font-size: 14px;
                font-weight: 800;
                color: var(--primary);
            }

            /* STATUS */

            .status {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                border-radius: 20px;
                padding: 7px 10px;
                font-size: 9px;
                font-weight: 700;
                white-space: nowrap;
            }

                .status.pending {
                    background: var(--warning-bg);
                    color: var(--warning-text);
                }

                .status.approved {
                    background: var(--success-bg);
                    color: var(--success-text);
                }

                .status.rejected {
                    background: var(--danger-bg);
                    color: var(--danger-text);
                }

                .status.processing {
                    background: var(--blue-bg);
                    color: var(--blue-text);
                }

            /* ACTIONS */

            .claim-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
            }

            .open-button,
            .review-button {
                text-decoration: none;
                border-radius: 9px;
                padding: 10px 14px;
                font-family: inherit;
                font-size: 10px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: .2s;
            }

            .open-button {
                border: 1px solid var(--border);
                background: white;
                color: var(--primary);
            }

                .open-button:hover {
                    border-color: var(--accent);
                    color: var(--accent);
                    background: var(--accent-light);
                }

            .review-button {
                border: none;
                background: var(--accent);
                color: white;
            }

                .review-button:hover {
                    background: #216b4f;
                    transform: translateY(-1px);
                }

            /* EMPTY */

            .empty-state {
                padding: 70px 25px;
                text-align: center;
            }

            .empty-icon {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 15px;
                font-size: 25px;
            }

            .empty-state h3 {
                color: var(--primary);
                font-size: 14px;
                font-weight: 800;
            }

            .empty-state p {
                color: var(--text-muted);
                font-size: 11px;
                margin-top: 6px;
            }

            /* RESPONSIVE */

            @@media(max-width: 950px) {

                .summary {
                    grid-template-columns: repeat(2, 1fr);
                }

                .claim-item {
                    align-items: flex-start;
                    flex-direction: column;
                }

                .claim-actions {
                    width: 100%;
                }

                .open-button,
                .review-button {
                    justify-content: center;
                    flex: 1;
                }

                .claim-amount {
                    text-align: left;
                }
            }

            @@media(max-width: 600px) {

                .page-container {
                    padding: 20px;
                }

                .page-header {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 15px;
                }

                .summary {
                    grid-template-columns: 1fr;
                }
            }

    </style>

</head>

<body>

    <!-- HEADER -->

    <header class="top-header">

        <div class="header-left">

            <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                 class="header-logo"
                 alt="UNILAK">

            <div>

                <div class="header-title">
                    UNILAK Staff Portal
                </div>

                <div class="header-subtitle">
                    Academic Staff Engagement & Claim Processing
                </div>

            </div>

        </div>


        <div class="header-user">

            <div class="user-icon">

                <i class="bi bi-person"></i>

            </div>

            <div class="user-text">

                <div class="user-name">
                    @Model.CurrentUserName
                </div>

                <div class="user-role">
                    @Model.CurrentUserRole
                </div>

            </div>

        </div>

    </header>


    <!-- PAGE -->

    <main class="page-container">

        <!-- HEADER -->

        <div class="page-header">

            <div>

                <h1>
                    Claims
                </h1>

                <p>
                    View, submit and process academic staff engagement claims.
                </p>

            </div>

            <div class="role-badge">

                <i class="bi bi-shield-check"></i>

                @Model.CurrentUserRole

            </div>

        </div>


        <!-- SUMMARY -->

        <div class="summary">

            <div class="summary-card">

                <div class="summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <div class="summary-label">
                    Total Claims
                </div>

                <div class="summary-number">
                    @Model.TotalClaims
                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    <i class="bi bi-clock"></i>
                </div>

                <div class="summary-label">
                    Pending
                </div>

                <div class="summary-number">
                    @Model.PendingClaims
                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div class="summary-label">
                    Approved
                </div>

                <div class="summary-number">
                    @Model.ApprovedClaims
                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div class="summary-label">
                    Total Amount
                </div>

                <div class="summary-number"
                     style="font-size:18px;">

                    RWF @Model.TotalAmount.ToString("N0")

                </div>

            </div>

        </div>


        <!-- CLAIMS -->

        <div class="claims-card">

            <div class="claims-header">

                <div>

                    <div class="claims-title">

                        <i class="bi bi-receipt-cutoff"></i>

                        Academic Engagement Claims

                    </div>

                    <div class="claims-description">

                        Claims relevant to your role and approval responsibilities.

                    </div>

                </div>

            </div>


            @if (Model.Claims.Any())
            {

                <div class="claim-list">

                    @foreach (var claim in Model.Claims)
                    {

                        <div class="claim-item">

                            <div class="claim-left">

                                <div class="claim-icon">

                                    <i class="bi bi-receipt"></i>

                                </div>


                                <div class="claim-info">

                                    <div class="claim-number">

                                        @claim.ClaimNumber

                                    </div>


                                    <div class="claim-course">

                                        @claim.CourseCode -
                                        @claim.CourseName

                                    </div>


                                    <div class="claim-meta">

                                        <span>

                                            <i class="bi bi-person"></i>

                                            @claim.LecturerName

                                        </span>


                                        <span>

                                            <i class="bi bi-calendar3"></i>

                                            @claim.AcademicYear

                                        </span>


                                        <span>

                                            <i class="bi bi-building"></i>

                                            @claim.Campus

                                        </span>


                                        <span>

                                            <i class="bi bi-clock"></i>

                                            @claim.Hours hours

                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="claim-amount">

                                <div class="amount-label">
                                    Claim Amount
                                </div>

                                <div class="amount">

                                    RWF @claim.Amount.ToString("N0")

                                </div>

                            </div>


                            <span class="status @claim.StatusClass">

                                <i class="bi @claim.StatusIcon"></i>

                                @claim.Status

                            </span>


                            <div class="claim-actions">

                                <a class="open-button"
                                   href="/Shared/ClaimPreview?ClaimId=@claim.Id">

                                    <i class="bi bi-eye"></i>

                                    Open

                                </a>


                                @if (Model.CanReviewClaims)
                                {

                                    <a class="review-button"
                                       href="/Shared/ClaimPreview?ClaimId=@claim.Id&Review=true">

                                        <i class="bi bi-check2-square"></i>

                                        Review

                                    </a>

                                }

                            </div>

                        </div>

                    }

                </div>

            }
            else
            {

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-receipt"></i>

                    </div>

                    <h3>
                        No Claims Available
                    </h3>

                    <p>
                        There are currently no claims requiring your attention.
                    </p>

                </div>

            }

        </div>

    </main>

</body>

</html>