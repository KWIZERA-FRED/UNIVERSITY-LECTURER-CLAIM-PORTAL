@page "/Contracts"
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Shared.ContractsModel

@{
    Layout = null;
    ViewData["Title"] = "Contracts";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Contracts | UNILAK Staff Portal</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --primary: #174d3b;
                --primary-light: #236b51;
                --accent: #2a7f5e;
                --accent-light: #e1f0e8;
                --bg: #f5f8f6;
                --card: #ffffff;
                --border: #dce7e1;
                --text: #1a2b24;
                --text-muted: #60736a;
                --warning-bg: #fff7df;
                --warning-text: #8a6500;
                --success-bg: #e1f0e8;
                --success-text: #236b51;
                --radius: 16px;
                --shadow: 0 10px 30px rgba(23, 77, 59, 0.08);
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background: var(--bg);
                color: var(--text);
                min-height: 100vh;
            }

            /* HEADER */

            .top-header {
                height: 72px;
                background: rgba(255,255,255,.97);
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .header-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .header-logo {
                width: 42px;
                height: 42px;
                object-fit: contain;
            }

            .header-title {
                font-size: 15px;
                font-weight: 700;
                color: var(--primary);
            }

            .header-subtitle {
                font-size: 11px;
                color: var(--text-muted);
                margin-top: 2px;
            }

            .header-user {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .user-icon {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .user-text {
                font-size: 12px;
            }

            .user-name {
                font-weight: 700;
            }

            .user-role {
                color: var(--text-muted);
                font-size: 10px;
            }

            /* MAIN */

            .page-container {
                max-width: 1250px;
                margin: 0 auto;
                padding: 35px;
            }

            /* PAGE HEADER */

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                margin-bottom: 28px;
            }

                .page-header h1 {
                    color: var(--primary);
                    font-size: 26px;
                    font-weight: 800;
                }

                .page-header p {
                    color: var(--text-muted);
                    font-size: 12px;
                    margin-top: 6px;
                }

            .role-badge {
                background: var(--accent-light);
                color: var(--accent);
                border-radius: 20px;
                padding: 9px 14px;
                font-size: 11px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 7px;
            }

            /* SUMMARY */

            .summary {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
                margin-bottom: 25px;
            }

            .summary-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 20px;
                box-shadow: var(--shadow);
            }

            .summary-label {
                font-size: 10px;
                color: var(--text-muted);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .summary-number {
                margin-top: 6px;
                font-size: 25px;
                font-weight: 800;
                color: var(--primary);
            }

            .summary-icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                float: right;
            }

            /* CONTRACT CARD */

            .contracts-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                overflow: hidden;
            }

            .contracts-header {
                padding: 22px 25px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .contracts-title {
                display: flex;
                align-items: center;
                gap: 10px;
                color: var(--primary);
                font-size: 14px;
                font-weight: 800;
            }

                .contracts-title i {
                    color: var(--accent);
                }

            .contracts-description {
                color: var(--text-muted);
                font-size: 11px;
                margin-top: 4px;
            }

            /* CONTRACT LIST */

            .contract-list {
                display: flex;
                flex-direction: column;
            }

            .contract-item {
                padding: 22px 25px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                transition: .2s;
            }

                .contract-item:last-child {
                    border-bottom: none;
                }

                .contract-item:hover {
                    background: #fbfdfc;
                }

            .contract-left {
                display: flex;
                align-items: center;
                gap: 15px;
                min-width: 0;
            }

            .document-icon {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .contract-info {
                min-width: 0;
            }

            .contract-number {
                color: var(--primary);
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 4px;
            }

            .contract-course {
                font-size: 13px;
                font-weight: 700;
                color: var(--text);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .contract-meta {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
                margin-top: 6px;
                font-size: 10px;
                color: var(--text-muted);
            }

                .contract-meta span {
                    display: flex;
                    align-items: center;
                    gap: 4px;
                }

            /* STATUS */

            .status {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                border-radius: 20px;
                padding: 7px 10px;
                font-size: 9px;
                font-weight: 700;
                white-space: nowrap;
            }

                .status.pending {
                    background: var(--warning-bg);
                    color: var(--warning-text);
                }

                .status.signed {
                    background: var(--success-bg);
                    color: var(--success-text);
                }

            /* ACTIONS */

            .contract-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
            }

            .open-button {
                text-decoration: none;
                border: 1px solid var(--border);
                background: white;
                color: var(--primary);
                border-radius: 9px;
                padding: 10px 14px;
                font-family: inherit;
                font-size: 10px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: .2s;
            }

                .open-button:hover {
                    border-color: var(--accent);
                    color: var(--accent);
                    background: var(--accent-light);
                }

            .sign-button {
                text-decoration: none;
                border: none;
                background: var(--accent);
                color: white;
                border-radius: 9px;
                padding: 10px 15px;
                font-family: inherit;
                font-size: 10px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: .2s;
            }

                .sign-button:hover {
                    background: #216b4f;
                    transform: translateY(-1px);
                }

            /* EMPTY */

            .empty-state {
                padding: 70px 25px;
                text-align: center;
            }

            .empty-icon {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: var(--accent-light);
                color: var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 15px;
                font-size: 25px;
            }

            .empty-state h3 {
                color: var(--primary);
                font-size: 14px;
                font-weight: 800;
            }

            .empty-state p {
                color: var(--text-muted);
                font-size: 11px;
                margin-top: 6px;
            }

            /* RESPONSIVE */

            @@media(max-width: 800px) {

                .page-container {
                    padding: 20px;
                }

                .page-header {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 15px;
                }

                .summary {
                    grid-template-columns: 1fr;
                }

                .contract-item {
                    align-items: flex-start;
                    flex-direction: column;
                }

                .contract-actions {
                    width: 100%;
                }

                .open-button,
                .sign-button {
                    justify-content: center;
                    flex: 1;
                }
            }

    </style>

</head>

<body>

    <!-- HEADER -->

    <header class="top-header">

        <div class="header-left">

            <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                 class="header-logo"
                 alt="UNILAK">

            <div>

                <div class="header-title">
                    UNILAK Staff Portal
                </div>

                <div class="header-subtitle">
                    Academic Staff Engagement & Claim Processing
                </div>

            </div>

        </div>

        <div class="header-user">

            <div class="user-icon">

                <i class="bi bi-person"></i>

            </div>

            <div class="user-text">

                <div class="user-name">
                    @Model.CurrentUserName
                </div>

                <div class="user-role">
                    @Model.CurrentUserRole
                </div>

            </div>

        </div>

    </header>


    <!-- PAGE -->

    <main class="page-container">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <div>

                <h1>
                    Contracts
                </h1>

                <p>
                    Review contracts requiring your signature and complete the approval process.
                </p>

            </div>

            <div class="role-badge">

                <i class="bi bi-shield-check"></i>

                @Model.CurrentUserRole

            </div>

        </div>


        <!-- SUMMARY -->

        <div class="summary">

            <div class="summary-card">

                <div class="summary-icon">

                    <i class="bi bi-file-earmark-text"></i>

                </div>

                <div class="summary-label">
                    Total Contracts
                </div>

                <div class="summary-number">
                    @Model.TotalContracts
                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">

                    <i class="bi bi-pen"></i>

                </div>

                <div class="summary-label">
                    Awaiting Your Signature
                </div>

                <div class="summary-number">
                    @Model.PendingContracts
                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">

                    <i class="bi bi-check-circle"></i>

                </div>

                <div class="summary-label">
                    Signed By You
                </div>

                <div class="summary-number">
                    @Model.SignedContracts
                </div>

            </div>

        </div>


        <!-- CONTRACTS -->

        <div class="contracts-card">

            <div class="contracts-header">

                <div>

                    <div class="contracts-title">

                        <i class="bi bi-file-earmark-check"></i>

                        Contracts Requiring Your Action

                    </div>

                    <div class="contracts-description">

                        Open a contract to review its details before signing.

                    </div>

                </div>

            </div>


            @if (Model.Contracts.Any())
            {

                <div class="contract-list">

                    @foreach (var contract in Model.Contracts)
                    {

                        <div class="contract-item">

                            <div class="contract-left">

                                <div class="document-icon">

                                    <i class="bi bi-file-earmark-text"></i>

                                </div>


                                <div class="contract-info">

                                    <div class="contract-number">

                                        @contract.ContractNumber

                                    </div>


                                    <div class="contract-course">

                                        @contract.CourseCode -
                                        @contract.CourseName

                                    </div>


                                    <div class="contract-meta">

                                        <span>

                                            <i class="bi bi-person"></i>

                                            @contract.LecturerName

                                        </span>


                                        <span>

                                            <i class="bi bi-calendar3"></i>

                                            @contract.AcademicYear

                                        </span>


                                        <span>

                                            <i class="bi bi-building"></i>

                                            @contract.Campus

                                        </span>


                                        <span>

                                            <i class="bi bi-clock"></i>

                                            @contract.Hours hours

                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="contract-actions">

                                @if (contract.IsSignedByCurrentUser)
                                {

                                    <span class="status signed">

                                        <i class="bi bi-check-circle"></i>

                                        Signed

                                    </span>

                                }
                                else
                                {

                                    <span class="status pending">

                                        <i class="bi bi-clock"></i>

                                        Awaiting Signature

                                    </span>

                                }


                                <a class="open-button"
                                   href="/HOD/ContractPreview?ContractId=@contract.Id">

                                    <i class="bi bi-eye"></i>

                                    Open

                                </a>


                                @if (!contract.IsSignedByCurrentUser)
                                {

                                    <a class="sign-button"
                                       href="/HOD/ContractPreview?ContractId=@contract.Id&Sign=true">

                                        <i class="bi bi-pen"></i>

                                        Sign

                                    </a>

                                }

                            </div>

                        </div>

                    }

                </div>

            }
            else
            {

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-file-earmark-check"></i>

                    </div>

                    <h3>
                        No Contracts Require Your Signature
                    </h3>

                    <p>
                        There are currently no contracts waiting for your action.
                    </p>

                </div>

            }

        </div>

    </main>

</body>

</html>