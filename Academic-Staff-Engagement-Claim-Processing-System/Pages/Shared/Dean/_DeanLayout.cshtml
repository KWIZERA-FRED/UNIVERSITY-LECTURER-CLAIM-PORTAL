@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    bool IsActive(string page)
    {
        return string.Equals(
            currentPage,
            page,
            StringComparison.OrdinalIgnoreCase
        );
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#0f2742" />

    <title>@ViewData["Title"] | UNILAK</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/DEAN/dean-shell.css"
          asp-append-version="true" />

    @RenderSection("Styles", required: false)

</head>

<body>

    <div class="dean-app">

        <aside class="dean-sidebar"
               id="deanSidebar"
               aria-label="Dean Portal Navigation">

            <a asp-page="/DEAN/Index"
               class="dean-brand"
               aria-label="UNILAK Dean Portal">

                <span class="dean-brand-logo">

                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo" />

                </span>

                <span class="dean-brand-text">

                    <span class="dean-brand-title">
                        UNILAK
                    </span>

                    <span class="dean-brand-subtitle">
                        Dean Portal
                    </span>

                </span>

            </a>

            <nav class="dean-sidebar-nav"
                 aria-label="Dean navigation">

                <a asp-page="/DEAN/Index"
                   class="dean-nav-item @(IsActive("/DEAN/Index") ? "active" : "")">

                    <span class="dean-nav-icon">
                        <i class="bi bi-grid-1x2-fill"
                           aria-hidden="true"></i>
                    </span>

                    <span class="dean-nav-text">
                        Dashboard
                    </span>

                </a>

                <a asp-page="/DEAN/RegisterUser"
                   class="dean-nav-item @(IsActive("/DEAN/RegisterUser") ? "active" : "")">

                    <span class="dean-nav-icon">
                        <i class="bi bi-person-plus-fill"
                           aria-hidden="true"></i>
                    </span>

                    <span class="dean-nav-text">
                        Register New User
                    </span>

                </a>

                <a asp-page="/DEAN/Contracts"
                   class="dean-nav-item @(IsActive("/DEAN/Contracts") ? "active" : "")">

                    <span class="dean-nav-icon">
                        <i class="bi bi-file-earmark-check-fill"
                           aria-hidden="true"></i>
                    </span>

                    <span class="dean-nav-text">
                        Contracts
                    </span>

                </a>

                <a asp-page="/DEAN/Claims"
                   class="dean-nav-item @(IsActive("/DEAN/Claims") ? "active" : "")">

                    <span class="dean-nav-icon">
                        <i class="bi bi-receipt-cutoff"
                           aria-hidden="true"></i>
                    </span>

                    <span class="dean-nav-text">
                        Claims
                    </span>

                </a>

            </nav>

        </aside>

        <div class="dean-main">

            <header class="dean-topbar" id="deanTopbar">

                <button type="button"
                        class="dean-mobile-menu"
                        id="deanMobileMenuButton"
                        aria-label="Toggle navigation"
                        aria-controls="deanSidebar"
                        aria-expanded="false">

                    <i class="bi bi-list" aria-hidden="true"></i>

                </button>

                <div class="dean-topbar-spacer"></div>

                <div class="dean-topbar-actions">

                    <div class="dean-role-indicator">

                        <span class="dean-role-icon">

                            <i class="bi bi-person-badge-fill"
                               aria-hidden="true"></i>

                        </span>

                        <div class="dean-role-text">

                            <span class="dean-role-label">
                                Current role
                            </span>

                            <strong>
                                Dean
                            </strong>

                        </div>

                    </div>

                    <div class="dean-topbar-divider"></div>

                    <form method="post"
                          asp-page="/Logout"
                          class="dean-logout-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="dean-logout"
                                aria-label="Logout">

                            <span>
                                Logout
                            </span>

                        </button>

                    </form>

                </div>

            </header>

            <main class="dean-content">

                @RenderBody()

            </main>

        </div>

        <div class="dean-sidebar-overlay"
             id="deanSidebarOverlay">
        </div>

    </div>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* ============================================
               Sidebar drawer (mobile)
               ============================================ */

            const menuButton =
                document.getElementById("deanMobileMenuButton");

            const sidebar =
                document.getElementById("deanSidebar");

            const overlay =
                document.getElementById("deanSidebarOverlay");

            function openSidebar() {

                if (!sidebar || !overlay) return;

                sidebar.classList.add("open");
                overlay.classList.add("visible");

                if (menuButton) {
                    menuButton.setAttribute("aria-expanded", "true");
                }

            }

            function closeSidebar() {

                if (!sidebar || !overlay) return;

                sidebar.classList.remove("open");
                overlay.classList.remove("visible");

                if (menuButton) {
                    menuButton.setAttribute("aria-expanded", "false");
                }

            }

            if (menuButton) {

                menuButton.addEventListener("click", function () {

                    if (sidebar && sidebar.classList.contains("open")) {
                        closeSidebar();
                    } else {
                        openSidebar();
                    }

                });

            }

            if (overlay) {
                overlay.addEventListener("click", closeSidebar);
            }

            document
                .querySelectorAll(".dean-nav-item")
                .forEach(function (link) {

                    link.addEventListener("click", function () {

                        if (window.innerWidth <= 900) {
                            closeSidebar();
                        }

                    });

                });

            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {
                    closeSidebar();
                }

            });

            window.addEventListener("resize", function () {

                if (window.innerWidth > 900) {
                    closeSidebar();
                }

            });


            /* ============================================
               Topbar fade-out on scroll
               ============================================ */

            const topbar = document.getElementById("deanTopbar");

            function updateTopbarState() {

                if (!topbar) return;

                if (window.scrollY > 8) {
                    topbar.classList.add("is-scrolled");
                } else {
                    topbar.classList.remove("is-scrolled");
                }

            }

            updateTopbarState();

            window.addEventListener("scroll", updateTopbarState, { passive: true });

        });

    </script>

    @RenderSection("Scripts", required: false)

</body>

</html>