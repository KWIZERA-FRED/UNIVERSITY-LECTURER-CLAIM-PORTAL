@page
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.ContractsModel

@{
    ViewData["Title"] = "Contracts";

    var selectedContractRow =
        Model.ContractId.HasValue
            ? Model.Contracts.FirstOrDefault(c => c.ContractId == Model.ContractId.Value)
            : null;

    var activeContractsCount =
        Model.Contracts.Count(c => c.Status == ContractStatus.Active);

    var awaitingSignatureCount =
        Model.Contracts.Count(c =>
            !c.IsDeclined &&
            c.Status == ContractStatus.PendingSignature &&
            !string.IsNullOrWhiteSpace(c.CurrentStage) &&
            c.CurrentStage.Contains("Dean", StringComparison.OrdinalIgnoreCase));
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/DEAN/contracts.css"
          asp-append-version="true" />
}

<div class="contracts-page">

    <section class="page-header">
        <div class="page-header-content">
            <div class="breadcrumb">
                <span>Dean Portal</span>
                <i class="bi bi-chevron-right"></i>
                <span class="current">Contracts</span>
            </div>

            <h1 class="page-title">Contract Management</h1>

            <p class="page-subtitle">
                Review lecturer contracts, monitor the sequential approval
                workflow, and sign contracts awaiting Dean approval.
            </p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <div class="alert-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="alert-content">
                <strong>Success</strong>
                <p>@Model.SuccessMessage</p>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <div class="alert-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div class="alert-content">
                <strong>Action Failed</strong>
                <p>@Model.ErrorMessage</p>
            </div>
        </div>
    }

    <section class="contract-summary-grid">

        <div class="summary-card">
            <div class="summary-icon summary-icon-blue">
                <i class="bi bi-files"></i>
            </div>

            <div class="summary-card-content">
                <span class="summary-label">Total Contracts</span>
                <strong class="summary-value">
                    @Model.Contracts.Count
                </strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon summary-icon-amber">
                <i class="bi bi-clock-history"></i>
            </div>

            <div class="summary-card-content">
                <span class="summary-label">Awaiting Dean Signature</span>
                <strong class="summary-value">
                    @awaitingSignatureCount
                </strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon summary-icon-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="summary-card-content">
                <span class="summary-label">Active</span>
                <strong class="summary-value">
                    @activeContractsCount
                </strong>
            </div>
        </div>

    </section>

    <section class="contracts-section">

        <div class="section-header">
            <div>
                <span class="section-kicker">
                    CONTRACT REGISTER
                </span>

                <h2 class="section-title">
                    All Lecturer Contracts
                </h2>

                <p class="section-description">
                    Select a contract to review its details and approval history.
                </p>
            </div>
        </div>

        <div class="table-card">

            @if (Model.Contracts.Any())
            {
                <div class="table-responsive">

                    <table class="data-table">

                        <thead>
                            <tr>
                                <th>Contract</th>
                                <th>Lecturer</th>
                                <th>Department</th>
                                <th>Course</th>
                                <th>Version</th>
                                <th>Status</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var contract in Model.Contracts)
                            {
                                var isSelected =
                                    Model.ContractId.HasValue &&
                                    Model.ContractId.Value == contract.ContractId;

                                <tr class="@(isSelected ? "selected-row" : "")">

                                    <td>
                                        <div class="table-primary">
                                            Contract #@contract.ContractId
                                        </div>
                                    </td>

                                    <td>
                                        <div class="person-cell">

                                            <div class="person-avatar">
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <div class="person-details">
                                                <strong>
                                                    @contract.LecturerName
                                                </strong>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        <span class="table-secondary">
                                            @contract.Department
                                        </span>
                                    </td>

                                    <td>
                                        <div class="course-cell">
                                            <strong>
                                                @contract.CourseTitle
                                            </strong>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="version-badge">
                                            v@contract.Version
                                        </span>
                                    </td>

                                    <td>

                                        @if (contract.IsDeclined)
                                        {
                                            <span class="status-badge status-declined">
                                                <span class="badge-dot"></span>
                                                Declined
                                            </span>
                                        }
                                        else if (contract.Status == ContractStatus.Active)
                                        {
                                            <span class="status-badge status-active">
                                                <span class="badge-dot"></span>
                                                Active
                                            </span>
                                        }
                                        else if (contract.Status == ContractStatus.PendingSignature)
                                        {
                                            <span class="status-badge status-pending">
                                                <span class="badge-dot"></span>
                                                Pending Signature
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-neutral">
                                                <span class="badge-dot"></span>
                                                @contract.Status
                                            </span>
                                        }

                                    </td>

                                    <td class="text-right">

                                        <a asp-page="/DEAN/Contracts"
                                           asp-route-ContractId="@contract.ContractId"
                                           class="table-action">

                                            <i class="bi bi-eye"></i>
                                            Review

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-file-earmark-x"></i>
                    </div>

                    <h3>No contracts found</h3>

                    <p>
                        There are currently no lecturer contracts available
                        for review.
                    </p>

                </div>
            }

        </div>

    </section>

    @if (Model.SelectedContract != null)
    {
        var c = Model.SelectedContract;

        var selectedIsDeclined =
            selectedContractRow?.IsDeclined ?? false;

        var selectedIsActive =
            selectedContractRow?.Status == ContractStatus.Active;

        var selectedStatus =
            selectedContractRow?.Status;

        <section class="selected-contract-section">

            <div class="selected-contract-heading">

                <div>
                    <span class="section-kicker">
                        CONTRACT REVIEW
                    </span>

                    <h2 class="section-title">
                        Contract #@c.ContractId
                    </h2>

                    <p class="section-description">
                        Review the official contract and its sequential
                        electronic signing workflow.
                    </p>
                </div>

                <button type="button"
                        class="secondary-action preview-contract-button"
                        aria-haspopup="dialog"
                        aria-controls="contractPreviewModal">

                    <i class="bi bi-arrows-fullscreen"></i>
                    Open Full Preview

                </button>

            </div>

            <div class="contract-information-card">

                <div class="contract-information-header">

                    <div>
                        <span class="section-kicker">
                            CONTRACT DETAILS
                        </span>

                        <h3>Contract Information</h3>
                    </div>

                    @if (selectedIsDeclined)
                    {
                        <span class="status-badge status-declined">
                            <span class="badge-dot"></span>
                            Declined
                        </span>
                    }
                    else if (selectedIsActive)
                    {
                        <span class="status-badge status-active">
                            <span class="badge-dot"></span>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-pending">
                            <span class="badge-dot"></span>
                            @(selectedStatus?.ToString() ?? "Pending Signature")
                        </span>
                    }

                </div>

                <div class="contract-information-grid">

                    <div class="contract-information-item">
                        <span class="information-label">
                            Lecturer
                        </span>

                        <strong>
                            @c.LecturerName
                        </strong>
                    </div>

                    <div class="contract-information-item">
                        <span class="information-label">
                            Department
                        </span>

                        <strong>
                            @c.Department
                        </strong>
                    </div>

                    <div class="contract-information-item">
                        <span class="information-label">
                            Course
                        </span>

                        <strong>
                            @c.CourseTitle
                        </strong>
                    </div>

                    @if (selectedContractRow != null)
                    {
                        <div class="contract-information-item">

                            <span class="information-label">
                                Contract Version
                            </span>

                            <strong>
                                v@selectedContractRow.Version
                            </strong>

                        </div>

                        <div class="contract-information-item">

                            <span class="information-label">
                                Status
                            </span>

                            @if (selectedContractRow.IsDeclined)
                            {
                                <span class="status-badge status-declined">
                                    <span class="badge-dot"></span>
                                    Declined
                                </span>
                            }
                            else if (selectedContractRow.Status == ContractStatus.Active)
                            {
                                <span class="status-badge status-active">
                                    <span class="badge-dot"></span>
                                    Active
                                </span>
                            }
                            else if (selectedContractRow.Status == ContractStatus.PendingSignature)
                            {
                                <span class="status-badge status-pending">
                                    <span class="badge-dot"></span>
                                    Pending Signature
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-neutral">
                                    <span class="badge-dot"></span>
                                    @selectedContractRow.Status
                                </span>
                            }

                        </div>
                    }

                    <div class="contract-information-item">

                        <span class="information-label">
                            Allocated Hours
                        </span>

                        <strong>
                            @c.AllocatedHours.ToString("N2") hours
                        </strong>

                    </div>

                </div>

            </div>

            @if (Model.SelectedSignatureSteps.Any())
            {
                <div class="workflow-card">

                    <div class="workflow-card-header">

                        <div>
                            <span class="section-kicker">
                                SIGNING WORKFLOW
                            </span>

                            <h3>
                                Electronic Signing Workflow
                            </h3>

                            <p>
                                Signatures must be completed sequentially
                                before the contract becomes active.
                            </p>
                        </div>

                        <span class="workflow-sequential">
                            <i class="bi bi-shield-check"></i>
                            Sequential Approval
                        </span>

                    </div>

                    <div class="workflow-timeline">

                        @foreach (var step in Model.SelectedSignatureSteps
                            .OrderBy(s => s.SequenceOrder))
                        {
                            var signed =
                                step.Decision == SignatureDecision.Signed;

                            var declined =
                                step.Decision == SignatureDecision.Declined;

                            <div class="
                                workflow-step
                                @(signed ? "step-complete" : "")
                                @(declined ? "step-declined" : "")
                                @(step.IsCurrent ? "step-current" : "")
                            ">

                                <div class="workflow-step-marker">

                                    @if (signed)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                    else if (declined)
                                    {
                                        <i class="bi bi-x-lg"></i>
                                    }
                                    else
                                    {
                                        <span>
                                            @step.SequenceOrder
                                        </span>
                                    }

                                </div>

                                <div class="workflow-step-content">

                                    <div class="workflow-step-top">

                                        <div>

                                            <span class="workflow-step-order">
                                                STEP @step.SequenceOrder
                                            </span>

                                            <h4>
                                                @step.RoleName
                                            </h4>

                                        </div>

                                        @if (signed)
                                        {
                                            <span class="status-badge status-active">
                                                <span class="badge-dot"></span>
                                                Signed
                                            </span>
                                        }
                                        else if (declined)
                                        {
                                            <span class="status-badge status-declined">
                                                <span class="badge-dot"></span>
                                                Declined
                                            </span>
                                        }
                                        else if (step.IsCurrent)
                                        {
                                            <span class="status-badge status-pending">
                                                <span class="badge-dot"></span>
                                                Awaiting Action
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-neutral">
                                                <span class="badge-dot"></span>
                                                Waiting
                                            </span>
                                        }

                                    </div>

                                    @if (signed)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(step.SignatureFilePath))
                                        {
                                            <div class="signature-preview">

                                                <div class="signature-preview-label">
                                                    Electronic Signature
                                                </div>

                                                <img src="@step.SignatureFilePath"
                                                     alt="@step.RoleName electronic signature"
                                                     class="contract-signature-image" />

                                            </div>
                                        }

                                        @if (step.SignedAtUtc.HasValue)
                                        {
                                            <p class="workflow-step-date">

                                                <i class="bi bi-calendar-check"></i>

                                                Signed
                                                @step.SignedAtUtc.Value
                                                    .ToLocalTime()
                                                    .ToString("dd MMM yyyy, HH:mm")

                                            </p>
                                        }
                                    }

                                    @if (declined &&
                                         !string.IsNullOrWhiteSpace(step.Comments))
                                    {
                                        <div class="workflow-decline-reason">

                                            <strong>
                                                Decline Reason
                                            </strong>

                                            <p>
                                                @step.Comments
                                            </p>

                                        </div>
                                    }

                                    @if (step.IsCurrent &&
                                         !signed &&
                                         !declined)
                                    {
                                        <div class="current-step-indicator">

                                            <i class="bi bi-arrow-right-circle-fill"></i>

                                            Current approval stage

                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

            <div class="contract-document-card">

                <div class="contract-document-header">

                    <div>
                        <span class="section-kicker">
                            OFFICIAL DOCUMENT
                        </span>

                        <h3>
                            Contract Document
                        </h3>
                    </div>

                    <span class="document-security">

                        <i class="bi bi-shield-lock"></i>

                        Protected Document

                    </span>

                </div>

                <div class="contract-document">
                    @Html.Raw(c.ContractContent)
                </div>

            </div>

            @if (c.IsThisRolesTurn)
            {
                <div class="approval-card">

                    <div class="approval-card-content">

                        <div class="approval-card-icon">
                            <i class="bi bi-pen"></i>
                        </div>

                        <div>

                            <span class="section-kicker">
                                ACTION REQUIRED
                            </span>

                            <h3>
                                Dean Approval Required
                            </h3>

                            <p>
                                Review the complete contract carefully.
                                Signing will move the contract to the
                                HR Officer for the next approval stage.
                            </p>

                        </div>

                    </div>

                    <div class="approval-actions">

                        <form method="post"
                              asp-page-handler="Sign"
                              class="inline-form">

                            <input type="hidden"
                                   name="ContractId"
                                   value="@c.ContractId" />

                            <button type="submit"
                                    class="btn btn-success"
                                    onclick="return confirm('Are you sure you want to sign this contract?');">

                                <i class="bi bi-check-circle"></i>

                                Sign Contract

                            </button>

                        </form>

                        <button type="button"
                                class="btn btn-danger-outline"
                                id="showDeclinePanel">

                            <i class="bi bi-x-circle"></i>

                            Decline Contract

                        </button>

                    </div>

                    <div id="declinePanel"
                         class="decline-panel"
                         style="display:none;">

                        <div class="decline-panel-header">

                            <div>

                                <span class="section-kicker">
                                    CONTRACT DECISION
                                </span>

                                <h4>
                                    Decline Contract
                                </h4>

                                <p>
                                    Provide a clear reason for declining
                                    this contract.
                                </p>

                            </div>

                            <button type="button"
                                    id="cancelDecline"
                                    class="close-button"
                                    aria-label="Close decline panel">

                                <i class="bi bi-x-lg"></i>

                            </button>

                        </div>

                        <form method="post"
                              asp-page-handler="Decline">

                            <input type="hidden"
                                   name="ContractId"
                                   value="@c.ContractId" />

                            <div class="form-group">

                                <label asp-for="DeclineReason"
                                       class="form-label">

                                    Reason for Decline

                                    <span class="required">*</span>

                                </label>

                                <textarea asp-for="DeclineReason"
                                          class="form-control"
                                          rows="5"
                                          maxlength="1000"
                                          placeholder="Enter the reason for declining this contract..."
                                          required></textarea>

                            </div>

                            <div class="decline-actions">

                                <button type="button"
                                        id="cancelDeclineSecondary"
                                        class="btn btn-secondary">

                                    Cancel

                                </button>

                                <button type="submit"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to decline this contract?');">

                                    <i class="bi bi-x-circle"></i>

                                    Confirm Decline

                                </button>

                            </div>

                        </form>

                    </div>

                </div>
            }
            else if (!string.IsNullOrWhiteSpace(c.BlockedReason))
            {
                <div class="blocked-panel">

                    <div class="blocked-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <div class="blocked-content">

                        <span class="section-kicker">
                            WORKFLOW STATUS
                        </span>

                        <strong>
                            Dean Action Currently Blocked
                        </strong>

                        <p>
                            @c.BlockedReason
                        </p>

                    </div>

                </div>
            }
            else if (selectedIsActive)
            {
                <div class="approval-card completed">

                    <div class="approval-card-content">

                        <div class="approval-card-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>

                            <span class="section-kicker">
                                COMPLETED
                            </span>

                            <h3>
                                Contract Fully Approved
                            </h3>

                            <p>
                                All required authorities have signed this
                                contract. The contract is now active.
                            </p>

                        </div>

                    </div>

                </div>
            }

        </section>
    }
    else
    {
        <section class="contract-placeholder">

            <div class="placeholder-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <span class="section-kicker">
                CONTRACT REVIEW
            </span>

            <h2>
                Select a Contract
            </h2>

            <p>
                Select a contract from the register above to view its
                complete details, signing workflow, document, and
                available approval actions.
            </p>

        </section>
    }

</div>

@if (Model.SelectedContract != null)
{
    var previewContract = Model.SelectedContract;

    <div id="contractPreviewModal"
         class="contract-preview-modal"
         aria-hidden="true">

        <div class="contract-preview-backdrop"></div>

        <div class="contract-preview-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="contractPreviewTitle">

            <div class="contract-preview-header">

                <div class="contract-preview-title-wrapper">

                    <div class="contract-preview-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>

                        <span class="contract-preview-kicker">
                            OFFICIAL DOCUMENT
                        </span>

                        <h2 id="contractPreviewTitle">
                            Contract #@previewContract.ContractId
                        </h2>

                    </div>

                </div>

                <button type="button"
                        id="closeContractPreview"
                        class="contract-preview-close"
                        aria-label="Close contract preview">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

            <div class="contract-preview-body">

                <div class="contract-preview-paper">

                    <div class="contract-preview-document">
                        @Html.Raw(previewContract.ContractContent)
                    </div>

                </div>

            </div>

            <div class="contract-preview-footer">

                <div class="preview-security-note">

                    <i class="bi bi-shield-lock"></i>

                    <span>
                        Secure official contract preview
                    </span>

                </div>

                <button type="button"
                        id="closeContractPreviewFooter"
                        class="btn btn-secondary">

                    <i class="bi bi-x-lg"></i>

                    Close Preview

                </button>

            </div>

        </div>

    </div>
}

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const showDeclinePanel =
                document.getElementById("showDeclinePanel");

            const declinePanel =
                document.getElementById("declinePanel");

            const cancelDecline =
                document.getElementById("cancelDecline");

            const cancelDeclineSecondary =
                document.getElementById("cancelDeclineSecondary");

            function openDeclinePanel() {

                if (!declinePanel) {
                    return;
                }

                declinePanel.style.display = "block";

                declinePanel.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest"
                });

                const textarea =
                    document.getElementById("DeclineReason");

                if (textarea) {

                    setTimeout(function () {
                        textarea.focus();
                    }, 250);

                }
            }

            function closeDeclinePanel() {

                if (!declinePanel) {
                    return;
                }

                declinePanel.style.display = "none";
            }

            if (showDeclinePanel) {

                showDeclinePanel.addEventListener(
                    "click",
                    openDeclinePanel
                );

            }

            if (cancelDecline) {

                cancelDecline.addEventListener(
                    "click",
                    closeDeclinePanel
                );

            }

            if (cancelDeclineSecondary) {

                cancelDeclineSecondary.addEventListener(
                    "click",
                    closeDeclinePanel
                );

            }

            const previewModal =
                document.getElementById("contractPreviewModal");

            const closePreviewButton =
                document.getElementById("closeContractPreview");

            const closePreviewFooter =
                document.getElementById("closeContractPreviewFooter");

            const previewButtons =
                document.querySelectorAll(".preview-contract-button");

            function openContractPreview() {

                if (!previewModal) {
                    return;
                }

                previewModal.classList.add("is-open");

                previewModal.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.classList.add(
                    "contract-preview-open"
                );

                setTimeout(function () {

                    if (closePreviewButton) {
                        closePreviewButton.focus();
                    }

                }, 100);
            }

            function closeContractPreview() {

                if (!previewModal) {
                    return;
                }

                previewModal.classList.remove("is-open");

                previewModal.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.classList.remove(
                    "contract-preview-open"
                );
            }

            previewButtons.forEach(function (button) {

                button.addEventListener(
                    "click",
                    openContractPreview
                );

            });

            if (closePreviewButton) {

                closePreviewButton.addEventListener(
                    "click",
                    closeContractPreview
                );

            }

            if (closePreviewFooter) {

                closePreviewFooter.addEventListener(
                    "click",
                    closeContractPreview
                );

            }

            if (previewModal) {

                previewModal.addEventListener(
                    "click",
                    function (event) {

                        if (
                            event.target.classList.contains(
                                "contract-preview-backdrop"
                            )
                        ) {

                            closeContractPreview();

                        }

                    }
                );

            }

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        previewModal &&
                        previewModal.classList.contains("is-open")
                    ) {

                        closeContractPreview();

                    }

                }
            );

        });

    </script>
}