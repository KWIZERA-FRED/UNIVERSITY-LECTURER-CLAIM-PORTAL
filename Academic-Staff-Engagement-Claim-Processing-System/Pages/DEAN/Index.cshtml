@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.IndexModel

@{
    Layout = "~/Pages/Shared/DEAN/_DeanLayout.cshtml";
    ViewData["Title"] = "Dean Dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/DEAN/dashboard.css"
          asp-append-version="true" />
}

<section class="dashboard-page">

    <header class="page-header">
        <h1>Dean Dashboard</h1>
        <p>Monitor contracts, claims and pending academic staff approvals.</p>
    </header>

    <section class="stats-grid">

        <a asp-page="/DEAN/Contracts" class="stat-card stat-card-orange">
            <div class="stat-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <div class="stat-value">@Model.ContractsToSignCount</div>
            <span class="stat-label">Contracts to Sign</span>
        </a>

        <a asp-page="/DEAN/Contracts" class="stat-card stat-card-green">
            <div class="stat-icon">
                <i class="bi bi-file-earmark-check-fill"></i>
            </div>
            <div class="stat-value">@Model.ActiveContractsCount</div>
            <span class="stat-label">Active Contracts</span>
        </a>

        <a asp-page="/DEAN/Claims" class="stat-card stat-card-purple">
            <div class="stat-icon">
                <i class="bi bi-receipt"></i>
            </div>
            <div class="stat-value">@Model.ClaimsToSignCount</div>
            <span class="stat-label">Claims to Sign</span>
        </a>

        <a asp-page="/DEAN/Contracts" class="stat-card stat-card-blue">
            <div class="stat-icon">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-value">@Model.CompletedApprovalsCount</div>
            <span class="stat-label">Completed Approvals</span>
        </a>

    </section>

    <section class="section-card">

        <header class="section-header">
            <h2>Contracts Awaiting Signature</h2>
            <a asp-page="/DEAN/Contracts" class="section-link">View all</a>
        </header>

        @if (Model.ContractsAwaitingSignature != null &&
             Model.ContractsAwaitingSignature.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Lecturer</th>
                            <th>Department</th>
                            <th>Course</th>
                            <th>Status</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var contract in Model.ContractsAwaitingSignature)
                        {
                            <tr>
                                <td>
                                    <span class="reference-pill">
                                        CON-@contract.ContractId.ToString("D6")
                                    </span>
                                </td>

                                <td>
                                    <span class="lecturer-name">@contract.LecturerName</span>
                                </td>

                                <td>@contract.Department</td>

                                <td>
                                    <span class="course-title">@contract.CourseTitle</span>
                                </td>

                                <td>
                                    <span class="status-badge status-pending">
                                        Pending Signature
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/DEAN/Contracts"
                                       asp-route-ContractId="@contract.ContractId"
                                       class="gray-button">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No contracts awaiting signature.</p>
            </div>
        }

    </section>

    <section class="section-card">

        <header class="section-header">
            <h2>Claims Awaiting Signature</h2>
            <a asp-page="/DEAN/Claims" class="section-link">View all</a>
        </header>

        @if (Model.ClaimsAwaitingSignature != null &&
             Model.ClaimsAwaitingSignature.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Claim</th>
                            <th>Lecturer</th>
                            <th>Contract</th>
                            <th class="col-right">Hours</th>
                            <th>Status</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var claim in Model.ClaimsAwaitingSignature)
                        {
                            <tr>
                                <td>
                                    <span class="reference-pill">
                                        CLM-@claim.ClaimId.ToString("D6")
                                    </span>
                                </td>

                                <td>
                                    <span class="lecturer-name">@claim.LecturerName</span>
                                </td>

                                <td>
                                    <span class="contract-reference">
                                        CON-@claim.ContractId.ToString("D6")
                                    </span>
                                </td>

                                <td class="col-right">
                                    <span class="hours-value">@claim.HoursClaimed.ToString("N2")</span>
                                </td>

                                <td>
                                    <span class="status-badge status-pending">
                                        Pending Signature
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/DEAN/Claims"
                                       asp-route-ClaimId="@claim.ClaimId"
                                       class="gray-button">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No claims awaiting signature.</p>
            </div>
        }

    </section>

</section>