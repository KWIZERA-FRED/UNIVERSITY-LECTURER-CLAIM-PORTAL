@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.IndexModel

@{
    ViewData["Title"] = "Dean Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Dean Dashboard | UNILAK</title>

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Dean Dashboard CSS -->
    <link rel="stylesheet"
          href="~/css/DEAN/dashboard.css"
          asp-append-version="true" />
</head>

<body>

    <div class="dean-app">

        <!-- =========================================================
             TOP NAVIGATION
             ========================================================= -->
        <header class="topbar">

            <div class="topbar-brand">

                <div class="brand-logo">
                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo" />
                </div>

                <div class="brand-text">
                    <span class="brand-title">UNILAK</span>
                    <span class="brand-subtitle">Staff Engagement Portal</span>
                </div>

            </div>

            <div class="topbar-actions">

                <div class="role-indicator">
                    <i class="bi bi-person-badge"></i>
                    <span>Dean</span>
                </div>

                <a href="/Login" class="logout-link">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>

            </div>

        </header>


        <!-- =========================================================
             APPLICATION BODY
             ========================================================= -->
        <div class="app-body">

            <!-- =====================================================
                 SIDEBAR
                 ===================================================== -->
            <aside class="sidebar">

                <div class="sidebar-heading">
                    <span>Dean Portal</span>
                </div>

                <nav class="sidebar-nav">

                    <a href="/DEAN" class="nav-item active">
                        <span class="nav-icon">
                            <i class="bi bi-grid-1x2-fill"></i>
                        </span>
                        <span>Dashboard</span>
                    </a>

                    <a href="/DEAN/RegisterUser" class="nav-item">
                        <span class="nav-icon">
                            <i class="bi bi-person-plus-fill"></i>
                        </span>
                        <span>Register New User</span>
                    </a>

                    <a href="/DEAN/Contracts" class="nav-item">
                        <span class="nav-icon">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </span>
                        <span>Contracts</span>
                    </a>

                    <a href="/DEAN/Claims" class="nav-item">
                        <span class="nav-icon">
                            <i class="bi bi-cash-stack"></i>
                        </span>
                        <span>Claims</span>
                    </a>

                </nav>

                <div class="sidebar-footer">

                    <div class="security-note">
                        <div class="security-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <strong>Secure Portal</strong>
                            <span>Authorized Dean access</span>
                        </div>
                    </div>

                </div>

            </aside>


            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->
            <main class="main-content">

                <!-- Page heading -->
                <section class="page-heading">

                    <div>
                        <div class="breadcrumb">
                            <i class="bi bi-house-door"></i>
                            <span>/</span>
                            <span>Dean Portal</span>
                            <span>/</span>
                            <strong>Dashboard</strong>
                        </div>

                        <h1>Dean Dashboard</h1>

                        <p>
                            Monitor contracts, review academic staff claims,
                            and manage pending approvals.
                        </p>
                    </div>

                    <div class="heading-status">
                        <span class="status-dot"></span>
                        System Operational
                    </div>

                </section>


                <!-- =================================================
                     STATISTICS
                     ================================================= -->
                <section class="stats-grid">

                    <a href="/DEAN/Contracts" class="stat-card">

                        <div class="stat-card-top">

                            <div class="stat-icon pending">
                                <i class="bi bi-file-earmark-sign"></i>
                            </div>

                            <span class="stat-arrow">
                                <i class="bi bi-arrow-up-right"></i>
                            </span>

                        </div>

                        <div class="stat-number">
                            @Model.ContractsToSignCount
                        </div>

                        <div class="stat-label">
                            Contracts to Sign
                        </div>

                        <div class="stat-description">
                            Contracts awaiting your approval
                        </div>

                    </a>


                    <a href="/DEAN/Contracts" class="stat-card">

                        <div class="stat-card-top">

                            <div class="stat-icon active">
                                <i class="bi bi-file-earmark-check"></i>
                            </div>

                            <span class="stat-arrow">
                                <i class="bi bi-arrow-up-right"></i>
                            </span>

                        </div>

                        <div class="stat-number">
                            @Model.ActiveContractsCount
                        </div>

                        <div class="stat-label">
                            Active Contracts
                        </div>

                        <div class="stat-description">
                            Currently active staff contracts
                        </div>

                    </a>


                    <a href="/DEAN/Claims" class="stat-card">

                        <div class="stat-card-top">

                            <div class="stat-icon claims">
                                <i class="bi bi-cash-coin"></i>
                            </div>

                            <span class="stat-arrow">
                                <i class="bi bi-arrow-up-right"></i>
                            </span>

                        </div>

                        <div class="stat-number">
                            @Model.ClaimsToSignCount
                        </div>

                        <div class="stat-label">
                            Claims to Sign
                        </div>

                        <div class="stat-description">
                            Payment claims awaiting review
                        </div>

                    </a>


                    <div class="stat-card">

                        <div class="stat-card-top">

                            <div class="stat-icon completed">
                                <i class="bi bi-check2-circle"></i>
                            </div>

                            <span class="completion-label">
                                Completed
                            </span>

                        </div>

                        <div class="stat-number">
                            @Model.CompletedApprovalsCount
                        </div>

                        <div class="stat-label">
                            Completed Approvals
                        </div>

                        <div class="stat-description">
                            Approvals completed by you
                        </div>

                    </div>

                </section>


                <!-- =================================================
                     CONTRACTS SECTION
                     ================================================= -->
                <section class="content-card">

                    <div class="card-header">

                        <div class="card-heading">

                            <div class="section-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>

                            <div>
                                <h2>Contracts Awaiting Your Signature</h2>
                                <p>
                                    Review and sign contracts requiring Dean approval.
                                </p>
                            </div>

                        </div>

                        <a href="/DEAN/Contracts" class="view-all-link">
                            View All
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>


                    @if (Model.ContractsAwaitingSignature.Count == 0)
                    {
                        <div class="empty-state">

                            <div class="empty-icon">
                                <i class="bi bi-check2-circle"></i>
                            </div>

                            <h3>No pending contracts</h3>

                            <p>
                                There are currently no contracts awaiting your signature.
                            </p>

                            <a href="/DEAN/Contracts" class="secondary-btn">
                                View Contracts
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="table-container">

                            <table class="data-table">

                                <thead>
                                    <tr>
                                        <th>Contract</th>
                                        <th>Lecturer</th>
                                        <th>Department</th>
                                        <th>Course</th>
                                        <th>Hours</th>
                                        <th>Status</th>
                                        <th class="action-column">Action</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var row in Model.ContractsAwaitingSignature)
                                    {
                                        <tr>

                                            <td>
                                                <span class="record-id">
                                                    C@(row.ContractId.ToString("D3"))
                                                </span>
                                            </td>

                                            <td>
                                                <div class="person-cell">
                                                    <div class="person-avatar">
                                                        <i class="bi bi-person"></i>
                                                    </div>

                                                    <span>@row.LecturerName</span>
                                                </div>
                                            </td>

                                            <td>
                                                <span class="muted-text">
                                                    @row.Department
                                                </span>
                                            </td>

                                            <td>
                                                <span class="course-name">
                                                    @row.CourseTitle
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hours-value">
                                                    @row.AllocatedHours h
                                                </span>
                                            </td>

                                            <td>
                                                <span class="status-badge pending">
                                                    <span class="status-dot"></span>
                                                    Pending Signature
                                                </span>
                                            </td>

                                            <td class="action-column">

                                                <a href="/DEAN/Contracts?contractId=@row.ContractId"
                                                   class="review-btn">
                                                    Review
                                                    <i class="bi bi-arrow-right"></i>
                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </section>


                <!-- =================================================
                     CLAIMS SECTION
                     ================================================= -->
                <section class="content-card">

                    <div class="card-header">

                        <div class="card-heading">

                            <div class="section-icon claims-section-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>

                            <div>
                                <h2>Claims Awaiting Your Signature</h2>
                                <p>
                                    Review academic staff payment claims requiring approval.
                                </p>
                            </div>

                        </div>

                        <a href="/DEAN/Claims" class="view-all-link">
                            View All
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>


                    @if (Model.ClaimsAwaitingSignature.Count == 0)
                    {
                        <div class="empty-state">

                            <div class="empty-icon">
                                <i class="bi bi-check2-circle"></i>
                            </div>

                            <h3>No pending claims</h3>

                            <p>
                                There are currently no claims awaiting your signature.
                            </p>

                            <a href="/DEAN/Claims" class="secondary-btn">
                                View Claims
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="table-container">

                            <table class="data-table">

                                <thead>
                                    <tr>
                                        <th>Claim</th>
                                        <th>Lecturer</th>
                                        <th>Contract</th>
                                        <th>Hours</th>
                                        <th>Status</th>
                                        <th class="action-column">Action</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var row in Model.ClaimsAwaitingSignature)
                                    {
                                        <tr>

                                            <td>
                                                <span class="record-id">
                                                    CL@(row.ClaimId.ToString("D3"))
                                                </span>
                                            </td>

                                            <td>
                                                <div class="person-cell">

                                                    <div class="person-avatar">
                                                        <i class="bi bi-person"></i>
                                                    </div>

                                                    <span>@row.LecturerName</span>

                                                </div>
                                            </td>

                                            <td>
                                                <span class="contract-reference">
                                                    C@(row.ContractId.ToString("D3"))
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hours-value">
                                                    @row.HoursClaimed h
                                                </span>
                                            </td>

                                            <td>
                                                <span class="status-badge review">
                                                    <span class="status-dot"></span>
                                                    Awaiting Signature
                                                </span>
                                            </td>

                                            <td class="action-column">

                                                <a href="/DEAN/Claims?claimId=@row.ClaimId"
                                                   class="review-btn">
                                                    Review
                                                    <i class="bi bi-arrow-right"></i>
                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </section>


                <!-- =================================================
                     FOOTER
                     ================================================= -->
                <footer class="portal-footer">

                    <div>
                        <strong>UNILAK Portal</strong>
                        <span>
                            Academic Staff Engagement &amp; Claim Processing System
                        </span>
                    </div>

                    <div class="footer-right">
                        © @DateTime.Now.Year University of Lay Adventists of Kigali
                    </div>

                </footer>

            </main>

        </div>

    </div>

</body>
</html>