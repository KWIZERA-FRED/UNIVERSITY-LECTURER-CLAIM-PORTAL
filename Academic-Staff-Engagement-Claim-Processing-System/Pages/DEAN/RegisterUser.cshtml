@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.RegisterUserModel

@{
    ViewData["Title"] = "Register New User";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Register New User | UNILAK</title>

    <!-- =========================================================
         GOOGLE FONTS
         ========================================================= -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <!-- =========================================================
         BOOTSTRAP ICONS
         ========================================================= -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =========================================================
         DEAN REGISTER USER CSS
         ========================================================= -->
    <link rel="stylesheet"
          href="~/css/DEAN/register-user.css"
          asp-append-version="true" />

</head>

<body>

    <div class="dean-app">

        <!-- =====================================================
             TOP NAVIGATION
             ===================================================== -->

        <header class="topbar">

            <div class="topbar-brand">

                <div class="brand-logo">

                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo" />

                </div>

                <div class="brand-text">

                    <span class="brand-title">
                        UNILAK
                    </span>

                    <span class="brand-subtitle">
                        Staff Engagement Portal
                    </span>

                </div>

            </div>


            <div class="topbar-actions">

                <div class="role-indicator">

                    <i class="bi bi-person-badge"></i>

                    <span>
                        Dean
                    </span>

                </div>


                <a href="/Login" class="logout-link">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>

        </header>


        <!-- =====================================================
             APPLICATION BODY
             ===================================================== -->

        <div class="app-body">

            <!-- =================================================
                 SIDEBAR
                 ================================================= -->

            <aside class="sidebar">

                <div class="sidebar-heading">
                    Dean Portal
                </div>


                <nav class="sidebar-nav">

                    <a href="/DEAN" class="nav-item">

                        <span class="nav-icon">
                            <i class="bi bi-grid-1x2-fill"></i>
                        </span>

                        <span>
                            Dashboard
                        </span>

                    </a>


                    <a href="/DEAN/RegisterUser"
                       class="nav-item active">

                        <span class="nav-icon">
                            <i class="bi bi-person-plus-fill"></i>
                        </span>

                        <span>
                            Register New User
                        </span>

                    </a>


                    <a href="/DEAN/Contracts" class="nav-item">

                        <span class="nav-icon">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </span>

                        <span>
                            Contracts
                        </span>

                    </a>


                    <a href="/DEAN/Claims" class="nav-item">

                        <span class="nav-icon">
                            <i class="bi bi-cash-stack"></i>
                        </span>

                        <span>
                            Claims
                        </span>

                    </a>

                </nav>


                <!-- Sidebar footer -->

                <div class="sidebar-footer">

                    <div class="security-note">

                        <div class="security-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div class="security-text">

                            <strong>
                                Secure Portal
                            </strong>

                            <span>
                                Authorized Dean access
                            </span>

                        </div>

                    </div>

                </div>

            </aside>


            <!-- =================================================
                 MAIN CONTENT
                 ================================================= -->

            <main class="main-content">

                <!-- =================================================
                     PAGE HEADER
                     ================================================= -->

                <section class="page-heading">

                    <div>

                        <div class="breadcrumb">

                            <i class="bi bi-house-door"></i>

                            <span>/</span>

                            <span>
                                Dean Portal
                            </span>

                            <span>/</span>

                            <strong>
                                Register User
                            </strong>

                        </div>


                        <h1>
                            Register New User
                        </h1>


                        <p>
                            Create a new HOD or Management account and securely
                            capture their digital signature.
                        </p>

                    </div>


                    <a href="/DEAN" class="back-link">

                        <i class="bi bi-arrow-left"></i>

                        <span>
                            Back to Dashboard
                        </span>

                    </a>

                </section>


                <!-- =================================================
                     SYSTEM BOOTSTRAP INFORMATION
                     ================================================= -->

                @if (Model.IsBootstrapMode)
                {
                    <div class="alert-box bootstrap-alert">

                        <div class="alert-icon">
                            <i class="bi bi-shield-exclamation"></i>
                        </div>

                        <div class="alert-content">

                            <strong>
                                Initial System Setup
                            </strong>

                            <p>
                                No Dean account exists yet. This first registration
                                will create the initial Dean account. After that,
                                this page will only allow the Dean to create HOD
                                and Management accounts.
                            </p>

                        </div>

                    </div>
                }


                <!-- =================================================
                     SUCCESS MESSAGE
                     ================================================= -->

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert-box success-alert">

                        <div class="alert-icon">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>

                        <div class="alert-content">

                            <strong>
                                Registration Successful
                            </strong>

                            <p>
                                @Model.SuccessMessage
                            </p>

                        </div>

                    </div>
                }


                <!-- =================================================
                     ERROR MESSAGE
                     ================================================= -->

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert-box error-alert">

                        <div class="alert-icon">
                            <i class="bi bi-exclamation-circle-fill"></i>
                        </div>

                        <div class="alert-content">

                            <strong>
                                Registration Failed
                            </strong>

                            <p>
                                @Model.ErrorMessage
                            </p>

                        </div>

                    </div>
                }


                <!-- =================================================
                     REGISTRATION CARD
                     ================================================= -->

                <section class="content-card">

                    <!-- Card heading -->

                    <div class="card-header">

                        <div class="card-heading">

                            <div class="section-icon">

                                <i class="bi bi-person-plus-fill"></i>

                            </div>

                            <div>

                                <h2>
                                    User Registration
                                </h2>

                                <p>
                                    Enter the account information below.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         FORM
                         ================================================= -->

                    <form method="post"
                          id="registerForm"
                          class="registration-form">

                        <div class="form-grid">


                            <!-- =================================================
                                 FULL NAME
                                 ================================================= -->

                            <div class="form-group">

                                <label asp-for="Name">

                                    Full Name

                                    <span class="required">
                                        *
                                    </span>

                                </label>


                                <div class="input-wrapper">

                                    <i class="bi bi-person input-icon"></i>

                                    <input type="text"
                                           asp-for="Name"
                                           class="form-control has-icon"
                                           placeholder="Enter full name"
                                           autocomplete="name"
                                           required />

                                </div>

                                <span asp-validation-for="Name"
                                      class="validation-message">
                                </span>

                            </div>


                            <!-- =================================================
                                 EMAIL
                                 ================================================= -->

                            <div class="form-group">

                                <label asp-for="Email">

                                    Email Address

                                    <span class="required">
                                        *
                                    </span>

                                </label>


                                <div class="input-wrapper">

                                    <i class="bi bi-envelope input-icon"></i>

                                    <input type="email"
                                           asp-for="Email"
                                           class="form-control has-icon"
                                           placeholder="Enter email address"
                                           autocomplete="email"
                                           required />

                                </div>

                                <span asp-validation-for="Email"
                                      class="validation-message">
                                </span>

                            </div>


                            <!-- =================================================
                                 ROLE
                                 ================================================= -->

                            <div class="form-group">

                                <label asp-for="Role">

                                    System Role

                                    <span class="required">
                                        *
                                    </span>

                                </label>


                                <div class="input-wrapper">

                                    <i class="bi bi-person-gear input-icon"></i>

                                    <select asp-for="Role"
                                            class="form-select has-icon"
                                            id="roleSelect"
                                            required>

                                        <option value="">
                                            Select system role
                                        </option>


                                        @if (Model.IsBootstrapMode)
                                        {
                                            <option value="Dean">
                                                Dean — Initial System Account
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="HOD">
                                                Head of Department
                                            </option>

                                            <option value="Management">
                                                Management
                                            </option>
                                        }

                                    </select>

                                </div>

                            </div>


                            <!-- =================================================
                                 DEPARTMENT
                                 ================================================= -->

                            <div class="form-group"
                                 id="departmentGroup">

                                <label asp-for="Department">

                                    Department

                                    <span class="required">
                                        *
                                    </span>

                                </label>


                                <div class="input-wrapper">

                                    <i class="bi bi-building input-icon"></i>

                                    <input type="text"
                                           asp-for="Department"
                                           id="departmentInput"
                                           class="form-control has-icon"
                                           placeholder="Enter department" />

                                </div>


                                <div class="field-help">

                                    <i class="bi bi-info-circle"></i>

                                    Required only for Head of Department accounts.

                                </div>

                            </div>


                            <!-- =================================================
                                 MANAGEMENT OFFICE
                                 ================================================= -->

                            <div class="form-group"
                                 id="managementTitleGroup">

                                <label asp-for="ManagementTitle">

                                    Management Office

                                    <span class="required">
                                        *
                                    </span>

                                </label>


                                <div class="input-wrapper">

                                    <i class="bi bi-building-gear input-icon"></i>

                                    <select asp-for="ManagementTitle"
                                            id="managementTitleInput"
                                            class="form-select has-icon">

                                        <option value="">
                                            Select management office
                                        </option>

                                        <option value="HROfficer">
                                            Human Resource Officer
                                        </option>

                                        <option value="DVCAR">
                                            DVCAR
                                        </option>

                                        <option value="ViceChancellor">
                                            Vice Chancellor
                                        </option>

                                        <option value="ExamOffice">
                                            Exam Office
                                        </option>

                                        <option value="DirectorOfQuality">
                                            Director of Quality
                                        </option>

                                    </select>

                                </div>


                                <div class="field-help">

                                    <i class="bi bi-info-circle"></i>

                                    Required when registering a Management account.

                                </div>

                            </div>


                            <!-- =================================================
                                 ROLE INFORMATION
                                 ================================================= -->

                            <div class="role-info"
                                 id="roleInfo">

                                <div class="role-info-icon">

                                    <i class="bi bi-info-circle-fill"></i>

                                </div>

                                <div>

                                    <strong id="roleInfoTitle">
                                        Account Information
                                    </strong>

                                    <span id="roleInfoText"></span>

                                </div>

                            </div>


                            <!-- =================================================
                                 DIGITAL SIGNATURE
                                 ================================================= -->

                            <div class="signature-section">

                                <div class="signature-heading">

                                    <div>

                                        <label>

                                            Digital Signature

                                            <span class="required">
                                                *
                                            </span>

                                        </label>

                                        <p>
                                            Capture the user's handwritten signature.
                                        </p>

                                    </div>


                                    <span class="signature-required">

                                        <i class="bi bi-pen"></i>

                                        Required

                                    </span>

                                </div>


                                <div class="signature-container">

                                    <div class="signature-canvas-area">

                                        <div class="signature-placeholder"
                                             id="signaturePlaceholder">

                                            <i class="bi bi-pen"></i>

                                            <span>
                                                Sign inside this area
                                            </span>

                                        </div>

                                        <canvas id="signaturePad"></canvas>

                                    </div>


                                    <div class="signature-footer">

                                        <div class="signature-status">

                                            <span class="signature-status-icon">

                                                <i class="bi bi-shield-check"></i>

                                            </span>

                                            <span>
                                                Signature will be securely associated
                                                with this account.
                                            </span>

                                        </div>


                                        <button type="button"
                                                class="clear-signature"
                                                id="clearSignature">

                                            <i class="bi bi-eraser"></i>

                                            Clear

                                        </button>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================================
                                 GENERAL INFORMATION
                                 ================================================= -->

                            <div class="info-box">

                                <div class="info-box-icon">

                                    <i class="bi bi-info-circle-fill"></i>

                                </div>

                                <div>

                                    <strong>
                                        Account Creation
                                    </strong>

                                    <p>
                                        After registration, the system will
                                        automatically generate the user's username
                                        and password. Login credentials will be
                                        sent to the email address provided above.
                                    </p>

                                    <p>
                                        HOD accounts require a department.
                                        Management accounts require a management
                                        office. Lecturer accounts are created by
                                        an HOD and are not registered here.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             FORM ACTIONS
                             ================================================= -->

                        <div class="form-actions">

                            <a href="/DEAN"
                               class="cancel-button">

                                <i class="bi bi-x-lg"></i>

                                Cancel

                            </a>


                            <button type="submit"
                                    class="create-button">

                                <i class="bi bi-person-check-fill"></i>

                                Create User

                            </button>

                        </div>


                        <!-- =================================================
                             HIDDEN SIGNATURE DATA
                             ================================================= -->

                        <input type="hidden"
                               asp-for="SignatureData"
                               id="signatureData" />

                    </form>

                </section>


                <!-- =================================================
                     FOOTER
                     ================================================= -->

                <footer class="portal-footer">

                    <div>

                        <strong>
                            UNILAK Portal
                        </strong>

                        <span>
                            Academic Staff Engagement &amp; Claim Processing System
                        </span>

                    </div>


                    <div class="footer-right">

                        © @DateTime.Now.Year
                        University of Lay Adventists of Kigali

                    </div>

                </footer>

            </main>

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script>

        /* =========================================================
           ROLE FIELD MANAGEMENT
           ========================================================= */

        const roleSelect =
            document.getElementById("roleSelect");

        const departmentGroup =
            document.getElementById("departmentGroup");

        const departmentInput =
            document.getElementById("departmentInput");

        const managementTitleGroup =
            document.getElementById("managementTitleGroup");

        const managementTitleInput =
            document.getElementById("managementTitleInput");

        const roleInfo =
            document.getElementById("roleInfo");

        const roleInfoTitle =
            document.getElementById("roleInfoTitle");

        const roleInfoText =
            document.getElementById("roleInfoText");


        function updateRoleFields() {

            const role = roleSelect.value;


            /* Reset fields */

            departmentGroup.classList.remove("visible");

            managementTitleGroup.classList.remove("visible");

            roleInfo.classList.remove("visible");

            departmentInput.required = false;

            managementTitleInput.required = false;


            /* HOD */

            if (role === "HOD") {

                departmentGroup.classList.add("visible");

                departmentInput.required = true;

                roleInfoTitle.textContent =
                    "Head of Department Account";

                roleInfoText.textContent =
                    "This account will be associated with the selected department and will be used by the HOD to manage departmental academic activities.";

                roleInfo.classList.add("visible");

            }


            /* Dean */

            else if (role === "Dean") {

                roleInfoTitle.textContent =
                    "Initial Dean Account";

                roleInfoText.textContent =
                    "This creates the initial Dean account for the system. This option is only available during the initial system setup.";

                roleInfo.classList.add("visible");

            }


            /* Management */

            else if (role === "Management") {

                managementTitleGroup.classList.add("visible");

                managementTitleInput.required = true;

                roleInfoTitle.textContent =
                    "Management Account";

                roleInfoText.textContent =
                    "This account represents one specific management office. Select the office that this user will represent.";

                roleInfo.classList.add("visible");

            }

        }


        roleSelect.addEventListener(
            "change",
            updateRoleFields
        );

        updateRoleFields();


        /* =========================================================
           SIGNATURE PAD
           ========================================================= */

        const canvas =
            document.getElementById("signaturePad");

        const ctx =
            canvas.getContext("2d");

        const placeholder =
            document.getElementById("signaturePlaceholder");

        let drawing = false;

        let hasSignature = false;


        function resizeCanvas() {

            const rect =
                canvas.getBoundingClientRect();

            const ratio =
                window.devicePixelRatio || 1;

            const existingSignature =
                hasSignature
                    ? canvas.toDataURL("image/png")
                    : null;


            canvas.width =
                rect.width * ratio;

            canvas.height =
                rect.height * ratio;


            ctx.setTransform(
                ratio,
                0,
                0,
                ratio,
                0,
                0
            );


            ctx.lineWidth = 2;

            ctx.lineCap = "round";

            ctx.lineJoin = "round";

            ctx.strokeStyle = "#0f2742";


            if (existingSignature) {

                const image =
                    new Image();

                image.onload = function () {

                    ctx.drawImage(
                        image,
                        0,
                        0,
                        rect.width,
                        rect.height
                    );

                };

                image.src =
                    existingSignature;

            }

        }


        resizeCanvas();

        window.addEventListener(
            "resize",
            resizeCanvas
        );


        function getPosition(e) {

            const rect =
                canvas.getBoundingClientRect();


            if (
                e.touches &&
                e.touches.length > 0
            ) {

                return {

                    x:
                        e.touches[0].clientX -
                        rect.left,

                    y:
                        e.touches[0].clientY -
                        rect.top

                };

            }


            return {

                x:
                    e.clientX -
                    rect.left,

                y:
                    e.clientY -
                    rect.top

            };

        }


        function startDrawing(e) {

            e.preventDefault();

            drawing = true;

            hasSignature = true;

            placeholder.classList.add("hidden");

            const position =
                getPosition(e);

            ctx.beginPath();

            ctx.moveTo(
                position.x,
                position.y
            );

        }


        function draw(e) {

            if (!drawing) {
                return;
            }

            e.preventDefault();

            const position =
                getPosition(e);

            ctx.lineTo(
                position.x,
                position.y
            );

            ctx.stroke();

        }


        function stopDrawing() {

            if (!drawing) {
                return;
            }

            drawing = false;

            document.getElementById(
                "signatureData"
            ).value =
                canvas.toDataURL("image/png");

        }


        canvas.addEventListener(
            "mousedown",
            startDrawing
        );

        canvas.addEventListener(
            "mousemove",
            draw
        );

        canvas.addEventListener(
            "mouseup",
            stopDrawing
        );

        canvas.addEventListener(
            "mouseleave",
            stopDrawing
        );


        canvas.addEventListener(
            "touchstart",
            startDrawing,
            { passive: false }
        );

        canvas.addEventListener(
            "touchmove",
            draw,
            { passive: false }
        );

        canvas.addEventListener(
            "touchend",
            stopDrawing
        );


        /* =========================================================
           CLEAR SIGNATURE
           ========================================================= */

        document
            .getElementById("clearSignature")
            .addEventListener(
                "click",
                function () {

                    const rect =
                        canvas.getBoundingClientRect();

                    ctx.clearRect(
                        0,
                        0,
                        rect.width,
                        rect.height
                    );

                    hasSignature = false;

                    placeholder.classList.remove(
                        "hidden"
                    );

                    document.getElementById(
                        "signatureData"
                    ).value = "";

                }
            );


        /* =========================================================
           FORM VALIDATION
           ========================================================= */

        document
            .getElementById("registerForm")
            .addEventListener(
                "submit",
                function (e) {

                    const role =
                        roleSelect.value;


                    if (!role) {

                        e.preventDefault();

                        alert(
                            "Please select the user's system role."
                        );

                        roleSelect.focus();

                        return;

                    }


                    if (!hasSignature) {

                        e.preventDefault();

                        alert(
                            "Please provide the user's digital signature."
                        );

                        return;

                    }


                    if (
                        role === "HOD" &&
                        !departmentInput.value.trim()
                    ) {

                        e.preventDefault();

                        alert(
                            "Please enter the HOD's department."
                        );

                        departmentInput.focus();

                        return;

                    }


                    if (
                        role === "Management" &&
                        !managementTitleInput.value
                    ) {

                        e.preventDefault();

                        alert(
                            "Please select the Management office."
                        );

                        managementTitleInput.focus();

                        return;

                    }


                    document.getElementById(
                        "signatureData"
                    ).value =
                        canvas.toDataURL("image/png");

                }
            );

    </script>

</body>
</html>