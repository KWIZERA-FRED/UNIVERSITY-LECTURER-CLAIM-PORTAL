@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.RegisterUserModel

@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    Layout = "~/Pages/Shared/DEAN/_DeanLayout.cshtml";
    ViewData["Title"] = "Register User";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/DEAN/register-user.css"
          asp-append-version="true" />
}

<section class="register-page">

    <header class="page-header">
        <h1>Register User</h1>
        <p>Create an institutional account for an HOD or management officer.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="validation-summary"
         role="alert">
    </div>

    <section class="section-card">

        <header class="section-header">
            <h2>User Account Information</h2>
        </header>

        <form method="post"
              id="registerUserForm"
              novalidate>

            <div class="form-body">

                <div class="form-section">

                    <h3 class="form-section-title">Personal Information</h3>

                    <div class="form-grid">

                        <div class="form-group form-group-full">
                            <label asp-for="Name">Full Name <span>*</span></label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter full name"
                                   autocomplete="name" />
                            <span asp-validation-for="Name" class="field-validation"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email">Email Address <span>*</span></label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter institutional email"
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="field-validation"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Department">Department</label>
                            <input asp-for="Department"
                                   class="form-control"
                                   placeholder="Enter department" />
                            <span asp-validation-for="Department" class="field-validation"></span>
                        </div>

                    </div>

                </div>

                <div class="form-divider"></div>

                <div class="form-section">

                    <h3 class="form-section-title">Role &amp; Organisation</h3>

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="Role">Role <span>*</span></label>
                            <select asp-for="Role" class="form-control" id="roleSelect">
                                <option value="">Select role</option>

                                @if (Model.IsBootstrapMode)
                                {
                                    <option value="Dean">Dean</option>
                                }
                                else
                                {
                                    <option value="HOD">Head of Department (HOD)</option>
                                    <option value="Management">Management</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="field-validation"></span>
                        </div>

                        <div class="form-group"
                             id="managementTitleContainer"
                             style="display:none;">
                            <label asp-for="ManagementTitle">Management Office</label>
                            <select asp-for="ManagementTitle"
                                    class="form-control"
                                    id="managementTitleSelect">
                                <option value="">Select management office</option>

                                @foreach (var title in Enum.GetValues<ManagementTitle>())
                                {
                                    <option value="@title">@title</option>
                                }
                            </select>
                            <span asp-validation-for="ManagementTitle" class="field-validation"></span>
                        </div>

                    </div>

                </div>

                <div class="form-divider"></div>

                <div class="form-section">

                    <h3 class="form-section-title">Electronic Signature</h3>

                    <div class="signature-area">

                        <div class="signature-wrapper">

                            <canvas id="signatureCanvas"
                                    class="signature-canvas"
                                    tabindex="0"
                                    aria-label="Electronic signature area">
                            </canvas>

                            <div class="signature-canvas-placeholder"
                                 id="signaturePlaceholder">

                                <i class="bi bi-pencil"></i>
                                <span>Sign here</span>

                            </div>

                            <div class="signature-line"></div>
                            <div class="signature-label">Electronic Signature</div>

                        </div>

                        <input asp-for="SignatureData"
                               type="hidden"
                               id="signatureData" />

                        <div class="signature-actions">

                            <button type="button"
                                    class="secondary-button clear-signature"
                                    id="clearSignature">

                                <i class="bi bi-arrow-counterclockwise"></i>
                                Clear Signature

                            </button>

                        </div>

                        <span asp-validation-for="SignatureData"
                              class="field-validation signature-validation">
                        </span>

                    </div>

                </div>

            </div>

            <footer class="form-actions">

                <a asp-page="/DEAN/Index" class="secondary-button">
                    Cancel
                </a>

                <button type="submit"
                        class="primary-button"
                        id="registerButton">

                    <span class="button-text">
                        <i class="bi bi-person-plus-fill"></i>
                        Register User
                    </span>

                    <span class="button-loading">
                        <span class="loading-spinner"></span>
                        Registering...
                    </span>

                </button>

            </footer>

        </form>

    </section>

</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const roleSelect =
                document.getElementById("roleSelect");

            const managementTitleContainer =
                document.getElementById("managementTitleContainer");

            const managementTitleSelect =
                document.getElementById("managementTitleSelect");

            const form =
                document.getElementById("registerUserForm");

            const canvas =
                document.getElementById("signatureCanvas");

            const signatureData =
                document.getElementById("signatureData");

            const clearButton =
                document.getElementById("clearSignature");

            const signaturePlaceholder =
                document.getElementById("signaturePlaceholder");

            const registerButton =
                document.getElementById("registerButton");


            /* ============================================================
               MANAGEMENT TITLE VISIBILITY
               ============================================================ */

            function updateManagementTitleVisibility() {

                if (!roleSelect || !managementTitleContainer) return;

                const isManagement =
                    roleSelect.value.toLowerCase() === "management";

                managementTitleContainer.style.display =
                    isManagement ? "" : "none";

                if (!isManagement && managementTitleSelect) {
                    managementTitleSelect.value = "";
                }

            }

            if (roleSelect) {

                roleSelect.addEventListener(
                    "change",
                    updateManagementTitleVisibility
                );

                updateManagementTitleVisibility();

            }


            /* ============================================================
               SIGNATURE PAD
               ============================================================ */

            if (!canvas) return;

            const context = canvas.getContext("2d");

            if (!context) return;

            let drawing = false;
            let hasSignature = false;
            let lastX = 0;
            let lastY = 0;


            function resizeCanvas() {

                const rect = canvas.getBoundingClientRect();

                if (rect.width === 0 || rect.height === 0) return;

                const ratio = Math.max(window.devicePixelRatio || 1, 1);

                /* Snapshot existing pixels before resizing */
                let snapshot = null;

                if (canvas.width > 0 && canvas.height > 0) {
                    try {
                        snapshot = context.getImageData(0, 0, canvas.width, canvas.height);
                    } catch { snapshot = null; }
                }

                canvas.width  = Math.round(rect.width  * ratio);
                canvas.height = Math.round(rect.height * ratio);

                context.setTransform(ratio, 0, 0, ratio, 0, 0);

                context.lineWidth = 2.2;
                context.lineCap = "round";
                context.lineJoin = "round";
                context.strokeStyle = "#0f2742";

                if (snapshot) {
                    try {
                        context.putImageData(snapshot, 0, 0);
                    } catch { /* ignore */ }
                }

            }

            resizeCanvas();

            if (typeof ResizeObserver !== "undefined") {
                const observer = new ResizeObserver(resizeCanvas);
                observer.observe(canvas);
            }

            window.addEventListener("resize", resizeCanvas);


            /* Scroll-safe cursor → canvas coordinates */
            function getCanvasOffset() {

                let offsetX = 0;
                let offsetY = 0;
                let el = canvas;

                while (el) {
                    offsetX += el.offsetLeft || 0;
                    offsetY += el.offsetTop || 0;
                    el = el.offsetParent;
                }

                return { x: offsetX, y: offsetY };

            }

            function getPosition(event) {

                let pageX;
                let pageY;

                if (event.touches && event.touches.length > 0) {
                    pageX = event.touches[0].pageX;
                    pageY = event.touches[0].pageY;
                } else if (event.changedTouches && event.changedTouches.length > 0) {
                    pageX = event.changedTouches[0].pageX;
                    pageY = event.changedTouches[0].pageY;
                } else {
                    pageX = event.clientX + (window.pageXOffset || document.documentElement.scrollLeft || 0);
                    pageY = event.clientY + (window.pageYOffset || document.documentElement.scrollTop || 0);
                }

                const offset = getCanvasOffset();

                return {
                    x: pageX - offset.x,
                    y: pageY - offset.y
                };

            }


            function startDrawing(event) {

                event.preventDefault();

                const pos = getPosition(event);

                drawing = true;
                hasSignature = true;
                lastX = pos.x;
                lastY = pos.y;

                context.beginPath();
                context.arc(pos.x, pos.y, 1.1, 0, Math.PI * 2);
                context.fillStyle = context.strokeStyle;
                context.fill();

                context.beginPath();
                context.moveTo(pos.x, pos.y);

                if (signaturePlaceholder) {
                    signaturePlaceholder.classList.add("signature-placeholder-hidden");
                }

            }

            function draw(event) {

                if (!drawing) return;

                event.preventDefault();

                const pos = getPosition(event);

                const midX = (lastX + pos.x) / 2;
                const midY = (lastY + pos.y) / 2;

                context.quadraticCurveTo(lastX, lastY, midX, midY);
                context.stroke();

                context.beginPath();
                context.moveTo(midX, midY);

                lastX = pos.x;
                lastY = pos.y;

            }

            function stopDrawing(event) {

                if (!drawing) return;

                if (event) event.preventDefault();

                drawing = false;

                context.closePath();

            }

            canvas.addEventListener("mousedown", startDrawing);
            canvas.addEventListener("mousemove", draw);
            canvas.addEventListener("mouseup", stopDrawing);
            canvas.addEventListener("mouseleave", stopDrawing);

            canvas.addEventListener("touchstart", startDrawing, { passive: false });
            canvas.addEventListener("touchmove", draw, { passive: false });
            canvas.addEventListener("touchend", stopDrawing, { passive: false });
            canvas.addEventListener("touchcancel", stopDrawing, { passive: false });


            /* ============================================================
               CLEAR SIGNATURE
               ============================================================ */

            function clearSignaturePad() {

                context.clearRect(0, 0, canvas.width, canvas.height);

                hasSignature = false;

                if (signatureData) signatureData.value = "";

                if (signaturePlaceholder) {
                    signaturePlaceholder.classList.remove("signature-placeholder-hidden");
                }

            }

            if (clearButton) {
                clearButton.addEventListener("click", clearSignaturePad);
            }


            /* ============================================================
               FORM SUBMISSION
               ============================================================ */

            if (form) {

                form.addEventListener("submit", function (event) {

                    if (!hasSignature) {

                        event.preventDefault();

                        alert("Please capture the user's electronic signature before registering the account.");

                        canvas.focus();

                        return;

                    }

                    if (signatureData) {
                        signatureData.value = canvas.toDataURL("image/png");
                    }

                    if (registerButton) {

                        registerButton.disabled = true;

                        const text = registerButton.querySelector(".button-text");
                        const loading = registerButton.querySelector(".button-loading");

                        if (text) text.style.display = "none";
                        if (loading) loading.style.display = "inline-flex";

                    }

                });

            }

        });

    </script>
}