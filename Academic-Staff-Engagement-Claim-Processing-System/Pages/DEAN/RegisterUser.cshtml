
@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.RegisterUserModel

@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    ViewData["Title"] = "Register User";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/DEAN/register-user.css"
          asp-append-version="true" />
}

<div class="register-user-page">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="register-page-header">

        <div class="register-header-content">

            <div>

                <div class="register-breadcrumb">

                    <a asp-page="/DEAN/Index">
                        <i class="bi bi-grid-1x2-fill"></i>
                        Dashboard
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>Register User</span>

                </div>


                <h1>
                    <i class="bi bi-person-plus-fill"></i>
                    Register User
                </h1>


                <p>
                    Create an institutional account for an HOD or management
                    officer and capture their electronic signature.
                </p>

            </div>


            <div class="register-header-icon">
                <i class="bi bi-person-badge-fill"></i>
            </div>

        </div>

    </div>


    <!-- ============================================================
         SUCCESS MESSAGE
         ============================================================ -->

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="register-alert register-alert-success"
             role="alert">

            <div class="alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div class="alert-content">

                <strong>Success</strong>

                <span>
                    @Model.SuccessMessage
                </span>

            </div>

            <button type="button"
                    class="alert-close"
                    aria-label="Close"
                    onclick="this.closest('.register-alert').remove();">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>
    }


    <!-- ============================================================
         ERROR MESSAGE
         ============================================================ -->

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="register-alert register-alert-danger"
             role="alert">

            <div class="alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div class="alert-content">

                <strong>Registration failed</strong>

                <span>
                    @Model.ErrorMessage
                </span>

            </div>

            <button type="button"
                    class="alert-close"
                    aria-label="Close"
                    onclick="this.closest('.register-alert').remove();">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>
    }


    <!-- ============================================================
         VALIDATION SUMMARY
         ============================================================ -->

    <div asp-validation-summary="ModelOnly"
         class="validation-summary"
         role="alert">
    </div>


    <!-- ============================================================
         REGISTRATION CARD
         ============================================================ -->

    <div class="registration-card">


        <!-- CARD HEADER -->
        <div class="registration-card-header">

            <div class="card-header-icon">
                <i class="bi bi-person-vcard-fill"></i>
            </div>

            <div>

                <h2>
                    User Account Information
                </h2>

                <p>
                    Enter the required information to create the account.
                </p>

            </div>

        </div>


        <form method="post"
              id="registerUserForm"
              novalidate>


            <!-- ========================================================
                 SECTION 01 — PERSONAL INFORMATION
                 ======================================================== -->

            <section class="form-section">

                <div class="form-section-heading">

                    <div class="section-number">
                        01
                    </div>

                    <div>

                        <h3>
                            Personal Information
                        </h3>

                        <p>
                            Provide the user's basic institutional information.
                        </p>

                    </div>

                </div>


                <div class="form-grid">


                    <!-- NAME -->
                    <div class="form-field">

                        <label asp-for="Name">

                            Full Name

                            <span class="required">
                                *
                            </span>

                        </label>


                        <div class="input-wrapper">

                            <i class="bi bi-person"></i>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter full name"
                                   autocomplete="name" />

                        </div>


                        <span asp-validation-for="Name"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- EMAIL -->
                    <div class="form-field">

                        <label asp-for="Email">

                            Email Address

                            <span class="required">
                                *
                            </span>

                        </label>


                        <div class="input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter institutional email"
                                   autocomplete="email" />

                        </div>


                        <span asp-validation-for="Email"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- DEPARTMENT -->
                    <div class="form-field">

                        <label asp-for="Department">

                            Department

                        </label>


                        <div class="input-wrapper">

                            <i class="bi bi-building"></i>

                            <input asp-for="Department"
                                   class="form-control"
                                   placeholder="Enter department" />

                        </div>


                        <span asp-validation-for="Department"
                              class="field-validation">
                        </span>

                    </div>

                </div>

            </section>


            <!-- ========================================================
                 SECTION 02 — ROLE & ORGANISATION
                 ======================================================== -->

            <section class="form-section">

                <div class="form-section-heading">

                    <div class="section-number">
                        02
                    </div>

                    <div>

                        <h3>
                            Role &amp; Organisation
                        </h3>

                        <p>
                            Select the institutional role for this account.
                        </p>

                    </div>

                </div>


                <div class="form-grid">


                    <!-- ROLE -->
                    <div class="form-field">

                        <label asp-for="Role">

                            Role

                            <span class="required">
                                *
                            </span>

                        </label>


                        <div class="input-wrapper select-wrapper">

                            <i class="bi bi-shield-check"></i>

                            <select asp-for="Role"
                                    class="form-control"
                                    id="roleSelect">

                                <option value="">
                                    Select role
                                </option>


                                @if (Model.IsBootstrapMode)
                                {
                                    <option value="Dean">
                                        Dean
                                    </option>
                                }
                                else
                                {
                                    <option value="HOD">
                                        Head of Department (HOD)
                                    </option>

                                    <option value="Management">
                                        Management
                                    </option>
                                }

                            </select>

                        </div>


                        <span asp-validation-for="Role"
                              class="field-validation">
                        </span>


                        @if (Model.IsBootstrapMode)
                        {
                            <small class="field-help">
                                This is the initial system account.
                                The first account must be a Dean.
                            </small>
                        }
                        else
                        {
                            <small class="field-help">
                                The Dean can create HOD and Management
                                accounts. Lecturer accounts are created
                                by an HOD.
                            </small>
                        }

                    </div>


                    <!-- MANAGEMENT TITLE -->
                    <div class="form-field"
                         id="managementTitleContainer">

                        <label asp-for="ManagementTitle">

                            Management Office

                        </label>


                        <div class="input-wrapper select-wrapper">

                            <i class="bi bi-award"></i>

                            <select asp-for="ManagementTitle"
                                    class="form-control"
                                    id="managementTitleSelect">

                                <option value="">
                                    Select management office
                                </option>


                                @foreach (var title in Enum.GetValues<ManagementTitle>())
                                {
                                    <option value="@title">
                                        @title
                                    </option>
                                }

                            </select>

                        </div>


                        <span asp-validation-for="ManagementTitle"
                              class="field-validation">
                        </span>


                        <small class="field-help">
                            Required only when the selected role is Management.
                        </small>

                    </div>

                </div>

            </section>


            <!-- ========================================================
                 SECTION 03 — ELECTRONIC SIGNATURE
                 ======================================================== -->

            <section class="form-section signature-section">

                <div class="form-section-heading">

                    <div class="section-number">
                        03
                    </div>

                    <div>

                        <h3>
                            Electronic Signature
                        </h3>

                        <p>
                            Capture the user's electronic signature for
                            official institutional documents.
                        </p>

                    </div>

                </div>


                <div class="signature-panel">


                    <!-- SIGNATURE HEADER -->
                    <div class="signature-panel-header">

                        <div class="signature-title">

                            <div class="signature-icon">
                                <i class="bi bi-pen"></i>
                            </div>

                            <div>

                                <h4>
                                    Signature Capture
                                </h4>

                                <p>
                                    Ask the user to sign inside the box below.
                                </p>

                            </div>

                        </div>


                        <span class="signature-required-badge">
                            Required
                        </span>

                    </div>


                    <!-- SIGNATURE CANVAS -->
                    <div class="signature-canvas-container">

                        <canvas id="signatureCanvas"
                                class="signature-canvas"
                                tabindex="0"
                                aria-label="Electronic signature area">
                        </canvas>


                        <div class="signature-canvas-placeholder"
                             id="signaturePlaceholder">

                            <i class="bi bi-pencil"></i>

                            <span>
                                Sign here
                            </span>

                        </div>

                    </div>


                    <!-- SIGNATURE DATA -->
                    <input asp-for="SignatureData"
                           type="hidden"
                           id="signatureData" />


                    <span asp-validation-for="SignatureData"
                          class="field-validation signature-validation">
                    </span>


                    <!-- SIGNATURE ACTIONS -->
                    <div class="signature-actions">

                        <button type="button"
                                class="btn btn-secondary"
                                id="clearSignature">

                            <i class="bi bi-eraser"></i>

                            Clear Signature

                        </button>


                        <span class="signature-status-text"
                              id="signatureStatus">

                            <i class="bi bi-info-circle"></i>

                            Signature has not been captured.

                        </span>

                    </div>

                </div>

            </section>


            <!-- ========================================================
                 INFORMATION
                 ======================================================== -->

            <div class="registration-info-box">

                <div class="info-icon">

                    <i class="bi bi-shield-lock-fill"></i>

                </div>


                <div class="info-content">

                    <h4>
                        Important
                    </h4>

                    <p>
                        The account will be created according to the selected
                        institutional role. The electronic signature will be
                        associated with the account and can be used for
                        official contracts, approvals and other institutional
                        documents.
                    </p>

                </div>

            </div>


            <!-- ========================================================
                 FORM ACTIONS
                 ======================================================== -->

            <div class="form-actions">

                <a asp-page="/DEAN/Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="btn btn-primary"
                        id="registerButton">

                    <i class="bi bi-person-plus-fill"></i>

                    Register User

                </button>

            </div>


        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // ============================================================
            // ELEMENTS
            // ============================================================

            const roleSelect =
                document.getElementById("roleSelect");

            const managementTitleContainer =
                document.getElementById(
                    "managementTitleContainer"
                );

            const managementTitleSelect =
                document.getElementById(
                    "managementTitleSelect"
                );

            const form =
                document.getElementById(
                    "registerUserForm"
                );

            const canvas =
                document.getElementById(
                    "signatureCanvas"
                );

            const signatureData =
                document.getElementById(
                    "signatureData"
                );

            const clearButton =
                document.getElementById(
                    "clearSignature"
                );

            const signaturePlaceholder =
                document.getElementById(
                    "signaturePlaceholder"
                );

            const signatureStatus =
                document.getElementById(
                    "signatureStatus"
                );

            const registerButton =
                document.getElementById(
                    "registerButton"
                );


            // ============================================================
            // MANAGEMENT TITLE VISIBILITY
            // ============================================================

            function updateManagementTitleVisibility() {

                if (!roleSelect ||
                    !managementTitleContainer) {

                    return;
                }


                const selectedRole =
                    roleSelect.value.toLowerCase();


                const isManagement =
                    selectedRole === "management";


                managementTitleContainer.style.display =
                    isManagement ? "" : "none";


                if (!isManagement &&
                    managementTitleSelect) {

                    managementTitleSelect.value = "";

                }

            }


            if (roleSelect) {

                roleSelect.addEventListener(
                    "change",
                    updateManagementTitleVisibility
                );


                updateManagementTitleVisibility();

            }


            // ============================================================
            // SIGNATURE CANVAS
            // ============================================================

            if (!canvas) {
                return;
            }


            const context =
                canvas.getContext("2d");


            if (!context) {
                return;
            }


            let drawing = false;
            let hasSignature = false;


            // ============================================================
            // RESIZE CANVAS
            // ============================================================

            function resizeCanvas() {

                const rect =
                    canvas.getBoundingClientRect();


                const ratio =
                    Math.max(
                        window.devicePixelRatio || 1,
                        1
                    );


                canvas.width =
                    rect.width * ratio;


                canvas.height =
                    rect.height * ratio;


                context.setTransform(
                    ratio,
                    0,
                    0,
                    ratio,
                    0,
                    0
                );


                context.lineWidth = 2;
                context.lineCap = "round";
                context.lineJoin = "round";
                context.strokeStyle = "#0b1f33";

            }


            // ============================================================
            // POINTER POSITION
            // ============================================================

            function getPointerPosition(event) {

                const rect =
                    canvas.getBoundingClientRect();


                return {
                    x: event.clientX - rect.left,
                    y: event.clientY - rect.top
                };

            }


            // ============================================================
            // START DRAWING
            // ============================================================

            function startDrawing(event) {

                event.preventDefault();


                drawing = true;
                hasSignature = true;


                const position =
                    getPointerPosition(event);


                context.beginPath();


                context.moveTo(
                    position.x,
                    position.y
                );


                if (signaturePlaceholder) {

                    signaturePlaceholder.classList.add(
                        "signature-placeholder-hidden"
                    );

                }


                updateSignatureStatus();

            }


            // ============================================================
            // DRAW
            // ============================================================

            function draw(event) {

                if (!drawing) {
                    return;
                }


                event.preventDefault();


                const position =
                    getPointerPosition(event);


                context.lineTo(
                    position.x,
                    position.y
                );


                context.stroke();

            }


            // ============================================================
            // STOP DRAWING
            // ============================================================

            function stopDrawing(event) {

                if (!drawing) {
                    return;
                }


                event.preventDefault();


                drawing = false;


                context.closePath();


                updateSignatureStatus();

            }


            // ============================================================
            // SIGNATURE STATUS
            // ============================================================

            function updateSignatureStatus() {

                if (!signatureStatus) {
                    return;
                }


                if (hasSignature) {

                    signatureStatus.innerHTML =
                        '<i class="bi bi-check-circle-fill"></i> ' +
                        'Signature captured successfully.';


                    signatureStatus.classList.add(
                        "signature-status-success"
                    );

                }
                else {

                    signatureStatus.innerHTML =
                        '<i class="bi bi-info-circle"></i> ' +
                        'Signature has not been captured.';


                    signatureStatus.classList.remove(
                        "signature-status-success"
                    );

                }

            }


            // ============================================================
            // CLEAR SIGNATURE
            // ============================================================

            function clearSignaturePad() {

                context.clearRect(
                    0,
                    0,
                    canvas.width,
                    canvas.height
                );


                hasSignature = false;


                if (signatureData) {
                    signatureData.value = "";
                }


                if (signaturePlaceholder) {

                    signaturePlaceholder.classList.remove(
                        "signature-placeholder-hidden"
                    );

                }


                updateSignatureStatus();

            }


            // ============================================================
            // POINTER EVENTS
            // ============================================================

            canvas.addEventListener(
                "pointerdown",
                startDrawing
            );


            canvas.addEventListener(
                "pointermove",
                draw
            );


            canvas.addEventListener(
                "pointerup",
                stopDrawing
            );


            canvas.addEventListener(
                "pointerleave",
                stopDrawing
            );


            canvas.addEventListener(
                "pointercancel",
                stopDrawing
            );


            // ============================================================
            // CLEAR BUTTON
            // ============================================================

            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    clearSignaturePad
                );

            }


            // ============================================================
            // INITIALIZE
            // ============================================================

            resizeCanvas();

            updateSignatureStatus();


            // ============================================================
            // FORM SUBMISSION
            // ============================================================

            if (form) {

                form.addEventListener(
                    "submit",
                    function (event) {

                        // ------------------------------------------------
                        // Signature is mandatory.
                        // ------------------------------------------------

                        if (!hasSignature) {

                            event.preventDefault();


                            alert(
                                "Please capture the user's electronic signature before registering the account."
                            );


                            canvas.focus();


                            return;

                        }


                        // ------------------------------------------------
                        // Convert signature to PNG data URL.
                        // ------------------------------------------------

                        if (signatureData) {

                            signatureData.value =
                                canvas.toDataURL(
                                    "image/png"
                                );

                        }


                        // ------------------------------------------------
                        // Prevent double submission.
                        // ------------------------------------------------

                        if (registerButton) {

                            registerButton.disabled =
                                true;


                            registerButton.innerHTML =
                                '<span class="button-spinner"></span>' +
                                ' Registering...';

                        }

                    }
                );

            }

        });

    </script>
}

