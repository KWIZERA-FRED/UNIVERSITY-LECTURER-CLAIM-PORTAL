@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.ClaimDetailsModel

@{
    Layout = "~/Pages/Shared/DEAN/_DeanLayout.cshtml";
    ViewData["Title"] = "Claim Review";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/DEAN/claims.css"
          asp-append-version="true" />
}

<section class="claims-page">

    <header class="page-header">

        <div class="page-header-main">
            <h1>Claim Review</h1>
            <p>Review and approve the lecturer's payment claim.</p>
        </div>

        <div class="page-header-actions">
            <a asp-page="/DEAN/Claims" class="secondary-button">
                <i class="bi bi-arrow-left"></i>
                Back to Claims
            </a>
        </div>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (Model.SelectedClaim is null)
    {
        <section class="section-card">
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-file-earmark-x"></i>
                </span>
                <h3>Claim not found</h3>
                <p>That claim could not be found, or is not awaiting Dean approval.</p>
                <a asp-page="/DEAN/Claims" class="secondary-button">
                    Back to Claims
                </a>
            </div>
        </section>
    }
    else
    {
        var c = Model.SelectedClaim;

        <!-- ============================================================
             CLAIM SUMMARY
             ============================================================ -->

        <section class="section-card">

            <header class="section-header">
                <h2>CL@(c.ClaimId.ToString("D3"))</h2>
                <span class="status-badge status-pending">Pending Dean Approval</span>
            </header>

            <div class="detail-grid">

                <div class="detail-item">
                    <span class="detail-label">Lecturer</span>
                    <span class="detail-value">@c.LecturerName</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Contract</span>
                    <span class="detail-value">C@(c.ContractId.ToString("D3"))</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Hours Claimed</span>
                    <span class="detail-value">@c.HoursClaimed.ToString("N2") h</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Approval Step</span>
                    <span class="detail-value">Dean</span>
                </div>

            </div>

        </section>

        <!-- ============================================================
             CLAIM DESCRIPTION
             ============================================================ -->

        <section class="section-card">

            <header class="section-header">
                <h2>Claim Description</h2>
            </header>

            <div class="detail-notes">

                @if (!string.IsNullOrWhiteSpace(c.Description))
                {
                    <p>@c.Description</p>
                }
                else
                {
                    <p class="muted-text">No description was provided for this claim.</p>
                }

            </div>

        </section>

        <!-- ============================================================
             EVIDENCE — Contract, Claim Letter, Marks
             ============================================================ -->

        <section class="section-card">

            <header class="section-header">
                <h2>Evidence</h2>
            </header>

            <!-- Contract status -->
            @if (c.ContractSigned)
            {
                <div class="detail-notes">

                    <div class="status-information">

                        <i class="bi bi-check-circle-fill"></i>

                        <div>
                            <strong>Contract signed</strong>
                            <span>
                                Signed
                                @(c.ContractSignedAtUtc?.ToString("dd MMM yyyy") ?? "")
                            </span>
                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="detail-notes">

                    <div class="status-warning">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                        <div>
                            <strong>Contract not signed</strong>
                            <span>
                                The associated contract has not yet reached
                                the ACTIVE status.
                            </span>
                        </div>

                    </div>

                </div>
            }

            <!-- Marks submission -->
            @if (c.MarksSigned && c.MarksSubmissionId.HasValue)
            {
                <div class="detail-grid">

                    <div class="detail-item">
                        <span class="detail-label">Marks file</span>
                        <span class="detail-value">
                            @(c.MarksFileName ?? "Signed Marks Submission")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Signed by</span>
                        <span class="detail-value">
                            @(c.MarksSignedByName ?? "—")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Signed</span>
                        <span class="detail-value">
                            @(c.MarksSignedAtUtc.HasValue
                                ? c.MarksSignedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                : "—")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Reference</span>
                        <span class="detail-value">
                            @(c.MarksReference ?? "—")
                        </span>
                    </div>

                </div>
            }
            else
            {
                <div class="empty-state empty-state--compact">
                    <span class="empty-state-icon" aria-hidden="true">
                        <i class="bi bi-clipboard-x"></i>
                    </span>
                    <h3>No marks submission</h3>
                    <p>No signed marks submission was found for this claim.</p>
                </div>
            }

            <!-- Document link -->
            @if (!string.IsNullOrWhiteSpace(c.QrCodeToken))
            {
                <div class="section-actions">

                    <a href="/Public/ClaimDocuments?token=@c.QrCodeToken"
                       class="secondary-button">
                        <i class="bi bi-folder2-open"></i>
                        <span>View contract &amp; claim documents</span>
                    </a>

                </div>
            }
            else
            {
                <div class="empty-state empty-state--compact">
                    <span class="empty-state-icon" aria-hidden="true">
                        <i class="bi bi-link-45deg"></i>
                    </span>
                    <h3>No document link</h3>
                    <p>No document token is available for this claim.</p>
                </div>
            }

        </section>

        <!-- ============================================================
             DEAN DECISION
             ============================================================ -->

        @if (!c.IsThisRolesTurn)
        {
            <section class="section-card">

                <header class="section-header">
                    <h2>Action blocked</h2>
                </header>

                <div class="detail-notes">

                    <div class="status-warning">

                        <i class="bi bi-lock-fill"></i>

                        <div>
                            <span>
                                @(c.BlockedReason ??
                                    "An earlier required approval on this claim is still pending.")
                            </span>
                        </div>

                    </div>

                </div>

            </section>
        }
        else
        {
            <section class="section-card">

                <header class="section-header">
                    <h2>Dean Decision</h2>
                    <span class="section-meta">Action required</span>
                </header>

                <div class="decision-actions" id="decisionActions">

                    <button type="button"
                            class="primary-button"
                            id="showApprovePanel">

                        <i class="bi bi-check-circle-fill"></i>
                        Approve Claim

                    </button>

                    <button type="button"
                            class="danger-outline-button"
                            id="showRejectPanel">

                        <i class="bi bi-x-circle"></i>
                        Reject Claim

                    </button>

                </div>

                <!-- Approve confirmation panel -->
                <div id="approvePanel"
                     class="confirm-panel"
                     style="display:none;">

                    <div class="confirm-panel-header">
                        <strong>Approve this claim?</strong>
                        <span>Your approval will be recorded and the claim will advance to the next stage.</span>
                    </div>

                    <form method="post"
                          asp-page-handler="Approve"
                          class="confirm-form">

                        <input type="hidden" asp-for="ClaimId" value="@c.ClaimId" />

                        <div class="confirm-actions">

                            <button type="button"
                                    id="cancelApprove"
                                    class="secondary-button">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="primary-button">
                                <i class="bi bi-check-circle-fill"></i>
                                Confirm approval
                            </button>

                        </div>

                    </form>

                </div>

                <!-- Reject panel -->
                <div id="rejectPanel"
                     class="confirm-panel confirm-panel--danger"
                     style="display:none;">

                    <div class="confirm-panel-header">
                        <strong>Reject Claim</strong>
                        <span>Provide a clear reason for the rejection.</span>
                    </div>

                    <form method="post"
                          asp-page-handler="Reject"
                          class="confirm-form">

                        <input type="hidden" asp-for="ClaimId" value="@c.ClaimId" />

                        <div class="form-group">
                            <label asp-for="RejectReason">
                                Rejection Reason <span>*</span>
                            </label>

                            <textarea asp-for="RejectReason"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Explain why this claim is being rejected…"
                                      required></textarea>
                        </div>

                        <div class="confirm-actions">

                            <button type="button"
                                    id="cancelReject"
                                    class="secondary-button">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="danger-button">
                                <i class="bi bi-x-circle"></i>
                                Confirm rejection
                            </button>

                        </div>

                    </form>

                </div>

            </section>
        }
    }

</section>

@section Scripts {
<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* ============================================================
           Decision panel toggles (approve + reject)
           Only one is open at a time.
           ============================================================ */

        const decisionActions = document.getElementById("decisionActions");
        const approvePanel = document.getElementById("approvePanel");
        const rejectPanel = document.getElementById("rejectPanel");

        const showApprovePanel = document.getElementById("showApprovePanel");
        const showRejectPanel = document.getElementById("showRejectPanel");
        const cancelApprove = document.getElementById("cancelApprove");
        const cancelReject = document.getElementById("cancelReject");

        function hideAllPanels() {
            if (approvePanel) approvePanel.style.display = "none";
            if (rejectPanel) rejectPanel.style.display = "none";
            if (decisionActions) decisionActions.style.display = "";
        }

        function showPanel(panel) {
            hideAllPanels();

            if (panel) {
                panel.style.display = "block";
                panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }

            if (decisionActions) {
                decisionActions.style.display = "none";
            }
        }

        if (showApprovePanel) {
            showApprovePanel.addEventListener("click", function () {
                showPanel(approvePanel);
            });
        }

        if (showRejectPanel) {
            showRejectPanel.addEventListener("click", function () {
                showPanel(rejectPanel);

                const textarea = document.getElementById("RejectReason");
                if (textarea) {
                    setTimeout(function () { textarea.focus(); }, 250);
                }
            });
        }

        if (cancelApprove) {
            cancelApprove.addEventListener("click", hideAllPanels);
        }

        if (cancelReject) {
            cancelReject.addEventListener("click", hideAllPanels);
        }

    });

</script>
}