@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.ClaimsModel

@{
    Layout = "~/Pages/Shared/DEAN/_DeanLayout.cshtml";
    ViewData["Title"] = "Claims";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/DEAN/claims.css"
          asp-append-version="true" />
}

<section class="claims-page">

    <header class="page-header">
        <div class="page-header-main">
            <h1>Claims</h1>
            <p>Review lecturer payment claims awaiting your approval.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <section class="section-card" id="claims-card">

        <header class="section-header">
            <h2>Awaiting your approval</h2>
            <span class="section-meta">
                @Model.PendingClaims.Count
                @(Model.PendingClaims.Count == 1 ? "claim" : "claims")
            </span>
        </header>

        @if (Model.PendingClaims.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-inbox"></i>
                </span>
                <h3>No claims awaiting your approval</h3>
                <p>
                    Everything assigned to you has been processed.
                    New claims will appear here once the previous
                    approver has finished their step.
                </p>
            </div>
        }
        else
        {
            <div class="toolbar">

                <form class="search-box"
                      role="search"
                      onsubmit="return false;">

                    <i class="bi bi-search" aria-hidden="true"></i>

                    <input type="search"
                           id="claimSearch"
                           placeholder="Search by claim, lecturer or contract…"
                           aria-label="Search claims"
                           autocomplete="off" />

                    <span class="search-hint" aria-hidden="true">Press /</span>

                </form>

            </div>

            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Claim</th>
                            <th>Lecturer</th>
                            <th>Contract</th>
                            <th class="col-right">Hours</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in Model.PendingClaims)
                        {
                            <tr class="claim-row"
                                data-search="CL@(row.ClaimId.ToString("D3")) @row.LecturerName C@(row.ContractId.ToString("D3"))">

                                <td>
                                    <span class="reference-pill">
                                        CL@(row.ClaimId.ToString("D3"))
                                    </span>
                                </td>

                                <td>
                                    <span class="lecturer-name">@row.LecturerName</span>
                                </td>

                                <td>
                                    <span class="contract-reference">
                                        C@(row.ContractId.ToString("D3"))
                                    </span>
                                </td>

                                <td class="col-right">
                                    <span class="hours-value">
                                        @row.HoursClaimed.ToString("N2")
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/DEAN/ClaimDetails"
                                       asp-route-claimId="@row.ClaimId"
                                       class="row-action row-action--primary">
                                        Review &amp; approve
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="table-empty" id="noResults" style="display:none;">
                <p>No claims match your search.</p>
            </div>
        }

    </section>

</section>

@section Scripts {
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input = document.getElementById("claimSearch");
        const noResults = document.getElementById("noResults");

        if (!input) return;

        const rows = Array.prototype.slice.call(
            document.querySelectorAll(".claim-row"));

        function apply() {

            const query = input.value.trim().toLowerCase();
            const terms = query.split(/\s+/).filter(Boolean);

            let shown = 0;

            rows.forEach(function (row) {

                const key = (row.dataset.search || "").toLowerCase();

                const match = terms.every(function (t) {
                    return key.indexOf(t) !== -1;
                });

                row.style.display = match ? "" : "none";

                if (match) shown++;
            });

            if (noResults) {
                noResults.style.display = shown === 0 ? "" : "none";
            }
        }

        input.addEventListener("input", apply);
        input.addEventListener("search", apply);

        // Press / to focus the search box.
        document.addEventListener("keydown", function (event) {

            const tag = (document.activeElement || {}).tagName || "";

            if (event.key === "/" &&
                !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) &&
                !event.ctrlKey && !event.metaKey && !event.altKey) {

                event.preventDefault();
                input.focus();
                input.select();
            }
        });

    });

</script>
}