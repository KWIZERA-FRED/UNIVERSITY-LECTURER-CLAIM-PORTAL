@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.ClaimsModel

@{
    ViewData["Title"] = "Claims";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Claims - Dean Portal</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <style>

            * { box-sizing: border-box; }

            :root {
                --primary: #0f2b4a;
                --accent: #2a7f5e;
                --accent-light: #e1f0e8;
                --bg: #f0f4fa;
                --card: #ffffff;
                --border: #dce4ed;
                --text: #1a2634;
                --text-muted: #4d6278;
                --radius: 16px;
                --shadow: 0 12px 30px -10px rgba(0,20,40,0.12);
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                background: var(--bg);
                color: var(--text);
            }

            .dean-app { min-height: 100vh; display: flex; flex-direction: column; }

            .app-header {
                height: 70px; background: var(--primary); color: white;
                padding: 0.9rem 2rem; display: flex; align-items: center;
                justify-content: space-between; border-bottom: 3px solid var(--accent);
            }

            .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; font-size: 1.2rem; }
            .brand i { color: #7bc9a0; font-size: 1.4rem; }

            .user-area { display: flex; align-items: center; gap: 1rem; }

            .role-badge { background: rgba(255,255,255,0.1); padding: 0.35rem 1rem; border-radius: 40px; font-size: 0.8rem; }

            .logout {
                color: white; text-decoration: none; font-size: 0.85rem;
                padding: 0.4rem 0.9rem; border: 1px solid rgba(255,255,255,0.25); border-radius: 30px;
            }
            .logout:hover { background: rgba(255,255,255,0.1); }

            .app-body { display: flex; flex: 1; }

            .sidebar {
                width: 230px; background: white; border-right: 1px solid var(--border);
                padding: 1.2rem 0; flex-shrink: 0; min-height: calc(100vh - 70px);
            }

            .sidebar-title {
                padding: 0 1.8rem 0.8rem; font-size: 0.7rem; text-transform: uppercase;
                letter-spacing: 0.8px; color: var(--text-muted); font-weight: 700;
            }

            .sidebar a {
                display: block; width: 100%; text-decoration: none; padding: 0.7rem 1.8rem;
                color: var(--text); font-size: 0.9rem; font-weight: 500;
                border-left: 3px solid transparent; transition: 0.2s ease;
            }
            .sidebar a i { width: 1.6rem; color: var(--text-muted); }
            .sidebar a:hover { background: var(--bg); }
            .sidebar a.active { background: var(--accent-light); border-left-color: var(--accent); color: var(--primary); font-weight: 600; }
            .sidebar a.active i { color: var(--accent); }

            .main { flex: 1; padding: 1.8rem 2rem 2rem; overflow-x: auto; }

            .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
            .page-header h1 { margin: 0; color: var(--primary); font-size: 1.6rem; }
            .page-header p { margin-top: 0.3rem; color: var(--text-muted); font-size: 0.85rem; }

            .card {
                background: white; border: 1px solid var(--border); border-radius: var(--radius);
                padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: var(--shadow);
            }
            .card h3 { font-size: 1rem; margin-bottom: 0.8rem; color: var(--primary); }
            .card h3 i { color: var(--accent); margin-right: 0.4rem; }

            .empty-state { padding: 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.85rem; }

            table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
            th { background: var(--primary); color: white; font-weight: 600; padding: 0.65rem 0.8rem; text-align: left; }
            td { padding: 0.65rem 0.8rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
            tr:hover td { background: #f8fafc; }

            .action-btn {
                background: var(--accent); color: white; border: none; padding: 0.4rem 1rem;
                border-radius: 40px; font-size: 0.75rem; font-weight: 600; cursor: pointer;
                text-decoration: none; display: inline-block;
            }
            .action-btn:hover { background: #1d6a4d; }

            .detail-row { display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
            .detail-item { min-width: 160px; }
            .detail-item label { display: block; font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.2rem; }
            .detail-item span { font-size: 0.95rem; font-weight: 600; color: var(--text); }

            .claim-description {
                white-space: pre-wrap; background: var(--bg); border: 1px solid var(--border);
                border-radius: 10px; padding: 1rem; font-size: 0.85rem; line-height: 1.6;
                margin-bottom: 1.3rem;
            }

            .blocked-notice {
                background: #fff3cd; border: 1px solid #ffe08a; color: #7a5b00;
                padding: 0.9rem 1rem; border-radius: 10px; font-size: 0.85rem; margin-bottom: 1.2rem;
            }

            .form-group { margin-bottom: 1rem; }
            .form-group label { display: block; margin-bottom: 0.4rem; font-size: 0.8rem; font-weight: 600; }
            textarea.form-control {
                width: 100%; padding: 0.7rem 0.9rem; border: 1px solid var(--border);
                border-radius: 9px; font-family: inherit; font-size: 0.85rem; resize: vertical; min-height: 70px;
            }

            .btn-row { display: flex; gap: 0.8rem; margin-top: 1rem; }

            .btn-approve {
                background: var(--accent); color: white; border: none; padding: 0.7rem 1.4rem;
                border-radius: 30px; font-size: 0.85rem; font-weight: 600; cursor: pointer;
            }
            .btn-approve:hover { background: #1d6a4d; }

            .btn-reject {
                background: white; color: #a33d3d; border: 1px solid #efcccc; padding: 0.7rem 1.4rem;
                border-radius: 30px; font-size: 0.85rem; font-weight: 600; cursor: pointer;
            }
            .btn-reject:hover { background: #fcecec; }

            .success-message, .error-message {
                margin-bottom: 1.2rem; padding: 0.9rem 1rem; border-radius: 10px; font-size: 0.85rem;
            }
            .success-message { background: #e1f0e8; border: 1px solid #cfe3d8; color: #275c46; }
            .error-message { background: #fdecec; border: 1px solid #f3caca; color: #9c3b3b; }

            @@media (max-width: 700px) {
                .app-body { flex-direction: column; }
                .sidebar { width: 100%; min-height: auto; border-right: none; border-bottom: 1px solid var(--border); }
                .main { padding: 1.2rem; }
            }

    </style>

</head>

<body>

    <div class="dean-app">

        <header class="app-header">
            <div class="brand"><i class="fas fa-university"></i><span>UNILAK · Staff Engagement</span></div>
            <div class="user-area">
                <span class="role-badge"><i class="fas fa-user-tie"></i> Dean</span>
                <a href="/Login" class="logout">Logout</a>
            </div>
        </header>

        <div class="app-body">

            <aside class="sidebar">
                <div class="sidebar-title">Dean Portal</div>
                <a href="/DEAN"><i class="fas fa-th-large"></i> Dashboard</a>
                <a href="/DEAN/RegisterUser"><i class="fas fa-user-plus"></i> Register New User</a>
                <a href="/DEAN/Contracts"><i class="fas fa-file-signature"></i> Contracts</a>
                <a href="/DEAN/Claims" class="active"><i class="fas fa-coins"></i> Claims</a>
            </aside>

            <main class="main">

                <div class="page-header">
                    <div>
                        <h1>Claims</h1>
                        <p>Review and approve lecturer payment claims awaiting your signature.</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="success-message">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="error-message">@Model.ErrorMessage</div>
                }

                @if (Model.SelectedClaim is not null)
                {
                    var c = Model.SelectedClaim;

                    <div class="card">

                        <h3><i class="fas fa-coins"></i> Claim CL@(c.ClaimId.ToString("D3"))</h3>

                        <div class="detail-row">
                            <div class="detail-item"><label>Lecturer</label><span>@c.LecturerName</span></div>
                            <div class="detail-item"><label>Contract</label><span>C@(c.ContractId.ToString("D3"))</span></div>
                            <div class="detail-item"><label>Hours Claimed</label><span>@c.HoursClaimed h</span></div>
                        </div>

                        <div class="claim-description">@c.Description</div>

                        <div class="detail-row" style="margin-top:1rem;">

                            <div class="detail-item">
                                <label>Contract</label>
                                @if (c.ContractSigned)
                                {
                                    <span><i class="fas fa-check-circle" style="color:var(--accent);"></i>
                                        Signed @(c.ContractSignedAtUtc?.ToString("dd MMM yyyy") ?? "")</span>
                                }
                                else
                                {
                                    <span><i class="fas fa-exclamation-triangle" style="color:#b45309;"></i> Not signed</span>
                                }
                                <br />
                                <a href="/Public/ClaimDocuments?token=@c.QrCodeToken" target="_blank">View contract</a>
                            </div>

                            <div class="detail-item">
                                <label>Claim letter</label>
                                <br />
                                <a href="/Public/ClaimDocuments?token=@c.QrCodeToken" target="_blank">View claim letter</a>
                            </div>

                            <div class="detail-item">
                                <label>Marks submission</label>
                                @if (c.MarksSigned)
                                {
                                    <span><i class="fas fa-check-circle" style="color:var(--accent);"></i>
                                        Signed by @c.MarksSignedByName
                                        @(c.MarksSignedAtUtc?.ToString("dd MMM yyyy") ?? "")</span>
                                    <br />
                                    <span style="color:var(--text-muted);font-size:0.85em;">@c.MarksReference</span>
                                    <br />
                                    <a asp-page-handler="DownloadMarks"
                                       asp-route-claimId="@c.ClaimId"
                                       asp-route-marksId="@c.MarksSubmissionId"
                                       target="_blank">Download marks file</a>
                                }
                                else
                                {
                                    <span><i class="fas fa-exclamation-triangle" style="color:#b45309;"></i>
                                        No signed marks submission found</span>
                                }
                            </div>

                        </div>

                        @if (!c.IsThisRolesTurn)
                        {
                            <div class="blocked-notice">
                                <i class="fas fa-lock"></i>
                                @c.BlockedReason
                            </div>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Approve">
                                <input type="hidden" asp-for="ClaimId" value="@c.ClaimId" />
                                <button type="submit" class="btn-approve">
                                    <i class="fas fa-check"></i> Approve Claim
                                </button>
                            </form>

                            <form method="post" asp-page-handler="Reject" style="margin-top:1rem;">
                                <input type="hidden" asp-for="ClaimId" value="@c.ClaimId" />
                                <div class="form-group">
                                    <label>Reason for rejecting (required if rejecting)</label>
                                    <textarea asp-for="RejectReason" class="form-control"
                                              placeholder="Explain why this claim is being rejected"></textarea>
                                </div>
                                <button type="submit" class="btn-reject">
                                    <i class="fas fa-times"></i> Reject Claim
                                </button>
                            </form>
                        }

                        <div class="btn-row">
                            <a href="/DEAN/Claims" class="action-btn" style="background:white;color:var(--text-muted);border:1px solid var(--border);">
                                Back to list
                            </a>
                        </div>

                    </div>
                }
                else
                {
                    <div class="card">

                        <h3><i class="fas fa-coins"></i> Claims Awaiting Your Signature</h3>

                        @if (Model.PendingClaims.Count == 0)
                        {
                            <div class="empty-state">No claims are currently awaiting your signature.</div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr><th>Claim ID</th><th>Lecturer</th><th>Contract</th><th>Hours</th><th>Action</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.PendingClaims)
                                    {
                                        <tr>
                                            <td><strong>CL@(row.ClaimId.ToString("D3"))</strong></td>
                                            <td>@row.LecturerName</td>
                                            <td>C@(row.ContractId.ToString("D3"))</td>
                                            <td>@row.HoursClaimed h</td>
                                            <td>
                                                <a href="/DEAN/Claims?claimId=@row.ClaimId" class="action-btn">Review</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                    </div>
                }

            </main>

        </div>

    </div>

</body>
</html>