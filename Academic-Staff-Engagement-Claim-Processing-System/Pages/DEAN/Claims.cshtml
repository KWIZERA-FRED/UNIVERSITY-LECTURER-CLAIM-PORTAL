@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.DEAN.ClaimsModel

@{
    ViewData["Title"] = "Claims";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Claims | UNILAK Staff Engagement</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/DEAN/claims.css"
          asp-append-version="true" />

</head>


<body>

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <header class="top-header">

        <div class="header-left">

            <button type="button"
                    class="mobile-menu-btn"
                    id="mobileMenuBtn"
                    aria-label="Open navigation menu">

                <i class="bi bi-list"></i>

            </button>


            <a asp-page="/DEAN/Index" class="brand">

                <div class="brand-logo">

                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo" />

                </div>


                <div class="brand-text">

                    <span class="brand-title">
                        UNILAK Staff Engagement
                    </span>

                    <span class="brand-subtitle">
                        Academic Staff Management Portal
                    </span>

                </div>

            </a>

        </div>


        <div class="header-right">

            <div class="user-info">

                <div class="user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="user-details">

                    <strong>
                        @(User.Identity?.Name ?? "Dean")
                    </strong>

                    <span>
                        Dean
                    </span>

                </div>

            </div>


            <a href="/Login" class="logout-btn">

                <i class="bi bi-box-arrow-right"></i>

                <span>
                    Logout
                </span>

            </a>

        </div>

    </header>


    <!-- ============================================================
         SIDEBAR
         ============================================================ -->

    <aside class="sidebar" id="sidebar">

        <div class="sidebar-header">

            <span class="sidebar-label">
                MAIN MENU
            </span>

        </div>


        <nav class="sidebar-nav">

            <a asp-page="/DEAN/Index"
               class="nav-item">

                <span class="nav-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </span>

                <span class="nav-text">
                    Dashboard
                </span>

            </a>


            <a asp-page="/DEAN/RegisterUser"
               class="nav-item">

                <span class="nav-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </span>

                <span class="nav-text">
                    Register New User
                </span>

            </a>


            <a asp-page="/DEAN/Contracts"
               class="nav-item">

                <span class="nav-icon">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </span>

                <span class="nav-text">
                    Contracts
                </span>

            </a>


            <a asp-page="/DEAN/Claims"
               class="nav-item active">

                <span class="nav-icon">
                    <i class="bi bi-cash-stack"></i>
                </span>

                <span class="nav-text">
                    Claims
                </span>

            </a>

        </nav>


        <div class="sidebar-footer">

            <div class="workflow-card">

                <div class="workflow-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div class="workflow-content">

                    <strong>
                        Approval Workflow
                    </strong>

                    <span>
                        Dean Review
                    </span>

                </div>

                <span class="status-dot"></span>

            </div>

        </div>

    </aside>


    <div class="sidebar-overlay"
         id="sidebarOverlay">
    </div>


    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

    <main class="main-content">


        <!-- PAGE HEADER -->

        <section class="page-header">

            <div>

                <div class="page-eyebrow">

                    <i class="bi bi-cash-stack"></i>

                    DEAN PORTAL

                </div>


                <h1>
                    Claims
                </h1>


                <p>
                    Review and approve lecturer payment claims awaiting
                    your signature.
                </p>

            </div>


            <div class="page-status">

                <span class="status-indicator"></span>

                Approval Workflow Active

            </div>

        </section>


        <!-- ========================================================
             SUCCESS MESSAGE
             ======================================================== -->

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success">

                <div class="alert-icon">

                    <i class="bi bi-check-circle-fill"></i>

                </div>


                <div class="alert-content">

                    <strong>
                        Success
                    </strong>

                    <span>
                        @Model.SuccessMessage
                    </span>

                </div>


                <button type="button"
                        class="alert-close"
                        onclick="this.parentElement.remove()">

                    <i class="bi bi-x"></i>

                </button>

            </div>
        }


        <!-- ========================================================
             ERROR MESSAGE
             ======================================================== -->

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">

                <div class="alert-icon">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                </div>


                <div class="alert-content">

                    <strong>
                        Action Failed
                    </strong>

                    <span>
                        @Model.ErrorMessage
                    </span>

                </div>


                <button type="button"
                        class="alert-close"
                        onclick="this.parentElement.remove()">

                    <i class="bi bi-x"></i>

                </button>

            </div>
        }


        <!-- ========================================================
             SELECTED CLAIM
             ======================================================== -->

        @if (Model.SelectedClaim is not null)
        {
            var c = Model.SelectedClaim;

            <section class="card claim-review-card">


                <!-- CARD HEADER -->

                <div class="card-header">

                    <div class="card-header-left">

                        <div class="section-icon">

                            <i class="bi bi-file-earmark-check-fill"></i>

                        </div>


                        <div>

                            <span class="section-eyebrow">
                                CLAIM REVIEW
                            </span>

                            <h2>
                                Claim #@c.ClaimId.ToString("D3")
                            </h2>

                        </div>

                    </div>


                    <div class="claim-status pending">

                        <span></span>

                        Pending Dean Approval

                    </div>

                </div>


                <!-- ==================================================
                     CLAIM SUMMARY
                     ================================================== -->

                <div class="claim-summary">


                    <div class="summary-item">

                        <span class="summary-label">
                            Lecturer
                        </span>

                        <strong>
                            @c.LecturerName
                        </strong>

                    </div>


                    <div class="summary-item">

                        <span class="summary-label">
                            Contract
                        </span>

                        <strong>
                            C@c.ContractId.ToString("D3")
                        </strong>

                    </div>


                    <div class="summary-item">

                        <span class="summary-label">
                            Hours Claimed
                        </span>

                        <strong>
                            @c.HoursClaimed.ToString("N2") h
                        </strong>

                    </div>


                    <div class="summary-item">

                        <span class="summary-label">
                            Approval Step
                        </span>

                        <strong>
                            Dean
                        </strong>

                    </div>

                </div>


                <!-- ==================================================
                     DESCRIPTION
                     ================================================== -->

                <div class="detail-section">

                    <div class="detail-heading">

                        <i class="bi bi-card-text"></i>

                        <h3>
                            Claim Description
                        </h3>

                    </div>


                    <div class="description-box">

                        @if (!string.IsNullOrWhiteSpace(c.Description))
                        {
                            <p>
                                @c.Description
                            </p>
                        }
                        else
                        {
                            <p class="muted-text">
                                No description was provided for this claim.
                            </p>
                        }

                    </div>

                </div>


                <!-- ==================================================
                     CONTRACT
                     ================================================== -->

                <div class="detail-section">

                    <div class="detail-heading">

                        <i class="bi bi-file-earmark-lock-fill"></i>

                        <h3>
                            Contract
                        </h3>

                    </div>


                    @if (c.ContractSigned)
                    {
                        <div class="status-information">

                            <div class="status-information-icon">

                                <i class="bi bi-check-circle-fill"></i>

                            </div>


                            <div>

                                <strong>
                                    Contract Signed
                                </strong>

                                <span>
                                    Signed
                                    @(c.ContractSignedAtUtc?.ToString("dd MMM yyyy") ?? "")
                                </span>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="blocked-panel">

                            <div class="blocked-icon">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                            </div>


                            <div class="blocked-content">

                                <strong>
                                    Contract Not Signed
                                </strong>

                                <p>
                                    The associated contract has not yet
                                    reached the ACTIVE status.
                                </p>

                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(c.QrCodeToken))
                    {
                        <div class="document-action">

                            <a href="/Public/ClaimDocuments?token=@c.QrCodeToken"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="document-btn">

                                <i class="bi bi-box-arrow-up-right"></i>

                                View Contract &amp; Claim Documents

                            </a>

                        </div>
                    }

                </div>


                <!-- ==================================================
                     CLAIM DOCUMENT
                     ================================================== -->

                <div class="detail-section">

                    <div class="detail-heading">

                        <i class="bi bi-envelope-paper-fill"></i>

                        <h3>
                            Claim Letter
                        </h3>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(c.QrCodeToken))
                    {
                        <div class="document-card">

                            <div class="document-icon">

                                <i class="bi bi-file-earmark-text-fill"></i>

                            </div>


                            <div class="document-info">

                                <strong>
                                    Claim Documents
                                </strong>

                                <span>
                                    Open the secure claim document
                                    package using the verification token.
                                </span>

                            </div>


                            <a href="/Public/ClaimDocuments?token=@c.QrCodeToken"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="document-btn">

                                <i class="bi bi-box-arrow-up-right"></i>

                                View

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="empty-document">

                            <i class="bi bi-file-earmark-x"></i>

                            <span>
                                No claim document token is available.
                            </span>

                        </div>
                    }

                </div>


                <!-- ==================================================
                     MARKS SUBMISSION
                     ================================================== -->

                <div class="detail-section">

                    <div class="detail-heading">

                        <i class="bi bi-file-earmark-spreadsheet-fill"></i>

                        <h3>
                            Marks Submission
                        </h3>

                    </div>


                    @if (c.MarksSigned && c.MarksSubmissionId.HasValue)
                    {
                        <div class="document-card">

                            <div class="document-icon spreadsheet">

                                <i class="bi bi-file-earmark-spreadsheet-fill"></i>

                            </div>


                            <div class="document-info">

                                <strong>
                                    @(c.MarksFileName ?? "Signed Marks Submission")
                                </strong>

                                <span>

                                    @if (!string.IsNullOrWhiteSpace(c.MarksSignedByName))
                                    {
                                        <text>
                                            Signed by @c.MarksSignedByName
                                        </text>
                                    }

                                    @if (c.MarksSignedAtUtc.HasValue)
                                    {
                                        <text>
                                            · @c.MarksSignedAtUtc.Value.ToString("dd MMM yyyy")
                                        </text>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(c.MarksReference))
                                    {
                                        <text>
                                            · @c.MarksReference
                                        </text>
                                    }

                                </span>

                            </div>


                            <a asp-page-handler="DownloadMarks"
                               asp-route-claimId="@c.ClaimId"
                               asp-route-marksId="@c.MarksSubmissionId.Value"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="document-btn">

                                <i class="bi bi-download"></i>

                                Download

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="empty-document">

                            <i class="bi bi-exclamation-triangle"></i>

                            <span>
                                No signed marks submission was found
                                for this claim.
                            </span>

                        </div>
                    }

                </div>


                <!-- ==================================================
                     APPROVAL WORKFLOW
                     ================================================== -->

                @if (!c.IsThisRolesTurn)
                {
                    <div class="blocked-panel">

                        <div class="blocked-icon">

                            <i class="bi bi-lock-fill"></i>

                        </div>


                        <div class="blocked-content">

                            <strong>
                                Dean Action Currently Blocked
                            </strong>

                            <p>
                                @(c.BlockedReason ??
                                    "An earlier required approval on this claim is still pending.")
                            </p>

                        </div>

                    </div>
                }
                else
                {
                    <div class="approval-panel">


                        <div class="approval-header">

                            <div class="approval-title">

                                <div class="approval-icon">

                                    <i class="bi bi-check2-square"></i>

                                </div>


                                <div>

                                    <span>
                                        DEAN DECISION
                                    </span>

                                    <h3>
                                        Review This Claim
                                    </h3>

                                </div>

                            </div>


                            <div class="approval-badge">
                                Action Required
                            </div>

                        </div>


                        <div class="approval-note">

                            <i class="bi bi-info-circle-fill"></i>

                            <p>
                                Review the lecturer, claimed hours,
                                contract status, claim documents and
                                signed marks submission before making
                                your decision.
                            </p>

                        </div>


                        <!-- APPROVE -->

                        <form method="post"
                              asp-page-handler="Approve"
                              class="approval-form">

                            <input type="hidden"
                                   asp-for="ClaimId"
                                   value="@c.ClaimId" />


                            <button type="submit"
                                    class="btn btn-approve"
                                    onclick="return confirm('Are you sure you want to approve this claim?');">

                                <i class="bi bi-check-circle-fill"></i>

                                Approve Claim

                            </button>

                        </form>


                        <!-- REJECT -->

                        <form method="post"
                              asp-page-handler="Reject"
                              class="reject-form">

                            <input type="hidden"
                                   asp-for="ClaimId"
                                   value="@c.ClaimId" />


                            <div class="reject-heading">

                                <i class="bi bi-exclamation-octagon-fill"></i>

                                <div>

                                    <strong>
                                        Reject Claim
                                    </strong>

                                    <span>
                                        A reason is required when rejecting
                                        this claim.
                                    </span>

                                </div>

                            </div>


                            <label asp-for="RejectReason">
                                Rejection Reason
                            </label>


                            <textarea asp-for="RejectReason"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Explain why this claim is being rejected..."
                                      required></textarea>


                            <button type="submit"
                                    class="btn btn-reject"
                                    onclick="return confirm('Are you sure you want to reject this claim?');">

                                <i class="bi bi-x-circle-fill"></i>

                                Reject Claim

                            </button>

                        </form>

                    </div>
                }


                <!-- BACK -->

                <div class="back-section">

                    <a asp-page="/DEAN/Claims"
                       class="back-btn">

                        <i class="bi bi-arrow-left"></i>

                        Back to Claims

                    </a>

                </div>

            </section>
        }
        else
        {
            <!-- ====================================================
                 PENDING CLAIMS LIST
                 ==================================================== -->

            <section class="card pending-claims-card">


                <div class="card-header">

                    <div class="card-header-left">

                        <div class="section-icon">

                            <i class="bi bi-hourglass-split"></i>

                        </div>


                        <div>

                            <span class="section-eyebrow">
                                PENDING WORK
                            </span>

                            <h2>
                                Claims Awaiting Your Signature
                            </h2>

                        </div>

                    </div>


                    <div class="claim-count">

                        <strong>
                            @Model.PendingClaims.Count
                        </strong>

                        <span>
                            Pending
                        </span>

                    </div>

                </div>


                @if (Model.PendingClaims.Count == 0)
                {
                    <div class="empty-state">

                        <div class="empty-state-icon">

                            <i class="bi bi-check2-circle"></i>

                        </div>


                        <h3>
                            No Pending Claims
                        </h3>


                        <p>
                            There are currently no claims awaiting
                            your signature.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-wrapper">

                        <table class="claims-table">

                            <thead>

                                <tr>

                                    <th>
                                        Claim
                                    </th>

                                    <th>
                                        Lecturer
                                    </th>

                                    <th>
                                        Contract
                                    </th>

                                    <th>
                                        Hours
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var row in Model.PendingClaims)
                                {
                                    <tr>


                                        <td>

                                            <div class="claim-reference">

                                                <div class="claim-table-icon">

                                                    <i class="bi bi-file-earmark-text-fill"></i>

                                                </div>


                                                <div>

                                                    <strong>
                                                        CL@row.ClaimId.ToString("D3")
                                                    </strong>

                                                    <span>
                                                        Claim
                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <td>

                                            <div class="lecturer-cell">

                                                <div class="lecturer-avatar">

                                                    <i class="bi bi-person-fill"></i>

                                                </div>


                                                <span>
                                                    @row.LecturerName
                                                </span>

                                            </div>

                                        </td>


                                        <td>

                                            <span class="contract-number">
                                                C@row.ContractId.ToString("D3")
                                            </span>

                                        </td>


                                        <td>

                                            <strong class="hours-value">
                                                @row.HoursClaimed.ToString("N2") h
                                            </strong>

                                        </td>


                                        <td>

                                            <a asp-page="/DEAN/Claims"
                                               asp-route-ClaimId="@row.ClaimId"
                                               class="review-btn">

                                                <span>
                                                    Review
                                                </span>

                                                <i class="bi bi-arrow-right"></i>

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }


        <!-- ========================================================
             FOOTER
             ======================================================== -->

        <footer class="page-footer">

            <div class="footer-brand">

                <strong>
                    UNILAK Portal
                </strong>

                <span>
                    Academic Staff Engagement &amp; Claim Processing System
                </span>

            </div>


            <div class="footer-copy">

                © @DateTime.Now.Year
                University of Lay Adventists of Kigali

            </div>

        </footer>


    </main>


    <!-- ============================================================
         JAVASCRIPT
         ============================================================ -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const mobileMenuBtn =
                document.getElementById("mobileMenuBtn");

            const sidebar =
                document.getElementById("sidebar");

            const sidebarOverlay =
                document.getElementById("sidebarOverlay");


            function openSidebar() {

                if (sidebar) {
                    sidebar.classList.add("mobile-open");
                }

                if (sidebarOverlay) {
                    sidebarOverlay.classList.add("active");
                }

                document.body.classList.add("menu-open");
            }


            function closeSidebar() {

                if (sidebar) {
                    sidebar.classList.remove("mobile-open");
                }

                if (sidebarOverlay) {
                    sidebarOverlay.classList.remove("active");
                }

                document.body.classList.remove("menu-open");
            }


            if (mobileMenuBtn) {

                mobileMenuBtn.addEventListener(
                    "click",
                    function () {

                        if (
                            sidebar &&
                            sidebar.classList.contains("mobile-open")
                        ) {
                            closeSidebar();
                        }
                        else {
                            openSidebar();
                        }

                    }
                );

            }


            if (sidebarOverlay) {

                sidebarOverlay.addEventListener(
                    "click",
                    closeSidebar
                );

            }


            document
                .querySelectorAll(".sidebar-nav .nav-item")
                .forEach(function (item) {

                    item.addEventListener(
                        "click",
                        function () {

                            if (window.innerWidth <= 900) {
                                closeSidebar();
                            }

                        }
                    );

                });


            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {
                        closeSidebar();
                    }

                }
            );


            window.addEventListener(
                "resize",
                function () {

                    if (window.innerWidth > 900) {
                        closeSidebar();
                    }

                }
            );

        });

    </script>

</body>

</html>