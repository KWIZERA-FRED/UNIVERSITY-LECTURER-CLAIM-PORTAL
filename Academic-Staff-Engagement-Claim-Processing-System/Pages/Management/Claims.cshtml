@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Management.ClaimsModel
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Claims";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Management/Claims.css" asp-append-version="true" />
}

<div class="claims-page">

    <div class="page-header">
        <div>
            <div class="page-title-row">
                <div class="page-icon">
                    <i class="bi bi-file-earmark-check"></i>
                </div>

                <div>
                    <h1>Claims</h1>
                    <p>
                        Review and process lecturer payment claims
                        awaiting your approval.
                    </p>
                </div>
            </div>
        </div>

        <a asp-page="/ManagementDashboard" class="back-dashboard">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Dashboard</span>
        </a>
    </div>

    <div class="approval-stage">
        <div class="stage-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div>
            <strong>@Model.RoleLabel Approval Stage</strong>
            <span>
                Claims displayed here are awaiting your review and decision.
            </span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-error" role="alert">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (Model.SelectedClaim is not null)
    {
        var claim = Model.SelectedClaim;

        <section class="content-card claim-review-card">

            <div class="card-header">
                <div>
                    <div class="card-title">
                        <i class="bi bi-file-earmark-text"></i>
                        Claim CL@(claim.ClaimId.ToString("D3"))
                    </div>

                    <div class="card-subtitle">
                        Lecturer payment claim
                    </div>
                </div>

                <span class="review-badge">
                    <i class="bi bi-hourglass-split"></i>
                    @Model.RoleLabel Review
                </span>
            </div>

            <div class="claim-details">

                <div class="detail-item">
                    <span class="detail-label">Lecturer</span>
                    <strong>@claim.LecturerName</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Contract</span>
                    <strong>C@(claim.ContractId.ToString("D3"))</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Hours Claimed</span>
                    <strong>@claim.HoursClaimed h</strong>
                </div>

            </div>

            <div class="description-section">
                <span class="detail-label">Claim Description</span>

                <div class="claim-description">
                    @if (string.IsNullOrWhiteSpace(claim.Description))
                    {
                        <span class="muted-text">
                            No description was provided.
                        </span>
                    }
                    else
                    {
                        @claim.Description
                    }
                </div>
            </div>

            @if (!claim.IsThisRolesTurn)
            {
                <div class="blocked-notice">
                    <div class="blocked-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <div>
                        <strong>Approval not available</strong>
                        <span>@claim.BlockedReason</span>
                    </div>
                </div>
            }
            else
            {
                <div class="decision-section">

                    <div class="decision-heading">
                        <div>
                            <h3>Approval Decision</h3>
                            <p>
                                Review the claim information before making
                                your decision.
                            </p>
                        </div>
                    </div>

                    <div class="decision-actions">

                        <form method="post"
                              asp-page-handler="Approve"
                              class="approve-form">

                            <input type="hidden"
                                   asp-for="ClaimId"
                                   value="@claim.ClaimId" />

                            <button type="submit"
                                    class="btn btn-approve">
                                <i class="bi bi-check-lg"></i>
                                Approve Claim
                            </button>
                        </form>

                        <div class="reject-panel">

                            <form method="post"
                                  asp-page-handler="Reject">

                                <input type="hidden"
                                       asp-for="ClaimId"
                                       value="@claim.ClaimId" />

                                <div class="form-group">
                                    <label asp-for="RejectReason">
                                        Rejection Reason
                                    </label>

                                    <textarea asp-for="RejectReason"
                                              class="form-control"
                                              maxlength="2000"
                                              placeholder="Explain why this claim is being rejected..."></textarea>

                                    <div class="field-hint">
                                        A reason is required when rejecting
                                        a claim.
                                    </div>
                                </div>

                                <button type="submit"
                                        class="btn btn-reject">
                                    <i class="bi bi-x-lg"></i>
                                    Reject Claim
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

            <div class="card-footer">
                <a asp-page="/Management/Claims"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Claims
                </a>
            </div>

        </section>
    }
    else
    {
        <section class="content-card">

            <div class="card-header">
                <div>
                    <div class="card-title">
                        <i class="bi bi-file-earmark-check"></i>
                        Claims Awaiting Your Approval
                    </div>

                    <div class="card-subtitle">
                        Claims currently assigned to the
                        @Model.RoleLabel approval stage.
                    </div>
                </div>

                <span class="count-badge">
                    @Model.PendingClaims.Count
                </span>
            </div>

            @if (Model.PendingClaims.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <h3>No claims awaiting approval</h3>

                    <p>
                        There are currently no lecturer claims assigned
                        to your approval stage.
                    </p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="claims-table">
                        <thead>
                            <tr>
                                <th>Claim</th>
                                <th>Lecturer</th>
                                <th>Contract</th>
                                <th>Hours</th>
                                <th class="action-column">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in Model.PendingClaims)
                            {
                                <tr>
                                    <td>
                                        <span class="claim-reference">
                                            CL@(row.ClaimId.ToString("D3"))
                                        </span>
                                    </td>

                                    <td>
                                        <span class="lecturer-name">
                                            @row.LecturerName
                                        </span>
                                    </td>

                                    <td>
                                        C@(row.ContractId.ToString("D3"))
                                    </td>

                                    <td>
                                        <span class="hours-value">
                                            @row.HoursClaimed h
                                        </span>
                                    </td>

                                    <td class="action-column">
                                        <a asp-page="/Management/Claims"
                                           asp-route-ClaimId="@row.ClaimId"
                                           class="btn btn-review">
                                            <i class="bi bi-eye"></i>
                                            Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </section>
    }

</div>