@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Management.MarksModel

@{
Layout = null;
ViewData["Title"] = "Marks Review";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Marks Review · Management Portal</title>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<link rel="stylesheet"
      href="~/css/Management/layout.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/Management/dashboard.css"
      asp-append-version="true" />

</head>

<body>

<div class="management-app">

    <header class="top-navbar">

        <div class="navbar-left">

            <div class="brand">

                <div class="brand-logo">
                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK" />
                </div>

                <div class="brand-text">

                    <span class="brand-title">UNILAK</span>

                    <span class="brand-subtitle">
                        Staff Engagement Portal
                    </span>

                </div>

            </div>

        </div>

        <div class="navbar-right">

            <div class="navbar-user">

                <div class="user-avatar">
                    <i class="fas fa-file-signature"></i>
                </div>

                <div class="user-details">

                    <span class="user-name">
                        Exam Office
                    </span>

                    <span class="user-role">
                        Management
                    </span>

                </div>

            </div>

            <form method="post"
                  action="/Logout"
                  class="logout-form">

                <button type="submit"
                        class="logout-button">

                    <i class="fas fa-right-from-bracket"></i>

                    <span>Logout</span>

                </button>

            </form>

        </div>

    </header>


    <div class="app-body">

        <aside class="sidebar">

            <div class="sidebar-content">

                <nav class="sidebar-navigation">

                    <span class="navigation-heading">
                        Management
                    </span>

                    <a href="/ManagementDashboard"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fas fa-chart-line"></i>
                        </span>

                        <span class="sidebar-label">
                            Dashboard
                        </span>

                    </a>

                    <a href="/Management/Contracts"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fas fa-file-signature"></i>
                        </span>

                        <span class="sidebar-label">
                            Contracts
                        </span>

                    </a>

                    <a href="/Management/Marks"
                       class="sidebar-link active">

                        <span class="sidebar-icon">
                            <i class="fas fa-file-excel"></i>
                        </span>

                        <span class="sidebar-label">
                            Marks Review
                        </span>

                    </a>

                </nav>


                <div class="sidebar-profile">

                    <div class="profile-icon">
                        <i class="fas fa-shield-halved"></i>
                    </div>

                    <div class="profile-content">

                        <span class="profile-title">
                            Exam Office
                        </span>

                        <span class="profile-text">
                            Marks verification and signing
                        </span>

                    </div>

                </div>

            </div>

        </aside>


        <main class="main-content">

            <div class="management-dashboard">

                <div class="dashboard-header">

                    <div class="dashboard-heading">

                        <span class="page-eyebrow">
                            EXAMINATION OFFICE
                        </span>

                        <h1>
                            Marks Review
                        </h1>

                        <p>
                            Review submitted marks sheets before signing
                            them for claim processing.
                        </p>

                    </div>

                    <a href="/ManagementDashboard"
                       class="primary-action">

                        <i class="fas fa-arrow-left"></i>

                        Dashboard

                    </a>

                </div>


                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="marks-message marks-message-success">

                        <i class="fas fa-circle-check"></i>

                        <span>
                            @Model.SuccessMessage
                        </span>

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="marks-message marks-message-error">

                        <i class="fas fa-circle-exclamation"></i>

                        <span>
                            @Model.ErrorMessage
                        </span>

                    </div>
                }


                @if (Model.SelectedSubmission != null)
                {
                    <section class="dashboard-card marks-review-card">

                        <div class="card-header">

                            <div>

                                <span class="section-eyebrow">
                                    SUBMISSION REVIEW
                                </span>

                                <h2>
                                    @Model.SelectedSubmission.Reference
                                </h2>

                                <p>
                                    Review the submitted marks sheet before
                                    signing it.
                                </p>

                            </div>

                            <span class="stage-badge">

                                <i class="fas fa-clock"></i>

                                Pending Review

                            </span>

                        </div>


                        <div class="marks-information">

                            <div class="marks-information-item">

                                <span>
                                    Lecturer
                                </span>

                                <strong>
                                    @Model.SelectedSubmission.LecturerName
                                </strong>

                            </div>


                            <div class="marks-information-item">

                                <span>
                                    Course
                                </span>

                                <strong>
                                    @Model.SelectedSubmission.CourseTitle
                                </strong>

                            </div>


                            <div class="marks-information-item">

                                <span>
                                    Marks File
                                </span>

                                <strong class="marks-file-name">

                                    <i class="fas fa-file-excel"></i>

                                    @Model.SelectedSubmission.FileName

                                </strong>

                            </div>

                        </div>


                        <div class="marks-action-row">

                            <a asp-page-handler="Download"
                               asp-route-submissionId="@Model.SelectedSubmission.Id"
                               class="review-button">

                                <i class="fas fa-download"></i>

                                Download Marks Sheet

                            </a>


                            <form method="post"
                                  asp-page-handler="Approve">

                                <input type="hidden"
                                       name="SubmissionId"
                                       value="@Model.SelectedSubmission.Id" />

                                <button type="submit"
                                        class="review-button">

                                    <i class="fas fa-file-signature"></i>

                                    Sign Marks

                                </button>

                            </form>

                        </div>


                        <div class="marks-decline">

                            <div class="marks-decline-heading">

                                <span class="section-eyebrow">
                                    CORRECTION REQUIRED
                                </span>

                                <h3>
                                    Decline Submission
                                </h3>

                                <p>
                                    If the marks sheet contains errors,
                                    provide a reason before declining it.
                                </p>

                            </div>


                            <form method="post"
                                  asp-page-handler="Decline">

                                <input type="hidden"
                                       name="SubmissionId"
                                       value="@Model.SelectedSubmission.Id" />

                                <div class="marks-form-group">

                                    <label asp-for="DeclineReason">
                                        Reason for declining
                                    </label>

                                    <textarea asp-for="DeclineReason"
                                              class="marks-textarea"
                                              placeholder="Explain what needs to be corrected"></textarea>

                                    <small>
                                        A reason is required when declining
                                        a marks submission.
                                    </small>

                                </div>

                                <button type="submit"
                                        class="marks-decline-button">

                                    <i class="fas fa-times"></i>

                                    Decline Submission

                                </button>

                            </form>

                        </div>


                        <div class="marks-card-footer">

                            <a href="/Management/Marks"
                               class="section-link">

                                <i class="fas fa-arrow-left"></i>

                                Back to Marks List

                            </a>

                        </div>

                    </section>
                }
                else
                {
                    <section class="dashboard-card contracts-card">

                        <div class="card-header">

                            <div>

                                <span class="section-eyebrow">
                                    EXAMINATION OFFICE
                                </span>

                                <h2>
                                    Marks Awaiting Review
                                </h2>

                                <p>
                                    Marks submissions waiting for Exam
                                    Office verification and signing.
                                </p>

                            </div>

                        </div>


                        @if (Model.PendingSubmissions.Count == 0)
                        {
                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fas fa-folder-open"></i>

                                </div>

                                <h3>
                                    No pending marks submissions
                                </h3>

                                <p>
                                    There are currently no marks sheets
                                    awaiting Exam Office review.
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="table-wrapper">

                                <table class="contracts-table">

                                    <thead>

                                        <tr>

                                            <th>Reference</th>

                                            <th>Lecturer</th>

                                            <th>Course</th>

                                            <th>Academic Year</th>

                                            <th>Submitted</th>

                                            <th>Action</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var row in Model.PendingSubmissions)
                                        {
                                            <tr>

                                                <td>

                                                    <div class="contract-reference">

                                                        <span class="contract-icon">

                                                            <i class="fas fa-file-excel"></i>

                                                        </span>

                                                        <div>

                                                            <strong>
                                                                @row.Reference
                                                            </strong>

                                                            <span>
                                                                Marks submission
                                                            </span>

                                                        </div>

                                                    </div>

                                                </td>

                                                <td>

                                                    <span class="lecturer-name">
                                                        @row.LecturerName
                                                    </span>

                                                </td>

                                                <td>

                                                    <span class="course-name">
                                                        @row.CourseTitle
                                                    </span>

                                                </td>

                                                <td>
                                                    @row.AcademicYear
                                                </td>

                                                <td>
                                                    @row.SubmittedAtUtc.ToString("dd MMM yyyy")
                                                </td>

                                                <td>

                                                    <a href="/Management/Marks?submissionId=@row.Id"
                                                       class="review-button">

                                                        <i class="fas fa-eye"></i>

                                                        Review

                                                    </a>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </section>
                }

            </div>

        </main>

    </div>

</div>

</body>
</html>
