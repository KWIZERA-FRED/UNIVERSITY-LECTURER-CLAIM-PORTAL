@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Management.ManagementDashboardModel

@{
    Layout = "~/Pages/Shared/Management/_ManagementLayout.cshtml";
    ViewData["Title"] = "Management Dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Management/dashboard.css"
          asp-append-version="true" />
}

<section class="management-dashboard">

    <header class="page-header">

        <div class="page-header-main">
            <h1>Contract Management</h1>
            <p>Review and manage lecturer contracts assigned to your role.</p>
        </div>

        <a asp-page="/Management/Contracts" class="primary-button">
            <i class="bi bi-file-earmark-check-fill"></i>
            Review Contracts
        </a>

    </header>

    <section class="stats-grid">

        <a asp-page="/Management/Contracts" class="stat-card">
            <div class="stat-icon stat-icon-orange">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-value">@Model.PendingContractCount</div>
            <span class="stat-label">Awaiting My Signature</span>
        </a>

        <a asp-page="/Management/Contracts" class="stat-card">
            <div class="stat-icon stat-icon-green">
                <i class="bi bi-patch-check-fill"></i>
            </div>
            <div class="stat-value">@Model.MySignedContractCount</div>
            <span class="stat-label">Contracts I Have Signed</span>
        </a>

        <a asp-page="/Management/Contracts" class="stat-card">
            <div class="stat-icon stat-icon-blue">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <div class="stat-value">@Model.InSigningProcessCount</div>
            <span class="stat-label">Contracts in Progress</span>
        </a>

        <a asp-page="/Management/Contracts" class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-value">@Model.ActiveContractsCount</div>
            <span class="stat-label">Active Contracts</span>
        </a>

    </section>

    <section class="section-card">

        <header class="section-header">
            <h2>Contracts Awaiting My Signature</h2>
            <a asp-page="/Management/Contracts" class="section-link">View all</a>
        </header>

        @if (Model.PendingContracts.Count == 0)
        {
            <div class="empty-state">
                <p>No contracts awaiting your signature.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Lecturer</th>
                            <th>Department</th>
                            <th>Course</th>
                            <th class="col-right">Hours</th>
                            <th>Stage</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var contract in Model.PendingContracts)
                        {
                            <tr>
                                <td>
                                    <span class="reference-pill">
                                        C@(contract.ContractId.ToString("D3"))
                                    </span>
                                </td>

                                <td>
                                    <span class="lecturer-name">@contract.LecturerName</span>
                                </td>

                                <td>@contract.Department</td>

                                <td>
                                    <span class="course-title">@contract.CourseTitle</span>
                                </td>

                                <td class="col-right">
                                    <span class="hours-value">
                                        @contract.AllocatedHours.ToString("0.##")
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge status-pending">
                                        @contract.CurrentStage
                                    </span>
                                </td>

                                <td class="col-action">
                                    <a asp-page="/Management/Contracts"
                                       asp-route-contractId="@contract.ContractId"
                                       class="gray-button">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </section>

</section>