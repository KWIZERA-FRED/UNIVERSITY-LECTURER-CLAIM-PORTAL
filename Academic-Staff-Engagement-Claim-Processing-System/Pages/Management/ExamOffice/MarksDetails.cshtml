@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Management.ExamOffice.MarkDetailsModel

@{
    ViewData["Title"] = "Mark Details";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap">

    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/MANAGEMENT/marks.css"
          asp-append-version="true" />
}

<section class="mark-details-page">

    @* ---------------- Header ---------------- *@

    <header class="page-header">
        <div class="page-header-main">

            <a asp-page="/Management/ExamOffice/Marks"
               class="back-link">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Back to Marks Review</span>
            </a>

            <h1>Mark Details</h1>

            <p>Review the submitted marks sheet before signing it for claim processing.</p>

        </div>
    </header>


    @* ---------------- Alerts ---------------- *@

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error" role="alert">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }


    @if (Model.SelectedSubmission is not null)
    {
        var rawReference   = Model.SelectedSubmission.Reference ?? string.Empty;
        var displayReference = rawReference.Length > 24
            ? rawReference.Substring(0, 21) + "…"
            : rawReference;

        @* ---------------- Submission information ---------------- *@

        <section class="section-card section-card--branded">

            <header class="section-header">
                <div>
                    <h2>Submission Information</h2>
                    <p>Verify the submitted marks before signing.</p>
                </div>

                <span class="reference-pill" title="@rawReference">
                    @displayReference
                </span>
            </header>

            <div class="details-grid">

                <div class="detail-item">
                    <span class="detail-label">Lecturer</span>
                    <strong>@Model.SelectedSubmission.LecturerName</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Course</span>
                    <strong>@Model.SelectedSubmission.CourseTitle</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">File</span>
                    <strong>@Model.SelectedSubmission.FileName</strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Status</span>
                    <span class="status-badge status-pending">
                        Pending Review
                    </span>
                </div>

            </div>

        </section>


        @* ---------------- Marks sheet file ---------------- *@

        <section class="section-card">

            <header class="section-header">
                <div>
                    <h2>Marks Sheet</h2>
                    <p>Download and verify the submitted marks sheet.</p>
                </div>
            </header>

            <div class="file-panel">

                <div class="file-icon" aria-hidden="true">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                </div>

                <div class="file-information">
                    <strong>@Model.SelectedSubmission.FileName</strong>
                    <span>Submitted marks sheet</span>
                </div>

                <div class="file-panel-actions">
                    <a asp-page-handler="Download"
                       asp-route-submissionId="@Model.SelectedSubmission.Id"
                       class="gray-button">
                        <i class="bi bi-download" aria-hidden="true"></i>
                        Download Marks
                    </a>
                </div>

            </div>

        </section>


        @* ---------------- Verification + actions ---------------- *@

        <section class="section-card">

            <header class="section-header">
                <div>
                    <h2>Verification</h2>
                    <p>Confirm both items before signing the marks submission.</p>
                </div>
            </header>

            <form method="post" id="markDetailsForm">

                <input type="hidden" asp-for="SubmissionId" />

                <div class="verification-list">

                    <label class="verification-item">
                        <input type="checkbox"
                               asp-for="ScriptsMatchPhysical"
                               data-verify="required" />

                        <span class="verification-content">
                            <strong>Scripts match physical scripts</strong>
                            <small>
                                I confirm that the submitted marks correspond
                                to the physical examination scripts.
                            </small>
                        </span>
                    </label>

                    <label class="verification-item">
                        <input type="checkbox"
                               asp-for="StudentCountMatches"
                               data-verify="required" />

                        <span class="verification-content">
                            <strong>Student count matches</strong>
                            <small>
                                I confirm that the number of students on the
                                marks sheet matches the verified student count.
                            </small>
                        </span>
                    </label>

                </div>

                <div class="action-area">

                    <button type="submit"
                            asp-page-handler="Approve"
                            class="primary-button"
                            id="signMarksButton"
                            formnovalidate
                            disabled>
                        <i class="bi bi-pen-fill" aria-hidden="true"></i>
                        Sign Marks
                    </button>

                    <button type="button"
                            class="danger-button"
                            aria-controls="declinePanel"
                            aria-expanded="false"
                            onclick="toggleDecline(this)">
                        <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                        Decline
                    </button>

                </div>

                <div id="declinePanel"
                     class="decline-panel">

                    <label asp-for="DeclineReason">
                        Reason for declining
                    </label>

                    <textarea asp-for="DeclineReason"
                              rows="4"
                              required
                              minlength="10"
                              placeholder="Enter the reason for declining this marks submission…"></textarea>

                    <div class="decline-actions">
                        <button type="submit"
                                asp-page-handler="Decline"
                                class="danger-button">
                            <i class="bi bi-x-circle" aria-hidden="true"></i>
                            Confirm Decline
                        </button>
                    </div>

                </div>

            </form>

        </section>
    }
    else
    {
        @* ---------------- Empty state ---------------- *@

        <section class="section-card">

            <div class="empty-state">

                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-file-earmark-x"></i>
                </span>

                <h3>Submission unavailable</h3>

                <p>
                    The selected marks submission could not be found,
                    or it has already been reviewed.
                </p>

                <a asp-page="/Management/ExamOffice/Marks"
                   class="primary-button">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Back to Marks Review
                </a>

            </div>

        </section>
    }

</section>


@section Scripts {
    <script>

        (function () {

            /* ---- Gate the Sign button on the two verification checkboxes ---- */

            var form     = document.getElementById("markDetailsForm");
            var signBtn  = document.getElementById("signMarksButton");

            if (form && signBtn) {

                var checks = form.querySelectorAll('input[data-verify="required"]');

                function refresh() {

                    var allChecked = Array.prototype.every.call(
                        checks,
                        function (c) { return c.checked; });

                    signBtn.disabled = !allChecked;
                }

                checks.forEach(function (c) {
                    c.addEventListener("change", refresh);
                });

                refresh();
            }

            /* ---- Decline panel toggle (ARIA-aware) ---- */

            window.toggleDecline = function (btn) {

                var panel = document.getElementById("declinePanel");

                if (!panel) return;

                var visible = panel.classList.toggle("is-visible");

                btn.setAttribute("aria-expanded", visible ? "true" : "false");

                if (visible) {
                    var ta = panel.querySelector("textarea");
                    if (ta) ta.focus();
                }
            };

        })();

    </script>
}