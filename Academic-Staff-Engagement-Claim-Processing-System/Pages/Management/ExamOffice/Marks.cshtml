@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Management.ExamOffice.MarksModel

@{
    ViewData["Title"] = "Marks Review";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Management/dashboard.css"
          asp-append-version="true" />
}

<section class="management-dashboard">

    <header class="page-header">
        <div class="page-header-main">
            <h1>Marks Review</h1>
            <p>Review submitted marks sheets before signing them for claim processing.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="page-alert page-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="page-alert page-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <section class="section-card">

        <header class="section-header">
            <h2>Marks Awaiting Review</h2>

            <span class="section-meta">
                @Model.PendingSubmissions.Count
                @(Model.PendingSubmissions.Count == 1
                    ? "submission"
                    : "submissions")
            </span>
        </header>

        @if (Model.PendingSubmissions.Count == 0)
        {
            <div class="empty-state">
                <p>No marks sheets awaiting review.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Lecturer</th>
                            <th>Course</th>
                            <th>Academic Year</th>
                            <th>Submitted</th>
                            <th class="col-action"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in Model.PendingSubmissions)
                        {
                            <tr>
                                <td>
                                    <span class="reference-pill">
                                        @row.Reference
                                    </span>
                                </td>

                                <td>
                                    <span class="lecturer-name">
                                        @row.LecturerName
                                    </span>
                                </td>

                                <td>
                                    <span class="course-title">
                                        @row.CourseTitle
                                    </span>
                                </td>

                                <td>
                                    @row.AcademicYear
                                </td>

                                <td>
                                    @row.SubmittedAtUtc.ToString("dd MMM yyyy")
                                </td>

                                <td class="col-action">

                                    <a href="@Url.Page(
                                        "/Management/ExamOffice/MarksDetails",
                                        new { submissionId = row.Id })"
                                       class="gray-button">

                                        <i class="bi bi-eye-fill"></i>
                                        Review

                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </section>

</section>