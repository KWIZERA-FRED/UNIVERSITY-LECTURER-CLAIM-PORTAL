@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.Management.ContractsModel

@{
    ViewData["Title"] = "Contracts";
}

@section Styles {
    <link
        rel="stylesheet"
        href="~/css/MANAGEMENT/contracts.css"
        asp-append-version="true" />
}

<section class="contracts-page">

    <header class="contracts-page-header">

        <div class="contracts-heading">

            <div class="contracts-heading-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>

            <span class="page-eyebrow">
                MANAGEMENT PORTAL
            </span>

            <h1>
                Contracts
            </h1>

            <p>
                Review and complete lecturer contract signing actions assigned to your role.
            </p>

        </div>

        <a
            asp-page="/ManagementDashboard"
            class="contracts-back-button">

            <i class="bi bi-arrow-left"></i>

            <span>
                Back to Dashboard
            </span>

        </a>

    </header>


    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="contract-alert contract-alert-success">

            <span class="contract-alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </span>

            <span>
                @Model.SuccessMessage
            </span>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="contract-alert contract-alert-error">

            <span class="contract-alert-icon">
                <i class="bi bi-exclamation-circle-fill"></i>
            </span>

            <span>
                @Model.ErrorMessage
            </span>

        </div>
    }


    @if (Model.SelectedContract is not null)
    {
        var contract = Model.SelectedContract;

        <section class="selected-contract">

            <header class="selected-contract-header">

                <div class="contract-reference">

                    <span class="reference-label">
                        Contract Reference
                    </span>

                    <span class="reference-number">
                        CON-@contract.ContractId.ToString("D6")
                    </span>

                    <div class="selected-contract-meta">

                        <span>
                            <i class="bi bi-person-fill"></i>
                            @contract.LecturerName
                        </span>

                        <span>
                            <i class="bi bi-book-fill"></i>
                            @contract.CourseTitle
                        </span>

                    </div>

                </div>


                @if (contract.IsThisRolesTurn)
                {
                    <span class="contract-status status-pending">

                        <span class="status-dot"></span>

                        Awaiting Your Action

                    </span>
                }
                else
                {
                    <span class="contract-status status-closed">

                        <span class="status-dot"></span>

                        Awaiting Another Signer

                    </span>
                }

            </header>


            <div class="contract-detail-grid">

                <div class="contract-detail-item">

                    <span class="detail-label">
                        Lecturer
                    </span>

                    <span class="detail-value">
                        @contract.LecturerName
                    </span>

                </div>


                <div class="contract-detail-item">

                    <span class="detail-label">
                        Department
                    </span>

                    <span class="detail-value">
                        @contract.Department
                    </span>

                </div>


                <div class="contract-detail-item">

                    <span class="detail-label">
                        Course
                    </span>

                    <span class="detail-value">
                        @contract.CourseTitle
                    </span>

                </div>


                <div class="contract-detail-item">

                    <span class="detail-label">
                        Allocated Hours
                    </span>

                    <span class="detail-value">
                        @contract.AllocatedHours.ToString("0.##") hrs
                    </span>

                </div>


                <div class="contract-detail-item">

                    <span class="detail-label">
                        Signing Role
                    </span>

                    <span class="detail-value">
                        @Model.RoleLabel
                    </span>

                </div>

            </div>


            <section class="contract-section">

                <div class="section-heading">

                    <div class="section-heading-icon">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>

                    <div>

                        <h2>
                            Contract Document
                        </h2>

                        <p>
                            Review the contract terms before taking action.
                        </p>

                    </div>

                </div>


                <div class="contract-document">
                    @Html.Raw(contract.ContractContent)
                </div>

            </section>


            @if (!contract.IsThisRolesTurn)
            {
                <div class="blocked-notice">

                    <div class="blocked-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <div>

                        <strong>
                            Action unavailable
                        </strong>

                        <span>
                            @contract.BlockedReason
                        </span>

                    </div>

                </div>
            }


            @if (contract.IsThisRolesTurn)
            {
                <section class="contract-actions">

                    <div class="contract-action-information">

                        <strong>
                            Your action is required
                        </strong>

                        <span>
                            Review the contract carefully before signing or declining it.
                        </span>

                    </div>


                    <div class="contract-action-buttons">

                        <form
                            method="post"
                            asp-page-handler="Sign">

                            <input
                                type="hidden"
                                asp-for="ContractId"
                                value="@contract.ContractId" />

                            <button
                                type="submit"
                                class="sign-contract-button">

                                <i class="bi bi-pen-fill"></i>

                                Sign Contract

                            </button>

                        </form>

                    </div>

                </section>


                <section class="decline-section">

                    <div class="section-heading">

                        <div class="section-heading-icon decline-icon">
                            <i class="bi bi-x-circle-fill"></i>
                        </div>

                        <div>

                            <h2>
                                Decline Contract
                            </h2>

                            <p>
                                Provide a reason if the contract cannot be approved.
                            </p>

                        </div>

                    </div>


                    <form
                        method="post"
                        asp-page-handler="Decline"
                        class="decline-form">

                        <input
                            type="hidden"
                            asp-for="ContractId"
                            value="@contract.ContractId" />

                        <div class="decline-field">

                            <label asp-for="DeclineReason">
                                Reason for Declining
                            </label>

                            <textarea
                                asp-for="DeclineReason"
                                class="decline-input"
                                placeholder="Explain why this contract is being declined."
                                rows="4"></textarea>

                        </div>


                        <button
                            type="submit"
                            class="decline-contract-button">

                            <i class="bi bi-x-lg"></i>

                            Decline Contract

                        </button>

                    </form>

                </section>
            }


            <footer class="contract-footer">

                <a
                    asp-page="/Management/Contracts"
                    class="back-to-contracts">

                    <i class="bi bi-arrow-left"></i>

                    Back to Contracts

                </a>

            </footer>

        </section>
    }
    else
    {
        <section class="contracts-section">

            <header class="contracts-section-header">

                <div>

                    <span class="section-eyebrow">
                        ACTION REQUIRED
                    </span>

                    <h2>
                        Contracts Awaiting Your Signature
                    </h2>

                    <p>
                        Contracts that have reached your signing stage.
                    </p>

                </div>

                <span class="contract-count">
                    @Model.PendingContracts.Count
                </span>

            </header>


            @if (Model.PendingContracts.Count == 0)
            {
                <div class="empty-contracts">

                    <div class="empty-contract-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <h3>
                        No pending contracts
                    </h3>

                    <p>
                        There are currently no lecturer contracts awaiting your signature.
                    </p>

                </div>
            }
            else
            {
                <div class="contract-list">

                    @foreach (var contract in Model.PendingContracts)
                    {
                        <article class="contract-card">

                            <div class="contract-card-main">

                                <div class="contract-card-icon">
                                    <i class="bi bi-file-earmark-text-fill"></i>
                                </div>

                                <div class="contract-card-information">

                                    <div class="contract-card-reference">

                                        <span>
                                            CON-@contract.ContractId.ToString("D6")
                                        </span>

                                        <span class="contract-status status-pending">
                                            <span class="status-dot"></span>
                                            Pending
                                        </span>

                                    </div>

                                    <h3>
                                        @contract.LecturerName
                                    </h3>

                                    <div class="contract-card-meta">

                                        <span>
                                            <i class="bi bi-book-fill"></i>
                                            @contract.CourseTitle
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="contract-card-actions">

                                <a
                                    asp-page="/Management/Contracts"
                                    asp-route-contractId="@contract.ContractId"
                                    class="view-contract-button">

                                    <i class="bi bi-eye-fill"></i>

                                    Review Contract

                                </a>

                            </div>

                        </article>
                    }

                </div>
            }

        </section>
    }

</section>