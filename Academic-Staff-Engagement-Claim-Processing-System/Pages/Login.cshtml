@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "UNILAK Portal Login";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <meta
        name="description"
        content="UNILAK Academic Staff Engagement and Claim Processing System" />

    <title>@ViewData["Title"]</title>

    <!-- Marks the page as JS-enabled so entrance animations can wait until the page has loaded -->
    <script>
        document.documentElement.classList.add("js");
    </script>

    <link
        rel="icon"
        type="image/png"
        href="~/images/PNG_LOGO-_UNILAK-removebg-preview.png" />

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com" />

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link
        rel="stylesheet"
        href="~/css/login.css"
        asp-append-version="true" />

</head>

<body>

    <div class="login-page">

        <!-- =================================================
             NAVBAR
             ================================================= -->

        <nav class="navbar">

            <div class="navbar-container">

                <a
                    href="/"
                    class="navbar-brand-wrapper"
                    aria-label="UNILAK Portal Home">

                    <img
                        src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                        alt="UNILAK Logo"
                        class="navbar-logo" />

                    <span class="navbar-brand">

                        <span class="brand-name">
                            UNILAK Portal
                        </span>

                        <span class="brand-subtitle">
                            Academic Staff Engagement System
                        </span>

                    </span>

                </a>

                <ul class="navbar-nav">

                    <li>

                        <a
                            href="/"
                            class="nav-link">

                            <i class="bi bi-house-door-fill"></i>

                            <span>
                                Home
                            </span>

                        </a>

                    </li>

                    <li>

                        <a
                            href="/#features"
                            class="nav-link">

                            <i class="bi bi-grid-fill"></i>

                            <span>
                                Features
                            </span>

                        </a>

                    </li>

                    <li>

                        <a
                            href="/Login"
                            class="nav-login"
                            aria-current="page">

                            <i class="bi bi-box-arrow-in-right"></i>

                            <span>
                                Login
                            </span>

                        </a>

                    </li>

                </ul>

            </div>

        </nav>


        <div class="login-split">

            <!-- =================================================
                 LEFT PANEL — brand, message and product preview
                 ================================================= -->

            <aside class="login-aside">

                <a
                    href="/"
                    class="aside-brand"
                    aria-label="UNILAK Portal Home">

                    <span class="aside-brand-logo">

                        <img
                            src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                            alt="UNILAK Logo" />

                    </span>

                    <span class="aside-brand-name">
                        UNILAK Portal
                    </span>

                </a>


                <div class="aside-copy">

                    <h2>
                        Engagements, Contracts and Claims in One Platform
                    </h2>

                    <p>
                        Sign in to manage teaching engagements, digital
                        contracts, attendance and payment claims across
                        the university.
                    </p>

                </div>


                <div
                    class="aside-visual"
                    aria-hidden="true">

                    <div class="pipeline">

                        <div class="pipeline-head">

                            <span class="pipeline-icon">
                                <i class="bi bi-diagram-3-fill"></i>
                            </span>

                            <span class="pipeline-title">
                                Signing pipeline
                            </span>

                            <span class="pipeline-meta">
                                Stage 3 of 5
                            </span>

                        </div>

                        <div class="pipeline-bar">
                            <span></span>
                        </div>

                        <ul class="pipeline-list">

                            <li class="stage stage--done">
                                <span class="stage-dot"><i class="bi bi-check-lg"></i></span>
                                <span class="stage-name">Engagement</span>
                                <span class="stage-status">Registered</span>
                            </li>

                            <li class="stage stage--done">
                                <span class="stage-dot"><i class="bi bi-check-lg"></i></span>
                                <span class="stage-name">Contract</span>
                                <span class="stage-status">Signed</span>
                            </li>

                            <li class="stage stage--active">
                                <span class="stage-dot"></span>
                                <span class="stage-name">Attendance</span>
                                <span class="stage-status">In progress</span>
                            </li>

                            <li class="stage stage--pending">
                                <span class="stage-dot"></span>
                                <span class="stage-name">Claim</span>
                                <span class="stage-status">Pending</span>
                            </li>

                            <li class="stage stage--pending">
                                <span class="stage-dot"></span>
                                <span class="stage-name">Approval</span>
                                <span class="stage-status">Pending</span>
                            </li>

                        </ul>

                        <div class="pipeline-stripes"></div>

                    </div>

                    <span class="chip chip--contracts">
                        <i class="bi bi-file-earmark-text-fill"></i>
                        Digital Contracts
                    </span>

                    <span class="chip chip--attendance">
                        <i class="bi bi-clock-history"></i>
                        Attendance
                    </span>

                    <span class="chip chip--claims">
                        <i class="bi bi-cash-coin"></i>
                        Payment Claims
                    </span>

                    <span class="chip chip--approvals">
                        <i class="bi bi-patch-check-fill"></i>
                        Approvals
                    </span>

                    <span class="chip chip--action">
                        <i class="bi bi-cursor-fill"></i>
                        Review &amp; sign
                    </span>

                </div>


                <p class="aside-footer">
                    &copy; @DateTime.Now.Year
                    University of Lay Adventists of Kigali.
                    All rights reserved.
                </p>

            </aside>


            <!-- =================================================
                 RIGHT SIDE — login card
                 ================================================= -->

            <main class="login-side">

                <div class="login-container">

                    <div
                        class="frame-hatch frame-hatch--top"
                        aria-hidden="true">
                    </div>

                    <div class="card-frame">

                        <section class="login-card">

                            <span class="screw screw--tl" aria-hidden="true"></span>
                            <span class="screw screw--tr" aria-hidden="true"></span>

                            <div class="card-body">

                                <header class="login-header">

                                    <div class="login-logo">

                                        <img
                                            src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                                            alt="UNILAK" />

                                    </div>

                                    <h1>
                                        Login to
                                        <span>UNILAK Portal</span>
                                    </h1>

                                    <p>
                                        Sign in to access the UNILAK Academic Staff Engagement Portal.
                                    </p>

                                </header>


                                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <div
                                        class="error-message"
                                        role="alert">

                                        <i class="bi bi-exclamation-circle-fill"></i>

                                        <span>
                                            @Model.ErrorMessage
                                        </span>

                                    </div>
                                }


                                <form method="post">

                                    <input type="hidden" asp-for="ReturnUrl" />

                                    <div class="form-group">

                                        <label
                                            asp-for="Username"
                                            class="form-label">

                                            Username

                                        </label>

                                        <div class="input-wrapper">

                                            <input
                                                asp-for="Username"
                                                placeholder="Enter your username"
                                                autocomplete="username" />

                                        </div>

                                    </div>


                                    <div class="form-group">

                                        <label
                                            asp-for="Password"
                                            class="form-label">

                                            Password

                                        </label>

                                        <div class="input-wrapper">

                                            <input
                                                asp-for="Password"
                                                id="passwordInput"
                                                type="password"
                                                placeholder="Enter your password"
                                                autocomplete="current-password" />

                                            <button
                                                type="button"
                                                class="password-toggle"
                                                id="passwordToggle"
                                                aria-label="Show password"
                                                title="Show password">

                                                <i
                                                    class="bi bi-eye"
                                                    id="passwordToggleIcon">
                                                </i>

                                            </button>

                                        </div>

                                    </div>


                                    <button
                                        type="submit"
                                        class="login-button">

                                        <span>
                                            Sign In
                                        </span>

                                    </button>

                                </form>

                            </div>


                            <div class="card-foot">

                                <p>
                                    Don't have an account?
                                    <strong>Contact your administrator</strong>
                                </p>

                            </div>

                        </section>

                    </div>

                    <p class="login-note">
                        Access is limited to authorized UNILAK staff.
                    </p>

                    <div
                        class="frame-hatch frame-hatch--bottom"
                        aria-hidden="true">
                    </div>

                </div>

            </main>

        </div>

    </div>


    <!-- =================================================
         START ANIMATIONS ONCE THE PAGE HAS FULLY LOADED
         (fonts, icons and images are ready, so no dropped frames)
         ================================================= -->

    <script>

        (function () {

            var page =
                document.querySelector(
                    ".login-page"
                );

            if (!page) {
                return;
            }

            function start() {

                requestAnimationFrame(
                    function () {

                        requestAnimationFrame(
                            function () {

                                page.classList.add(
                                    "is-ready"
                                );

                            }
                        );

                    }
                );

            }

            if (document.readyState === "complete") {

                start();

            } else {

                window.addEventListener(
                    "load",
                    start
                );

            }

            // Safety net so the page never stays paused
            setTimeout(
                function () {
                    page.classList.add(
                        "is-ready"
                    );
                },
                3000
            );

        })();

    </script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const passwordInput =
                    document.getElementById(
                        "passwordInput"
                    );

                const passwordToggle =
                    document.getElementById(
                        "passwordToggle"
                    );

                const passwordToggleIcon =
                    document.getElementById(
                        "passwordToggleIcon"
                    );


                if (
                    !passwordInput ||
                    !passwordToggle ||
                    !passwordToggleIcon
                ) {
                    return;
                }


                passwordToggle.addEventListener(
                    "click",
                    function () {

                        const isPassword =
                            passwordInput.type === "password";


                        passwordInput.type =
                            isPassword
                                ? "text"
                                : "password";


                        passwordToggleIcon.className =
                            isPassword
                                ? "bi bi-eye-slash"
                                : "bi bi-eye";


                        passwordToggle.setAttribute(
                            "aria-label",
                            isPassword
                                ? "Hide password"
                                : "Show password"
                        );


                        passwordToggle.setAttribute(
                            "title",
                            isPassword
                                ? "Hide password"
                                : "Show password"
                        );

                    }
                );

            }
        );

    </script>

</body>

</html>