@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "UNILAK Portal Login";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <meta
        name="description"
        content="UNILAK Academic Staff Engagement and Claim Processing System" />

    <title>@ViewData["Title"]</title>

    <link
        rel="icon"
        type="image/png"
        href="~/images/PNG_LOGO-_UNILAK-removebg-preview.png" />

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com" />

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin />

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet" />

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link
        rel="stylesheet"
        href="~/css/login.css"
        asp-append-version="true" />

</head>

<body>

    <div class="login-page">

        <nav class="navbar">

            <div class="navbar-container">

                <a
                    href="/"
                    class="navbar-brand-wrapper"
                    aria-label="UNILAK Portal Home">

                    <img
                        src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                        alt="UNILAK Logo"
                        class="navbar-logo" />

                    <span class="navbar-brand">

                        <span class="brand-name">
                            UNILAK Portal
                        </span>

                        <span class="brand-subtitle">
                            Academic Staff Engagement System
                        </span>

                    </span>

                </a>

                <ul class="navbar-nav">

                    <li>

                        <a
                            href="/"
                            class="nav-link">

                            <i class="bi bi-house-door-fill"></i>

                            <span>
                                Home
                            </span>

                        </a>

                    </li>

                    <li>

                        <a
                            href="/#features"
                            class="nav-link">

                            <i class="bi bi-grid-fill"></i>

                            <span>
                                Features
                            </span>

                        </a>

                    </li>

                    <li>

                        <a
                            href="/Login"
                            class="nav-login"
                            aria-current="page">

                            <i class="bi bi-box-arrow-in-right"></i>

                            <span>
                                Login
                            </span>

                        </a>

                    </li>

                </ul>

            </div>

        </nav>


        <main class="login-main">

            <div class="login-container">

                <section class="login-card">

                    <header class="login-header">

                        <div class="login-logo">

                            <i class="bi bi-shield-lock-fill"></i>

                        </div>

                        <h1>
                            Welcome Back
                        </h1>

                        <p>
                            Sign in to access the UNILAK Academic Staff Engagement Portal.
                        </p>

                    </header>


                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div
                            class="error-message"
                            role="alert">

                            <i class="bi bi-exclamation-circle-fill"></i>

                            <span>
                                @Model.ErrorMessage
                            </span>

                        </div>
                    }


                    <form method="post">

                        <div class="form-group">

                            <label
                                asp-for="Username"
                                class="form-label">

                                Username

                            </label>

                            <div class="input-wrapper">

                                <i
                                    class="bi bi-person input-icon">
                                </i>

                                <input
                                    asp-for="Username"
                                    placeholder="Enter your username"
                                    autocomplete="username" />

                            </div>

                        </div>


                        <div class="form-group">

                            <label
                                asp-for="Password"
                                class="form-label">

                                Password

                            </label>

                            <div class="input-wrapper">

                                <i
                                    class="bi bi-lock input-icon">
                                </i>

                                <input
                                    asp-for="Password"
                                    id="passwordInput"
                                    type="password"
                                    placeholder="Enter your password"
                                    autocomplete="current-password" />

                                <button
                                    type="button"
                                    class="password-toggle"
                                    id="passwordToggle"
                                    aria-label="Show password"
                                    title="Show password">

                                    <i
                                        class="bi bi-eye"
                                        id="passwordToggleIcon">
                                    </i>

                                </button>

                            </div>

                        </div>


                        <button
                            type="submit"
                            class="login-button">

                            <span>
                                Sign In
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>


                    <a
                        href="/"
                        class="back-link">

                        <i class="bi bi-arrow-left"></i>

                        <span>
                            Back to Home
                        </span>

                    </a>

                </section>

            </div>

        </main>


        <footer class="footer">

            <div>

                <strong>
                    UNILAK Portal
                </strong>

                <span>
                    · Academic Staff Engagement &amp; Claim Processing System
                </span>

            </div>

            <div class="footer-security">

                <i class="bi bi-shield-check"></i>

                <span>
                    Secure Academic Management Platform
                </span>

            </div>

        </footer>

    </div>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const passwordInput =
                    document.getElementById(
                        "passwordInput"
                    );

                const passwordToggle =
                    document.getElementById(
                        "passwordToggle"
                    );

                const passwordToggleIcon =
                    document.getElementById(
                        "passwordToggleIcon"
                    );


                if (
                    !passwordInput ||
                    !passwordToggle ||
                    !passwordToggleIcon
                ) {
                    return;
                }


                passwordToggle.addEventListener(
                    "click",
                    function () {

                        const isPassword =
                            passwordInput.type === "password";


                        passwordInput.type =
                            isPassword
                                ? "text"
                                : "password";


                        passwordToggleIcon.className =
                            isPassword
                                ? "bi bi-eye-slash"
                                : "bi bi-eye";


                        passwordToggle.setAttribute(
                            "aria-label",
                            isPassword
                                ? "Hide password"
                                : "Show password"
                        );


                        passwordToggle.setAttribute(
                            "title",
                            isPassword
                                ? "Hide password"
                                : "Show password"
                        );

                    }
                );

            }
        );

    </script>

</body>

</html>