@page
@model Academic_Staff_Engagement_Claim_Processing_System.Pages.ManagementDashboardModel
@using Academic_Staff_Engagement_Claim_Processing_System.Data.Models.Enums

@{
    Layout = null;
    ViewData["Title"] = "Management Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Management Dashboard · UNILAK ASECPS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Management Dashboard CSS -->
    <link rel="stylesheet"
          href="~/css/MANAGEMENT/dashboard.css"
          asp-append-version="true" />
</head>

<body>

    <!-- =========================================================
         MOBILE OVERLAY
         ========================================================= -->

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header class="app-header">

        <div class="header-left">

            <button type="button"
                    class="mobile-menu-btn"
                    id="mobileMenuBtn"
                    aria-label="Open navigation">
                <i class="bi bi-list"></i>
            </button>

            <div class="brand">

                <div class="brand-logo">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div class="brand-text">
                    <strong>UNILAK</strong>
                    <span>Staff Engagement Portal</span>
                </div>

            </div>

        </div>

        <div class="header-right">

            <div class="role-badge">
                <i class="bi bi-person-badge-fill"></i>
                <span>@Model.RoleLabel</span>
            </div>

            <a href="/Login" class="logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>

        </div>

    </header>


    <!-- =========================================================
         SIDEBAR
         ========================================================= -->

    <aside class="sidebar" id="sidebar">

        <div class="sidebar-profile">

            <div class="profile-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="profile-info">
                <strong>@Model.DisplayName</strong>
                <span>@Model.RoleLabel</span>
            </div>

        </div>


        <nav class="sidebar-nav">

            <div class="nav-section-title">
                MAIN MENU
            </div>

            <a href="/ManagementDashboard"
               class="nav-item active">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/Management/Contracts"
               class="nav-item">
                <i class="bi bi-file-earmark-text-fill"></i>
                <span>Contracts</span>

                @if (Model.PendingContractCount > 0)
                {
                    <span class="nav-count">
                        @Model.PendingContractCount
                    </span>
                }
            </a>


            <div class="nav-section-title nav-section-spaced">
                ACCOUNT
            </div>

            <a href="/Login"
               class="nav-item">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sign Out</span>
            </a>

        </nav>


        <div class="sidebar-footer">

            <div class="sidebar-footer-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <strong>Secure Portal</strong>
                <span>UNILAK ASECPS</span>
            </div>

        </div>

    </aside>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <main class="main-content">

        <!-- PAGE HEADER -->

        <section class="page-heading">

            <div>

                <span class="eyebrow">
                    MANAGEMENT PORTAL
                </span>

                <h1>
                    Contract Management
                </h1>

                <p>
                    Review and manage lecturer contracts at your stage
                    of the institutional signing workflow.
                </p>

            </div>

            <a href="/Management/Contracts"
               class="primary-action">

                <i class="bi bi-file-earmark-check-fill"></i>

                <span>Review Contracts</span>

            </a>

        </section>


        <!-- =====================================================
             WELCOME BANNER
             ===================================================== -->

        <section class="welcome-banner">

            <div class="welcome-content">

                <div class="welcome-icon">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <div>

                    <span class="welcome-label">
                        Welcome back
                    </span>

                    <h2>
                        @Model.DisplayName
                    </h2>

                    <p>
                        You are signed in as
                        <strong>@Model.RoleLabel</strong>.
                        Contracts assigned to your signing stage are
                        displayed below.
                    </p>

                </div>

            </div>

            <div class="welcome-stage">

                <span>Your signing stage</span>

                <strong>
                    @Model.RoleLabel
                </strong>

            </div>

        </section>


        <!-- =====================================================
             SUMMARY CARDS
             ===================================================== -->

        <section class="stats-grid">

            <!-- Pending -->

            <div class="stat-card pending-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="bi bi-file-earmark-diff-fill"></i>
                    </div>

                    <span class="stat-status">
                        Action Required
                    </span>

                </div>

                <div class="stat-value">
                    @Model.PendingContractCount
                </div>

                <div class="stat-label">
                    Contracts Awaiting My Signature
                </div>

                <div class="stat-footer">

                    <span>
                        <i class="bi bi-pen-fill"></i>
                        Requires review
                    </span>

                    <a href="/Management/Contracts">
                        View
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>


            <!-- My signed -->

            <div class="stat-card signed-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>

                    <span class="stat-status">
                        Completed
                    </span>

                </div>

                <div class="stat-value">
                    @Model.MySignedContractCount
                </div>

                <div class="stat-label">
                    Contracts I Have Signed
                </div>

                <div class="stat-footer">

                    <span>
                        <i class="bi bi-check-circle-fill"></i>
                        Your approvals
                    </span>

                    <span class="stat-static">
                        Completed
                    </span>

                </div>

            </div>


            <!-- Workflow -->

            <div class="stat-card workflow-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <span class="stat-status">
                        In Progress
                    </span>

                </div>

                <div class="stat-value">
                    @Model.InSigningProcessCount
                </div>

                <div class="stat-label">
                    Contracts in Signing Process
                </div>

                <div class="stat-footer">

                    <span>
                        <i class="bi bi-diagram-3-fill"></i>
                        Across all stages
                    </span>

                </div>

            </div>


            <!-- Active -->

            <div class="stat-card active-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <span class="stat-status">
                        Active
                    </span>

                </div>

                <div class="stat-value">
                    @Model.ActiveContractsCount
                </div>

                <div class="stat-label">
                    Active Contracts
                </div>

                <div class="stat-footer">

                    <span>
                        <i class="bi bi-shield-check"></i>
                        Fully executed
                    </span>

                </div>

            </div>

        </section>


        <!-- =====================================================
             SIGNING WORKFLOW
             ===================================================== -->

        <section class="section-card workflow-section">

            <div class="section-header">

                <div>

                    <span class="section-eyebrow">
                        CONTRACT LIFECYCLE
                    </span>

                    <h2>
                        Contract Signing Workflow
                    </h2>

                    <p>
                        Every lecturer contract follows the institutional
                        signing sequence below.
                    </p>

                </div>

            </div>


            <div class="workflow">

                <div class="workflow-step">

                    <div class="workflow-number">
                        1
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <strong>Lecturer</strong>

                    <span>Signs</span>

                </div>


                <div class="workflow-line"></div>


                <div class="workflow-step">

                    <div class="workflow-number">
                        2
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-building-fill"></i>
                    </div>

                    <strong>Dean</strong>

                    <span>Signs</span>

                </div>


                <div class="workflow-line"></div>


                <div class="workflow-step current">

                    <div class="workflow-number">
                        3
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>

                    <strong>HR Officer</strong>

                    <span>Management</span>

                </div>


                <div class="workflow-line"></div>


                <div class="workflow-step">

                    <div class="workflow-number">
                        4
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>

                    <strong>DVCAR</strong>

                    <span>Management</span>

                </div>


                <div class="workflow-line"></div>


                <div class="workflow-step">

                    <div class="workflow-number">
                        5
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-award-fill"></i>
                    </div>

                    <strong>Vice Chancellor</strong>

                    <span>Final Signer</span>

                </div>


                <div class="workflow-line"></div>


                <div class="workflow-step final">

                    <div class="workflow-number">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <div class="workflow-icon">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>

                    <strong>ACTIVE</strong>

                    <span>Contract Complete</span>

                </div>

            </div>

        </section>


        <!-- =====================================================
             CONTRACTS AWAITING MY SIGNATURE
             ===================================================== -->

        <section class="section-card">

            <div class="section-header">

                <div>

                    <span class="section-eyebrow">
                        ACTION REQUIRED
                    </span>

                    <h2>
                        Contracts Awaiting My Signature
                    </h2>

                    <p>
                        These contracts have reached your stage in the
                        signing sequence and require your review.
                    </p>

                </div>

                <a href="/Management/Contracts"
                   class="section-link">

                    View All
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            @if (Model.PendingContracts.Count == 0)
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <h3>
                        No contracts require your signature
                    </h3>

                    <p>
                        There are currently no lecturer contracts
                        waiting for action at your signing stage.
                    </p>

                </div>
            }
            else
            {
                <div class="table-wrapper">

                    <table class="contracts-table">

                        <thead>

                            <tr>
                                <th>Contract</th>
                                <th>Lecturer</th>
                                <th>Department</th>
                                <th>Course</th>
                                <th>Hours</th>
                                <th>Stage</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var contract in Model.PendingContracts)
                            {
                                <tr>

                                    <td>

                                        <div class="contract-reference">

                                            <div class="contract-icon">
                                                <i class="bi bi-file-earmark-text-fill"></i>
                                            </div>

                                            <div>
                                                <strong>
                                                    C@(contract.ContractId.ToString("D3"))
                                                </strong>

                                                <span>
                                                    v@(contract.Version)
                                                </span>
                                            </div>

                                        </div>

                                    </td>


                                    <td>
                                        <span class="lecturer-name">
                                            @contract.LecturerName
                                        </span>
                                    </td>


                                    <td>
                                        @contract.Department
                                    </td>


                                    <td>
                                        <span class="course-name">
                                            @contract.CourseTitle
                                        </span>
                                    </td>


                                    <td>
                                        <strong>
                                            @contract.AllocatedHours.ToString("0.##")
                                        </strong>
                                        <span class="hours-label">hrs</span>
                                    </td>


                                    <td>

                                        <span class="stage-badge">
                                            <i class="bi bi-hourglass-split"></i>
                                            @contract.CurrentStage
                                        </span>

                                    </td>


                                    <td>

                                        <a href="/Management/Contracts?contractId=@contract.ContractId"
                                           class="review-btn">

                                            <i class="bi bi-eye-fill"></i>

                                            Review

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </section>


        <!-- =====================================================
             REVIEW REQUIREMENTS
             ===================================================== -->

        <section class="requirements-grid">

            <div class="section-card requirement-card">

                <div class="requirement-icon">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>

                <div>

                    <h3>
                        Lecturer Information
                    </h3>

                    <p>
                        Confirm the lecturer identity and employment
                        information before signing.
                    </p>

                </div>

            </div>


            <div class="section-card requirement-card">

                <div class="requirement-icon">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>

                <div>

                    <h3>
                        Course Assignment
                    </h3>

                    <p>
                        Verify the department, course and allocated
                        teaching hours.
                    </p>

                </div>

            </div>


            <div class="section-card requirement-card">

                <div class="requirement-icon">
                    <i class="bi bi-file-earmark-check-fill"></i>
                </div>

                <div>

                    <h3>
                        Contract Details
                    </h3>

                    <p>
                        Check the contract version, rate and applicable
                        engagement information.
                    </p>

                </div>

            </div>


            <div class="section-card requirement-card">

                <div class="requirement-icon">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>

                <div>

                    <h3>
                        Previous Signatures
                    </h3>

                    <p>
                        Confirm that all required preceding signatories
                        have completed their steps.
                    </p>

                </div>

            </div>

        </section>


        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <footer class="portal-footer">

            <div>

                <strong>
                    UNILAK Portal
                </strong>

                <span>
                    Academic Staff Engagement &amp; Claim Processing System
                </span>

            </div>

            <span>
                © @DateTime.Now.Year University of Lay Adventists of Kigali
            </span>

        </footer>

    </main>


    <!-- =========================================================
         MOBILE SIDEBAR SCRIPT
         ========================================================= -->

    <script>

        const mobileMenuBtn =
            document.getElementById("mobileMenuBtn");

        const sidebar =
            document.getElementById("sidebar");

        const sidebarOverlay =
            document.getElementById("sidebarOverlay");


        function openSidebar() {

            sidebar.classList.add("open");
            sidebarOverlay.classList.add("show");

        }


        function closeSidebar() {

            sidebar.classList.remove("open");
            sidebarOverlay.classList.remove("show");

        }


        mobileMenuBtn?.addEventListener(
            "click",
            openSidebar
        );


        sidebarOverlay?.addEventListener(
            "click",
            closeSidebar
        );


        document
            .querySelectorAll(".nav-item")
            .forEach(item => {

                item.addEventListener(
                    "click",
                    closeSidebar
                );

            });

    </script>

</body>
</html>