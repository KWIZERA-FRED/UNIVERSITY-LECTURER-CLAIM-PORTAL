@page
@model ChangePasswordModel

@{
    Layout = null;
    ViewData["Title"] = "Change Password — UNILAK Portal";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Plus Jakarta Sans", sans-serif;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            padding: 24px;
        }

        .card {
            width: 100%;
            max-width: 440px;
            padding: 40px 36px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 20px 30px -10px rgba(15, 23, 42, 0.35);
        }

        .heading {
            text-align: center;
            margin-bottom: 28px;
        }

        .icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            border-radius: 12px;
            color: #059669;
            background: #ecfdf5;
            font-size: 26px;
        }

        .heading h1 {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .heading p {
            color: #64748b;
            font-size: 13.5px;
            line-height: 1.6;
        }

        .heading strong {
            color: #0f172a;
        }

        .error-message {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding: 12px 14px;
            margin-bottom: 20px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #b91c1c;
            font-size: 13px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            transition: border-color 0.2s ease;
        }

        .input-wrapper:focus-within {
            border-color: #059669;
        }

        .input-wrapper i {
            color: #94a3b8;
        }

        input {
            border: none;
            outline: none;
            flex: 1;
            font-size: 14px;
            font-family: inherit;
        }

        .hint {
            margin-top: 6px;
            font-size: 12px;
            color: #94a3b8;
        }

        button {
            width: 100%;
            margin-top: 6px;
            padding: 12px;
            background: #059669;
            border: none;
            border-radius: 8px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        button:hover:not(:disabled) {
            background: #047857;
        }

        button:disabled {
            background: #94a3b8;
            cursor: not-allowed;
        }

    </style>

</head>

<body>

    <div class="card">

        <div class="heading">
            <div class="icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1>Set a New Password</h1>
            <p>
                Welcome, <strong>@Model.DisplayUsername</strong>. For your
                account's security, you must set a new password before
                continuing.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-message">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @if (!Model.IsLockedOut)
        {
            <form method="post" autocomplete="off">

                <div class="form-group">
                    <label asp-for="CurrentPassword">Current (temporary) password</label>
                    <div class="input-wrapper">
                        <i class="bi bi-lock"></i>
                        <input asp-for="CurrentPassword"
                               type="password"
                               placeholder="Enter the password you were emailed"
                               autocomplete="current-password" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword">New password</label>
                    <div class="input-wrapper">
                        <i class="bi bi-key"></i>
                        <input asp-for="NewPassword"
                               type="password"
                               placeholder="Choose a new password"
                               autocomplete="new-password" />
                    </div>
                    <div class="hint">
                        At least 10 characters, with an uppercase letter,
                        a lowercase letter, a number, and a symbol.
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmNewPassword">Confirm new password</label>
                    <div class="input-wrapper">
                        <i class="bi bi-key-fill"></i>
                        <input asp-for="ConfirmNewPassword"
                               type="password"
                               placeholder="Re-enter your new password"
                               autocomplete="new-password" />
                    </div>
                </div>

                <button type="submit">Update Password</button>

            </form>
        }

    </div>

</body>

</html>