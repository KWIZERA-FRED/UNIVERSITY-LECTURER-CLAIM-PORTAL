@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "UNILAK Portal Login";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="UNILAK Academic Staff Engagement and Claim Processing System" />

    <title>@ViewData["Title"]</title>

    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            /* =========================================================
                       RESET & BASE
                    ========================================================= */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: "Plus Jakarta Sans", "Poppins", sans-serif;
                color: #1e293b;
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
            }

            a {
                text-decoration: none;
            }


            /* =========================================================
                       LOGIN PAGE
                    ========================================================= */

            .login-page {
                min-height: 100vh;
                width: 100%;
                display: flex;
                flex-direction: column;
                position: relative;
                overflow: hidden;
                background: url("/images/unilak-campus.jpg") center/cover no-repeat fixed;
            }


            /* =========================================================
                       BACKGROUND OVERLAY
                       SAME STYLE AS HOME PAGE
                    ========================================================= */

            .page-overlay {
                position: absolute;
                inset: 0;
                background: radial-gradient( circle at center, rgba(15, 23, 42, 0.82) 0%, rgba(15, 23, 42, 0.94) 100% );
                z-index: 1;
            }


            /* =========================================================
                       NAVIGATION
                       SAME AS HOME PAGE
                    ========================================================= */

            .navbar {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 80px;
                z-index: 1000;
                background: rgba(10, 25, 47, 0.75);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                transition: all 0.3s ease;
            }

            .navbar-container {
                max-width: 1280px;
                height: 100%;
                margin: 0 auto;
                padding: 0 32px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .navbar-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .logo-link {
                display: flex;
                align-items: center;
            }

            .navbar-logo {
                width: 48px;
                height: 48px;
                object-fit: contain;
                filter: drop-shadow( 0 2px 4px rgba(0, 0, 0, 0.3) );
                transition: transform 0.3s ease;
            }

            .logo-link:hover .navbar-logo {
                transform: scale(1.05);
            }

            .navbar-brand {
                color: #ffffff;
                font-size: 20px;
                font-weight: 700;
                letter-spacing: -0.3px;
            }

                .navbar-brand span {
                    color: #64748b;
                    font-weight: 400;
                }

            .navbar-nav {
                display: flex;
                align-items: center;
                gap: 28px;
                list-style: none;
            }

            .nav-link {
                position: relative;
                display: flex;
                align-items: center;
                gap: 8px;
                color: #cbd5e1;
                font-size: 14px;
                font-weight: 500;
                padding: 8px 0;
                transition: color 0.2s ease;
            }

                .nav-link:hover,
                .nav-link.active {
                    color: #ffffff;
                }

                .nav-link::after {
                    content: "";
                    position: absolute;
                    bottom: -2px;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background: #34d399;
                    border-radius: 2px;
                    transition: width 0.3s ease;
                }

                .nav-link:hover::after,
                .nav-link.active::after {
                    width: 100%;
                }

            .nav-btn-login {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 9px 20px;
                border-radius: 8px;
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #ffffff;
                font-size: 14px;
                font-weight: 600;
                transition: all 0.2s ease;
            }

                .nav-btn-login:hover {
                    background: #ffffff;
                    color: #0f172a;
                    border-color: #ffffff;
                }


            /* =========================================================
                       MAIN
                    ========================================================= */

            .login-main {
                position: relative;
                z-index: 2;
                min-height: 100vh;
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 140px 24px 100px;
            }

            .login-container {
                width: 100%;
                max-width: 440px;
                animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            }


            /* =========================================================
                       LOGIN CARD
                    ========================================================= */

            .login-card {
                width: 100%;
                padding: 40px 36px;
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                box-shadow: 0 20px 30px -10px rgba(15, 23, 42, 0.20);
                transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
            }

                .login-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 25px 40px -10px rgba(15, 23, 42, 0.25);
                }


            /* =========================================================
                       LOGIN HEADING
                    ========================================================= */

            .login-heading {
                text-align: center;
                margin-bottom: 32px;
            }

            .login-icon {
                width: 60px;
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 20px;
                border-radius: 12px;
                color: #059669;
                background: #ecfdf5;
                font-size: 26px;
                transition: all 0.3s ease;
            }

            .login-card:hover .login-icon {
                color: #ffffff;
                background: #059669;
                transform: translateY(-2px);
            }

            .login-heading h1 {
                color: #0f172a;
                font-size: 30px;
                font-weight: 700;
                letter-spacing: -0.8px;
                margin-bottom: 8px;
            }

            .login-heading p {
                color: #64748b;
                font-size: 14px;
                line-height: 1.6;
            }


            /* =========================================================
                       ERROR MESSAGE
                    ========================================================= */

            .error-message {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                background: #fef2f2;
                color: #b91c1c;
                border: 1px solid #fecaca;
                border-radius: 10px;
                padding: 12px 14px;
                margin-bottom: 20px;
                font-size: 13px;
                line-height: 1.5;
            }

                .error-message i {
                    margin-top: 2px;
                }


            /* =========================================================
                       FORM
                    ========================================================= */

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    color: #334155;
                    font-size: 13px;
                    font-weight: 600;
                    margin-bottom: 8px;
                }

            .input-wrapper {
                position: relative;
            }

                .input-wrapper i {
                    position: absolute;
                    left: 16px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #64748b;
                    font-size: 16px;
                    pointer-events: none;
                    transition: color 0.2s ease;
                }

                .input-wrapper input {
                    width: 100%;
                    padding: 13px 16px 13px 46px;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    background: #ffffff;
                    color: #0f172a;
                    font-family: inherit;
                    font-size: 14px;
                    transition: border-color 0.2s ease, box-shadow 0.2s ease;
                }

                    .input-wrapper input::placeholder {
                        color: #94a3b8;
                    }

                    .input-wrapper input:focus {
                        outline: none;
                        border-color: #059669;
                        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.10);
                    }

                .input-wrapper:focus-within i {
                    color: #059669;
                }


            /* =========================================================
                       LOGIN BUTTON
                    ========================================================= */

            .login-button {
                width: 100%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 14px 28px;
                margin-top: 4px;
                border: none;
                border-radius: 10px;
                color: #ffffff;
                background: #059669;
                box-shadow: 0 4px 14px rgba(5, 150, 105, 0.35);
                font-family: inherit;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            }

                .login-button:hover {
                    background: #047857;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(5, 150, 105, 0.45);
                }

                .login-button:active {
                    transform: translateY(0);
                }


            /* =========================================================
                       BACK TO HOME
                    ========================================================= */

            .back-link {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                margin-top: 24px;
                color: #64748b;
                font-size: 13px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .back-link:hover {
                    color: #059669;
                    gap: 10px;
                }


            /* =========================================================
                       FOOTER
                    ========================================================= */

            .footer {
                position: relative;
                z-index: 2;
                padding: 30px 24px;
                color: #94a3b8;
                background: #020617;
                border-top: 1px solid #1e293b;
                text-align: center;
                font-size: 13px;
            }

                .footer strong {
                    color: #f8fafc;
                    font-weight: 600;
                }

                .footer i {
                    color: #34d399;
                    margin-right: 5px;
                }


            /* =========================================================
                       ANIMATION
                    ========================================================= */

            @@keyframes fadeIn {

                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }


            /* =========================================================
                       RESPONSIVE
                    ========================================================= */

            @@media (max-width: 768px) {

                .navbar-container {
                    padding: 0 20px;
                }

                .navbar-nav {
                    gap: 16px;
                }

                .login-main {
                    padding: 120px 20px 80px;
                }

                .login-card {
                    padding: 34px 28px;
                }
            }


            @@media (max-width: 480px) {

                .navbar {
                    height: 70px;
                }

                .navbar-container {
                    padding: 0 16px;
                }

                .navbar-nav {
                    gap: 8px;
                }

                    .navbar-nav .nav-link {
                        display: none;
                    }

                .navbar-logo {
                    width: 40px;
                    height: 40px;
                }

                .navbar-brand {
                    font-size: 16px;
                }

                .nav-btn-login {
                    padding: 8px 14px;
                    font-size: 13px;
                }

                .login-main {
                    padding: 110px 16px 60px;
                }

                .login-card {
                    padding: 30px 22px;
                }

                .login-heading h1 {
                    font-size: 26px;
                }

                .footer {
                    padding: 22px 16px;
                    font-size: 11px;
                }
            }

    </style>

</head>


<body>

    <div class="login-page">

        <!-- =====================================================
             BACKGROUND OVERLAY
        ====================================================== -->

        <div class="page-overlay"></div>


        <!-- =====================================================
             NAVIGATION
        ====================================================== -->

        <nav class="navbar">

            <div class="navbar-container">

                <div class="navbar-left">

                    <a href="/" class="logo-link">

                        <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                             alt="UNILAK Logo"
                             class="navbar-logo">

                    </a>

                    <a href="/" class="navbar-brand">

                        UNILAK <span>Portal</span>

                    </a>

                </div>


                <ul class="navbar-nav">

                    <li>

                        <a href="/" class="nav-link">

                            <i class="bi bi-house-door-fill"></i>

                            <span>Home</span>

                        </a>

                    </li>


                    <li>

                        <a href="/#features" class="nav-link">

                            <i class="bi bi-grid-fill"></i>

                            <span>Features</span>

                        </a>

                    </li>


                    <li>

                        <a href="/Login"
                           class="nav-btn-login">

                            <i class="bi bi-box-arrow-in-right"></i>

                            <span>Login</span>

                        </a>

                    </li>

                </ul>

            </div>

        </nav>


        <!-- =====================================================
             LOGIN
        ====================================================== -->

        <main class="login-main">

            <div class="login-container">

                <div class="login-card">

                    <!-- HEADING -->

                    <div class="login-heading">

                        <div class="login-icon">

                            <i class="bi bi-person-fill"></i>

                        </div>

                        <h1>Welcome Back</h1>

                        <p>
                            Sign in to access the UNILAK Staff Engagement Portal.
                        </p>

                    </div>


                    <!-- ERROR -->
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="error-message">

                            <i class="bi bi-exclamation-circle-fill"></i>

                            <span>
                                @Model.ErrorMessage
                            </span>

                        </div>
                    }


                    <!-- FORM -->

                    <form method="post">

                        <div class="form-group">

                            <label asp-for="Username">
                                Username
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-person"></i>

                                <input asp-for="Username"
                                       placeholder="Enter your username"
                                       autocomplete="username" />

                            </div>

                        </div>


                        <div class="form-group">

                            <label asp-for="Password">
                                Password
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-lock"></i>

                                <input asp-for="Password"
                                       type="password"
                                       placeholder="Enter your password"
                                       autocomplete="current-password" />

                            </div>

                        </div>


                        <button type="submit"
                                class="login-button">

                            <span>Sign In</span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>


                    <!-- BACK -->

                    <a href="/" class="back-link">

                        <i class="bi bi-arrow-left"></i>

                        <span>Back to Home</span>

                    </a>

                </div>

            </div>

        </main>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <footer class="footer">

            <strong>UNILAK Portal</strong>

            · Academic Staff Engagement & Claim Processing System

            <div style="margin-top: 5px;">

                <i class="bi bi-shield-check"></i>

                Secure Academic Management Platform

            </div>

        </footer>

    </div>

</body>

</html>